          <property name="source-code">((CPC.P0025.IA.A002_OV.FLW_PLC.Val &gt; 0)?(CPC.P0025.IA.A002_OV.FLW_PLC.Val):(0)) + ((CPC.P0025.JAR.CRUDE_OIL_TANK.URD.PCU_Open.STATE.ALM)?(CPC.P0025_LTM.V1237SA.LAUNCHER_RECEIVER.FT0002.Val - CPC.P0025_LTM.V1237SA.LAUNCHER_RECEIVER.FT0022.Val):(0)) - ((CPC.P0025.JAR.BOOSTER_PUMP.URR.FIT0382.Val &gt; 0)?(CPC.P0025.JAR.BOOSTER_PUMP.URR.FIT0382.Val):(0))</property>
