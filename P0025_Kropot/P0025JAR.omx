        <ct:handler name="_TimeLaftInlet" uuid="7753497f-cb5e-4df2-a0ff-47663d4ba3c5">
          <property name="source-code">/*if (VolumeFree.Val &gt; 0)
{
    is_flw_sikn: bool = (CPC.P0025.IA.A002_OV.FLW_PLC.Val &gt; 0);
    
	if ((CPC.P0025_LTM.V1237SA.LAUNCHER_RECEIVER.FT0002.Val &gt; 0) &amp;&amp; (CPC.P0025_LTM.V1237SA.LAUNCHER_RECEIVER.FT0022.Val &gt; 0))
	{
		delta: float = (CPC.P0025_LTM.V1237SA.LAUNCHER_RECEIVER.FT0002.Val - CPC.P0025_LTM.V1237SA.LAUNCHER_RECEIVER.FT0022.Val);
		if (delta &gt; 500)
			if (is_flw_sikn)
				TimeLeftInlet = DateTime.AddHours(DateTime.Now(), VolumeFree.Val / (CPC.P0025.IA.A002_OV.FLW_PLC.Val + delta));
			else
				TimeLeftInlet = DateTime.AddHours(DateTime.Now(), VolumeFree.Val / delta);
		else
		{
			if (is_flw_sikn)
				TimeLeftInlet = DateTime.AddHours(DateTime.Now(), VolumeFree.Val / CPC.P0025.IA.A002_OV.FLW_PLC.Val);
		}
	}
}*/

if (FlowBalance &gt;= 10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.INFO.Calc)
	{
		_hour += ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.OutPreset.SP_AH)) - CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.INFO.Calc)
	{
		_hour += ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.OutPreset.SP_AH)) - CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.Val;
		_calc_hour = true;
	}
	if (_calc_hour)
		_hour = _hour / CPC.Calculator.DAILY_CALC.Kropotkinskaja.TankFeature.Koef;
	
	_calc_hour_koef2:bool = false;
	_hour_koef2:float = 0;
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.INFO.Calc)
	{
		_hour_koef2 += ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AH)) - CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.Val;
		_calc_hour_koef2 = true;
	}
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.INFO.Calc)
	{
		_hour_koef2 += ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AH)) - CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.Val;
		_calc_hour_koef2 = true;
	}
	if (_calc_hour_koef2)
		_hour_koef2 = _hour_koef2 / CPC.Calculator.DAILY_CALC.Kropotkinskaja.TankFeature.Koef2;
	
	if (_calc_hour || _calc_hour_koef2)
	{		
		_hour = (_hour + _hour_koef2) / FlowBalance;
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
	
}
else if (FlowBalance &lt;= -10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.INFO.Calc)
	{
		_hour += CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.Val - ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.INFO.Calc)
	{
		_hour += CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.Val - ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (_calc_hour)
		_hour = _hour / CPC.Calculator.DAILY_CALC.Kropotkinskaja.TankFeature.Koef;
	
	_calc_hour_koef2:bool = false;
	_hour_koef2:float = 0;
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.INFO.Calc)
	{
		_hour_koef2 += CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.Val - ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AL));
		_calc_hour_koef2 = true;
	}
	if (CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.INFO.Calc)
	{
		_hour_koef2 += CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.Val - ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AL));
		_calc_hour_koef2 = true;
	}
	if (_calc_hour_koef2)
		_hour_koef2 = _hour_koef2 / CPC.Calculator.DAILY_CALC.Kropotkinskaja.TankFeature.Koef2;
	
	if (_calc_hour || _calc_hour_koef2)
	{
		_hour = (_hour + _hour_koef2) / FlowBalance;
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else
{
	if (TimeLeftInlet != 0)
		TimeLeftInlet = 0;
}</property>
