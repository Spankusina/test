        <ct:handler name="IZMP1" access-level="public" uuid="9cd74aa1-8ebe-4f66-a8bc-8879c9446545">
          <ct:trigger on="P1.OUT" cause="update" />
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P1.OUT);
if (prior == 1) {L1 = 1;}
else if (prior == 2) {L2 = 1;}
else if (prior == 3) {L3 = 1;}
else if (prior == 4) {L4 = 1;}</property>
        </ct:handler>
        <ct:handler name="IZMP2" access-level="public" uuid="82638d2d-6ca4-4748-b895-6fb765be8e52">
          <ct:trigger on="P2.OUT" cause="update" />
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P2.OUT);
if (prior == 1) {L1 = 2;}
else if (prior == 2) {L2 = 2;}
else if (prior == 3) {L3 = 2;}
else if (prior == 4) {L4 = 2;}</property>
        </ct:handler>
        <ct:handler name="IZMP3" access-level="public" uuid="1edcc221-9da6-434e-830a-044b436a0cea">
          <ct:trigger on="P3.OUT" cause="update" />
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P3.OUT);
if (prior == 1) {L1 = 3;}
else if (prior == 2) {L2 = 3;}
else if (prior == 3) {L3 = 3;}
else if (prior == 4) {L4 = 3;}</property>
        </ct:handler>
        <ct:handler name="IZMP4" access-level="public" uuid="46523686-0c30-4cac-86eb-993fe984ef81">
          <ct:trigger on="P4.OUT" cause="update" />
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P4.OUT);
if (prior == 1) {L1 = 4;}
else if (prior == 2) {L2 = 4;}
else if (prior == 3) {L3 = 4;}
else if (prior == 4) {L4 = 4;}</property>
        </ct:handler>
