        <ct:parameter name="TimeLeftInlet" access-level="public" access-scope="global" direction="out" type="uint64" uuid="d1fed591-718b-48ed-bda4-099fd49a6592">
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
        </ct:parameter>
        <ct:parameter name="FlowBalance" uuid="d69a462c-b7b8-4a8a-bf33-b4231141792e" type="float32" direction="out">
          <attribute type="unit.System.Attributes.Description" value="Сумма всех расходов поступающих в РП минус откачка из РП" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        </ct:parameter>
        <ct:formula target="FlowBalance">
          <property name="source-code">((CPC.P0021.IB.A004_OV.FLW_PLC.Val &gt; 0)?(CPC.P0021.IB.A004_OV.FLW_PLC.Val):(0)) - ((CPC.P0021.JAR.DRA_UNIT.FT0023.Val &gt; 0)?(CPC.P0021.JAR.DRA_UNIT.FT0023.Val):(0))</property>
        </ct:formula>
        <ct:handler name="_TimeLeftInlet" uuid="adf66a07-75b6-4710-8d20-de5d92033c77">
          <property name="source-code">if (FlowBalance &gt;= 10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0021.JAR.TANKAGE.TKB001A.INFO.Calc)
	{
		_hour += ((CPC.P0021.JAR.TANKAGE.TKB001A.Level.Mode.use_plc_H)?(CPC.P0021.JAR.TANKAGE.TKB001A.Level.PLC_Preset.SP_AH):(CPC.P0021.JAR.TANKAGE.TKB001A.Level.OutPreset.SP_AH)) - CPC.P0021.JAR.TANKAGE.TKB001A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB001B.INFO.Calc)
	{
		_hour += ((CPC.P0021.JAR.TANKAGE.TKB001B.Level.Mode.use_plc_H)?(CPC.P0021.JAR.TANKAGE.TKB001B.Level.PLC_Preset.SP_AH):(CPC.P0021.JAR.TANKAGE.TKB001B.Level.OutPreset.SP_AH)) - CPC.P0021.JAR.TANKAGE.TKB001B.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB002A.INFO.Calc)
	{
		_hour += ((CPC.P0021.JAR.TANKAGE.TKB002A.Level.Mode.use_plc_H)?(CPC.P0021.JAR.TANKAGE.TKB002A.Level.PLC_Preset.SP_AH):(CPC.P0021.JAR.TANKAGE.TKB002A.Level.OutPreset.SP_AH)) - CPC.P0021.JAR.TANKAGE.TKB002A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB002B.INFO.Calc)
	{
		_hour += ((CPC.P0021.JAR.TANKAGE.TKB002B.Level.Mode.use_plc_H)?(CPC.P0021.JAR.TANKAGE.TKB002B.Level.PLC_Preset.SP_AH):(CPC.P0021.JAR.TANKAGE.TKB002B.Level.OutPreset.SP_AH)) - CPC.P0021.JAR.TANKAGE.TKB002B.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB003A.INFO.Calc)
	{
		_hour += ((CPC.P0021.JAR.TANKAGE.TKB003A.Level.Mode.use_plc_H)?(CPC.P0021.JAR.TANKAGE.TKB003A.Level.PLC_Preset.SP_AH):(CPC.P0021.JAR.TANKAGE.TKB003A.Level.OutPreset.SP_AH)) - CPC.P0021.JAR.TANKAGE.TKB003A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB003B.INFO.Calc)
	{
		_hour += ((CPC.P0021.JAR.TANKAGE.TKB003B.Level.Mode.use_plc_H)?(CPC.P0021.JAR.TANKAGE.TKB003B.Level.PLC_Preset.SP_AH):(CPC.P0021.JAR.TANKAGE.TKB003B.Level.OutPreset.SP_AH)) - CPC.P0021.JAR.TANKAGE.TKB003B.Level.Val;
		_calc_hour = true;
	}
	
	if (_calc_hour)
	{
		_hour = _hour / CPC.Calculator.DAILY_CALC.Tengiz.TankFeature.Koef / FlowBalance;
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else if (FlowBalance &lt;= -10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0021.JAR.TANKAGE.TKB001A.INFO.Calc)
	{
		_hour += CPC.P0021.JAR.TANKAGE.TKB001A.Level.Val - ((CPC.P0021.JAR.TANKAGE.TKB001A.Level.Mode.use_plc_L)?(CPC.P0021.JAR.TANKAGE.TKB001A.Level.PLC_Preset.SP_AL):(CPC.P0021.JAR.TANKAGE.TKB001A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB001B.INFO.Calc)
	{
		_hour += CPC.P0021.JAR.TANKAGE.TKB001B.Level.Val - ((CPC.P0021.JAR.TANKAGE.TKB001B.Level.Mode.use_plc_L)?(CPC.P0021.JAR.TANKAGE.TKB001B.Level.PLC_Preset.SP_AL):(CPC.P0021.JAR.TANKAGE.TKB001B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB002A.INFO.Calc)
	{
		_hour += CPC.P0021.JAR.TANKAGE.TKB002A.Level.Val - ((CPC.P0021.JAR.TANKAGE.TKB002A.Level.Mode.use_plc_L)?(CPC.P0021.JAR.TANKAGE.TKB002A.Level.PLC_Preset.SP_AL):(CPC.P0021.JAR.TANKAGE.TKB002A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB002B.INFO.Calc)
	{
		_hour += CPC.P0021.JAR.TANKAGE.TKB002B.Level.Val - ((CPC.P0021.JAR.TANKAGE.TKB002B.Level.Mode.use_plc_L)?(CPC.P0021.JAR.TANKAGE.TKB002B.Level.PLC_Preset.SP_AL):(CPC.P0021.JAR.TANKAGE.TKB002B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB003A.INFO.Calc)
	{
		_hour += CPC.P0021.JAR.TANKAGE.TKB003A.Level.Val - ((CPC.P0021.JAR.TANKAGE.TKB003A.Level.Mode.use_plc_L)?(CPC.P0021.JAR.TANKAGE.TKB003A.Level.PLC_Preset.SP_AL):(CPC.P0021.JAR.TANKAGE.TKB003A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0021.JAR.TANKAGE.TKB003B.INFO.Calc)
	{
		_hour += CPC.P0021.JAR.TANKAGE.TKB003B.Level.Val - ((CPC.P0021.JAR.TANKAGE.TKB003B.Level.Mode.use_plc_L)?(CPC.P0021.JAR.TANKAGE.TKB003B.Level.PLC_Preset.SP_AL):(CPC.P0021.JAR.TANKAGE.TKB003B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	
	if (_calc_hour)
	{
		_hour = _hour / CPC.Calculator.DAILY_CALC.Tengiz.TankFeature.Koef / Math.Abs(FlowBalance);
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else
{
	if (TimeLeftInlet != 0)
		TimeLeftInlet = 0;
}</property>
          <ct:trigger on="FlowBalance" cause="change" />
          <ct:trigger on="CPC.P0021.JAR.TANKAGE.TKB001A.Level.Mode.use_plc_L" cause="change" />
          <ct:trigger on="CPC.P0021.JAR.TANKAGE.TKB001A.Level.PLC_Preset.SP_AL" cause="change" />
