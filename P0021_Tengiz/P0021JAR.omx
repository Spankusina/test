          <attribute type="unit.System.Attributes.Description" value="@(Calc_ADR:System.Attributes.Description)" />
          <attribute type="unit.Server.Attributes.Alarm" value="{&quot;Condition&quot;:{&quot;IsEnabled&quot;:&quot;true&quot;,&quot;Subconditions&quot;:[{&quot;AckStrategy&quot;:0,&quot;IsEnabled&quot;:true,&quot;Message&quot;:&quot;. @(Calc_ADR:System.Attributes.Description)&quot;,&quot;Severity&quot;:&quot;104&quot;,&quot;Type&quot;:&quot;On&quot;},{&quot;AckStrategy&quot;:0,&quot;IsEnabled&quot;:true,&quot;Message&quot;:&quot;. @(Calc_ADR:System.Attributes.Description). Сигнал снят&quot;,&quot;Severity&quot;:&quot;104&quot;,&quot;Type&quot;:&quot;Off&quot;}],&quot;Type&quot;:&quot;Discrete&quot;}}" />
