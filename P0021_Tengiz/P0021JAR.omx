          <attribute type="unit.System.Attributes.InitialValue" value="Logic" />
        </ct:parameter>
        <ct:handler name="TU_Calc_On" access-level="public" uuid="9e195e6c-798a-48f3-819f-e97e91b0712e">
          <ct:trigger on="TU.Calc_On" cause="any-change" />
          <property name="source-code">if ((TU.Calc_On.Quality &gt;= 192) &amp;&amp; TU.Calc_On.Value)
{	
	CPC.P0021.JAR.TANKAGE.TKB001A.INFO.Calc = true;
	CPC.P0021.JAR.TANKAGE.TKB001B.INFO.Calc = true;
	CPC.P0021.JAR.TANKAGE.TKB002A.INFO.Calc = true;
	CPC.P0021.JAR.TANKAGE.TKB002B.INFO.Calc = true;
	CPC.P0021.JAR.TANKAGE.TKB003A.INFO.Calc = true;
	CPC.P0021.JAR.TANKAGE.TKB003B.INFO.Calc = true;
	Calc = true;
}</property>
        </ct:handler>
        <ct:handler name="TU_Calc_Off" access-level="public" uuid="1230e112-f3ad-4689-8645-bacb15c54472">
          <ct:trigger on="TU.Calc_Off" cause="any-change" />
          <property name="source-code">if ((TU.Calc_Off.Quality &gt;= 192) &amp;&amp; TU.Calc_Off.Value)
{
	CPC.P0021.JAR.TANKAGE.TKB001A.INFO.Calc = false;
	CPC.P0021.JAR.TANKAGE.TKB001B.INFO.Calc = false;
	CPC.P0021.JAR.TANKAGE.TKB002A.INFO.Calc = false;
	CPC.P0021.JAR.TANKAGE.TKB002B.INFO.Calc = false;
	CPC.P0021.JAR.TANKAGE.TKB003A.INFO.Calc = false;
	CPC.P0021.JAR.TANKAGE.TKB003B.INFO.Calc = false;
	Calc = false;
}</property>
        </ct:handler>
        <ct:socket name="TU" access-level="public" access-scope="global" direction="in" uuid="4f0b5ecb-7f99-4868-b465-3577f88b2abc">
          <ct:socket-parameter name="Calc_On" type="bool" uuid="967907a4-03cb-4539-8d44-06a2469423fe">
            <attribute type="unit.System.Attributes.Description" value="@(Calc_On_ADR:unit.System.Attributes.Description)" />
