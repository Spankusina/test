    <ct:object name="AUX_OPERATOR_ALARMS" uuid="721ab61f-b93a-4f2e-ab33-633a570eafe3">
      <ct:object name="A004" uuid="ec9e291e-b4d9-4a7e-8306-d2bb12df49b1">
        <attribute type="unit.System.Attributes.Description" value="СИКН A004" />
        <ct:object name="SetPoints" base-type="unit.Types.Группа уставок.IOS_Group_SetPoints" uuid="dc30a982-4fef-4438-af0c-58064c092d34">
          <ct:handler name="_On" uuid="c74ceb35-5b32-4d7e-b6b3-01fa8979c505">
            <ct:trigger on="TU.On" cause="any-change" />
            <property name="source-code">if ((TU.On.Quality &gt;= 192) &amp;&amp; TU.On.Value)
{
	CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_L = true;
	CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_H = true;
	
	CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_L = true;
	CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_H = true;
	
	//CPC.P0023.IB.A004_OV.NMASS_READ.Mode.alm_oper_L = true;
	//CPC.P0023.IB.A004_OV.NMASS_READ.Mode.alm_oper_H = true;
	
	CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_L = true;
	CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_H = true;

	
}</property>
          </ct:handler>
          <ct:handler name="_Off" uuid="8736afdb-1044-474a-b364-df775171704d">
            <property name="source-code">if ((TU.Off.Quality &gt;= 192) &amp;&amp; TU.Off.Value)
{
	CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_L = false;
	CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_H = false;
	
	CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_L = false;
	CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_H = false;
	
	//CPC.P0023.IB.A004_OV.NMASS_READ.Mode.alm_oper_L = false;
	//CPC.P0023.IB.A004_OV.NMASS_READ.Mode.alm_oper_H = false;
	
	CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_L = false;
	CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_H = false;

}</property>
            <ct:trigger on="TU.Off" cause="any-change" />
          </ct:handler>
          <ct:formula target="On">
            <property name="source-code">((CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_L.Quality &lt; 192) ? (false) : (CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_L)) &amp;&amp; ((CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_H.Quality &lt; 192) ? (false) : (CPC.P0023.IB.A004_OV.PT1208.Mode.alm_oper_H)) &amp;&amp; ((CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_L.Quality &lt; 192) ? (false) : (CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_L)) &amp;&amp; ((CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_H.Quality &lt; 192) ? (false) : (CPC.P0023.IB.A004_OV.FLW_PLC.Mode.alm_oper_H)) &amp;&amp;((CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_L.Quality &lt; 192) ? (false) : (CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_L)) &amp;&amp; ((CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_H.Quality &lt; 192) ? (false) : (CPC.P0023.IB.A004_QUALITY.BSW.MAIN.Mode.alm_oper_H))</property>
          </ct:formula>
        </ct:object>
      </ct:object>
    </ct:object>
