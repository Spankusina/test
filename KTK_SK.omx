                  <property name="source-code">(!((P0031JAR.P0031JAR_CPU.Enabled &amp;&amp; (P0031JAR.P0031JAR_CPU.Channel_1.Status.Enabled || P0031JAR.P0031JAR_CPU.Channel_2.Status.Enabled) &amp;&amp; !P0031JAR.P0031JAR_CPU.Connected))?(0):(1)) + 

