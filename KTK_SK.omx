                <ct:formula target="Offline_PLC">
                  <property name="source-code">(!((P0025JAR.P0025JAR_CPU.Enabled &amp;&amp; (P0025JAR.P0025JAR_CPU.Channel_1.Status.Enabled || P0025JAR.P0025JAR_CPU.Channel_2.Status.Enabled) &amp;&amp; !P0025JAR.P0025JAR_CPU.Connected))?(0):(1)) + 

