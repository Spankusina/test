                <ct:formula target="Offline_PLC">
                  <property name="source-code">(!((P0021JAR.P0021JAR_CPU.Enabled &amp;&amp; (P0021JAR.P0021JAR_CPU.Channel_1.Status.Enabled || P0021JAR.P0021JAR_CPU.Channel_2.Status.Enabled) &amp;&amp; !P0021JAR.P0021JAR_CPU.Connected))?(0):(1)) + 

