                  <property name="source-code">((!P0025JAR.P0025JAR_CPU.Enabled || (!P0025JAR.P0025JAR_CPU.Channel_1.Status.Enabled &amp;&amp; !P0025JAR.P0025JAR_CPU.Channel_2.Status.Enabled))?(1):(0)) + 

