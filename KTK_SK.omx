                <attribute type="unit.Types.Attributes.PLC_Count" value="10" />
                <ct:formula target="Offline_PLC">
                  <property name="source-code">(!((M0042JAR.CPU.Enabled &amp;&amp; (M0042JAR.CPU.Channel_1.Status.Enabled || M0042JAR.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042JAR.CPU.Connected))?(0):(1)) + 

(!((M0042NBR.CPU.Enabled &amp;&amp; (M0042NBR.CPU.Channel_1.Status.Enabled || M0042NBR.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042NBR.CPU.Connected))?(0):(1)) + 

(!((M0042E.CPU.Enabled &amp;&amp; (M0042E.CPU.Channel_1.Status.Enabled || M0042E.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042E.CPU.Connected))?(0):(1)) + 

(!((M0042IB.CPU.Enabled &amp;&amp; (M0042IB.CPU.Channel_1.Status.Enabled || M0042IB.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042IB.CPU.Connected))?(0):(1)) + 

(!((M0042IC.CPU.Enabled &amp;&amp; (M0042IC.CPU.Channel_1.Status.Enabled || M0042IC.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042IC.CPU.Connected))?(0):(1)) + 

(!((M0042ID.CPU.Enabled &amp;&amp; (M0042ID.CPU.Channel_1.Status.Enabled || M0042ID.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042ID.CPU.Connected))?(0):(1)) + 

(!((M0042NAR.CPU.Enabled &amp;&amp; (M0042NAR.CPU.Channel_1.Status.Enabled || M0042NAR.CPU.Channel_2.Status.Enabled) &amp;&amp; !M0042NAR.CPU.Connected))?(0):(1)) + 

(!((R1504SA.CPU.Enabled &amp;&amp; (R1504SA.CPU.Channel_1.Status.Enabled || R1504SA.CPU.Channel_2.Status.Enabled) &amp;&amp; !R1504SA.CPU.Connected))?(0):(1)) + 

(!((V1499SA.CPU.Enabled &amp;&amp; (V1499SA.CPU.Channel_1.Status.Enabled || V1499SA.CPU.Channel_2.Status.Enabled) &amp;&amp; !V1499SA.CPU.Connected))?(0):(1)) + 

(!((W0040JB.CPU.Enabled &amp;&amp; (W0040JB.CPU.Channel_1.Status.Enabled || W0040JB.CPU.Channel_2.Status.Enabled) &amp;&amp; !W0040JB.CPU.Connected))?(0):(1))</property>
                </ct:formula>
                <ct:formula target="Off_PLC">
                  <property name="source-code">((!M0042JAR.CPU.Enabled || (!M0042JAR.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042JAR.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!M0042NBR.CPU.Enabled || (!M0042NBR.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042NBR.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!M0042E.CPU.Enabled || (!M0042E.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042E.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!M0042IB.CPU.Enabled || (!M0042IB.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042IB.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!M0042IC.CPU.Enabled || (!M0042IC.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042IC.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!M0042ID.CPU.Enabled || (!M0042ID.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042ID.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!M0042NAR.CPU.Enabled || (!M0042NAR.CPU.Channel_1.Status.Enabled &amp;&amp; !M0042NAR.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!R1504SA.CPU.Enabled || (!R1504SA.CPU.Channel_1.Status.Enabled &amp;&amp; !R1504SA.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!V1499SA.CPU.Enabled || (!V1499SA.CPU.Channel_1.Status.Enabled &amp;&amp; !V1499SA.CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!W0040JB.CPU.Enabled || (!W0040JB.CPU.Channel_1.Status.Enabled &amp;&amp; !W0040JB.CPU.Channel_2.Status.Enabled))?(1):(0))</property>
                </ct:formula>
              </ct:object>
