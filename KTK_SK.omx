                <ct:formula target="Off_PLC">
                  <property name="source-code">((!P0036NAR.P0036NAR_CPU.Enabled || (!P0036NAR.P0036NAR_CPU.Channel_1.Status.Enabled &amp;&amp; !P0036NAR.P0036NAR_CPU.Channel_2.Status.Enabled))?(1):(0)) + 

