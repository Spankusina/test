                <attribute type="unit.Types.Attributes.PLC_Count" value="7" />
                <ct:formula target="Offline_PLC">
                  <property name="source-code">(!((P0036NAR.P0036NAR_CPU.Enabled &amp;&amp; (P0036NAR.P0036NAR_CPU.Channel_1.Status.Enabled || P0036NAR.P0036NAR_CPU.Channel_2.Status.Enabled) &amp;&amp; !P0036NAR.P0036NAR_CPU.Connected))?(0):(1)) + 

