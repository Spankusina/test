((!P0021NBR.P0021NBR_CPU.Enabled || (!P0021NBR.P0021NBR_CPU.Channel_1.Status.Enabled &amp;&amp; !P0021NBR.P0021NBR_CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!P0021VT.P0021VT_CPU.Enabled || (!P0021VT.P0021VT_CPU.Channel_1.Status.Enabled &amp;&amp; !P0021VT.P0021VT_CPU.Channel_2.Status.Enabled))?(1):(0))</property>
