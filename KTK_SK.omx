(!((P0036EA.P0036EA_CPU.Enabled &amp;&amp; (P0036EA.P0036EA_CPU.Channel_1.Status.Enabled || P0036EA.P0036EA_CPU.Channel_2.Status.Enabled) &amp;&amp; !P0036EA.P0036EA_CPU.Connected))?(0):(1)) + 

(!((P0036JC.P0036JC_CPU.Enabled &amp;&amp; (P0036JC.P0036JC_CPU.Channel_1.Status.Enabled || P0036JC.P0036JC_CPU.Channel_2.Status.Enabled) &amp;&amp; !P0036JC.P0036JC_CPU.Connected))?(0):(1)) + 

