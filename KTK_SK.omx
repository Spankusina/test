                  <property name="source-code">((!P0021JAR.P0021JAR_CPU.Enabled || (!P0021JAR.P0021JAR_CPU.Channel_1.Status.Enabled &amp;&amp; !P0021JAR.P0021JAR_CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!P0021EB.P0021EB_CPU.Enabled || (!P0021EB.P0021EB_CPU.Channel_1.Status.Enabled &amp;&amp; !P0021EB.P0021EB_CPU.Channel_2.Status.Enabled))?(1):(0)) + 

((!P0021IB.P0021IB_CPU.Enabled || (!P0021IB.P0021IB_CPU.Channel_1.Status.Enabled &amp;&amp; !P0021IB.P0021IB_CPU.Channel_2.Status.Enabled))?(1):(0)) + 

