		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[i - 1] + accumulating;
		}
		
		flow_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
		
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
		
		level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	}

	Tank_1.Level.UpdateVal = true;
	Tank_1.Level.UpdateState = true;
	
	Tank_2.Level.UpdateVal = true;
	Tank_2.Level.UpdateState = true;
	
	Tank_3.Level.UpdateVal = true;
