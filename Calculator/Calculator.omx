            <property name="value">Минимальное значение из всех уставок High для уровней Резервуаров</property>
          </attribute>
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        </ct:parameter>
        <ct:formula target="Low">
          <property name="source-code">Math.Max(Math.Max(Math.Max(((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Mode.use_plc_L)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.PLC_Preset.SP_AL):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.OutPreset.SP_AL)),-3.4028235E+38f), ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Mode.use_plc_L)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.PLC_Preset.SP_AL):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.OutPreset.SP_AL))), ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Mode.use_plc_L)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.PLC_Preset.SP_AL):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.OutPreset.SP_AL)))</property>
        </ct:formula>
        <ct:formula target="High">
          <property name="source-code">Math.Min(Math.Min(Math.Min(((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Mode.use_plc_H)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.PLC_Preset.SP_AH):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.OutPreset.SP_AH)), 3.4028235E+38f), ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Mode.use_plc_H)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.PLC_Preset.SP_AH):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.OutPreset.SP_AH))), ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Mode.use_plc_H)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.PLC_Preset.SP_AH):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.OutPreset.SP_AH)))</property>
        </ct:formula>
      </ct:object>
    </ct:object>
