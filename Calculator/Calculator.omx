      <ct:parameter name="ChangeLastTime" type="uint64" direction="out" uuid="eb2c085c-5c0c-4898-9c7e-0cc73a75d52f">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">Время последнего изменения входных значений параметров (нулевая точка)</property>
        </attribute>
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
      <ct:parameter name="ChangeLastTime_Local" type="uint64" direction="out" uuid="8bb6df71-1a2b-4723-9188-ee2a7d10593b">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">Время последнего изменения входных значений параметров (нулевая точка) в текущем часовом поясе</property>
        </attribute>
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="ChangeLastTime.Local" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
      <ct:formula target="ChangeLastTime_Local" source-code="DateTime.ToLocal(ChangeLastTime)" />
      <ct:handler name="_TU_UpdateInput" uuid="68fa11c7-5550-4e69-85f7-1f07f5a00ed5">
        <ct:trigger on="TU.UpdateInput" cause="any-change" />
        <property name="source-code">if ((TU.UpdateInput.Value &amp;&amp; (TU.UpdateInput.Quality &gt;= 192)) || ((CPC_tree.Service.Replication.This.Role.Value == 2) &amp;&amp; (CPC_tree.Service.Replication.This.Role.Quality &gt;= 192)))
{
	if (SIKN_1.Flow.Arrays.Event[0] == false)
	{
		SIKN_1.Flow.Arrays.Val[0] = CPC.P0021.IB.A004_OV.FLW_PLC.Val;
		SIKN_1.InitFlow = CPC.P0021.IB.A004_OV.FLW_PLC.Val;
	}
	
	if (TotalFlowOut.Arrays.Event[0] == false)
	{
		TotalFlowOut.Arrays.Val[0] = CPC.P0021.JAR.DRA_UNIT.FT0023.Val;
		TotalFlowOut.InitFlowOut = CPC.P0021.JAR.DRA_UNIT.FT0023.Val;
	}
	
	Tank_1.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB001A.Level.Val;
	Tank_2.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB001B.Level.Val;
	Tank_3.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB002A.Level.Val;
	Tank_4.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB002B.Level.Val;
	Tank_5.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB003A.Level.Val;
	Tank_6.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB003B.Level.Val;
	
	TotalFlowIn.Arrays.Val[0] = SIKN_1.Flow.Arrays.Val[0];
	
	curTime: uint8 = DateTime.Now();
	CurMinute: uint1 = DateTime.Minute(curTime);
	CurSecond: uint1 = DateTime.Second(curTime);
	
	
	partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
	partMinute: float; //доля секунд в интервале одной минуты
	partMinute = (60 - CurSecond) / 60f;
	MinutesUntilInterval: float; //количество минут до конца интервала
	if (CurMinute == 0)
	{
		MinutesUntilInterval = 14;
	}
	else if ((15 - CurMinute) &gt; 0)
	{
		MinutesUntilInterval = 14 - CurMinute; //(15 - CurMinute) - 1 + partMinute
	}
	else if ((30 - CurMinute) &gt; 0)
	{
		MinutesUntilInterval = 29 - CurMinute;
	}
	else if ((45 - CurMinute) &gt; 0)
	{
		MinutesUntilInterval = 44 - CurMinute;
	}
	else
	{
		MinutesUntilInterval = 59 - CurMinute;
	}
	
	
	times: uint8 = curTime;
	Times.Val[0] = times;
	EventsInTime.Time_0 = times;
	times = DateTime.Create(DateTime.Year(curTime), DateTime.Month(curTime), DateTime.Day(curTime), DateTime.Hour(curTime), TypeConvert.ToUint1(CurMinute + MinutesUntilInterval + 1), 0, 0);
	Times.Val[1] = times;
	
	MinutesUntilInterval += partMinute;
	partInterval = MinutesUntilInterval / 15f;

	ChangeLastTime = curTime;
	
	
	
	flow_Max: float = -3.4028235E+38f;
	flow_Min: float = 3.4028235E+38f;
	
	flowOut_Max: float = -3.4028235E+38f;
	flowOut_Min: float = 3.4028235E+38f;
	
	level_Max: float = -3.4028235E+38f;
	level_Min: float = 3.4028235E+38f;
	
	flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[0]);
	flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[0]);
	
	flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[0]);
	flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[0]);
	
	level_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[0]), Tank_2.Level.Arrays.Val[0]), Tank_3.Level.Arrays.Val[0]), Tank_4.Level.Arrays.Val[0]), Tank_5.Level.Arrays.Val[0]), Tank_6.Level.Arrays.Val[0]);
	level_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[0]), Tank_2.Level.Arrays.Val[0]), Tank_3.Level.Arrays.Val[0]), Tank_4.Level.Arrays.Val[0]), Tank_5.Level.Arrays.Val[0]), Tank_6.Level.Arrays.Val[0]);
	
	
	accumulating: float;
	
	first_event_SIKN_1: bool = false;
	if ((SIKN_1.Flow.Arrays.Event[1] == false) &amp;&amp; (first_event_SIKN_1 == false))
	{
		SIKN_1.Flow.Arrays.Val[1] = SIKN_1.Flow.Arrays.Val[0];
	}
	else
	{
		if (first_event_SIKN_1 == false)
		{
			first_event_SIKN_1 = true;
		}
	}
	
	first_event_TotalFlowOut: bool = false;
	if ((TotalFlowOut.Arrays.Event[1] == false) &amp;&amp; (first_event_TotalFlowOut == false))
	{
		TotalFlowOut.Arrays.Val[1] = TotalFlowOut.Arrays.Val[0];
	}
	else
	{
		if (first_event_TotalFlowOut == false)
		{
			first_event_TotalFlowOut = true;
		}
	}
	
	TotalFlowIn.Arrays.Val[1] = SIKN_1.Flow.Arrays.Val[1];
	
	accumulating = ((TotalFlowIn.Arrays.Val[0] - TotalFlowOut.Arrays.Val[0]) / ((Math.TestBit(Tank_1.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_5.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_6.Level.Arrays.State[0], 1)?0:1)) / TankFeature.Koef / (TankFeature.HourParts / partInterval));
	if (Math.TestBit(Tank_1.Level.Arrays.State[0], 1))
	{
		Tank_1.Level.Arrays.Val[1] = Tank_1.Level.Arrays.Val[0];
	}
	else
	{
		Tank_1.Level.Arrays.Val[1] = Tank_1.Level.Arrays.Val[0] + accumulating;
	}
	if (Math.TestBit(Tank_2.Level.Arrays.State[0], 1))
	{
		Tank_2.Level.Arrays.Val[1] = Tank_2.Level.Arrays.Val[0];
	}
	else
	{
		Tank_2.Level.Arrays.Val[1] = Tank_2.Level.Arrays.Val[0] + accumulating;
	}
	if (Math.TestBit(Tank_3.Level.Arrays.State[0], 1))
	{
		Tank_3.Level.Arrays.Val[1] = Tank_3.Level.Arrays.Val[0];
	}
	else
	{
		Tank_3.Level.Arrays.Val[1] = Tank_3.Level.Arrays.Val[0] + accumulating;
	}
	if (Math.TestBit(Tank_4.Level.Arrays.State[0], 1))
	{
		Tank_4.Level.Arrays.Val[1] = Tank_4.Level.Arrays.Val[0];
	}
	else
	{
		Tank_4.Level.Arrays.Val[1] = Tank_4.Level.Arrays.Val[0] + accumulating;
	}
	if (Math.TestBit(Tank_5.Level.Arrays.State[0], 1))
	{
		Tank_5.Level.Arrays.Val[1] = Tank_5.Level.Arrays.Val[0];
	}
	else
	{
		Tank_5.Level.Arrays.Val[1] = Tank_5.Level.Arrays.Val[0] + accumulating;
	}
	if (Math.TestBit(Tank_6.Level.Arrays.State[0], 1))
	{
		Tank_6.Level.Arrays.Val[1] = Tank_6.Level.Arrays.Val[0];
	}
	else
	{
		Tank_6.Level.Arrays.Val[1] = Tank_6.Level.Arrays.Val[0] + accumulating;
	}
	
	flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[1]);
	flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[1]);
	
	flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[1]);
	flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[1]);
	
	level_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[1]), Tank_2.Level.Arrays.Val[1]), Tank_3.Level.Arrays.Val[1]), Tank_4.Level.Arrays.Val[1]), Tank_5.Level.Arrays.Val[1]), Tank_6.Level.Arrays.Val[1]);
	level_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[1]), Tank_2.Level.Arrays.Val[1]), Tank_3.Level.Arrays.Val[1]), Tank_4.Level.Arrays.Val[1]), Tank_5.Level.Arrays.Val[1]), Tank_6.Level.Arrays.Val[1]);
	
	for (i: uint4 = 2; i &lt; 193; i += 1)
	{
		if ((SIKN_1.Flow.Arrays.Event[i] == false) &amp;&amp; (first_event_SIKN_1 == false))
		{
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[0];
		}
		else
		{
			if (first_event_SIKN_1 == false)
			{
				first_event_SIKN_1 = true;
			}
		}
		
		if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (first_event_TotalFlowOut == false))
		{
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[0];
		}
		else
		{
			if (first_event_TotalFlowOut == false)
			{
				first_event_TotalFlowOut = true;
			}
		}
		
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i];
		
		accumulating = ((TotalFlowIn.Arrays.Val[i - 1] - TotalFlowOut.Arrays.Val[i - 1]) / ((Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_5.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_6.Level.Arrays.State[i - 1], 1)?0:1)) / TankFeature.Koef / TankFeature.HourParts);
		if (Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[i - 1] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[i - 1], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[i - 1] + accumulating;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[i - 1], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[i - 1] + accumulating;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[i - 1], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[i - 1] + accumulating;
		}
		if (Math.TestBit(Tank_5.Level.Arrays.State[i - 1], 1))
		{
			Tank_5.Level.Arrays.Val[i] = Tank_5.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_5.Level.Arrays.Val[i] = Tank_5.Level.Arrays.Val[i - 1] + accumulating;
		}
		if (Math.TestBit(Tank_6.Level.Arrays.State[i - 1], 1))
		{
			Tank_6.Level.Arrays.Val[i] = Tank_6.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_6.Level.Arrays.Val[i] = Tank_6.Level.Arrays.Val[i - 1] + accumulating;
		}
		
		flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]);
		
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
		
		level_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]), Tank_5.Level.Arrays.Val[i]), Tank_6.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]), Tank_5.Level.Arrays.Val[i]), Tank_6.Level.Arrays.Val[i]);
		
		times = DateTime.AddMinutes(times, 15);
		Times.Val[i] = times;
	}

	SIKN_1.Flow.UpdateVal = true;
	TotalFlowOut.UpdateVal = true;
	
	Tank_1.Level.UpdateVal = true;
	Tank_2.Level.UpdateVal = true;
	Tank_3.Level.UpdateVal = true;
	Tank_4.Level.UpdateVal = true;
	Tank_5.Level.UpdateVal = true;
	Tank_6.Level.UpdateVal = true;

	TotalFlowIn.UpdateVal = true;
	
	EventsInTime.UpdateTime = true;
	
	AutoScale.MaxFlow = flow_Max;
	AutoScale.MinFlow = flow_Min;
	AutoScale.MaxFlowOut = flowOut_Max;
	AutoScale.MinFlowOut = flowOut_Min;
	AutoScale.MaxLevel = level_Max;
	AutoScale.MinLevel = level_Min;
}</property>
        <ct:trigger on="CPC_tree.Service.Replication.This.Role" cause="any-change" />
      </ct:handler>
      <ct:object name="Tank_5" uuid="84c9db27-86d6-40cb-829c-1f30bab6ba64">
