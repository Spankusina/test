		if (Math.TestBit(Tank_4.Level.Arrays.State[i], 1) == true)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, false);
			if (is_zero_i)
			{
				Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 0, false);
				event_Tank_4 = true;
			}
			else
			{
				if (Math.TestBit(Tank_4.Level.Arrays.State[i], 0))
				{
					if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1) == false)
					{
						Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 0, false);
						event_Tank_4 = true;
					}
				}
				else
				{
					Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 0, true);
					event_Tank_4 = true;
				}
			}
		}
	}
	
	set_Batch_SIKN_1: bool = false;
	set_Batch_SIKN_2: bool = false;
	
	EndTime_SIKN_1: uint8;
	EndTime_SIKN_2: uint8;
	
	//--------------------Batch-------------------------
	if (is_zero_i == false)
	{
		if (TU.Values.SIKN_1.Batch.State.Value)
		{
			if (TU.Values.SIKN_1.Flow.Val.Quality &gt;= 192)
			{
				EndTime_SIKN_1 = DateTime.AddHours(Times.Val[i], TU.Values.SIKN_1.Batch.Val.Value / ((TU.Values.SIKN_1.Flow.Val.Value * Density) / 1000f));
				if (EndTime_SIKN_1 &lt;= Times.Val[192])
				{
					if (Math.TestBit(SIKN_1.Batch.Arrays.State[i], 0))
					{
						if (SIKN_1.Batch.Arrays.Val[i] != TU.Values.SIKN_1.Batch.Val.Value)
						{
							SIKN_1.Batch.Arrays.Val[i] = TU.Values.SIKN_1.Batch.Val.Value;
							set_Batch_SIKN_1 = true;
						}
					}
					else
					{
						SIKN_1.Batch.Arrays.Val[i] = TU.Values.SIKN_1.Batch.Val.Value;
						SIKN_1.Batch.Arrays.State[i] = Math.SetBit(SIKN_1.Batch.Arrays.State[i], 0, true);	//начало партии
						set_Batch_SIKN_1 = true;
					}
				}
			}
		}
		else
		{
			if (Math.TestBit(SIKN_1.Batch.Arrays.State[i], 0))
			{
				SIKN_1.Batch.Arrays.State[i] = Math.SetBit(SIKN_1.Batch.Arrays.State[i], 0, false);
				SIKN_1.Batch.Arrays.Val[i] = 0;
			}
		}
		
		if (TU.Values.SIKN_2.Batch.State.Value)
		{
			if (TU.Values.SIKN_2.Flow.Val.Quality &gt;= 192)
			{		
				EndTime_SIKN_2 = DateTime.AddHours(Times.Val[i], TU.Values.SIKN_2.Batch.Val.Value / ((TU.Values.SIKN_2.Flow.Val.Value * Density) / 1000f));
				if (EndTime_SIKN_2 &lt;= Times.Val[192])
				{
					if (Math.TestBit(SIKN_2.Batch.Arrays.State[i], 0))
					{
						if (SIKN_2.Batch.Arrays.Val[i] != TU.Values.SIKN_2.Batch.Val.Value)
						{
							SIKN_2.Batch.Arrays.Val[i] = TU.Values.SIKN_2.Batch.Val.Value;
							set_Batch_SIKN_2 = true;
						}
					}
					else
					{
						SIKN_2.Batch.Arrays.Val[i] = TU.Values.SIKN_2.Batch.Val.Value;
						SIKN_2.Batch.Arrays.State[i] = Math.SetBit(SIKN_2.Batch.Arrays.State[i], 0, true);	//начало партии
						set_Batch_SIKN_2 = true;
					}
				}
			}
		}
		else
		{
			if (Math.TestBit(SIKN_2.Batch.Arrays.State[i], 0))
			{
				SIKN_2.Batch.Arrays.State[i] = Math.SetBit(SIKN_2.Batch.Arrays.State[i], 0, false);
				SIKN_2.Batch.Arrays.Val[i] = 0;
			}
		}
	}
	
	accumulating_volume: float;
	accumulating1: float;
	accumulating2: float;
	
	partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
	if (is_zero_i == false)
	{
		if (i == 1)
		{
			
			CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
			CurSecond: uint1 = DateTime.Second(ChangeLastTime);
		
			//partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
			partMinute: float; //доля секунд в интервале одной минуты
			partMinute = (60 - CurSecond) / 60f;
			MinutesUntilInterval: float; //количество минут до конца интервала
			if (CurMinute == 0)
			{
				MinutesUntilInterval = 14 + partMinute;
			}
			else if ((15 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
			}
			else if ((30 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 29 - CurMinute + partMinute;
			}
			else if ((45 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 44 - CurMinute + partMinute;
			}
			else
			{
				MinutesUntilInterval = 59 - CurMinute + partMinute;
			}
		
			partInterval = MinutesUntilInterval / 15f;
		}
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i] + SIKN_2.Flow.Arrays.Val[i];
		accumulating_volume = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1)) / ((i == 1)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)));
		
		accumulating1 = accumulating_volume / TankFeature.Koef;
		accumulating2 = accumulating_volume / TankFeature.Koef2;
	
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j] + accumulating2;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j] + accumulating2;
		}
	}
	else
	{
		CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
		CurSecond: uint1 = DateTime.Second(ChangeLastTime);
	
		//partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
		partMinute: float; //доля секунд в интервале одной минуты
		partMinute = (60 - CurSecond) / 60f;
		MinutesUntilInterval: float; //количество минут до конца интервала
		if (CurMinute == 0)
		{
			MinutesUntilInterval = 14 + partMinute;
		}
		else if ((15 - CurMinute) &gt; 0)
		{
			MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
		}
		else if ((30 - CurMinute) &gt; 0)
		{
			MinutesUntilInterval = 29 - CurMinute + partMinute;
		}
		else if ((45 - CurMinute) &gt; 0)
		{
			MinutesUntilInterval = 44 - CurMinute + partMinute;
		}
		else
		{
			MinutesUntilInterval = 59 - CurMinute + partMinute;
		}
		
		partInterval = MinutesUntilInterval / 15f;
	}
	
	flow_Max: float = -3.4028235E+38f;
	flow_Min: float = 3.4028235E+38f;
	
	flowOut_Max: float = -3.4028235E+38f;
	flowOut_Min: float = 3.4028235E+38f;
	
	level_Max: float = -3.4028235E+38f;
	level_Min: float = 3.4028235E+38f;
	
	flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
	flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
	flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
	flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
		
	level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	
	j = i;	
	i += 1;
	for (; i &lt; 193; i += 1)
	{
			//------------------Flow------------------
		
		if ((SIKN_1.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_1))
		{
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_1)
			{
				event_Flow_SIKN_1 = false;
			}
		}
			
		if ((SIKN_2.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_2))
		{
			SIKN_2.Flow.Arrays.Val[i] = SIKN_2.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_2)
			{
				event_Flow_SIKN_2 = false;
			}
		}
		
		if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (event_Flow_Out))
		{
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_Out)
			{
				event_Flow_Out = false;
			}
		}
		
		//------------------Tank------------------
		
		if ((Math.TestBit(Tank_1.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_1)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_1)
			{
				event_Tank_1 = false;
			}
		}
		
		if ((Math.TestBit(Tank_2.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_2)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_2)
			{
				event_Tank_2 = false;
			}
		}
		
		if ((Math.TestBit(Tank_3.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_3)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_3)
			{
				event_Tank_3 = false;
			}
		}
		
		if ((Math.TestBit(Tank_4.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_4)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, Math.TestBit(Tank_4.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_4)
			{
				event_Tank_4 = false;
			}
		}
		
		//------------------Batch------------------
		
		if (set_Batch_SIKN_1)
		{
			if ((EndTime_SIKN_1 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_1 &lt;= Times.Val[i]))
			{
				SIKN_1.Batch.Arrays.State[i] = Math.SetBit(SIKN_1.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_1.Batch.Arrays.Val[i] = 0;
				
				SIKN_1.Flow.Arrays.Val[i] = 0;
				SIKN_1.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_1 = false;
				event_Flow_SIKN_1 = true;
			}
		}
		
		if (set_Batch_SIKN_2)
		{
			if ((EndTime_SIKN_2 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_2 &lt;= Times.Val[i]))
			{
				SIKN_2.Batch.Arrays.State[i] = Math.SetBit(SIKN_2.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_2.Batch.Arrays.Val[i] = 0;
				
				SIKN_2.Flow.Arrays.Val[i] = 0;
				SIKN_2.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_2 = false;
				event_Flow_SIKN_2 = true;
			}
		}
		
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i] + SIKN_2.Flow.Arrays.Val[i];
		accumulating_volume = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1)) / (is_zero_i?((j == 0)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)):(TankFeature.HourParts)));
		
		accumulating1 = accumulating_volume / TankFeature.Koef;
		accumulating2 = accumulating_volume / TankFeature.Koef2;
		
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j] + accumulating2;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j] + accumulating2;
		}
		
		j += 1;
		
		flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
			
		level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	}
	
	Tank_1.Level.UpdateVal = true;
	Tank_1.Level.UpdateState = true;
	
	Tank_2.Level.UpdateVal = true;
	Tank_2.Level.UpdateState = true;
	
	Tank_3.Level.UpdateVal = true;
	Tank_3.Level.UpdateState = true;
	
	Tank_4.Level.UpdateVal = true;
	Tank_4.Level.UpdateState = true;
	TotalFlowIn.UpdateVal = true;
	
	SIKN_1.Flow.UpdateVal = true;
	SIKN_1.Flow.UpdateEvent = true;
	
	SIKN_2.Flow.UpdateVal = true;
	SIKN_2.Flow.UpdateEvent = true;
	
	TotalFlowOut.UpdateVal = true;
	TotalFlowOut.UpdateEvent = true;
	
	SIKN_1.Batch.Update = true;
	SIKN_2.Batch.Update = true;
	
	if (is_zero_i == false)
	{
		j = TU.Set_index.Value;
		i = 0;
		for (; i &lt; j; i += 1)
		{
			flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
			flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
			flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
			flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
			
			level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			
		}
		
	}
	
	AutoScale.MaxFlow = flow_Max;
	AutoScale.MinFlow = flow_Min;
	AutoScale.MaxFlowOut = flowOut_Max;
	AutoScale.MinFlowOut = flowOut_Min;
	AutoScale.MaxLevel = level_Max;
	AutoScale.MinLevel = level_Min;
}</property>
      </ct:handler>
      <ct:parameter name="Density" type="float32" direction="out" uuid="8d27fa3c-bab7-4613-8429-468d6b8da9a7">
        <attribute type="unit.System.Attributes.InitialValue" value="790" />
      </ct:parameter>
      <ct:handler name="_TU_Reset_Point" uuid="cc25c54d-7e75-4cf9-a6d3-8c511480aa42">
        <ct:trigger on="TU.Reset_Point" cause="any-change" />
        <property name="source-code">if ((TU.Reset_Point.Quality &gt;= 192) &amp;&amp; TU.Reset_Point.Value &amp;&amp; (TU.Reset_Point_index.Quality &gt;= 192) &amp;&amp; (TU.Reset_Point_index.Value &gt;= 0) &amp;&amp; (TU.Reset_Point_index.Value &lt;= 192))
{
	i: uint4 = TU.Reset_Point_index;
	j: uint4 = 0;
	is_zero_i: bool = false;
	
	if (i == 0)
	{
		is_zero_i = true;
	}
	else
	{
		j = i - 1;
	}
	
	event_Flow_SIKN_1: bool = false;
	event_Flow_SIKN_2: bool = false;
	event_Flow_Out: bool = false;
	
	if (SIKN_1.Flow.Arrays.Event[i])
	{
		SIKN_1.Flow.Arrays.Event[i] = false;
		event_Flow_SIKN_1 = true;
		if (is_zero_i == false)
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[j];
		else
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.InitFlow;
	}
	
	if (SIKN_2.Flow.Arrays.Event[i])
	{
		SIKN_2.Flow.Arrays.Event[i] = false;
		event_Flow_SIKN_2 = true;
		if (is_zero_i == false)
			SIKN_2.Flow.Arrays.Val[i] = SIKN_2.Flow.Arrays.Val[j];
		else
			SIKN_2.Flow.Arrays.Val[i] = SIKN_2.InitFlow;
	}
	
	if (TotalFlowOut.Arrays.Event[i])
	{
		TotalFlowOut.Arrays.Event[i] = false;
		event_Flow_Out = true;
		if (is_zero_i == false)
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
		else
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.InitFlowOut;
	}

	TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i] + SIKN_2.Flow.Arrays.Val[i];

	if (Math.TestBit(SIKN_1.Batch.Arrays.State[i], 0) || Math.TestBit(SIKN_1.Batch.Arrays.State[i], 1))
	{
		SIKN_1.Batch.Arrays.State[i] = 0;
		SIKN_1.Batch.Arrays.Val[i] = 0;
	}
	
	if (Math.TestBit(SIKN_2.Batch.Arrays.State[i], 0) || Math.TestBit(SIKN_2.Batch.Arrays.State[i], 1))
	{
		SIKN_2.Batch.Arrays.State[i] = 0;
		SIKN_2.Batch.Arrays.Val[i] = 0;
	}

	event_Tank_1: bool = false;
	event_Tank_3: bool = false;
	event_Tank_2: bool = false;
	event_Tank_4: bool = false;
	
	if (Math.TestBit(Tank_1.Level.Arrays.State[i], 0))
	{
		Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, false);
		event_Tank_1 = true;
		if (is_zero_i)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[j], 1));
		}
	}
	
	if (Math.TestBit(Tank_3.Level.Arrays.State[i], 0))
	{
		Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 0, false);
		event_Tank_3 = true;
		if (is_zero_i)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[j], 1));
		}
	}

	
	if (Math.TestBit(Tank_2.Level.Arrays.State[i], 0))
	{
		Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 0, false);
		event_Tank_2 = true;
		if (is_zero_i)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
	}
	
	if (Math.TestBit(Tank_4.Level.Arrays.State[i], 0))
	{
		Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 0, false);
		event_Tank_4 = true;
		if (is_zero_i)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, Math.TestBit(Tank_4.Level.Arrays.State[j], 1));
		}
	}
	
	accumulating_volume: float;
	accumulating1: float;
	accumulating2: float;
	
	partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	if (is_zero_i == false)
	{
		
		if (i == 1)
		{
			
			CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
			CurSecond: uint1 = DateTime.Second(ChangeLastTime);
		
			//partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
			partMinute: float; //доля секунд в интервале одной минуты
			partMinute = (60 - CurSecond) / 60f;
			MinutesUntilInterval: float; //количество минут до конца интервала
			if (CurMinute == 0)
			{
				MinutesUntilInterval = 14 + partMinute;
			}
			else if ((15 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
			}
			else if ((30 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 29 - CurMinute + partMinute;
			}
			else if ((45 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 44 - CurMinute + partMinute;
			}
			else
			{
				MinutesUntilInterval = 59 - CurMinute + partMinute;
			}
		
			partInterval = MinutesUntilInterval / 15f;
		}
		
		accumulating_volume = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1)) / ((i == 1)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)));
		
		accumulating1 = accumulating_volume / TankFeature.Koef;
		accumulating2 = accumulating_volume / TankFeature.Koef2;
	
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j] + accumulating2;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j] + accumulating2;
		}
	}
	else
	{
		CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
		CurSecond: uint1 = DateTime.Second(ChangeLastTime);
	
		//partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
		partMinute: float; //доля секунд в интервале одной минуты
		partMinute = (60 - CurSecond) / 60f;
		MinutesUntilInterval: float; //количество минут до конца интервала
		if (CurMinute == 0)
		{
			MinutesUntilInterval = 14 + partMinute;
		}
		else if ((15 - CurMinute) &gt; 0)
		{
			MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
		}
		else if ((30 - CurMinute) &gt; 0)
		{
			MinutesUntilInterval = 29 - CurMinute + partMinute;
		}
		else if ((45 - CurMinute) &gt; 0)
		{
			MinutesUntilInterval = 44 - CurMinute + partMinute;
		}
		else
		{
			MinutesUntilInterval = 59 - CurMinute + partMinute;
		}
		
		partInterval = MinutesUntilInterval / 15f;
	}
	
	flow_Max: float = -3.4028235E+38f;
	flow_Min: float = 3.4028235E+38f;
	
	flowOut_Max: float = -3.4028235E+38f;
	flowOut_Min: float = 3.4028235E+38f;
	
	level_Max: float = -3.4028235E+38f;
	level_Min: float = 3.4028235E+38f;
	
	flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
	flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
	flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
	flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
		
	level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	
	j = i;	
	i += 1;
	for (; i &lt; 193; i += 1)
	{
		//------------------Flow------------------
		
		if ((SIKN_1.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_1))
		{
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_1)
			{
				event_Flow_SIKN_1 = false;
			}
		}
			
		if ((SIKN_2.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_2))
		{
			SIKN_2.Flow.Arrays.Val[i] = SIKN_2.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_2)
			{
				event_Flow_SIKN_2 = false;
			}
		}
		
		if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (event_Flow_Out))
		{
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_Out)
			{
				event_Flow_Out = false;
			}
		}
		
		
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i] + SIKN_2.Flow.Arrays.Val[i];
		
		//------------------Tank------------------
		
		if ((Math.TestBit(Tank_1.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_1)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_1)
			{
				event_Tank_1 = false;
			}
		}
		
		if ((Math.TestBit(Tank_2.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_2)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_2)
			{
				event_Tank_2 = false;
			}
		}
		
		if ((Math.TestBit(Tank_3.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_3)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_3)
			{
				event_Tank_3 = false;
			}
		}
		
		if ((Math.TestBit(Tank_4.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_4)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, Math.TestBit(Tank_4.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_4)
			{
				event_Tank_4 = false;
			}
		}
		
		accumulating_volume = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1)) / (is_zero_i?((j == 0)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)):(TankFeature.HourParts)));
	
		accumulating1 = accumulating_volume / TankFeature.Koef;
		accumulating2 = accumulating_volume / TankFeature.Koef2;
	
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating1;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j] + accumulating2;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j] + accumulating2;
		}
		
		j += 1;
		
		flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
		
		level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	}

	Tank_1.Level.UpdateVal = true;
	Tank_1.Level.UpdateState = true;
	
	Tank_2.Level.UpdateVal = true;
	Tank_2.Level.UpdateState = true;
	
	Tank_3.Level.UpdateVal = true;
	Tank_3.Level.UpdateState = true;
	
	Tank_4.Level.UpdateVal = true;
	Tank_4.Level.UpdateState = true;
	
	TotalFlowIn.UpdateVal = true;
	
	SIKN_1.Flow.UpdateVal = true;
	SIKN_1.Flow.UpdateEvent = true;
	
	SIKN_2.Flow.UpdateVal = true;
	SIKN_2.Flow.UpdateEvent = true;
	
	TotalFlowOut.UpdateVal = true;
	TotalFlowOut.UpdateEvent = true;
	
	SIKN_1.Batch.Update = true;
	SIKN_2.Batch.Update = true;
	
	if (is_zero_i == false)
	{
		j = TU.Reset_Point_index.Value;
		i = 0;
		for (; i &lt; j; i += 1)
		{
			flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
			flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
			flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
			flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
			
			level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			
		}
		
	}
	
	AutoScale.MaxFlow = flow_Max;
	AutoScale.MinFlow = flow_Min;
	AutoScale.MaxFlowOut = flowOut_Max;
	AutoScale.MinFlowOut = flowOut_Min;
	AutoScale.MaxLevel = level_Max;
	AutoScale.MinLevel = level_Min;
}</property>
      </ct:handler>
      <ct:handler name="_TU_Transfer" uuid="83ae5765-b7e8-4241-9399-2284d4926b35">
        <ct:trigger on="TU.Transfer" cause="any-change" />
        <property name="source-code">if ((TU.Transfer.Quality &gt;= 192) &amp;&amp; TU.Transfer.Value &amp;&amp; (TU.Transfer_from_time.Quality &gt;= 192) &amp;&amp; (TU.Transfer_to_time.Quality &gt;= 192))
{
	if ((TU.Transfer_from_time.Value &gt;= Times.Val[1]) &amp;&amp; (TU.Transfer_from_time.Value &lt;= Times.Val[192]) &amp;&amp; (TU.Transfer_to_time.Value &gt;= Times.Val[1]) &amp;&amp; (TU.Transfer_to_time.Value &lt;= Times.Val[192]) &amp;&amp; (TU.Transfer_from_time.Value != TU.Transfer_to_time.Value))
	{
		i_reset: uint4;
		i_set: uint4;
		i_reset_less_i_set: bool = false;
		j: uint4;
		if (TU.Transfer_from_time.Value &lt; TU.Transfer_to_time)
		{
			i_reset_less_i_set = true;
			for (j = 1; j &lt; 193; j += 1)
			{
				if (Times.Val[j] == TU.Transfer_from_time.Value)
				{
					i_reset = j;
				}
				else
				{
					if (Times.Val[j] == TU.Transfer_to_time.Value)
					{
						i_set = j;
						break;
					}
				}
			}
		}
		else
		{
			for (j = 1; j &lt; 193; j += 1)
			{
				if (Times.Val[j] == TU.Transfer_from_time.Value)
				{
					i_reset = j;
					break;
				}
				else
				{
					if (Times.Val[j] == TU.Transfer_to_time.Value)
					{
						i_set = j;
					}
				}
			}
		}
		commit TU.Reset_Point_index = i_reset;
		commit TU.Set_index = i_set;
		
		commit TU.Reset_Point = true;
		TU.Set= true;
	}
}</property>
      </ct:handler>
