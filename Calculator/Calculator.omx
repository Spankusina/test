					event_Tank_2 = true;
				}
			}
		}
	}
	
	if (TU.Values.Tank_3.Level.State.Value)
	{
		if (Math.TestBit(Tank_3.Level.Arrays.State[i], 1) == false)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, true);
			if (is_zero_i)
			{
				Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 0, true);
