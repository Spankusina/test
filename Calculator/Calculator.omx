        <ct:handler name="_Transfer_from_time_i" uuid="447ca607-3d83-43d9-8e6a-8e49c83887b3">
          <ct:trigger on="Transfer_from_time_i" cause="any-change" />
          <property name="source-code">if ((Transfer_from_time_i.Value &gt;=0) &amp;&amp; (Transfer_from_time_i.Value &lt;=192))
	Transfer_from_time = Times.Val[Transfer_from_time_i];</property>
        </ct:handler>
