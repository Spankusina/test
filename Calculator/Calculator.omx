      <ct:handler name="_Times_Val" uuid="7bd6ac14-acb6-434e-946b-6ae3b299ccfd">
        <ct:trigger on="Timer" cause="any-change" />
        <property name="source-code">curTime: uint8 = DateTime.Now();
CurMinute: uint1 = DateTime.Minute(curTime);

if ((CurMinute == 0) || (CurMinute == 15) || (CurMinute == 30) || (CurMinute == 45) /*|| (CurMinute == 0) || (CurMinute == 2) || (CurMinute == 4) || (CurMinute == 6) || (CurMinute == 8) || (CurMinute == 10) || (CurMinute == 12) || (CurMinute == 14) || (CurMinute == 16) || (CurMinute == 18) || (CurMinute == 20) || (CurMinute == 22) || (CurMinute == 24) || (CurMinute == 26) || (CurMinute == 28) || (CurMinute == 30) || (CurMinute == 32) || (CurMinute == 34) || (CurMinute == 36) || (CurMinute == 38) || (CurMinute == 40) || (CurMinute == 42) || (CurMinute == 44) || (CurMinute == 46) || (CurMinute == 48) || (CurMinute == 50) || (CurMinute == 52) || (CurMinute == 54) || (CurMinute == 56) || (CurMinute == 58)*/)
{
	if (TimeShift == false)
	{
				
		times: uint8 = DateTime.Create(DateTime.Year(curTime), DateTime.Month(curTime), DateTime.Day(curTime), DateTime.Hour(curTime), DateTime.Minute(curTime), 0, 0);
		Times.Val[0] = times;
		EventsInTime.Time_0 = times;
		
		i: uint4 = 1;
		
		for (; i &lt; 193; i += 1)
		{
			times = DateTime.AddMinutes(times, 15);
			Times.Val[i] = times;
		}
		
//------------------------------Update Point 0---------------------------------
		if (SIKN_1.Flow.Arrays.Event[0] == false)
		{
			SIKN_1.Flow.Arrays.Val[0] = CPC.P0021.IB.A004_OV.FLW_PLC.Val;
			SIKN_1.Flow.Arrays.Val[1] = CPC.P0021.IB.A004_OV.FLW_PLC.Val;
			SIKN_1.InitFlow = CPC.P0021.IB.A004_OV.FLW_PLC.Val;
		}
		
		if (TotalFlowOut.Arrays.Event[0] == false)
		{
			TotalFlowOut.Arrays.Val[0] = CPC.P0021.JAR.DRA_UNIT.FT0023.Val;
			TotalFlowOut.Arrays.Val[1] = CPC.P0021.JAR.DRA_UNIT.FT0023.Val;
			TotalFlowOut.InitFlowOut = CPC.P0021.JAR.DRA_UNIT.FT0023.Val;
		}
	
		Tank_1.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB001A.Level.Val;
		Tank_2.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB001B.Level.Val;
		Tank_3.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB002A.Level.Val;
		Tank_4.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB002B.Level.Val;
		Tank_5.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB003A.Level.Val;
		Tank_6.Level.Arrays.Val[0] = CPC.P0021.JAR.TANKAGE.TKB003B.Level.Val;
		
		TotalFlowIn.Arrays.Val[0] = SIKN_1.Flow.Arrays.Val[0];
		
		ChangeLastTime = curTime;
	
//------------------------------TotalCalculating---------------------------------

		//------------------------------Flow_SIKN_1---------------------------------
		if (SIKN_1.Flow.Arrays.Event[1])
		{
			SIKN_1.Flow.Arrays.Event[1] = false;
		}
		if (SIKN_1.Flow.Arrays.Event[192])
		{
			SIKN_1.Flow.Arrays.Event[192] = false;
		}
		
		//------------------------------TotalFlowOut---------------------------------
		if (TotalFlowOut.Arrays.Event[1])
		{			
			TotalFlowOut.Arrays.Event[1] = false;
		}
		if (TotalFlowOut.Arrays.Event[192])
		{
			TotalFlowOut.Arrays.Event[192] = false;
		}
		
		reset_batch_SIKN_1: bool = false;
		//------------------------------Batch_SIKN_1---------------------------------
		if (Math.TestBit(SIKN_1.Batch.Arrays.State[1], 0))
		{
			reset_batch_SIKN_1 = true;
			SIKN_1.Batch.Arrays.Val[1] = 0;
		}
		else
		{
			SIKN_1.Batch.Arrays.Val[1] = SIKN_1.Batch.Arrays.Val[2];
		}
		SIKN_1.Batch.Arrays.State[1] = SIKN_1.Batch.Arrays.State[2];
		
		
		//------------------------------TotalFlowIn---------------------------------
		TotalFlowIn.Arrays.Val[0] = SIKN_1.Flow.Arrays.Val[0];
		TotalFlowIn.Arrays.Val[1] = SIKN_1.Flow.Arrays.Val[1];
		
		reset_off_Tank_1: bool = false;
		reset_off_Tank_3: bool = false;
		reset_off_Tank_2: bool = false;
		reset_off_Tank_4: bool = false;
		reset_off_Tank_5: bool = false;
		reset_off_Tank_6: bool = false;
		//---Level_Tank_1---
		Tank_1.Level.Arrays.State[1] = Tank_1.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_1.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_1.Level.Arrays.State[0], 1) != Math.TestBit(Tank_1.Level.Arrays.State[1], 1)))
		{
			Tank_1.Level.Arrays.State[1] = Math.SetBit(Tank_1.Level.Arrays.State[1], 1, Math.TestBit(Tank_1.Level.Arrays.State[0], 1));
			reset_off_Tank_1 = true;
		}
		//---Level_Tank_2---
		Tank_2.Level.Arrays.State[1] = Tank_2.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_2.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_2.Level.Arrays.State[0], 1) != Math.TestBit(Tank_2.Level.Arrays.State[1], 1)))
		{
			Tank_2.Level.Arrays.State[1] = Math.SetBit(Tank_2.Level.Arrays.State[1], 1, Math.TestBit(Tank_2.Level.Arrays.State[0], 1));
			reset_off_Tank_2 = true;
		}
		//---Level_Tank_3---
		Tank_3.Level.Arrays.State[1] = Tank_3.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_3.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_3.Level.Arrays.State[0], 1) != Math.TestBit(Tank_3.Level.Arrays.State[1], 1)))
		{
			Tank_3.Level.Arrays.State[1] = Math.SetBit(Tank_3.Level.Arrays.State[1], 1, Math.TestBit(Tank_3.Level.Arrays.State[0], 1));
			reset_off_Tank_3 = true;
		}
		//---Level_Tank_4---
		Tank_4.Level.Arrays.State[1] = Tank_4.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_4.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_4.Level.Arrays.State[0], 1) != Math.TestBit(Tank_4.Level.Arrays.State[1], 1)))
		{
			Tank_4.Level.Arrays.State[1] = Math.SetBit(Tank_4.Level.Arrays.State[1], 1, Math.TestBit(Tank_4.Level.Arrays.State[0], 1));
			reset_off_Tank_4 = true;
		}
		//---Level_Tank_5---
		Tank_5.Level.Arrays.State[1] = Tank_5.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_5.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_5.Level.Arrays.State[0], 1) != Math.TestBit(Tank_5.Level.Arrays.State[1], 1)))
		{
			Tank_5.Level.Arrays.State[1] = Math.SetBit(Tank_5.Level.Arrays.State[1], 1, Math.TestBit(Tank_5.Level.Arrays.State[0], 1));
			reset_off_Tank_5 = true;
		}
		//---Level_Tank_6---
		Tank_6.Level.Arrays.State[1] = Tank_6.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_6.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_6.Level.Arrays.State[0], 1) != Math.TestBit(Tank_6.Level.Arrays.State[1], 1)))
		{
			Tank_6.Level.Arrays.State[1] = Math.SetBit(Tank_6.Level.Arrays.State[1], 1, Math.TestBit(Tank_6.Level.Arrays.State[0], 1));
			reset_off_Tank_6 = true;
		}
	
		i = 2;
		first_event_Flow_SIKN_1: bool = false;
		first_event_Flow_Out: bool = false;
		for (; i &lt; 193; i += 1)
		{
			//---Flow_SIKN_1---
			if ((SIKN_1.Flow.Arrays.Event[i] == false) &amp;&amp; (first_event_Flow_SIKN_1 == false))
			{
				SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[0];
			}
			else
			{
				if (first_event_Flow_SIKN_1 == false)
				{
					first_event_Flow_SIKN_1 = true;
				}
				SIKN_1.Flow.Arrays.Event[i - 1] = SIKN_1.Flow.Arrays.Event[i];
				SIKN_1.Flow.Arrays.Val[i - 1] = SIKN_1.Flow.Arrays.Val[i];
			}
			
			//---TotalFlowOut---
			if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (first_event_Flow_Out == false))
			{
				TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[0];
			}
			else
			{
				if (first_event_Flow_Out == false)
				{
					first_event_Flow_Out = true;
				}
				TotalFlowOut.Arrays.Event[i - 1] = TotalFlowOut.Arrays.Event[i];
				TotalFlowOut.Arrays.Val[i - 1] = TotalFlowOut.Arrays.Val[i];
			}
			
			//---Level_Tank_1---
			if ((Math.TestBit(Tank_1.Level.Arrays.State[i], 0) == false) &amp;&amp; reset_off_Tank_1)
			{
				Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1));
			}
			else
			{
				if (reset_off_Tank_1)
				{
					reset_off_Tank_1 = false;
				}
