			}
			else
			{
				if (Math.TestBit(Tank_3.Level.Arrays.State[i], 0))
				{
					if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
					{
						Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 0, false);
						event_Tank_3 = true;
