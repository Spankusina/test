      </ct:handler>
      <ct:object name="TotalUstTank" uuid="366094a0-25f8-4b0e-bd72-94cc2213e94b">
        <ct:parameter name="Low" type="float32" direction="out" uuid="740e9614-01b8-44d6-95e3-48f20de6b4ab">
