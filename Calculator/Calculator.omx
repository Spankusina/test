				event_Flow_SIKN_3 = false;
			}
		}
			
		if ((SIKN_4.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_4))
		{
			SIKN_4.Flow.Arrays.Val[i] = SIKN_4.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_4)
			{
				event_Flow_SIKN_4 = false;
			}
		}
			
		if ((SIKN_5.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_5))
		{
			SIKN_5.Flow.Arrays.Val[i] = SIKN_5.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_5)
			{
				event_Flow_SIKN_5 = false;
			}
		}
		
		if ((SIKN_6.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_6))
		{
			SIKN_6.Flow.Arrays.Val[i] = SIKN_6.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_6)
			{
				event_Flow_SIKN_6 = false;
			}
		}
		
		if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (event_Flow_Out))
		{
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_Out)
			{
				event_Flow_Out = false;
			}
		}
		
		
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i] + SIKN_2.Flow.Arrays.Val[i] + SIKN_3.Flow.Arrays.Val[i] + SIKN_4.Flow.Arrays.Val[i] + SIKN_5.Flow.Arrays.Val[i] + SIKN_6.Flow.Arrays.Val[i];
		
		//------------------Tank------------------
		
		if ((Math.TestBit(Tank_1.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_1)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_1)
			{
				event_Tank_1 = false;
			}
		}
		
		if ((Math.TestBit(Tank_2.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_2)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_2)
			{
				event_Tank_2 = false;
			}
