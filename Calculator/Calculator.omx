          <ct:object name="Points" uuid="3e9e37ba-0ba8-43ac-9dbc-76c96c2bdf0a">
            <ct:object name="Point_1" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="852e2368-05bf-4ff3-b9af-245c64847025" />
