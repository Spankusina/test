    <ct:handler name="_Auto_Delete_Point_A580" uuid="791674aa-87b8-45b4-916b-9d822351c88a">
      <ct:trigger cause="change" on="CPC.M0042.JAR.SEQ_LOAD_NEW.LACT580.STEP_7" />
      <property name="source-code">if (CPC.M0042.JAR.SEQ_LOAD_NEW.LACT580.STEP_7.Value &amp;&amp; (CPC.M0042.JAR.SEQ_LOAD_NEW.LACT580.STEP_7.Quality &gt;= 192))
{
	for (i: uint4 = 0; i &lt; 10; i += 1)
	{
		if ((Arrays.Tanker[i] == A580.TankerName.Name))
		{
			if (Arrays.Empty[i] == false)
			{
				j: uint4;
				for (; i &lt; 49; i += 1)
				{
					j = i + 1;
					if (Arrays.Empty[j])
						break;
					else
					{
						Arrays.Number[i] = Arrays.Number[j];
						Arrays.Tanker[i] = Arrays.Tanker[j];
						Arrays.Mass[i] = Arrays.Mass[j];
						Arrays.Comment[i] = Arrays.Comment[j];
						Arrays.Empty[i] = Arrays.Empty[j];
					}
				}
				Arrays.Empty[i] = true;
				Arrays.FullCargoTime_OilAvail[i] = false;
				Points.CountFillPoints = i;
			}
			UpdatePoints = true;
			break;
		}
	}
}</property>
    </ct:handler>
