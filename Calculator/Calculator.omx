      <ct:handler name="_TU_Reset_Point" uuid="a747b9f1-9093-42f6-8f74-6d89c4d74bd3">
        <ct:trigger on="TU.Reset_Point" cause="any-change" />
        <property name="source-code">if ((TU.Reset_Point.Quality &gt;= 192) &amp;&amp; TU.Reset_Point.Value &amp;&amp; (TU.Reset_Point_index.Quality &gt;= 192) &amp;&amp; (TU.Reset_Point_index.Value &gt;= 0) &amp;&amp; (TU.Reset_Point_index.Value &lt;= 192))
{
	i: uint4 = TU.Reset_Point_index;
	j: uint4 = 0;
	is_zero_i: bool = false;
	
	if (i == 0)
	{
		is_zero_i = true;
	}
	else
	{
		j = i - 1;
	}
	
	event_Flow_SIKN_1: bool = false;
	event_Flow_Out: bool = false;
	
	if (SIKN_1.Flow.Arrays.Event[i])
	{
		SIKN_1.Flow.Arrays.Event[i] = false;
		event_Flow_SIKN_1 = true;
		if (is_zero_i == false)
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[j];
		else
			SIKN_1.Flow.Arrays.Val[i] = SIKN_1.InitFlow;
	}
	
	if (TotalFlowOut.Arrays.Event[i])
	{
		TotalFlowOut.Arrays.Event[i] = false;
		event_Flow_Out = true;
		if (is_zero_i == false)
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
		else
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.InitFlowOut;
	}

	TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i];

	if (Math.TestBit(SIKN_1.Batch.Arrays.State[i], 0) || Math.TestBit(SIKN_1.Batch.Arrays.State[i], 1))
	{
		SIKN_1.Batch.Arrays.State[i] = 0;
		SIKN_1.Batch.Arrays.Val[i] = 0;
	}

	event_Tank_1: bool = false;
	event_Tank_3: bool = false;
	event_Tank_2: bool = false;
	event_Tank_4: bool = false;
	event_Tank_5: bool = false;
	event_Tank_6: bool = false;
	
	if (Math.TestBit(Tank_1.Level.Arrays.State[i], 0))
	{
		Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, false);
		event_Tank_1 = true;
		if (is_zero_i)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[j], 1));
		}
	}
	
	if (Math.TestBit(Tank_3.Level.Arrays.State[i], 0))
	{
		Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 0, false);
		event_Tank_3 = true;
		if (is_zero_i)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[j], 1));
		}
	}

	
	if (Math.TestBit(Tank_2.Level.Arrays.State[i], 0))
	{
		Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 0, false);
		event_Tank_2 = true;
		if (is_zero_i)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
	}
	
	if (Math.TestBit(Tank_4.Level.Arrays.State[i], 0))
	{
		Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 0, false);
		event_Tank_4 = true;
		if (is_zero_i)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, Math.TestBit(Tank_4.Level.Arrays.State[j], 1));
		}
	}
	
	if (Math.TestBit(Tank_5.Level.Arrays.State[i], 0))
	{
		Tank_5.Level.Arrays.State[i] = Math.SetBit(Tank_5.Level.Arrays.State[i], 0, false);
		event_Tank_5 = true;
		if (is_zero_i)
		{
			Tank_5.Level.Arrays.State[i] = Math.SetBit(Tank_5.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_5.Level.Arrays.State[i] = Math.SetBit(Tank_5.Level.Arrays.State[i], 1, Math.TestBit(Tank_5.Level.Arrays.State[j], 1));
		}
	}
	
	if (Math.TestBit(Tank_6.Level.Arrays.State[i], 0))
	{
		Tank_6.Level.Arrays.State[i] = Math.SetBit(Tank_6.Level.Arrays.State[i], 0, false);
		event_Tank_6 = true;
		if (is_zero_i)
		{
			Tank_6.Level.Arrays.State[i] = Math.SetBit(Tank_6.Level.Arrays.State[i], 1, false);
		}
		else
		{
			Tank_6.Level.Arrays.State[i] = Math.SetBit(Tank_6.Level.Arrays.State[i], 1, Math.TestBit(Tank_6.Level.Arrays.State[j], 1));
		}
	}
	
	accumulating: float;
	partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	if (is_zero_i == false)
	{
		
		if (i == 1)
		{
			
			CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
			CurSecond: uint1 = DateTime.Second(ChangeLastTime);
		
			//partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
			partMinute: float; //доля секунд в интервале одной минуты
			partMinute = (60 - CurSecond) / 60f;
			MinutesUntilInterval: float; //количество минут до конца интервала
			if (CurMinute == 0)
			{
				MinutesUntilInterval = 14 + partMinute;
			}
			else if ((15 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
			}
			else if ((30 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 29 - CurMinute + partMinute;
			}
			else if ((45 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 44 - CurMinute + partMinute;
			}
			else
			{
				MinutesUntilInterval = 59 - CurMinute + partMinute;
			}
		
			partInterval = MinutesUntilInterval / 15f;
		}
		
		accumulating = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_5.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_6.Level.Arrays.State[j], 1)?0:1)) / TankFeature.Koef / ((i == 1)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)));
	
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating;
