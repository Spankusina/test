				event_Tank_1 = false;
			}
		}
		
		if ((Math.TestBit(Tank_2.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_2)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_2)
			{
				event_Tank_2 = false;
			}
		}
		
		if ((Math.TestBit(Tank_3.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_3)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_3)
			{
				event_Tank_3 = false;
			}
		}
		
		if ((Math.TestBit(Tank_4.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_4)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, Math.TestBit(Tank_4.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_4)
			{
				event_Tank_4 = false;
			}
		}
		
		if ((Math.TestBit(Tank_5.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_5)
		{
			Tank_5.Level.Arrays.State[i] = Math.SetBit(Tank_5.Level.Arrays.State[i], 1, Math.TestBit(Tank_5.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_5)
			{
				event_Tank_5 = false;
			}
		}
		
		if ((Math.TestBit(Tank_6.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_6)
		{
			Tank_6.Level.Arrays.State[i] = Math.SetBit(Tank_6.Level.Arrays.State[i], 1, Math.TestBit(Tank_6.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_6)
			{
				event_Tank_6 = false;
			}
		}
		
		accumulating = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_5.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_6.Level.Arrays.State[j], 1)?0:1)) / TankFeature.Koef / (is_zero_i?((j == 0)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)):(TankFeature.HourParts)));
	
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
