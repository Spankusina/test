            <ct:object name="Point_27" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="ba98ba9a-e35f-4c08-a85f-5fb8fbf0d9dd" />
            <ct:object name="Point_28" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="a5d71af3-f57f-461f-af24-51935b72ea3c" />
            <ct:object name="Point_29" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="e4f02534-6e11-44a7-82ac-8f8a9d193d73" />
            <ct:object name="Point_30" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="c223ac64-54b1-464c-aa95-e2fde3360153" />
            <ct:object name="Point_31" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="2a50a96c-6b2e-4a02-ac69-b1aa857261e7" />
            <ct:object name="Point_32" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="02e13fa7-11dd-4d51-8d36-df70e28436fb" />
            <ct:object name="Point_33" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="7cfdc632-78be-4c68-b61e-f780e0211a4b" />
            <ct:object name="Point_34" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="1e906d40-b986-46d5-9808-16ba53986577" />
            <ct:object name="Point_35" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="4c6602b7-232e-4117-8b1e-3d33bff075d8" />
            <ct:object name="Point_36" base-type="unit.Types.Калькулятор.Daily.UseArray.LevelPoint" uuid="6c7f69ad-c9c3-4911-b223-a6ed0df8e5ec" />
