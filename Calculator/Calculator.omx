	}
	
	//--------------------Tank-------------------------
	
	event_Tank_1: bool = false;
	event_Tank_3: bool = false;
	event_Tank_2: bool = false;
	
	if (TU.Values.Tank_1.Level.State.Value)
	{
		if (Math.TestBit(Tank_1.Level.Arrays.State[i], 1) == false)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, true);
			if (is_zero_i)
			{
				Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, true);
				event_Tank_1 = true;
			}
			else
			{
				if (Math.TestBit(Tank_1.Level.Arrays.State[i], 0))
				{
					if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
					{
						Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, false);
						event_Tank_1 = true;
					}
				}
				else
				{
					Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, true);
					event_Tank_1 = true;
				}
			}
		}
	}
	else
	{
