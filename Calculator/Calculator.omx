    <ct:object name="Agents" base-type="unit.Types.Калькулятор.Dashboard.Agents" uuid="808c953c-db48-4de2-b910-971f71e90ffc" />
    <ct:timer name="Timer" uuid="53e715d1-fee2-416b-a757-2a24cf221533" />
    <ct:handler name="_Timer" uuid="9a93e47e-7e87-4ce7-a064-44191e1b2964">
      <ct:trigger on="Timer" cause="any-change" />
      <property name="source-code">curDateTime: uint8 = DateTime.Now();
midnightDataTime: uint8 = DateTime.Create(DateTime.Year(curDateTime), DateTime.Month(curDateTime), DateTime.Day(curDateTime), 0, 0, 0, 0);
midnightDataTime = DateTime.AddDays(midnightDataTime, 1);
HoursToMidnight: float = (midnightDataTime - curDateTime) / 36000000000f;

if (curDateTime &gt;= TankFarm.MassCommerc_ToTime_DataTime)
{
	TankFarm.MassCommerc_ToTime_DataTime = DateTime.AddHours(DateTime.Create(DateTime.Year(curDateTime), DateTime.Month(curDateTime), DateTime.Day(curDateTime), DateTime.Hour(curDateTime), 0, 0, 0), 1);
}

HoursToTime: float  = (TankFarm.MassCommerc_ToTime_DataTime - curDateTime) / 36000000000f;

hour_loadingt: float; //время в часах, которое будет погрузаться остаток партии
calc_loading_to: float; //расчитанным значением погрузки ко времени / к полночи
rem_loading: float; //остаток погрузкм в единых единицах измерения

AllVolumeToMidnight: float = 0;
AllVolumeToTime: float = 0;
balance_massCommerc: float = TankFarm.MassCommerc; //остаток нефти в РП после погрузки всех танкеров и распределения всей оставшейся нефти между танкерами, ожидающими погрузки

// Если есть расход по СИКН A570
if ((A570.Flow.Value &gt; 0) &amp;&amp; (A570.Flow.Quality &gt;= 192) &amp;&amp; (A570.Remainder.Value &gt; 0) &amp;&amp; (A570.Remainder.Quality &gt;= 192))
{
	balance_massCommerc -= A570.Remainder;
	rem_loading = (A570.Remainder*1000f)/TankFarm.Density;
	calc_loading_to = A570.Flow.Value * HoursToTime;
	
	if (rem_loading &gt; calc_loading_to)      //к указанному времени не погрузится вся партия
		AllVolumeToTime = calc_loading_to;   //учитываем всю нефть, которая погрузится к указанному времени
	else								     //до указанного времени вся партия погрузится
		AllVolumeToTime = rem_loading;       //учитываем только остаток погрузки
	
	calc_loading_to = A570.Flow.Value * HoursToMidnight;
	if (rem_loading &gt; calc_loading_to)   //к полночи не погрузится вся партия
		AllVolumeToMidnight = calc_loading_to;
	else                                  //до полуночи погрузится вся партия
		AllVolumeToMidnight = rem_loading;
}

// Если есть расход по СИКН A580
if ((A580.Flow.Value &gt; 0) &amp;&amp; (A580.Flow.Quality &gt;= 192) &amp;&amp; (A580.Remainder.Value &gt; 0) &amp;&amp; (A580.Remainder.Quality &gt;= 192))
{
	balance_massCommerc -= A580.Remainder;
	rem_loading = (A580.Remainder*1000f)/TankFarm.Density;
	calc_loading_to = A580.Flow.Value * HoursToTime;
	
	if (rem_loading &gt; calc_loading_to) 
		AllVolumeToTime += calc_loading_to;
	else
		AllVolumeToTime += rem_loading;
	
	calc_loading_to = A580.Flow.Value * HoursToMidnight;
	if (rem_loading &gt; calc_loading_to)
		AllVolumeToMidnight += calc_loading_to;
	else
		AllVolumeToMidnight += rem_loading;
}

// Если есть расход по СИКН A590
if ((A590.Flow.Value &gt; 0) &amp;&amp; (A590.Flow.Quality &gt;= 192) &amp;&amp; (A590.Remainder.Value &gt; 0) &amp;&amp; (A590.Remainder.Quality &gt;= 192))
{
	balance_massCommerc -= A590.Remainder;
	rem_loading = (A590.Remainder*1000f)/TankFarm.Density;
	calc_loading_to = A590.Flow.Value * HoursToTime;
	
	if (rem_loading &gt; calc_loading_to) 
		AllVolumeToTime += calc_loading_to;
	else
		AllVolumeToTime += rem_loading;
	
	calc_loading_to = A580.Flow.Value * HoursToMidnight;
	if (rem_loading &gt; calc_loading_to)
		AllVolumeToMidnight += calc_loading_to;
	else
		AllVolumeToMidnight += rem_loading;
}

TankFarm.MassCommerc_Midnight = 0;
TankFarm.MassCommerc_ToTime = 0;

if (TankFarm.ManPlan_Use.Value)
{	
	if (TankFarm.ManPlan.Value &gt; AllVolumeToMidnight)
	{
		if (TankFarm.ManFlow_Use.Value)
		{
			if ((TankFarm.ManFlow.Value &gt;= 0) &amp;&amp; (TankFarm.ManFlow.Quality &gt;= 192))
			{
				TankFarm.MassCommerc_Midnight = ((TankFarm.ManFlow.Value * HoursToMidnight) - AllVolumeToMidnight) * TankFarm.Density.Value / 1000f;  //разница между закаченной нефти в резервуарный парк и откаченной с текущего момента до полуночи
				TankFarm.MassCommerc_ToTime = ((TankFarm.ManFlow.Value * HoursToTime) - AllVolumeToTime) * TankFarm.Density.Value / 1000f;            //разница между закаченной нефти в резервуарный парк и откаченной с текущего момента до указанного времени
			}
		}
		else
		{
			if ((TankFarm.Flow.Value &gt;= 0) &amp;&amp; (TankFarm.Flow.Quality &gt;=192))
			{
				TankFarm.MassCommerc_Midnight = ((TankFarm.Flow * HoursToMidnight) - AllVolumeToMidnight) * TankFarm.Density / 1000f;
				TankFarm.MassCommerc_ToTime = ((TankFarm.Flow * HoursToTime) - AllVolumeToTime) * TankFarm.Density / 1000f;
			}
		}
	}
	else
	{
		if (TankFarm.ManFlow_Use.Value)
		{
			if ((TankFarm.ManFlow.Value &gt;= 0) &amp;&amp; (TankFarm.ManFlow.Quality &gt;= 192))
			{
				TankFarm.MassCommerc_Midnight = ((TankFarm.ManFlow.Value * HoursToMidnight) - TankFarm.ManPlan.Value) * TankFarm.Density.Value / 1000f;
				TankFarm.MassCommerc_ToTime = ((TankFarm.ManFlow.Value * HoursToTime) - AllVolumeToTime) * TankFarm.Density.Value / 1000f;
			}
		}
		else
		{
			if ((TankFarm.Flow.Value &gt;= 0) &amp;&amp; (TankFarm.Flow.Quality &gt;=192))
			{
				TankFarm.MassCommerc_Midnight = ((TankFarm.Flow * HoursToMidnight) - TankFarm.ManPlan.Value) * TankFarm.Density / 1000f;
				TankFarm.MassCommerc_ToTime = ((TankFarm.Flow * HoursToTime) - AllVolumeToTime) * TankFarm.Density / 1000f;
			}
		}
	}
}
else 
{
	if (TankFarm.ManFlow_Use.Value == false)
	{
		if ((TankFarm.Flow.Value &gt;= 0) &amp;&amp; (TankFarm.Flow.Quality &gt;=192))
		{
			TankFarm.MassCommerc_Midnight = ((TankFarm.Flow * HoursToMidnight) - AllVolumeToMidnight) * TankFarm.Density / 1000f;
			TankFarm.MassCommerc_ToTime = ((TankFarm.Flow * HoursToTime) - AllVolumeToTime) * TankFarm.Density / 1000f;
		}
	}
	else
	{
		if ((TankFarm.ManFlow.Value &gt;= 0) &amp;&amp; (TankFarm.ManFlow.Quality &gt;= 192))
		{
			TankFarm.MassCommerc_Midnight = ((TankFarm.ManFlow.Value * HoursToMidnight) - AllVolumeToMidnight) * TankFarm.Density / 1000f;
			TankFarm.MassCommerc_ToTime = ((TankFarm.ManFlow.Value * HoursToTime) - AllVolumeToTime) * TankFarm.Density / 1000f;
		}
	}
		
	TankFarm.Plan = AllVolumeToMidnight * TankFarm.Density / 1000f;
}

TankFarm.MassCommerc_Midnight = TankFarm.MassCommerc + TankFarm.MassCommerc_Midnight;
TankFarm.MassCommerc_ToTime = TankFarm.MassCommerc + TankFarm.MassCommerc_ToTime;

dens: float;

if ((CPC.M0042.IB.PK42_A570_OV.NMASS_READ.Val.Value &gt; 0) &amp;&amp; (CPC.M0042.IB.PK42_A570_OV.VOLUME_READ.Val.Value &gt; 0) &amp;&amp; ((A570.Flow.Value &gt; 0)))
{
	dens = CPC.M0042.IB.PK42_A570_OV.NMASS_READ.Val.Value / CPC.M0042.IB.PK42_A570_OV.VOLUME_READ.Val.Value;
	
	hour_loadingt = (A570.Remainder / dens) / A570.Flow;
	if ((A570.Remainder.Value &lt; 4700) &amp;&amp; (A570.Remainder.Value &gt;= 3000))
		hour_loadingt += 0.9f;
	else if ((A570.Remainder.Value &lt; 3000) &amp;&amp; (A570.Remainder.Value &gt;= 2000))
		hour_loadingt += 0.7f;
	else if ((A570.Remainder.Value &lt; 2000) &amp;&amp; (A570.Remainder.Value &gt;= 1000))
		hour_loadingt += 0.6f;
	else if (A570.Remainder.Value &lt; 1000)
		hour_loadingt += 0.2f;
	else
		hour_loadingt += 1.5f;
	
	A570.EndTime = DateTime.AddHours(curDateTime, hour_loadingt);
	
	A570.FullCargoTime = DateTime.AddHours(curDateTime, (CPC.M0042.IB.PK42_A570_OV.VOLUME_READ.Val.Value / A570.Flow));
}
else
{
	A570.EndTime = 0;
	A570.FullCargoTime = 0;
}

if ((CPC.M0042.IC.PK42_A580_OV.NMASS_READ.Val.Value &gt; 0) &amp;&amp; (CPC.M0042.IC.PK42_A580_OV.VOLUME_READ.Val.Value &gt; 0) &amp;&amp; ((A580.Flow.Value &gt; 0)))
{
	dens = CPC.M0042.IC.PK42_A580_OV.NMASS_READ.Val.Value / CPC.M0042.IC.PK42_A580_OV.VOLUME_READ.Val.Value;
	
	hour_loadingt = (A580.Remainder / dens) / A580.Flow;
	if ((A580.Remainder.Value &lt; 4700) &amp;&amp; (A580.Remainder.Value &gt;= 3000))
		hour_loadingt += 0.9f;
	else if ((A580.Remainder.Value &lt; 3000) &amp;&amp; (A580.Remainder.Value &gt;= 2000))
		hour_loadingt += 0.7f;
	else if ((A580.Remainder.Value &lt; 2000) &amp;&amp; (A580.Remainder.Value &gt;= 1000))
		hour_loadingt += 0.6f;
	else if (A580.Remainder.Value &lt; 1000)
		hour_loadingt += 0.2f;
	else
		hour_loadingt += 1.5f;
	
	A580.EndTime = DateTime.AddHours(curDateTime, hour_loadingt);
	
	A580.FullCargoTime = DateTime.AddHours(curDateTime, (CPC.M0042.IC.PK42_A580_OV.VOLUME_READ.Val.Value / A580.Flow));
}
else
{
	A580.EndTime = 0;
	A580.FullCargoTime = 0;
}

if ((CPC.M0042.ID.PK42_A590_OV.NMASS_READ.Val.Value &gt; 0) &amp;&amp; (CPC.M0042.ID.PK42_A590_OV.VOLUME_READ.Val.Value &gt; 0) &amp;&amp; ((A590.Flow.Value &gt; 0)))
{
	dens = CPC.M0042.ID.PK42_A590_OV.NMASS_READ.Val.Value / CPC.M0042.ID.PK42_A590_OV.VOLUME_READ.Val.Value;
	
	hour_loadingt = (A590.Remainder / dens) / A590.Flow;
	if ((A590.Remainder.Value &lt; 4700) &amp;&amp; (A590.Remainder.Value &gt;= 3000))
		hour_loadingt += 0.9f;
	else if ((A590.Remainder.Value &lt; 3000) &amp;&amp; (A590.Remainder.Value &gt;= 2000))
		hour_loadingt += 0.7f;
	else if ((A590.Remainder.Value &lt; 2000) &amp;&amp; (A590.Remainder.Value &gt;= 1000))
		hour_loadingt += 0.6f;
	else if (A590.Remainder.Value &lt; 1000)
		hour_loadingt += 0.2f;
	else
		hour_loadingt += 1.5f;
	
	A590.EndTime = DateTime.AddHours(curDateTime, hour_loadingt);
	
	A590.FullCargoTime = DateTime.AddHours(curDateTime, (CPC.M0042.ID.PK42_A590_OV.VOLUME_READ.Val.Value / A590.Flow));
}
else
{
	A590.EndTime = 0;
	A590.FullCargoTime = 0;
}

for (i: uint4 = 0; i &lt; 50; i += 1)
{
	if (Arrays.Empty[i] == false)
	{
		if (balance_massCommerc &gt;= Arrays.Mass[i])
		{
			if (Arrays.FullCargoTime_OilAvail[i] == false)
				Arrays.FullCargoTime_OilAvail[i] = true;
			Arrays.FullCargoTime[i] = curDateTime;
			balance_massCommerc -= Arrays.Mass[i];
		}
		else
		{
			if (TankFarm.ManFlow_Use.Value == false)
			{
				if ((TankFarm.Flow.Quality &gt;= 192) &amp;&amp; (TankFarm.Flow.Value &gt; 0))
				{
					balance_massCommerc -= Arrays.Mass[i];
					Arrays.FullCargoTime[i] = DateTime.AddHours(curDateTime, (Math.Abs(balance_massCommerc))/(TankFarm.Flow * (TankFarm.Density / 1000f)));
				}
				else
					Arrays.FullCargoTime[i] = 0;
			}
			else
			{
				if ((TankFarm.ManFlow.Value &gt; 0))
				{
					balance_massCommerc -= Arrays.Mass[i];			
					Arrays.FullCargoTime[i] = DateTime.AddHours(curDateTime, (Math.Abs(balance_massCommerc))/(TankFarm.ManFlow * (TankFarm.Density / 1000f)));
				}
				else
					Arrays.FullCargoTime[i] = 0;
			}
			if (Arrays.FullCargoTime_OilAvail[i])
				Arrays.FullCargoTime_OilAvail[i] = false;
		}
	}
	else
	{
		break;
	}
}
UpdatePointsForFullCargo = true;</property>
    </ct:handler>
