    <ct:object name="Shipment" base-type="unit.Types.Калькулятор.Dashboard.Shipment" uuid="371583b5-a4b4-4e48-ac1b-8ce3f00e2309">
      <ct:schedule name="Schedule" cron-expression="0 0 0 1 1 *" uuid="5f90d76c-8077-4070-b802-59af4b2ac610" />
      <ct:handler name="_change_yaer" uuid="d78bccff-32cd-49be-826c-c3df94565caf">
        <ct:trigger on="Schedule" cause="any-change" />
        <property name="source-code">commit MTA_PREV = MTA_NOW;
commit MTA_NOW = 0;
MTA_PREV_year = MTA_NOW_year;
MTA_NOW_year += 1;

if (Ref_SnapShot_Generator.TemplateName != "Oil_Shipment_Template")
{
	commit Ref_SnapShot_Generator.TemplateName = "Oil_Shipment_Template";
}
if (Ref_SnapShot_Generator.OutFileName != "Oil_Shipment")
{
	commit Ref_SnapShot_Generator.OutFileName = "Oil_Shipment";
}
Ref_SnapShot_Generator.Generate = true;</property>
      </ct:handler>
      <ct:handler name="_start_server" uuid="fa496e1a-139a-483f-ab6b-5bcafa21ee7a">
        <ct:trigger on="CPC_tree.Service.Replication.This.Role_Trigger" cause="any-change" />
        <property name="source-code">if ((MTA_NOW_year == 0) &amp;&amp; (CPC_tree.Service.Replication.This.Role.Value == 2) &amp;&amp; (CPC_tree.Service.Replication.This.Role.Quality &gt;= 192) &amp;&amp; CPC_tree.Service.Replication.This.Role_Trigger.Value)
{
	MTA_NOW_year = DateTime.Year(DateTime.Now());
	MTA_PREV_year = TypeConvert.ToUint2(MTA_NOW_year - 1);
}</property>
      </ct:handler>
      <ct:handler name="_MTA_Add_A570" uuid="292e6274-c8fa-4163-bdb7-2cd74bee4cd3">
        <ct:trigger on="M0042.IB.PK42_A570_OV.S1_BAT_STATUS.Reference.PV" cause="any-change" />
        <property name="source-code">if ((M0042.IB.PK42_A570_OV.S1_BAT_STATUS.Reference.PV.Quality &gt;= 192) &amp;&amp; (M0042.IB.PK42_A570_OV.S1_BAT_STATUS.Reference.PV.Value == 0) &amp;&amp; (M0042.IB.PK42_A570_OV.NMASS_READ.Reference.PV == 0) &amp;&amp; (A570_NMASS_READ &gt; 0))
{
	commit MTA_NOW += A570_NMASS_READ / 1000000f;
	commit MTA_TOTAL += A570_NMASS_READ / 1000000f;
	A570_NMASS_READ = 0;
	
	if (Ref_SnapShot_Generator.TemplateName != "Oil_Shipment_Template")
	{
