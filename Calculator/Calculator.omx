    <ct:object name="TU" base-type="unit.Types.Калькулятор.Dashboard.TU_Array" uuid="99d89cb9-63e2-4407-9a48-c028eed69e8d" />
    <ct:handler name="_TU_Delete" uuid="9a1d3db9-1d55-4e51-9707-47d3fe86e7b6">
      <ct:trigger on="TU.Delete" cause="any-change" />
      <property name="source-code">if (TU.Delete.Value &amp;&amp; (TU.Delete.Quality &gt;= 192) &amp;&amp; (TU.Delete_Row.Quality &gt;= 192) &amp;&amp; (TU.Delete_Row.Value &gt;= 1) &amp;&amp; (TU.Delete_Row.Value &lt;= 50))
{
	i: uint4 = TU.Delete_Row.Value - 1;
	if (Arrays.Empty[i] == false)
	{
		j: uint4;
		for (; i &lt; 49; i += 1)
		{
			j = i + 1;
			if (Arrays.Empty[j])
				break;
			else
			{
				Arrays.Number[i] = Arrays.Number[j];
				Arrays.Tanker[i] = Arrays.Tanker[j];
				Arrays.Mass[i] = Arrays.Mass[j];
				Arrays.Comment[i] = Arrays.Comment[j];
				Arrays.Empty[i] = Arrays.Empty[j];
			}
		}
		Arrays.Empty[i] = true;
		Arrays.FullCargoTime_OilAvail[i] = false;
		Points.CountFillPoints = i;
	}
	UpdatePoints = true;
}</property>
    </ct:handler>
    <ct:handler name="_TU_Add" uuid="c41727e6-ce84-4a64-a5ea-e8f5ffa3a8a6">
      <ct:trigger on="TU.Add" cause="any-change" />
      <property name="source-code">if (TU.Add.Value &amp;&amp; (TU.Add.Quality &gt;= 192))
{
	for (i: uint4 = 0; i &lt; 50; i += 1)
	{
		if (Arrays.Empty[i])
		{
			Arrays.Number[i] = TU.Values.Number;
			Arrays.Tanker[i] = TU.Values.Tanker;
			Arrays.Mass[i] = TU.Values.Mass;
			Arrays.Comment[i] = TU.Values.Comment;
			Arrays.Empty[i] = false;
			
			UpdatePoints = true;
			Points.CountFillPoints = i + 1;
			break;
		}
	}
}</property>
    </ct:handler>
    <ct:handler name="_TU_Transfer" uuid="265eb46f-3ece-4098-8ad0-3c2557dd5803">
      <ct:trigger on="TU.Transfer" cause="any-change" />
      <property name="source-code">if (TU.Transfer.Value &amp;&amp; (TU.Transfer.Quality &gt;= 192) &amp;&amp; (TU.Transfer_From_Row.Quality &gt;= 192) &amp;&amp; (TU.Transfer_From_Row.Value &gt;= 1) &amp;&amp; (TU.Transfer_From_Row.Value &lt;= 50) &amp;&amp; (TU.Transfer_To_Row.Quality &gt;= 192) &amp;&amp; (TU.Transfer_To_Row.Value &gt;= 1) &amp;&amp; (TU.Transfer_To_Row.Value &lt;= 50) &amp;&amp; (TU.Transfer_From_Row.Value != TU.Transfer_To_Row.Value))
{
	i: uint4 = TU.Transfer_From_Row.Value - 1;
	if (Arrays.Empty[i] == false)
	{
		j: uint4 = TU.Transfer_To_Row.Value - 1;
		
		//сохраняем изменения, которые внёс пользователь
		number: uint4 = TU.Values.Number;;
		tankers: string = TU.Values.Tanker;
		mass: uint4 = TU.Values.Mass;
		comment: string = TU.Values.Comment;
		
		if (i &lt; j)
		{
			m: uint4 = i;
			n: uint4 =  m + 1;
			for (; m &lt; j; m += 1)
			{
				if (Arrays.Empty[n])
					break;
				Arrays.Number[m] = Arrays.Number[n];
				Arrays.Tanker[m] = Arrays.Tanker[n];
				Arrays.Mass[m] = Arrays.Mass[n];
				Arrays.Comment[m] = Arrays.Comment[n];
				n += 1;
			}
			Arrays.Number[m] = number;
			Arrays.Tanker[m] = tankers;
			Arrays.Mass[m] = mass;
			Arrays.Comment[m] = comment;
		}
		else
		{
			m: uint4 = i;
			n: uint4 =  m - 1;
			for (; m &gt; j; m -= 1)
			{
				Arrays.Number[m] = Arrays.Number[n];
				Arrays.Tanker[m] = Arrays.Tanker[n];
				Arrays.Mass[m] = Arrays.Mass[n];
				Arrays.Comment[m] = Arrays.Comment[n];
				n -= 1;
			}
			Arrays.Number[m] = number;
			Arrays.Tanker[m] = tankers;
			Arrays.Mass[m] = mass;
			Arrays.Comment[m] = comment;
		}
		UpdatePoints = true;
	}
}</property>
    </ct:handler>
    <ct:parameter name="UpdatePoints" type="bool" direction="out" uuid="d783cbd4-d4bd-4139-9c28-bc4de893abe4">
      <attribute type="unit.System.Attributes.Description" value="Обновить точки HMI" />
      <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
    </ct:parameter>
    <ct:handler name="_TU_Edit" uuid="ef13e27a-1806-41d0-9365-298c26bf16e6">
      <ct:trigger on="TU.Edit" cause="any-change" />
      <property name="source-code">if (TU.Edit.Value &amp;&amp; (TU.Edit.Quality &gt;= 192) &amp;&amp; (TU.Edit_Row.Quality &gt;= 192) &amp;&amp; (TU.Edit_Row.Value &gt;= 1) &amp;&amp; (TU.Edit_Row.Value &lt;= 50))
{
	i: uint4 = TU.Edit_Row.Value - 1;
	if (Arrays.Empty[i] == false)
	{
		Arrays.Number[i] = TU.Values.Number;
		Arrays.Tanker[i] = TU.Values.Tanker;
		Arrays.Mass[i] = TU.Values.Mass;
		Arrays.Comment[i] = TU.Values.Comment;
		
		UpdatePoints = true;
	}
}</property>
    </ct:handler>
    <ct:handler name="_Auto_Delete_Point_A570" uuid="4e2d75b3-3ac4-4b7c-a5a8-0e2ffca55d80">
      <ct:trigger cause="change" on="CPC.M0042.JAR.SEQ_LOAD_NEW.LACT570.STEP_7" />
      <property name="source-code">if (CPC.M0042.JAR.SEQ_LOAD_NEW.LACT570.STEP_7.Value &amp;&amp; (CPC.M0042.JAR.SEQ_LOAD_NEW.LACT570.STEP_7.Quality &gt;= 192))
{
	for (i: uint4 = 0; i &lt; 10; i += 1)
	{
		if ((Arrays.Tanker[i] == A570.TankerName.Name))
		{
			if (Arrays.Empty[i] == false)
			{
				j: uint4;
				for (; i &lt; 49; i += 1)
				{
					j = i + 1;
					if (Arrays.Empty[j])
						break;
					else
					{
						Arrays.Number[i] = Arrays.Number[j];
						Arrays.Tanker[i] = Arrays.Tanker[j];
						Arrays.Mass[i] = Arrays.Mass[j];
						Arrays.Comment[i] = Arrays.Comment[j];
						Arrays.Empty[i] = Arrays.Empty[j];
					}
				}
				Arrays.Empty[i] = true;
				Arrays.FullCargoTime_OilAvail[i] = false;
				Points.CountFillPoints = i;
			}
			UpdatePoints = true;
			break;
		}
	}
}</property>
    </ct:handler>
