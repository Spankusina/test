		accumulating_volume: float = ((TotalFlowIn.Arrays.Val[0] - TotalFlowOut.Arrays.Val[0]) / ((Math.TestBit(Tank_1.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[0], 1)?0:1)) / TankFeature.HourParts);
