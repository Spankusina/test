					}
					else
					{
						SIKN_1.Batch.Arrays.Val[i] = TU.Values.SIKN_1.Batch.Val.Value;
						SIKN_1.Batch.Arrays.State[i] = Math.SetBit(SIKN_1.Batch.Arrays.State[i], 0, true);	//начало партии
						set_Batch_SIKN_1 = true;
					}
				}
			}
		}
		else
		{
			if (Math.TestBit(SIKN_1.Batch.Arrays.State[i], 0))
			{
				SIKN_1.Batch.Arrays.State[i] = Math.SetBit(SIKN_1.Batch.Arrays.State[i], 0, false);
				SIKN_1.Batch.Arrays.Val[i] = 0;
			}
		}
	}
	
	accumulating: float;
	
	partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
	if (is_zero_i == false)
	{
		if (i == 1)
		{
			
			CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
			CurSecond: uint1 = DateTime.Second(ChangeLastTime);
		
			//partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
			partMinute: float; //доля секунд в интервале одной минуты
			partMinute = (60 - CurSecond) / 60f;
			MinutesUntilInterval: float; //количество минут до конца интервала
			if (CurMinute == 0)
			{
				MinutesUntilInterval = 14 + partMinute;
			}
			else if ((15 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
			}
			else if ((30 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 29 - CurMinute + partMinute;
			}
			else if ((45 - CurMinute) &gt; 0)
			{
				MinutesUntilInterval = 44 - CurMinute + partMinute;
			}
			else
			{
				MinutesUntilInterval = 59 - CurMinute + partMinute;
			}
		
			partInterval = MinutesUntilInterval / 15f;
		}
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i];
		accumulating = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_5.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_6.Level.Arrays.State[j], 1)?0:1)) / TankFeature.Koef / ((i == 1)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)));
	
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_5.Level.Arrays.State[j], 1))
		{
			Tank_5.Level.Arrays.Val[i] = Tank_5.Level.Arrays.Val[j];
		}
		else
		{
			Tank_5.Level.Arrays.Val[i] = Tank_5.Level.Arrays.Val[j] + accumulating;
