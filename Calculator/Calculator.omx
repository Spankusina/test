			}
		}
			
		if ((SIKN_5.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_5))
		{
			SIKN_5.Flow.Arrays.Val[i] = SIKN_5.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_5)
			{
				event_Flow_SIKN_5 = false;
			}
		}
		
		if ((SIKN_6.Flow.Arrays.Event[i] == false) &amp;&amp; (event_Flow_SIKN_6))
		{
			SIKN_6.Flow.Arrays.Val[i] = SIKN_6.Flow.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_SIKN_6)
			{
				event_Flow_SIKN_6 = false;
			}
		}
		
		if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (event_Flow_Out))
		{
			TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
		}
		else
		{
			if (event_Flow_Out)
			{
				event_Flow_Out = false;
			}
		}
		
		//------------------Tank------------------
		
		if ((Math.TestBit(Tank_1.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_1)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_1)
			{
				event_Tank_1 = false;
			}
		}
		
		if ((Math.TestBit(Tank_2.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_2)
		{
			Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_2)
			{
				event_Tank_2 = false;
			}
		}
		
		if ((Math.TestBit(Tank_3.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_3)
		{
			Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_3)
			{
				event_Tank_3 = false;
			}
		}
		
		if ((Math.TestBit(Tank_4.Level.Arrays.State[i], 0) == false) &amp;&amp; event_Tank_4)
		{
			Tank_4.Level.Arrays.State[i] = Math.SetBit(Tank_4.Level.Arrays.State[i], 1, Math.TestBit(Tank_4.Level.Arrays.State[j], 1));
		}
		else
		{
			if (event_Tank_4)
			{
				event_Tank_4 = false;
			}
		}
		
		//------------------Batch------------------
		
		if (set_Batch_SIKN_1)
		{
			if ((EndTime_SIKN_1 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_1 &lt;= Times.Val[i]))
			{
				SIKN_1.Batch.Arrays.State[i] = Math.SetBit(SIKN_1.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_1.Batch.Arrays.Val[i] = 0;
				
				SIKN_1.Flow.Arrays.Val[i] = 0;
				SIKN_1.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_1 = false;
				event_Flow_SIKN_1 = true;
			}
		}
		
		if (set_Batch_SIKN_2)
		{
			if ((EndTime_SIKN_2 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_2 &lt;= Times.Val[i]))
			{
				SIKN_2.Batch.Arrays.State[i] = Math.SetBit(SIKN_2.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_2.Batch.Arrays.Val[i] = 0;
				
				SIKN_2.Flow.Arrays.Val[i] = 0;
				SIKN_2.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_2 = false;
				event_Flow_SIKN_2 = true;
			}
		}
		
		if (set_Batch_SIKN_3)
		{
			if ((EndTime_SIKN_3 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_3 &lt;= Times.Val[i]))
			{
				SIKN_3.Batch.Arrays.State[i] = Math.SetBit(SIKN_3.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_3.Batch.Arrays.Val[i] = 0;
				
				SIKN_3.Flow.Arrays.Val[i] = 0;
				SIKN_3.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_3 = false;
				event_Flow_SIKN_3 = true;
			}
		}
		
		if (set_Batch_SIKN_4)
		{
			if ((EndTime_SIKN_4 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_4 &lt;= Times.Val[i]))
			{
				SIKN_4.Batch.Arrays.State[i] = Math.SetBit(SIKN_4.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_4.Batch.Arrays.Val[i] = 0;
				
				SIKN_4.Flow.Arrays.Val[i] = 0;
				SIKN_4.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_4 = false;
				event_Flow_SIKN_4 = true;
			}
		}
		
		if (set_Batch_SIKN_5)
		{
			if ((EndTime_SIKN_5 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_5 &lt;= Times.Val[i]))
			{
				SIKN_5.Batch.Arrays.State[i] = Math.SetBit(SIKN_5.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_5.Batch.Arrays.Val[i] = 0;
				
				SIKN_5.Flow.Arrays.Val[i] = 0;
				SIKN_5.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_5 = false;
				event_Flow_SIKN_5 = true;
			}
		}
		
		if (set_Batch_SIKN_6)
		{
			if ((EndTime_SIKN_6 &gt; Times.Val[j]) &amp;&amp; (EndTime_SIKN_6 &lt;= Times.Val[i]))
			{
				SIKN_6.Batch.Arrays.State[i] = Math.SetBit(SIKN_6.Batch.Arrays.State[i], 1, true); //партия завершена
				SIKN_6.Batch.Arrays.Val[i] = 0;
				
				SIKN_6.Flow.Arrays.Val[i] = 0;
				SIKN_6.Flow.Arrays.Event[i] = true;
				
				set_Batch_SIKN_6 = false;
				event_Flow_SIKN_6 = true;
			}
		}
		
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i] + SIKN_2.Flow.Arrays.Val[i] + SIKN_3.Flow.Arrays.Val[i] + SIKN_4.Flow.Arrays.Val[i] + SIKN_5.Flow.Arrays.Val[i] + SIKN_6.Flow.Arrays.Val[i];
		accumulating = ((TotalFlowIn.Arrays.Val[j] - TotalFlowOut.Arrays.Val[j]) / ((Math.TestBit(Tank_1.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[j], 1)?0:1) + (Math.TestBit(Tank_4.Level.Arrays.State[j], 1)?0:1)) / TankFeature.Koef / (is_zero_i?((j == 0)?(TankFeature.HourParts / partInterval):(TankFeature.HourParts)):(TankFeature.HourParts)));
		
		if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[j], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[j], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[j] + accumulating;
		}
		if (Math.TestBit(Tank_4.Level.Arrays.State[j], 1))
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[j] + accumulating;
		}
		
		j += 1;
		
		flow_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
		
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
			
		level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	}
	
	Tank_1.Level.UpdateVal = true;
	Tank_1.Level.UpdateState = true;
	
	Tank_2.Level.UpdateVal = true;
	Tank_2.Level.UpdateState = true;
	
	Tank_3.Level.UpdateVal = true;
	Tank_3.Level.UpdateState = true;
	
	Tank_4.Level.UpdateVal = true;
	Tank_4.Level.UpdateState = true;
	TotalFlowIn.UpdateVal = true;
	
	SIKN_1.Flow.UpdateVal = true;
	SIKN_1.Flow.UpdateEvent = true;
	
	SIKN_2.Flow.UpdateVal = true;
	SIKN_2.Flow.UpdateEvent = true;
	
	SIKN_3.Flow.UpdateVal = true;
	SIKN_3.Flow.UpdateEvent = true;
	
	SIKN_4.Flow.UpdateVal = true;
	SIKN_4.Flow.UpdateEvent = true;
	
	SIKN_5.Flow.UpdateVal = true;
	SIKN_5.Flow.UpdateEvent = true;
	
	SIKN_6.Flow.UpdateVal = true;
	SIKN_6.Flow.UpdateEvent = true;
	
	TotalFlowOut.UpdateVal = true;
	TotalFlowOut.UpdateEvent = true;
	
	SIKN_1.Batch.Update = true;
	SIKN_2.Batch.Update = true;
	SIKN_3.Batch.Update = true;
	SIKN_4.Batch.Update = true;
	SIKN_5.Batch.Update = true;
	SIKN_6.Batch.Update = true;
	
	if (is_zero_i == false)
	{
		j = TU.Set_index.Value;
		i = 0;
		/*while (i &gt;= 0)
		{	
			flow_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
			flow_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
		
			flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
			flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
			
			level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			i -= 1;			
		}*/
		for (; i &lt; j; i += 1)
		{
			flow_Max = Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
			flow_Min = Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]), SIKN_3.Flow.Arrays.Val[i]), SIKN_4.Flow.Arrays.Val[i]), SIKN_5.Flow.Arrays.Val[i]), SIKN_6.Flow.Arrays.Val[i]);
		
			flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
			flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
			
			level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
			
		}
		
	}
	
	AutoScale.MaxFlow = flow_Max;
	AutoScale.MinFlow = flow_Min;
	AutoScale.MaxFlowOut = flowOut_Max;
	AutoScale.MinFlowOut = flowOut_Min;
	AutoScale.MaxLevel = level_Max;
	AutoScale.MinLevel = level_Min;
}</property>
