			}
			else
			{
				SIKN_2.Flow.Arrays.Val[i] = SIKN_2.Flow.Arrays.Val[j];
			}
			SIKN_2.Flow.Arrays.Event[i] = false;
			event_Flow_SIKN_2 = true;
		}
	}
	
	if (TU.Values.TotalFlowOut.State.Value)
	{
		if (TotalFlowOut.Arrays.Event[i] == false)
		{
			TotalFlowOut.Arrays.Event[i] = true;
			event_Flow_Out = true;
		}
		if (TotalFlowOut.Arrays.Val[i] != TU.Values.TotalFlowOut.Val.Value)
		{
			TotalFlowOut.Arrays.Val[i] = TU.Values.TotalFlowOut.Val.Value;
			event_Flow_Out = true;
		}
	}
	else
	{
		if (TotalFlowOut.Arrays.Event[i])
		{
			if (is_zero_i)
			{
				TotalFlowOut.Arrays.Val[i] = TotalFlowOut.InitFlowOut;
			}
			else
			{
				TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[j];
			}
			TotalFlowOut.Arrays.Event[i] = false;
			event_Flow_Out = true;
		}
	}
	
	//--------------------Tank-------------------------
	
	event_Tank_1: bool = false;
	event_Tank_3: bool = false;
	event_Tank_2: bool = false;
	event_Tank_4: bool = false;
	
	if (TU.Values.Tank_1.Level.State.Value)
	{
		if (Math.TestBit(Tank_1.Level.Arrays.State[i], 1) == false)
		{
			Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, true);
			if (is_zero_i)
			{
				Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, true);
				event_Tank_1 = true;
			}
			else
			{
				if (Math.TestBit(Tank_1.Level.Arrays.State[i], 0))
				{
					if (Math.TestBit(Tank_1.Level.Arrays.State[j], 1))
					{
						Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, false);
						event_Tank_1 = true;
					}
				}
				else
				{
					Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, true);
					event_Tank_1 = true;
