      <ct:handler name="_Times_Val" uuid="b323e331-3c2f-4c9e-b46f-c3e8b2a367f8">
        <ct:trigger on="Timer" cause="any-change" />
        <property name="source-code">curTime: uint8 = DateTime.Now();
CurMinute: uint1 = DateTime.Minute(curTime);

if ((CurMinute == 0) || (CurMinute == 15) || (CurMinute == 30) || (CurMinute == 45) /*|| (CurMinute == 0) || (CurMinute == 2) || (CurMinute == 4) || (CurMinute == 6) || (CurMinute == 8) || (CurMinute == 10) || (CurMinute == 12) || (CurMinute == 14) || (CurMinute == 16) || (CurMinute == 18) || (CurMinute == 20) || (CurMinute == 22) || (CurMinute == 24) || (CurMinute == 26) || (CurMinute == 28) || (CurMinute == 30) || (CurMinute == 32) || (CurMinute == 34) || (CurMinute == 36) || (CurMinute == 38) || (CurMinute == 40) || (CurMinute == 42) || (CurMinute == 44) || (CurMinute == 46) || (CurMinute == 48) || (CurMinute == 50) || (CurMinute == 52) || (CurMinute == 54) || (CurMinute == 56) || (CurMinute == 58)*/)
{
	if (TimeShift == false)
	{
				
		times: uint8 = DateTime.Create(DateTime.Year(curTime), DateTime.Month(curTime), DateTime.Day(curTime), DateTime.Hour(curTime), DateTime.Minute(curTime), 0, 0);
		Times.Val[0] = times;
		EventsInTime.Time_0 = times;
		
		i: uint4 = 1;
		
		for (; i &lt; 193; i += 1)
		{
			times = DateTime.AddMinutes(times, 15);
			Times.Val[i] = times;
		}
		
//------------------------------Update Point 0---------------------------------
	
		if (SIKN_1.Flow.Arrays.Event[0] == false)
		{
			SIKN_1.Flow.Arrays.Val[0] = CPC.P0024.IB.A003_OV.FLW_PLC.Val;
			SIKN_1.Flow.Arrays.Val[1] = CPC.P0024.IB.A003_OV.FLW_PLC.Val;
			SIKN_1.InitFlow = CPC.P0024.IB.A003_OV.FLW_PLC.Val;
		}
		
		if (TotalFlowOut.Arrays.Event[0] == false)
		{
			TotalFlowOut.Arrays.Val[0] = CPC.P0024.JAR.BOOSTER_PUMP.FT0382.Val;
			TotalFlowOut.Arrays.Val[1] = CPC.P0024.JAR.BOOSTER_PUMP.FT0382.Val;
			TotalFlowOut.InitFlowOut = CPC.P0024.JAR.BOOSTER_PUMP.FT0382.Val;
		}
		
		Tank_1.Level.Arrays.Val[0] = CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Val;
		Tank_2.Level.Arrays.Val[0] = CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Val;
		Tank_3.Level.Arrays.Val[0] = CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Val;
		
		TotalFlowIn.Arrays.Val[0] = SIKN_1.Flow.Arrays.Val[0];
		
		ChangeLastTime = curTime;
		
//------------------------------TotalCalculating---------------------------------

		//------------------------------Flow_SIKN_1---------------------------------
		if (SIKN_1.Flow.Arrays.Event[1])
		{
			SIKN_1.Flow.Arrays.Event[1] = false;
		}
		if (SIKN_1.Flow.Arrays.Event[192])
		{
			SIKN_1.Flow.Arrays.Event[192] = false;
		}
		
		//------------------------------TotalFlowOut---------------------------------
		if (TotalFlowOut.Arrays.Event[1])
		{			
			TotalFlowOut.Arrays.Event[1] = false;
		}
		if (TotalFlowOut.Arrays.Event[192])
		{
			TotalFlowOut.Arrays.Event[192] = false;
		}
		
		reset_batch_SIKN_1: bool = false;
		//------------------------------Batch_SIKN_1---------------------------------
		if (Math.TestBit(SIKN_1.Batch.Arrays.State[1], 0))
		{
			reset_batch_SIKN_1 = true;
			SIKN_1.Batch.Arrays.Val[1] = 0;
		}
		else
		{
			SIKN_1.Batch.Arrays.Val[1] = SIKN_1.Batch.Arrays.Val[2];
		}
		SIKN_1.Batch.Arrays.State[1] = SIKN_1.Batch.Arrays.State[2];
		
		//------------------------------TotalFlowIn---------------------------------
		TotalFlowIn.Arrays.Val[0] = SIKN_1.Flow.Arrays.Val[0];
		TotalFlowIn.Arrays.Val[1] = SIKN_1.Flow.Arrays.Val[1];
		
		reset_off_Tank_1: bool = false;
		reset_off_Tank_3: bool = false;
		reset_off_Tank_2: bool = false;
		//---Level_Tank_1---
		Tank_1.Level.Arrays.State[1] = Tank_1.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_1.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_1.Level.Arrays.State[0], 1) != Math.TestBit(Tank_1.Level.Arrays.State[1], 1)))
		{
			Tank_1.Level.Arrays.State[1] = Math.SetBit(Tank_1.Level.Arrays.State[1], 1, Math.TestBit(Tank_1.Level.Arrays.State[0], 1));
			reset_off_Tank_1 = true;
		}
		//---Level_Tank_2---
		Tank_2.Level.Arrays.State[1] = Tank_2.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_2.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_2.Level.Arrays.State[0], 1) != Math.TestBit(Tank_2.Level.Arrays.State[1], 1)))
		{
			Tank_2.Level.Arrays.State[1] = Math.SetBit(Tank_2.Level.Arrays.State[1], 1, Math.TestBit(Tank_2.Level.Arrays.State[0], 1));
			reset_off_Tank_2 = true;
		}
		//---Level_Tank_3---
		Tank_3.Level.Arrays.State[1] = Tank_3.Level.Arrays.State[2];
		if ((Math.TestBit(Tank_3.Level.Arrays.State[1], 0) == false) &amp;&amp; (Math.TestBit(Tank_3.Level.Arrays.State[0], 1) != Math.TestBit(Tank_3.Level.Arrays.State[1], 1)))
		{
			Tank_3.Level.Arrays.State[1] = Math.SetBit(Tank_3.Level.Arrays.State[1], 1, Math.TestBit(Tank_3.Level.Arrays.State[0], 1));
			reset_off_Tank_3 = true;
		}
	
		i = 2;
		first_event_Flow_SIKN_1: bool = false;
		first_event_Flow_Out: bool = false;
		for (; i &lt; 193; i += 1)
		{
			//---Flow_SIKN_1---
			if ((SIKN_1.Flow.Arrays.Event[i] == false) &amp;&amp; (first_event_Flow_SIKN_1 == false))
			{
				SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[0];
			}
			else
			{
				if (first_event_Flow_SIKN_1 == false)
				{
					first_event_Flow_SIKN_1 = true;
				}
				SIKN_1.Flow.Arrays.Event[i - 1] = SIKN_1.Flow.Arrays.Event[i];
				SIKN_1.Flow.Arrays.Val[i - 1] = SIKN_1.Flow.Arrays.Val[i];
			}
			
			//---TotalFlowOut---
			if ((TotalFlowOut.Arrays.Event[i] == false) &amp;&amp; (first_event_Flow_Out == false))
			{
				TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[0];
			}
			else
			{
				if (first_event_Flow_Out == false)
				{
					first_event_Flow_Out = true;
				}
				TotalFlowOut.Arrays.Event[i - 1] = TotalFlowOut.Arrays.Event[i];
				TotalFlowOut.Arrays.Val[i - 1] = TotalFlowOut.Arrays.Val[i];
			}
			
			//---Level_Tank_1---
			if ((Math.TestBit(Tank_1.Level.Arrays.State[i], 0) == false) &amp;&amp; reset_off_Tank_1)
			{
				Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1));
			}
			else
			{
				if (reset_off_Tank_1)
				{
					reset_off_Tank_1 = false;
				}
			}
			//---Level_Tank_2---
			if ((Math.TestBit(Tank_2.Level.Arrays.State[i], 0) == false) &amp;&amp; reset_off_Tank_2)
			{
				Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[i - 1], 1));
			}
			else
			{
				if (reset_off_Tank_2)
				{
					reset_off_Tank_2 = false;
				}
			}
			//---Level_Tank_3---
			if ((Math.TestBit(Tank_3.Level.Arrays.State[i], 0) == false) &amp;&amp; reset_off_Tank_3)
			{
				Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[i - 1], 1));
			}
			else
			{
				if (reset_off_Tank_3)
				{
					reset_off_Tank_3 = false;
				}
			}
			
			//---Batch_SIKN_1---
			if (Math.TestBit(SIKN_1.Batch.Arrays.State[i], 1) == false &amp;&amp; reset_batch_SIKN_1)
			{
				SIKN_1.Batch.Arrays.State[i] = 0;
				SIKN_1.Batch.Arrays.Val[i] = 0;
			}
			else
			{
				if (reset_batch_SIKN_1)
				{
					reset_batch_SIKN_1 = false;
				}
				SIKN_1.Batch.Arrays.State[i - 1] = SIKN_1.Batch.Arrays.State[i];
				SIKN_1.Batch.Arrays.Val[i - 1] = SIKN_1.Batch.Arrays.Val[i];
			}
		}

		accumulating: float = ((TotalFlowIn.Arrays.Val[0] - TotalFlowOut.Arrays.Val[0]) / ((Math.TestBit(Tank_1.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[0], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[0], 1)?0:1)) / TankFeature.Koef / TankFeature.HourParts);
		if (Math.TestBit(Tank_1.Level.Arrays.State[0], 1))
		{
			Tank_1.Level.Arrays.Val[1] = Tank_1.Level.Arrays.Val[0];
		}
		else
		{
			Tank_1.Level.Arrays.Val[1] = Tank_1.Level.Arrays.Val[0] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[0], 1))
		{
			Tank_2.Level.Arrays.Val[1] = Tank_2.Level.Arrays.Val[0];
		}
		else
		{
			Tank_2.Level.Arrays.Val[1] = Tank_2.Level.Arrays.Val[0] + accumulating;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[0], 1))
		{
			Tank_3.Level.Arrays.Val[1] = Tank_3.Level.Arrays.Val[0];
		}
		else
		{
			Tank_3.Level.Arrays.Val[1] = Tank_3.Level.Arrays.Val[0] + accumulating;
		}
		
		flow_Max: float = -3.4028235E+38f;
		flow_Min: float = 3.4028235E+38f;
	
		flowOut_Max: float = -3.4028235E+38f;
		flowOut_Min: float = 3.4028235E+38f;
	
		level_Max: float = -3.4028235E+38f;
		level_Min: float = 3.4028235E+38f;
		
		flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[0]);
		flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[0]);
	
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[0]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[0]);
	
		level_Max = Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[0]), Tank_2.Level.Arrays.Val[0]), Tank_3.Level.Arrays.Val[0]);
		level_Min = Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[0]), Tank_2.Level.Arrays.Val[0]), Tank_3.Level.Arrays.Val[0]);
		
		flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[1]);
		flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[1]);
	
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[1]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[1]);
	
		level_Max = Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[1]), Tank_2.Level.Arrays.Val[1]), Tank_3.Level.Arrays.Val[1]);
		level_Min = Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[1]), Tank_2.Level.Arrays.Val[1]), Tank_3.Level.Arrays.Val[1]);
		
		//------------------------------TotalFlowIn---TanksLevel-------------------------
		i = 2;
		for (; i &lt; 192; i += 1)
		{		
			TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i];
			
			Tank_1.Level.Arrays.State[i] = Tank_1.Level.Arrays.State[i + 1];
			Tank_2.Level.Arrays.State[i] = Tank_2.Level.Arrays.State[i + 1];
			Tank_3.Level.Arrays.State[i] = Tank_3.Level.Arrays.State[i + 1];
			
			accumulating = ((TotalFlowIn.Arrays.Val[i - 1] - TotalFlowOut.Arrays.Val[i - 1]) / ((Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[i - 1], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[i - 1], 1)?0:1)) / TankFeature.Koef / TankFeature.HourParts);
			
			if (Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1))
			{
				Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[i - 1];
			}
			else
			{
				Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[i - 1] + accumulating;
			}
			if (Math.TestBit(Tank_2.Level.Arrays.State[i - 1], 1))
			{
				Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[i - 1];
			}
			else
			{
				Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[i - 1] + accumulating;
			}
			if (Math.TestBit(Tank_3.Level.Arrays.State[i - 1], 1))
			{
				Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[i - 1];
			}
			else
			{
				Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[i - 1] + accumulating;
			}
			
			flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]);
			flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]);
	
			flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
			flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
	
			level_Max = Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]);
			level_Min = Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]);
		}
		
		SIKN_1.Batch.Arrays.State[i] = 0;
		SIKN_1.Batch.Arrays.Val[i] = 0;
		
		Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 1, Math.TestBit(Tank_1.Level.Arrays.State[i - 1], 1));
		Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 1, Math.TestBit(Tank_3.Level.Arrays.State[i - 1], 1));
		Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 1, Math.TestBit(Tank_2.Level.Arrays.State[i - 1], 1));
			
		Tank_1.Level.Arrays.State[i] = Math.SetBit(Tank_1.Level.Arrays.State[i], 0, false);
		Tank_3.Level.Arrays.State[i] = Math.SetBit(Tank_3.Level.Arrays.State[i], 0, false);
		Tank_2.Level.Arrays.State[i] = Math.SetBit(Tank_2.Level.Arrays.State[i], 0, false);
		
		TotalFlowIn.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[i];
		accumulating = (TotalFlowIn.Arrays.Val[191] - TotalFlowOut.Arrays.Val[191]) / ((Math.TestBit(Tank_1.Level.Arrays.State[191], 1)?0:1) + (Math.TestBit(Tank_2.Level.Arrays.State[191], 1)?0:1) + (Math.TestBit(Tank_3.Level.Arrays.State[191], 1)?0:1)) / TankFeature.Koef / TankFeature.HourParts;
		if (Math.TestBit(Tank_1.Level.Arrays.State[191], 1))
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[191];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[191] + accumulating;
		}
		if (Math.TestBit(Tank_2.Level.Arrays.State[191], 1))
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[191];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[191] + accumulating;
		}
		if (Math.TestBit(Tank_3.Level.Arrays.State[191], 1))
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[191];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[191] + accumulating;
		}
		//-------------------------------------------------------------------
		
		flow_Max = Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]);
	
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
	
		level_Max = Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]);

		Tank_1.Level.UpdateVal = true;
		Tank_1.Level.UpdateState = true;
		
		Tank_2.Level.UpdateVal = true;
		Tank_2.Level.UpdateState = true;
		
		Tank_3.Level.UpdateVal = true;
		Tank_3.Level.UpdateState = true;

		TotalFlowIn.UpdateVal = true;
		
		SIKN_1.Flow.UpdateVal = true;
		SIKN_1.Flow.UpdateEvent = true;
		
		TotalFlowOut.UpdateVal = true;
		TotalFlowOut.UpdateEvent = true;
		
		SIKN_1.Batch.Update = true;
		
		EventsInTime.UpdateTime = true;
		
		AutoScale.MaxFlow = flow_Max;
		AutoScale.MinFlow = flow_Min;
		AutoScale.MaxFlowOut = flowOut_Max;
		AutoScale.MinFlowOut = flowOut_Min;
		AutoScale.MaxLevel = level_Max;
		AutoScale.MinLevel = level_Min;
		
		TimeShift = true;
	}
}
else
{
	if (TimeShift)
		TimeShift = false;
	if (DateTime.Minute(EventsInTime.Time_0.Value) != CurMinute)
	{
		times: uint8 = DateTime.Create(DateTime.Year(curTime), DateTime.Month(curTime), DateTime.Day(curTime), DateTime.Hour(curTime), DateTime.Minute(curTime), 0, 0);
		Times.Val[0] = times;
		EventsInTime.Time_0 = times;
	}
}</property>
      </ct:handler>
