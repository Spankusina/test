            <property name="source-code">if (Update.Value)
{
	//--------------------Points_Val----------------------------
	if (Points.Point_0.Val != Arrays.Val[0])
		Points.Point_0.Val = Arrays.Val[0];
	if (Points.Point_1.Val != Arrays.Val[1])
		Points.Point_1.Val = Arrays.Val[1];
