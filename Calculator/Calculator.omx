        <ct:formula target="Low">
          <property name="source-code">Math.Max(Math.Max(Math.Max(Math.Max(((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.OutPreset.SP_AL)), -3.4028235E+38f), ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.OutPreset.SP_AL))), ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AL))), ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_L)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AL):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AL)))</property>
        </ct:formula>
        <ct:formula target="High">
          <property name="source-code">Math.Min(Math.Min(Math.Min(Math.Min(((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001A.Level.OutPreset.SP_AH)), 3.4028235E+38f), ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB001B.Level.OutPreset.SP_AH))), ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AH))), ((CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_H)?(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AH):(CPC.P0025.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AH)))</property>
        </ct:formula>
