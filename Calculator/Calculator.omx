      <ct:handler name="_TU_Reset" uuid="fe1fa26e-f5a5-43f4-b220-34470cd79883">
        <ct:trigger on="TU.Reset" cause="any-change" />
        <property name="source-code">if ((TU.Reset.Quality &gt;= 192) &amp;&amp; TU.Reset.Value)
{	
	SIKN_1.Flow.Arrays.Event[1] = false;
	SIKN_1.Flow.Arrays.Val[1] = SIKN_1.Flow.Arrays.Val[0];
	
	SIKN_2.Flow.Arrays.Event[1] = false;
	SIKN_2.Flow.Arrays.Val[1] = SIKN_2.Flow.Arrays.Val[0];
	
	TotalFlowOut.Arrays.Event[1] = false;
	TotalFlowOut.Arrays.Val[1] = TotalFlowOut.Arrays.Val[0];

	TotalFlowIn.Arrays.Val[1] = SIKN_1.Flow.Arrays.Val[1] + SIKN_2.Flow.Arrays.Val[1];

	
	SIKN_1.Batch.Arrays.State[1] = 0;
	SIKN_1.Batch.Arrays.Val[1] = 0;
	
	SIKN_2.Batch.Arrays.State[1] = 0;
	SIKN_2.Batch.Arrays.Val[1] = 0;
	
	Tank_1.Level.Arrays.State[1] = 0;
	Tank_2.Level.Arrays.State[1] = 0;
	Tank_3.Level.Arrays.State[1] = 0;
	Tank_4.Level.Arrays.State[1] = 0;
	state_point_1_Tank_1: uint1 =  Math.SetBit(Tank_1.Level.Arrays.State[1], 1, Math.TestBit(Tank_1.Level.Arrays.State[0], 1));
	state_point_1_Tank_2: uint1 =  Math.SetBit(Tank_2.Level.Arrays.State[1], 1, Math.TestBit(Tank_2.Level.Arrays.State[0], 1));
	state_point_1_Tank_3: uint1 =  Math.SetBit(Tank_3.Level.Arrays.State[1], 1, Math.TestBit(Tank_3.Level.Arrays.State[0], 1));
	state_point_1_Tank_4: uint1 =  Math.SetBit(Tank_4.Level.Arrays.State[1], 1, Math.TestBit(Tank_4.Level.Arrays.State[0], 1));
	Tank_1.Level.Arrays.State[1] = state_point_1_Tank_1;
	Tank_2.Level.Arrays.State[1] = state_point_1_Tank_2;
	Tank_3.Level.Arrays.State[1] = state_point_1_Tank_3;
	Tank_4.Level.Arrays.State[1] = state_point_1_Tank_4;
	
	off_point_0_Tank_1: bool = Math.TestBit(Tank_1.Level.Arrays.State[0], 1);
	off_point_0_Tank_2: bool = Math.TestBit(Tank_2.Level.Arrays.State[0], 1);
	off_point_0_Tank_3: bool = Math.TestBit(Tank_3.Level.Arrays.State[0], 1);
	off_point_0_Tank_4: bool = Math.TestBit(Tank_4.Level.Arrays.State[0], 1);
	
	CurMinute: uint1 = DateTime.Minute(ChangeLastTime);
	CurSecond: uint1 = DateTime.Second(ChangeLastTime);
	
	partInterval: float; //доля времени в интервале от нулевой точки до следующего 15-ти минутного интервала (для наполнения резервуаров за это время)
	
	partMinute: float; //доля секунд в интервале одной минуты
	partMinute = (60 - CurSecond) / 60f;
	MinutesUntilInterval: float; //количество минут до конца интервала
	if (CurMinute == 0)
	{
		MinutesUntilInterval = 14 + partMinute;
	}
	else if ((15 - CurMinute) &gt; 0)
	{
		MinutesUntilInterval = 14 - CurMinute + partMinute; //(15 - CurMinute) - 1 + partMinute
	}
	else if ((30 - CurMinute) &gt; 0)
	{
		MinutesUntilInterval = 29 - CurMinute + partMinute;
	}
	else if ((45 - CurMinute) &gt; 0)
	{
		MinutesUntilInterval = 44 - CurMinute + partMinute;
	}
	else
	{
		MinutesUntilInterval = 59 - CurMinute + partMinute;
	}
	
	partInterval = MinutesUntilInterval / 15f;
	
	
	accumulating_volume: float = ((TotalFlowIn.Arrays.Val[0] - TotalFlowOut.Arrays.Val[0]) / ((off_point_0_Tank_1?0:1) + (off_point_0_Tank_2?0:1) + (off_point_0_Tank_3?0:1) + (off_point_0_Tank_4?0:1)) / (TankFeature.HourParts / partInterval));
	
	accumulating1: float = accumulating_volume / TankFeature.Koef;
	accumulating2: float = accumulating_volume / TankFeature.Koef2;
	
	if (Math.TestBit(Tank_1.Level.Arrays.State[0], 1))
	{
		Tank_1.Level.Arrays.Val[1] = Tank_1.Level.Arrays.Val[0];
	}
	else
	{
		Tank_1.Level.Arrays.Val[1] = Tank_1.Level.Arrays.Val[0] + accumulating1;
	}
	if (Math.TestBit(Tank_2.Level.Arrays.State[0], 1))
	{
		Tank_2.Level.Arrays.Val[1] = Tank_2.Level.Arrays.Val[0];
	}
	else
	{
		Tank_2.Level.Arrays.Val[1] = Tank_2.Level.Arrays.Val[0] + accumulating1;
	}
	if (Math.TestBit(Tank_3.Level.Arrays.State[0], 1))
	{
		Tank_3.Level.Arrays.Val[1] = Tank_3.Level.Arrays.Val[0];
	}
	else
	{
		Tank_3.Level.Arrays.Val[1] = Tank_3.Level.Arrays.Val[0] + accumulating2;
	}
	if (Math.TestBit(Tank_4.Level.Arrays.State[0], 1))
	{
		Tank_4.Level.Arrays.Val[1] = Tank_4.Level.Arrays.Val[0];
	}
	else
	{
		Tank_4.Level.Arrays.Val[1] = Tank_4.Level.Arrays.Val[0] + accumulating2;
	}
	
	flow_Max: float = -3.4028235E+38f;
	flow_Min: float = 3.4028235E+38f;
	
	flowOut_Max: float = -3.4028235E+38f;
	flowOut_Min: float = 3.4028235E+38f;
	
	level_Max: float = -3.4028235E+38f;
	level_Min: float = 3.4028235E+38f;
	
	flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[0]), SIKN_2.Flow.Arrays.Val[0]);
	flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[0]), SIKN_2.Flow.Arrays.Val[0]);
	
	flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[0]);
	flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[0]);
	
	level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[0]), Tank_2.Level.Arrays.Val[0]), Tank_3.Level.Arrays.Val[0]), Tank_4.Level.Arrays.Val[0]);
	level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[0]), Tank_2.Level.Arrays.Val[0]), Tank_3.Level.Arrays.Val[0]), Tank_4.Level.Arrays.Val[0]);
	
	accumulating_volume = ((TotalFlowIn.Arrays.Val[1] - TotalFlowOut.Arrays.Val[1]) / ((off_point_0_Tank_1?0:1) + (off_point_0_Tank_2?0:1) + (off_point_0_Tank_3?0:1) + (off_point_0_Tank_4?0:1)) / TankFeature.HourParts);
	accumulating1 = accumulating_volume / TankFeature.Koef;
	accumulating2 = accumulating_volume / TankFeature.Koef2;
	for (i: uint4 = 2; i &lt; 193; i += 1)
	{
		SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[0];
		SIKN_1.Flow.Arrays.Event[i] = false;
		
		SIKN_2.Flow.Arrays.Val[i] = SIKN_2.Flow.Arrays.Val[0];
		SIKN_2.Flow.Arrays.Event[i] = false;
		
		TotalFlowOut.Arrays.Val[i] = TotalFlowOut.Arrays.Val[0];
		TotalFlowOut.Arrays.Event[i] = false;
		
		TotalFlowIn.Arrays.Val[i] = TotalFlowIn.Arrays.Val[1];
		
		SIKN_1.Batch.Arrays.State[i] = 0;
		SIKN_1.Batch.Arrays.Val[i] = 0;
		
		SIKN_2.Batch.Arrays.State[i] = 0;
		SIKN_2.Batch.Arrays.Val[i] = 0;
		
		Tank_1.Level.Arrays.State[i] = state_point_1_Tank_1;
		if (off_point_0_Tank_1)
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_1.Level.Arrays.Val[i] = Tank_1.Level.Arrays.Val[i - 1] + accumulating1;
		}
		
		Tank_2.Level.Arrays.State[i] = state_point_1_Tank_2;
		if (off_point_0_Tank_2)
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_2.Level.Arrays.Val[i] = Tank_2.Level.Arrays.Val[i - 1] + accumulating1;
		}
		
		Tank_3.Level.Arrays.State[i] = state_point_1_Tank_3;
		if (off_point_0_Tank_3)
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_3.Level.Arrays.Val[i] = Tank_3.Level.Arrays.Val[i - 1] + accumulating2;
		}
		
		Tank_4.Level.Arrays.State[i] = state_point_1_Tank_4;
		if (off_point_0_Tank_4)
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[i - 1];
		}
		else
		{
			Tank_4.Level.Arrays.Val[i] = Tank_4.Level.Arrays.Val[i - 1] + accumulating2;
		}
		
		flow_Max = Math.Max(Math.Max(flow_Max, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		flow_Min = Math.Min(Math.Min(flow_Min, SIKN_1.Flow.Arrays.Val[i]), SIKN_2.Flow.Arrays.Val[i]);
		
		flowOut_Max = Math.Max(flowOut_Max, TotalFlowOut.Arrays.Val[i]);
		flowOut_Min = Math.Min(flowOut_Min, TotalFlowOut.Arrays.Val[i]);
		
		level_Max = Math.Max(Math.Max(Math.Max(Math.Max(level_Max, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
		level_Min = Math.Min(Math.Min(Math.Min(Math.Min(level_Min, Tank_1.Level.Arrays.Val[i]), Tank_2.Level.Arrays.Val[i]), Tank_3.Level.Arrays.Val[i]), Tank_4.Level.Arrays.Val[i]);
	}

	Tank_1.Level.UpdateVal = true;
	Tank_1.Level.UpdateState = true;
	
	Tank_2.Level.UpdateVal = true;
	Tank_2.Level.UpdateState = true;
	
	Tank_3.Level.UpdateVal = true;
	Tank_3.Level.UpdateState = true;
	
	Tank_4.Level.UpdateVal = true;
	Tank_4.Level.UpdateState = true;
	
	TotalFlowIn.UpdateVal = true;
	
	SIKN_1.Flow.UpdateVal = true;
	SIKN_1.Flow.UpdateEvent = true;
	
	SIKN_2.Flow.UpdateVal = true;
	SIKN_2.Flow.UpdateEvent = true;
	
	TotalFlowOut.UpdateVal = true;
	TotalFlowOut.UpdateEvent = true;
	
	SIKN_1.Batch.Update = true;
	SIKN_2.Batch.Update = true;
	
	AutoScale.MaxFlow = flow_Max;
	AutoScale.MinFlow = flow_Min;
	AutoScale.MaxFlowOut = flowOut_Max;
	AutoScale.MinFlowOut = flowOut_Min;
	AutoScale.MaxLevel = level_Max;
	AutoScale.MinLevel = level_Min;
}</property>
      </ct:handler>
      <ct:handler name="_TU_Set" uuid="efdc09d2-e4da-41e7-97e0-8fd2b9af633c">
        <ct:trigger on="TU.Set" cause="any-change" />
        <property name="source-code">if ((TU.Set.Quality &gt;= 192) &amp;&amp; TU.Set.Value &amp;&amp; (TU.Set_index.Quality &gt;= 192) &amp;&amp; (TU.Set_index.Value &gt;= 0) &amp;&amp; (TU.Set_index.Value &lt;= 192))
{
	i: uint4 = TU.Set_index.Value;
	j: uint4 = 0;
	is_zero_i: bool = false;
	
	if (i == 0)
	{
		is_zero_i = true;
	}
	else
	{
		j = i - 1;
	}

	//--------------------Flow-------------------------
	
	event_Flow_SIKN_1: bool = false;
	event_Flow_SIKN_2: bool = false;
	event_Flow_Out: bool = false;
	
	if (TU.Values.SIKN_1.Flow.State.Value)
	{
		if (SIKN_1.Flow.Arrays.Event[i] == false)
		{
			SIKN_1.Flow.Arrays.Event[i] = true;
			event_Flow_SIKN_1 = true;
		}
		if (SIKN_1.Flow.Arrays.Val[i] != TU.Values.SIKN_1.Flow.Val.Value)
		{
			SIKN_1.Flow.Arrays.Val[i] = TU.Values.SIKN_1.Flow.Val.Value;
			event_Flow_SIKN_1 = true;
		}
	}
	else
	{
		if (SIKN_1.Flow.Arrays.Event[i])
		{
			if (is_zero_i)
			{
				SIKN_1.Flow.Arrays.Val[i] = SIKN_1.InitFlow;
			}
			else
			{
				SIKN_1.Flow.Arrays.Val[i] = SIKN_1.Flow.Arrays.Val[j];
			}
			SIKN_1.Flow.Arrays.Event[i] = false;
			event_Flow_SIKN_1 = true;
		}
	}
	
	if (TU.Values.SIKN_2.Flow.State.Value)
	{
		if (SIKN_2.Flow.Arrays.Event[i] == false)
		{
			SIKN_2.Flow.Arrays.Event[i] = true;
			event_Flow_SIKN_2 = true;
		}
		if (SIKN_2.Flow.Arrays.Val[i] != TU.Values.SIKN_2.Flow.Val.Value)
		{
			SIKN_2.Flow.Arrays.Val[i] = TU.Values.SIKN_2.Flow.Val.Value;
			event_Flow_SIKN_2 = true;
		}
	}
	else
	{
