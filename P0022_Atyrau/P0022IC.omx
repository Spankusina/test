          <attribute type="unit.System.Attributes.Description" value="Динамическое сообщение" />
          <attribute type="unit.Server.Attributes.Alarm" value="{&quot;Condition&quot;:{&quot;IsEnabled&quot;:&quot;true&quot;,&quot;Subconditions&quot;:[{&quot;AckStrategy&quot;:0,&quot;IsEnabled&quot;:true,&quot;Severity&quot;:&quot;105&quot;,&quot;Type&quot;:&quot;Dynamic&quot;}],&quot;Type&quot;:&quot;Dynamic&quot;}}" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
