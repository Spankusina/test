        <ct:handler name="IZMP1" access-level="public" uuid="4170406e-4f58-4db9-b0a2-ec1ee2dfe92d">
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P1.OUT);
if (prior == 1) {L1 = 1;}
else if (prior == 2) {L2 = 1;}
else if (prior == 3) {L3 = 1;}</property>
          <ct:trigger on="P1.OUT" />
        </ct:handler>
        <ct:handler name="IZMP2" access-level="public" uuid="fdd228dd-b439-4934-a8b2-ecbf6c7ec8a5">
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P2.OUT);
if (prior == 1) {L1 = 2;}
else if (prior == 2) {L2 = 2;}
else if (prior == 3) {L3 = 2;}</property>
          <ct:trigger on="P2.OUT" />
        </ct:handler>
        <ct:handler name="IZMP3" access-level="public" uuid="d48436cc-e7e5-4a85-acce-d9b69f5d23fb">
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P3.OUT);
if (prior == 1) {L1 = 3;}
else if (prior == 2) {L2 = 3;}
else if (prior == 3) {L3 = 3;}</property>
          <ct:trigger on="P3.OUT" />
        </ct:handler>
