          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_H" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.Val" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_L" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_H" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AH" cause="change" />
