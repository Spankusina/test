        <ct:handler name="TU_Calc_On" access-level="public" uuid="4b0208c6-8df2-43c7-b6a2-79a0e20e2c4e">
          <ct:trigger on="TU.Calc_On" cause="any-change" />
          <property name="source-code">if ((TU.Calc_On.Quality &gt;= 192) &amp;&amp; TU.Calc_On.Value)
{	
	CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.INFO.Calc = true;
