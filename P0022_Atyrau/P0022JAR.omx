          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Val" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.INFO.Calc" cause="change" />
