        <ct:parameter name="TimeLeftInlet" access-level="public" access-scope="global" direction="out" type="uint64" uuid="2178ffd8-bbec-400a-8cc8-80b21e95dde3">
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
        </ct:parameter>
        <ct:handler name="_TimeLeftInlet" uuid="a72fc8f2-1f4c-46c7-a689-3502cb88dec0">
          <property name="source-code">if (FlowBalance &gt;= 10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.INFO.Calc)
	{
		_hour += ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_H)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.PLC_Preset.SP_AH):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.OutPreset.SP_AH)) - CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.INFO.Calc)
	{
		_hour += ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.Mode.use_plc_H)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.PLC_Preset.SP_AH):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.OutPreset.SP_AH)) - CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.INFO.Calc)
	{
		_hour += ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_H)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AH):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AH)) - CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.INFO.Calc)
	{
		_hour += ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_H)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AH):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AH)) - CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Val;
		_calc_hour = true;
	}
	
	if (_calc_hour)
	{
		_hour = _hour / CPC.Calculator.DAILY_CALC.Atyrau.TankFeature.Koef / FlowBalance;
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else if (FlowBalance &lt;= -10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.INFO.Calc)
	{
		_hour += CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.Val - ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_L)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.PLC_Preset.SP_AL):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.INFO.Calc)
	{
		_hour += CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.Val - ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.Mode.use_plc_L)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.PLC_Preset.SP_AL):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.INFO.Calc)
	{
		_hour += CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.Val - ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.Mode.use_plc_L)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.PLC_Preset.SP_AL):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.INFO.Calc)
	{
		_hour += CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Val - ((CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.Mode.use_plc_L)?(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.PLC_Preset.SP_AL):(CPC.P0022.JAR.CRUDE_OIL_TANK.TKB002B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}

	if (_calc_hour)
	{
		_hour = _hour / CPC.Calculator.DAILY_CALC.Atyrau.TankFeature.Koef / Math.Abs(FlowBalance);
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else
{	
	if (TimeLeftInlet != 0)
		TimeLeftInlet = 0;
}</property>
          <ct:trigger on="FlowBalance" cause="change" />
          <ct:trigger on="CPC.P0022.JAR.CRUDE_OIL_TANK.TKB001A.Level.Mode.use_plc_L" cause="change" />
