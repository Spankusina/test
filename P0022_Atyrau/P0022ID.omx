        <ct:handler name="IZMP1" access-level="public" uuid="2dc65ba0-e17c-46e4-ac0c-c44f05eb654e">
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P1.OUT);
if (prior == 1) {L1 = 1;}
else if (prior == 2) {L2 = 1;}</property>
          <ct:trigger on="P2.OUT" />
        </ct:handler>
        <ct:handler name="IZMP2" access-level="public" uuid="dff795ab-005a-414b-9af4-10b5fdfbf73a">
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P2.OUT);
if (prior == 1) {L1 = 2;}
else if (prior == 2) {L2 = 2;}</property>
          <ct:trigger on="P1.OUT" />
        </ct:handler>
