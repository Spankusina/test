        <ct:handler name="IZMP1" access-level="public" uuid="2d9ed2da-de82-4ded-94d5-0ecbc887db6c">
          <ct:trigger on="Timer" cause="change" />
          <property name="source-code">if ((Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192) &amp;&amp;  
((ModuleEnabled.Enabled &amp;&amp; ModuleEnabled.Channel_1.Status.Enabled) || (ModuleEnabled.Enabled &amp;&amp; ModuleEnabled.Channel_2.Status.Enabled))
)
{SY_WATCHDOG_TO.CMD = true;}</property>
        </ct:handler>
