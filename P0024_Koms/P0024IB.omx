    <ct:object name="AUX_OPERATOR_ALARMS" uuid="e3fe898d-49a7-445d-b753-5ae39d7d043d">
      <ct:object name="A003" uuid="af6fef9f-2d6e-4b0e-a31b-f43d46dd66a3">
        <attribute type="unit.System.Attributes.Description" value="СИКН A003" />
        <ct:object name="SetPoints" base-type="unit.Types.Группа уставок.IOS_Group_SetPoints" uuid="ad372a05-12bd-4b62-9261-292242a10f7c">
          <ct:handler name="_On" uuid="170cf0cb-74de-48d6-bfea-a1cbd575eb2f">
            <ct:trigger on="TU.On" cause="any-change" />
            <property name="source-code">if ((TU.On.Quality &gt;= 192) &amp;&amp; TU.On.Value)
{
	CPC.P0024.IB.A003_OV.PT1306.Mode.alm_oper_L = true;
	CPC.P0024.IB.A003_OV.PT1306.Mode.alm_oper_H = true;
	
	CPC.P0024.IB.A003_OV.FLW_PLC.Mode.alm_oper_L = true;
	CPC.P0024.IB.A003_OV.FLW_PLC.Mode.alm_oper_H = true;
	
	//CPC.P0024.IB.A003_OV.NMASS_READ.Mode.alm_oper_L = true;
	//CPC.P0024.IB.A003_OV.NMASS_READ.Mode.alm_oper_H = true;
	
	CPC.P0024.IB.A003_QUALITY.BSW.MAIN.Mode.alm_oper_L = true;
	CPC.P0024.IB.A003_QUALITY.BSW.MAIN.Mode.alm_oper_H = true;

	
}</property>
          </ct:handler>
          <ct:handler name="_Off" uuid="5533c4f3-0492-45e4-92a7-d54da3ddc148">
            <property name="source-code">if ((TU.Off.Quality &gt;= 192) &amp;&amp; TU.Off.Value)
{
