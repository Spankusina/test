      <ct:object name="PRIORITY" uuid="a8e56516-6e17-43e7-a000-01fb71672664">
        <attribute type="unit.System.Attributes.Description" />
        <ct:handler name="IZMP1" access-level="public" uuid="5f5368b6-9caa-42d7-bb91-b936a6250fd3">
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P1.OUT);
if (prior == 1) {L1 = 1;}
else if (prior == 2) {L2 = 1;}</property>
        </ct:handler>
        <ct:handler name="IZMP2" access-level="public" uuid="81eb668c-6f0b-4115-be8d-fd2411fd030a">
          <ct:trigger on="PRIORITY.P2.OUT" cause="update" />
          <property name="source-code">prior: int2 = TypeConvert.ToInt2(P2.OUT);
if (prior == 1) {L1 = 2;}
else if (prior == 2) {L2 = 2;}</property>
        </ct:handler>
