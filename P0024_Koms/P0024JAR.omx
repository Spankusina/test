        <ct:parameter name="FlowBalance" type="float32" direction="out" uuid="f33b4e42-b1ef-485b-865c-02f8e0808d56">
          <attribute type="unit.System.Attributes.Description" value="Сумма всех расходов поступающих в РП минус откачка из РП" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        </ct:parameter>
        <ct:formula target="FlowBalance">
          <property name="source-code">((CPC.P0024.IB.A003_OV.FLW_PLC.Val &gt; 0)?(CPC.P0024.IB.A003_OV.FLW_PLC.Val):(0)) - ((CPC.P0024.JAR.BOOSTER_PUMP.FT0382.Val &gt; 0)?(CPC.P0024.JAR.BOOSTER_PUMP.FT0382.Val):(0))</property>
        </ct:formula>
        <ct:handler name="_TimeLeftInlet" uuid="707ee62b-345d-48ad-a6be-9e6c40691584">
          <property name="source-code">if (FlowBalance &gt;= 10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.INFO.Calc)
	{
		_hour += ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Mode.use_plc_H)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.PLC_Preset.SP_AH):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.OutPreset.SP_AH)) - CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.INFO.Calc)
	{
		_hour += ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Mode.use_plc_H)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.PLC_Preset.SP_AH):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.OutPreset.SP_AH)) - CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Val;
		_calc_hour = true;
	}
	if (CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.INFO.Calc)
	{
		_hour += ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Mode.use_plc_H)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.PLC_Preset.SP_AH):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.OutPreset.SP_AH)) - CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Val;
		_calc_hour = true;
	}
	
	if (_calc_hour)
	{
		_hour = _hour / CPC.Calculator.DAILY_CALC.Komsomolskaja.TankFeature.Koef / FlowBalance;
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else if (FlowBalance &lt;= -10)
{
	_calc_hour: bool = false;
	_hour:float = 0;
	if (CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.INFO.Calc)
	{
		_hour += CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Val - ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Mode.use_plc_L)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.PLC_Preset.SP_AL):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.INFO.Calc)
	{
		_hour += CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Val - ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Mode.use_plc_L)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.PLC_Preset.SP_AL):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}
	if (CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.INFO.Calc)
	{
		_hour += CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Val - ((CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Mode.use_plc_L)?(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.PLC_Preset.SP_AL):(CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.OutPreset.SP_AL));
		_calc_hour = true;
	}

	if (_calc_hour)
	{
		_hour = _hour / CPC.Calculator.DAILY_CALC.Komsomolskaja.TankFeature.Koef / Math.Abs(FlowBalance);
		TimeLeftInlet = DateTime.AddHours(DateTime.Now(), _hour);
	}
	else
	{
		if (TimeLeftInlet != 0)
			TimeLeftInlet = 0;
	}
}
else
{
	if (TimeLeftInlet != 0)
		TimeLeftInlet = 0;
}</property>
          <ct:trigger on="FlowBalance" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Mode.use_plc_L" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.PLC_Preset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.OutPreset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Mode.use_plc_H" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.PLC_Preset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.OutPreset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.Level.Val" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Mode.use_plc_L" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.PLC_Preset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.OutPreset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Mode.use_plc_H" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.PLC_Preset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.OutPreset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.Level.Val" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Mode.use_plc_L" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.PLC_Preset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.OutPreset.SP_AL" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Mode.use_plc_H" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.PLC_Preset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.OutPreset.SP_AH" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.Level.Val" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003A.INFO.Calc" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB003B.INFO.Calc" cause="change" />
          <ct:trigger on="CPC.P0024.JAR.CRUDE_OIL_TANK.TKB002.INFO.Calc" cause="change" />
        </ct:handler>
      </ct:object>
