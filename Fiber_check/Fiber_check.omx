		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0022.P0022MA.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0022.P0022MA.DataReceivingMode.Set="SatelliteMode";
		}
	
