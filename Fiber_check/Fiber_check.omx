      <property name="source-code">// проверка включения режима слоуком
if (Domain.CPC_tree.CPC.Service.Fiber_Check.SlowcomMode)
{
// проверка включения режима слоуком
if ((!ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
{
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JC.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JC.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039SB.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039SB.DataReceivingMode.Set="SatelliteMode";
		}
	
	
}


else if (
	((ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) || (ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191)|| (ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
    &amp;&amp; 	
    ((!ARM1.$"6001".Info.Status&amp;&amp;ARM1.$"6001".Info.Status.Quality&gt;191)&amp;&amp;(!ARM2.$"6001".Info.Status&amp;&amp;ARM2.$"6001".Info.Status.Quality&gt;191)&amp;&amp;(!ARM3.$"6001".Info.Status&amp;&amp;ARM3.$"6001".Info.Status.Quality&gt;191))
   )
{
if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JC.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JC.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039SB.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039SB.DataReceivingMode.Set="RadioMode";
		}	

	
		


}

else 
	{	
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Name!="FiberMode")
		{
