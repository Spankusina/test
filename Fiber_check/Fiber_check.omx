		Domain.CPC_tree.Service.Modules.CIP_P0034.P0034EA.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0034.P0034JAR.DataReceivingMode.Name!="SatelliteMode")
