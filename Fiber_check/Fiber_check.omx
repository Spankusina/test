   )
{
if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033JAR.DataReceivingMode.Name!="RadioMode")
		{
