		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039SB.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039SB.DataReceivingMode.Set="FiberMode";
		}
	

	}
// проверка включения режима слоуком	
}
else 
{

		if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039EA.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JAR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JC.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JC.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JD.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039JE.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NAR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0039.P0039NBR.DataReceivingMode.Name!="FiberMode")
