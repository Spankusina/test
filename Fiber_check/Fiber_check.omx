      <property name="source-code">// проверка включения режима слоуком
if (Domain.CPC_tree.CPC.Service.Fiber_Check.SlowcomMode)
{
// проверка включения режима слоуком
if ((!ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
{
	if (Domain.CPC_tree.Service.Modules.CIP_M0041.M0041E.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_M0041.M0041E.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_M0041.M0041EA.DataReceivingMode.Name!="SatelliteMode")
		{
