		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0022.P0022IA35.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0022.P0022IA35.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0022.P0022IA67.DataReceivingMode.Name!="SatelliteMode")
		{
