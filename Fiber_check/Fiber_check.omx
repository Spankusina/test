    <ct:handler name="SetMode" uuid="5121e4f9-b8b8-4366-9304-766316b90d3e">
      <ct:trigger on="ARM1.6000.Info.Status" cause="any-change" />
      <ct:trigger on="ARM2.6000.Info.Status" cause="any-change" />
      <ct:trigger on="ARM1.6001.Info.Status" cause="any-change" />
      <ct:trigger on="ARM2.6001.Info.Status" cause="any-change" />
      <property name="source-code">// проверка включения режима слоуком
if (Domain.CPC_tree.CPC.Service.Fiber_Check.SlowcomMode)
{
// проверка включения режима слоуком	
if ((!ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
{
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JC.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JC.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NBR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NBR.DataReceivingMode.Set="SatelliteMode";
		}

}


else if (
	((ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) || (ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191)|| (ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
    &amp;&amp; 	
    ((!ARM1.$"6001".Info.Status&amp;&amp;ARM1.$"6001".Info.Status.Quality&gt;191)&amp;&amp;(!ARM2.$"6001".Info.Status&amp;&amp;ARM2.$"6001".Info.Status.Quality&gt;191)&amp;&amp;(!ARM3.$"6001".Info.Status&amp;&amp;ARM3.$"6001".Info.Status.Quality&gt;191))
   )
{
if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JC.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JC.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NBR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NBR.DataReceivingMode.Set="RadioMode";
		}	

	

}

else 
	{	
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JC.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JC.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NBR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NBR.DataReceivingMode.Set="FiberMode";
		}


	}
// проверка включения режима слоуком	
}
else 
{

		
		if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036EA.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JAR.DataReceivingMode.Set="FiberMode";
