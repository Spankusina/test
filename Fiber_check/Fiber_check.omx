		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033SB.DataReceivingMode.Set="RadioMode";
		}	

	

}

else 
	{	
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Set="FiberMode";
