	if (Domain.CPC_tree.Service.Modules.CIP_P0034.P0034SB.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0034.P0034SB.DataReceivingMode.Set="FiberMode";
		}
	

	}
	// проверка включения режима слоуком	
}
else 
{

		if (Domain.CPC_tree.Service.Modules.CIP_P0034.P0034EA.DataReceivingMode.Name!="FiberMode")
		{
