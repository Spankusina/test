		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033JE.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NAR.DataReceivingMode.Set="RadioMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NBR.DataReceivingMode.Name!="RadioMode")
