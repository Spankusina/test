    <ct:handler name="SetMode" uuid="cae16c48-22d2-4526-9bb6-aadf759be0b3">
      <property name="source-code">// проверка включения режима слоуком
if (Domain.CPC_tree.CPC.Service.Fiber_Check.SlowcomMode)
{
// проверка включения режима слоуком
if ((!ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
{
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033JAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033JAR.DataReceivingMode.Set="SatelliteMode";
		}
