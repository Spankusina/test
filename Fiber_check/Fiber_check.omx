    <ct:handler name="SetMode" uuid="05a06e42-6e27-4bc3-a9fa-befbe5c7e685">
      <property name="source-code">// проверка включения режима слоуком
if (Domain.CPC_tree.CPC.Service.Fiber_Check.SlowcomMode)
{
// проверка включения режима слоуком	
if ((!ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191) &amp;&amp; (!ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))

{
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Set="SatelliteMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Set="SatelliteMode";
		}
	
}


else if 		(
	((ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) || (ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191)|| (ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
    &amp;&amp; 	
    ((!ARM1.$"6001".Info.Status&amp;&amp;ARM1.$"6001".Info.Status.Quality&gt;191)&amp;&amp;(!ARM2.$"6001".Info.Status&amp;&amp;ARM2.$"6001".Info.Status.Quality&gt;191)&amp;&amp;(!ARM3.$"6001".Info.Status&amp;&amp;ARM3.$"6001".Info.Status.Quality&gt;191))
   )

{
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Set="RadioMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Set="RadioMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Set="RadioMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Set="RadioMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Set="RadioMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Set="RadioMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Name!="RadioMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Set="RadioMode";
		}
	
	
	
	
	
}

else 
	{	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Set="FiberMode";
		}
	}
// проверка включения режима слоуком	
}
else 
{

		if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021EB.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IB.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021IC.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021JAR.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NAR.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021NBR.DataReceivingMode.Set="FiberMode";
		}
	
	if (Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0021.P0021VT.DataReceivingMode.Set="FiberMode";
		}
}</property>
      <ct:trigger on="ARM1.6000.Info.Status" cause="any-change" />
      <ct:trigger on="ARM2.6000.Info.Status" cause="any-change" />
      <ct:trigger on="ARM1.6001.Info.Status" cause="any-change" />
      <ct:trigger on="ARM2.6001.Info.Status" cause="any-change" />
      <ct:trigger on="Domain.CPC_tree.CPC.Service.Fiber_Check.SlowcomMode" cause="any-change" />
      <ct:trigger on="ARM3.6000.Info.Status" cause="any-change" />
      <ct:trigger on="ARM3.6001.Info.Status" cause="any-change" />
    </ct:handler>
  </ct:object>
