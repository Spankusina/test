		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033SB.DataReceivingMode.Set="FiberMode";
		}


	}
// проверка включения режима слоуком	
}
else 
{

		if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033EA.DataReceivingMode.Name!="FiberMode")
		{
