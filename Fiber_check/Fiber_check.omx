		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JD.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036JE.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0036.P0036NAR.DataReceivingMode.Set="FiberMode";
