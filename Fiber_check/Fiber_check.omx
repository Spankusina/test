	if (Domain.CPC_tree.Service.Modules.CIP_M0042.M0042NBR.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_M0042.M0042NBR.DataReceivingMode.Set="FiberMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_M0042_DP.M0042DP.DataReceivingMode.Name!="FiberMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_M0042_DP.M0042DP.DataReceivingMode.Set="FiberMode";
		}
		
		
}</property>
