		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NAR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NAR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NBR.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033NBR.DataReceivingMode.Set="SatelliteMode";
		}
	if (Domain.CPC_tree.Service.Modules.CIP_P0033.P0033SB.DataReceivingMode.Name!="SatelliteMode")
		{
		Domain.CPC_tree.Service.Modules.CIP_P0033.P0033SB.DataReceivingMode.Set="SatelliteMode";
		}
	
}


else if (
	((ARM1.$"6000".Info.Status&amp;&amp;ARM1.$"6000".Info.Status.Quality&gt;191) || (ARM2.$"6000".Info.Status&amp;&amp;ARM2.$"6000".Info.Status.Quality&gt;191)|| (ARM3.$"6000".Info.Status&amp;&amp;ARM3.$"6000".Info.Status.Quality&gt;191))
