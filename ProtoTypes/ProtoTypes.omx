        <ct:handler name="ZL" access-level="public" uuid="bc09a075-0fd3-4a13-8eac-5193b2cd0346">
          <ct:trigger on="Reference.ZLO" cause="update" />
          <ct:trigger on="Reference.ZLC" cause="update" />
          <ct:trigger on="Mode.ImitIO" cause="update" />
          <property name="source-code">if (!Mode.ImitIO)
	{
	STATE.ZLOC = !Reference.ZLO&amp;&amp;!Reference.ZLC;
	STATE.ZLerr = Reference.ZLO&amp;&amp;Reference.ZLC;
	}
else
	{
	STATE.ZLOC = !STATE.ZLO&amp;&amp;!STATE.ZLC;
	STATE.ZLerr = STATE.ZLO&amp;&amp;STATE.ZLC;
	}</property>
        </ct:handler>
        <ct:parameter name="uMode" access-level="public" access-scope="global" direction="out" type="uint16" uuid="77ce8714-e3ee-428d-9839-5d90fe16d054">
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.System.Attributes.Description" value="0 - нет режима, 1 - авто, 2,-руч, 3-местный, 4 дист, 5 сбой" />
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode.Val" />
          <attribute type="unit.Server.Attributes.InitialQuality" value="28" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
        </ct:parameter>
        <ct:handler name="izm_mode" access-level="public" uuid="2d744ac7-7f7a-45d7-ba6a-23eccc01ac0f">
          <ct:trigger on="Mode.XL" cause="update" />
          <ct:trigger on="Mode.XR" cause="update" />
          <property name="source-code">if (Mode.XL.Quality&gt;=192 &amp;&amp; Mode.XR.Quality&gt;=192) {
	if (Mode.XL &amp;&amp; !Mode.XR) {uMode=3;}
	else if (Mode.XR &amp;&amp; !Mode.XL) {uMode=4;}
	else {uMode=5;}
}
else if (Mode.XL.Quality&lt;192 &amp;&amp; Mode.XR.Quality&lt;192) {
	if (Mode.XL.Quality&lt;Mode.XR.Quality) {uMode.Quality = Mode.XL.Quality;} //Снижаем качество
		else {uMode.Quality = Mode.XR.Quality;} //Снижаем качество
}</property>
        </ct:handler>
        <ct:socket name="Attrib" access-level="public" access-scope="global" direction="none" uuid="e94b62bc-23ff-4688-aa94-88351eaf6ee0">
          <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <ct:socket-parameter name="TypeHMI_64" type="uint64" uuid="54a00dc4-b9c7-4d33-b8b2-92ff89bc1e57">
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
          </ct:socket-parameter>
          <ct:socket-parameter name="TypeHMI_Str" type="string" uuid="86ab39b5-8cd3-43b1-b07c-20da2bdc85b2">
            <attribute type="unit.System.Attributes.InitialValue">
              <property name="value">000100010000000@(object:Attributes.Valve.Type.EnableALM)0000000000000000110011000@(object:Attributes.Valve.State.EnableSt_ComOpen)@(object:Attributes.Valve.State.EnableSt_ComClose)@(object:Attributes.Valve.State.EnableSt_ComStop)0000@(object:Attributes.Valve.Mode_other.EnableMode_Remote)@(object:Attributes.Valve.Mode_other.EnableMode_Local)00000000000000</property>
            </attribute>
          </ct:socket-parameter>
          <ct:socket-parameter name="Sign" type="string" uuid="1000a30c-59b2-4c14-a811-c7a6b4c827ff">
            <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Common.Sign)" />
            <attribute type="unit.System.Attributes.Description" value="@(object:System.Attributes.Description)" />
            <attribute type="Attributes.Attrib.Priority_Display_1000030" value="@(object:Attributes.Common.Priority_Display)" />
            <attribute type="Attributes.Attrib.DescriptionRUS_1000050" value="@(object:Attributes.Common.DescriptionRUS)" />
            <attribute type="Attributes.Attrib.Remote_1000020" value="@(object:Attributes.Common.Remote)" />
            <attribute type="Attributes.Attrib.Group_1000040" value="@(object:Attributes.Common.Group)" />
          </ct:socket-parameter>
        </ct:socket>
        <ct:handler name="Handler" uuid="e344f9f6-a1c5-4c2f-9fa7-3919bf228ecc">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="70ff4266-09fb-4c48-b640-9b81f85a0fe5">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="c3d579ac-f095-4849-8879-b8e19a7fcfa1">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="d28b35dd-13e0-4c90-acdb-b8bd58e1d393">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, Mode.XL.Value);
current = Math.SetBit(current, 1, Mode.XR.Value);


current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.HL.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XL" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XR" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="18339910-7c31-4afe-aebc-29adbc010964">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));

current = Math.SetBit(current, 4, (!STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 5, (STATE.ZLO.Value &amp;&amp; STATE.ZLC.Value));

current = Math.SetBit(current, 9, STATE.HSOO.Value);
current = Math.SetBit(current, 10,STATE.HSOC.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference.HSOO.Quality &gt;= 192) || (Reference.HSOC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
