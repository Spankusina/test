      <ct:handler name="_PoleLeakDop2" uuid="93948e33-7880-4ea9-92fe-9c69f5015a28">
        <property name="source-code">if (PoleLeakDop2.Value == 1)
{
	PoleLeakDop2.Messages.Selected.Message = PoleLeakDop2.Messages.Selected.Message + ". Координата: " + String.ToString(Math.Round(PoleLeakDop2_coord, 3)) + " км. Время: " + PoleLeakDop2_str_time;
}</property>
