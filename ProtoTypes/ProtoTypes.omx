      <ct:handler name="_uZL" uuid="0933709c-b357-4153-96e4-1ee851601fec">
        <ct:trigger on="STATE.ZLO" cause="change" />
        <ct:trigger on="STATE.ZLC" cause="change" />
        <property name="source-code">Temp_uZL :uint2;

if (Mode.ImitIO)
  {

    if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	  {      
        Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	  {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	   {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }
      
       if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &lt;192))
	   {      

         Temp_uZL =99;
	   }     
      
   }
else
  {
	
    if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	  {      
        Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &lt; 192))
	  {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((Reference.ZLO.Quality &lt; 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	   {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }
      
      if ((Reference.ZLO.Quality &lt; 192) &amp;&amp; (Reference.ZLC.Quality &lt; 192))
	   {      

         Temp_uZL=99;
	   }
      
   }
   
if  ((Temp_uZL&lt;99) &amp;&amp; (Temp_uZL!=STATE.uZL))
	{
	 STATE.uZL=Temp_uZL;
	}
	
if  (Temp_uZL==99)
	{
	 STATE.uZL=Temp_uZL;
	}</property>
      </ct:handler>
      <attribute type="Attributes.Electric.Type.EnableALM" value="0" />
