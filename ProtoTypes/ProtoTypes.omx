        <attribute type="Attributes.Common.Sign" value="@(parent:unit.Attributes.Common.Sign)-P" />
      </ct:object>
      <ct:bind source="P" target="Pressure.Val" />
      <attribute type="Attributes.AP.EUnitRUS" value="кПа" />
