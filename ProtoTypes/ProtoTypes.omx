      <ct:parameter name="SPT1" access-level="public" access-scope="global" direction="out" type="float32" uuid="40de3762-4cc9-4d5b-8803-7ea9d2de8735">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">@(*object:Attributes.Common.DescriptionRUS). Время, через которое будет обесточена задвижка</property>
        </attribute>
        <attribute type="unit.Server.Attributes.Unit" value="сек" />
