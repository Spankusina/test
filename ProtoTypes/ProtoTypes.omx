          <property name="source-code">TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL))</property>
        </ct:formula>
        <attribute type="Attributes.VS.Type.Type_FAN" value="1" />
        <attribute type="Attributes.VS.Type.EnableALM" value="1" />
        <attribute type="Attributes.VS.State.EnableSt_Work" value="1" />
        <attribute type="Attributes.VS.Mode_other.EnableMode_Local" value="1" />
        <attribute type="Attributes.VS.Mode_other.EnableMode_Remote" value="1" />
        <ct:handler name="Handler" uuid="8718feed-3010-4e7c-b4d5-7d71bc68674e">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
