          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"Message":". Основной регулятор. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"Message":". Основной регулятор. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"Message":". Основной регулятор. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"Message":". Основной регулятор. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
