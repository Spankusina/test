          <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
          <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
        </ct:handler>
        <ct:handler name="START" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.START = TU.START;" uuid="50d37357-ae5b-4c4e-b24e-83d0ff3aff38">
          <ct:trigger on="TU.START" cause="any-change" />
