      </ct:parameter>
      <ct:handler name="_ClusterRole" uuid="5d3d5c8d-1e52-44b6-92a6-2f2a8182917e">
        <property name="source-code">if ((ClusterRole_Trigger.Quality &gt;= 192) &amp;&amp; (ClusterRole_Trigger.Value) &amp;&amp; (ClusterRole.Quality &gt;= 192))
{
	if (ClusterRole.Value == 0)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Роль кластера &amp;apos;&amp;apos;Резервный&amp;apos;&amp;apos;' Severity='104' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Роль кластера &amp;apos;&amp;apos;Резервный&amp;apos;&amp;apos;' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
	else if (ClusterRole.Value == 1)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Роль кластера &amp;apos;&amp;apos;Основной&amp;apos;&amp;apos;' Severity='104' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Роль кластера &amp;apos;&amp;apos;Основной&amp;apos;&amp;apos;' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
	else if (ClusterRole.Value == 2)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Роль кластера &amp;apos;&amp;apos;Ремонт&amp;apos;&amp;apos;' Severity='51' Enabled='1' AckRequired='1'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Роль кластера &amp;apos;&amp;apos;Ремонт&amp;apos;&amp;apos;' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
}</property>
        <ct:trigger on="ClusterRole_Trigger" cause="change" />
      </ct:handler>
      <ct:parameter name="Status_Connected" type="bool" direction="out" uuid="9570c5a0-4db0-487f-87a5-eb7140240f7c">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Status.Connected" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
      </ct:parameter>
      <ct:handler name="_Status" uuid="3e924332-c834-4d79-9810-664e1c7da954">
        <ct:trigger on="Status" cause="change" />
        <property name="source-code">if (Status.Quality &gt;= 192)
{
	if (Status.Value == 0)
	{
		if (Status_Connected.Value)
			Status_Connected = false;
	}
	else
	{
		if (Status_Connected.Value == false)
		{
			Status_Connected = true;
		}
	}
}</property>
      </ct:handler>
      <ct:parameter name="StateChanged" type="uint32" direction="out" uuid="75232845-ae2f-4326-8135-1d8db3527f7e">
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
      <ct:bind source="StateChanged" target="ClusterRole_Trigger" transform="get_bit" bit="1" />
      <ct:bind source="StateChanged" target="Role_Trigger" transform="get_bit" bit="0" />
      <ct:bind source="Ref_Replication_Clusters_Replicas.StateChanged" target="StateChanged" />
    </ct:type>
  </namespace>
