        <ct:handler name="TU_ImitIO_On" uuid="169fb2bc-7194-4294-a93b-fe7cb414b5d5">
          <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
	Mode.ImitIO = true;</property>
          <ct:trigger on="TU.ImitIO_On" cause="update" />
        </ct:handler>
        <ct:handler name="TU_ImitIO_Off" uuid="0bab20c1-1d0c-4126-bd86-5f589c726d98">
          <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
