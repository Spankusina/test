        <property name="source-code">Temp_uDP :uint2;

if (Mode.ImitIO)
  {

    if ((STATE.ZLP.Quality &gt;= 192) &amp;&amp; (STATE.ZLD.Quality &gt;= 192))
	  {      
        Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(STATE.ZLD));
