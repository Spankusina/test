      <ct:handler name="_Mode_HMI" uuid="a0491385-9dc9-436b-b992-a1e88451c61c">
        <property name="source-code">current: uint2 = Mode_HMI;



if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, Mode.XLR.Value);
       current = Math.SetBit(current, 1, Mode.XLL.Value);	
	}
	
if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL.Quality &lt; 192))
	{      
	   current = Math.SetBit(current, 0, Mode.XLR.Value);
       current = Math.SetBit(current, 1, !Mode.XLR.Value);	
	}
	
if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, !Mode.XLL.Value);
       current = Math.SetBit(current, 1, Mode.XLL.Value);	
	}	
	

if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL.Quality &lt; 192))
	{      
	   current = Math.SetBit(current, 0, false);
       current = Math.SetBit(current, 1, false);	
	}
	
current = Math.SetBit(current, 14, Mode.ImitIO.Value);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XR.Quality &gt;= 192) || (Reference.XL.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
        <ct:trigger on="Mode.XLR" cause="any-change" />
        <ct:trigger on="Mode.XLL" cause="any-change" />
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
      </ct:handler>
      <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="c6ccc6b3-1fc7-432f-971c-ecc2f080fe8d">
