        <ct:formula target="STATE.XSS" source-code="(Mode.ImitIO)?(STATE.XSS):(Reference.XSS)" />
        <ct:handler name="_Mode_HMI" uuid="c4b13dab-79f7-469f-9150-3170a8a332c9">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, Mode.XLR.Value);
current = Math.SetBit(current, 1, Mode.XLL.Value);
current = Math.SetBit(current, 9, Mode.XSA.Value);
current = Math.SetBit(current, 10, Mode.XSM.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192) || (Reference.XSA.Quality &gt;= 192) || (Reference.XSM.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XLR" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
          <ct:trigger on="Mode.XLL" cause="any-change" />
          <ct:trigger on="Mode.XSM" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="5bb5bb16-1483-4e21-a6c2-173f8b179bb5">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="3dbadbc8-4f91-48b0-bbef-72d54562b9eb">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 4, STATE.XIF.Value);
current = Math.SetBit(current, 5, STATE.XIG.Value);
current = Math.SetBit(current, 10, STATE.XSS.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XIF.Quality &gt;= 192) || (Reference.XIG.Quality &gt;= 192) || (Reference.XSS.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XIF" cause="any-change" />
          <ct:trigger on="STATE.XIG" cause="any-change" />
          <ct:trigger on="STATE.XSS" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="d83439ee-d93d-4d99-a90f-22b7c96393d1">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_RDY_HMI" uuid="9b9a95cf-1a33-4848-842f-4272b6aa7bfc">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XS.Value);
current = Math.SetBit(current, 5, RDY.XL.Value);
current = Math.SetBit(current, 8, RDY.MPC_PERMISSIVE.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XS.Quality &gt;= 192) || (Reference.XL.Quality &gt;= 192) || (Reference.UAB.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="RDY.XL" cause="any-change" />
          <ct:trigger on="RDY.XS" cause="any-change" />
          <ct:trigger on="RDY.MPC_PERMISSIVE" cause="any-change" />
        </ct:handler>
        <ct:parameter name="RDY_HMI" type="uint16" direction="out" uuid="6d347750-9d44-48b8-b502-faa1dedc29f0">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="RDY" />
        </ct:parameter>
