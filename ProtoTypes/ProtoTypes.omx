    <ct:type name="IOS_SET_SIKN_SELLER_UST" base-type="Команда.IOS_CMD_notPLC" uuid="2506a2ba-a6c2-44f5-9874-8e967c46b058">
      <ct:parameter name="Seller_id" type="float32" direction="out" uuid="2f1354d4-e12f-44ac-aff7-12fe7ef87d00">
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
