      <ct:handler name="TU_ImitIO_Off" uuid="7aaa46b4-0f17-4f26-b692-731f9b402d22">
        <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
        <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
      </ct:handler>
      <ct:formula target="STATE.ALM">
        <property name="source-code">(Mode.ImitIO)?(STATE.ALM):(INV_DP?(!Reference.ALM):Reference.ALM)</property>
      </ct:formula>
      <ct:formula target="STATE.R_INPT" source-code="(Mode.ImitIO)?(STATE.R_INPT):(Reference.R_INPT)" />
      <ct:formula target="Mode.OVR_S" source-code="(Mode.ImitIO)?(Mode.OVR_S):(Reference.OVR_S)" />
      <attribute type="Attributes.DP.INV_DP" value="false" />
