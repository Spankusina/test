        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":1,"IsEnabled":true,"Message":". Коммуникационный модуль сервера включен","Severity":"1","Type":"On"},{"AckStrategy":1,"IsEnabled":true,"Message":". Коммуникационный модуль сервера отключен","Severity":"1","Sound":"siren.wav","Type":"Off"}],"Type":"Discrete"}}</property>
