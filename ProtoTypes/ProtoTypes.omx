        <property name="source-code">if (((Ref_AP1.Mode.alm_oper_L.Value &amp;&amp; (Ref_AP1.Mode.alm_oper_L.Quality &gt;= 192)) || (Ref_AP1.Mode.alm_oper_L.Quality &lt; 192)) &amp;&amp; ((Ref_AP1.Mode.alm_oper_H.Value &amp;&amp; (Ref_AP1.Mode.alm_oper_H.Quality &gt;= 192)) || (Ref_AP1.Mode.alm_oper_H.Quality &lt; 192)) &amp;&amp; 
	((Ref_AP2.Mode.alm_oper_L.Value &amp;&amp; (Ref_AP2.Mode.alm_oper_L.Quality &gt;= 192)) || (Ref_AP2.Mode.alm_oper_L.Quality &lt; 192)) &amp;&amp; ((Ref_AP2.Mode.alm_oper_H.Value &amp;&amp; (Ref_AP2.Mode.alm_oper_H.Quality &gt;= 192)) || (Ref_AP2.Mode.alm_oper_H.Quality &lt; 192)))
	On = true;
else
if (((!Ref_AP1.Mode.alm_oper_L.Value &amp;&amp; (Ref_AP1.Mode.alm_oper_L.Quality &gt;= 192)) || (Ref_AP1.Mode.alm_oper_L.Quality &lt; 192)) &amp;&amp; ((!Ref_AP1.Mode.alm_oper_H.Value &amp;&amp; (Ref_AP1.Mode.alm_oper_H.Quality &gt;= 192)) || (Ref_AP1.Mode.alm_oper_H.Quality &lt; 192)) &amp;&amp; 
	((!Ref_AP2.Mode.alm_oper_L.Value &amp;&amp; (Ref_AP2.Mode.alm_oper_L.Quality &gt;= 192)) || (Ref_AP2.Mode.alm_oper_L.Quality &lt; 192)) &amp;&amp; ((!Ref_AP2.Mode.alm_oper_H.Value &amp;&amp; (Ref_AP2.Mode.alm_oper_H.Quality &gt;= 192)) || (Ref_AP2.Mode.alm_oper_H.Quality &lt; 192)))
	On = false;</property>
