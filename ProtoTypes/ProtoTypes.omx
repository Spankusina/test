          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="9d32c42c-6a1a-4132-ae58-6ba3328fc4df">
          <property name="source-code">current: uint2 = Mode_HMI;



if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, Mode.XLR.Value);
       current = Math.SetBit(current, 1, Mode.XLL.Value);	
	}
	
if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL.Quality &lt; 192))
	{      
	   current = Math.SetBit(current, 0, Mode.XLR.Value);
       current = Math.SetBit(current, 1, !Mode.XLR.Value);	
	}
	
if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, !Mode.XLL.Value);
       current = Math.SetBit(current, 1, Mode.XLL.Value);	
	}	
	

if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL.Quality &lt; 192))
	{      
	   current = Math.SetBit(current, 0, false);
       current = Math.SetBit(current, 1, false);	
	}
	

if ((Mode.XSA.Quality &gt;= 192) &amp;&amp; (Mode.XSM.Quality &gt;= 192))
	{      
	  current = Math.SetBit(current, 2, Mode.XSA.Value);
      current = Math.SetBit(current, 3, Mode.XSM.Value);	
	}

if ((Mode.XSA.Quality &gt;= 192) &amp;&amp; (Mode.XSM.Quality &lt; 192))
	{      
	  current = Math.SetBit(current, 2, Mode.XSA.Value);
      current = Math.SetBit(current, 3, !Mode.XSA.Value);	
	}

if ((Mode.XSA.Quality &lt; 192) &amp;&amp; (Mode.XSM.Quality &gt;= 192))
	{      
	  current = Math.SetBit(current, 2, !Mode.XSM.Value);
      current = Math.SetBit(current, 3, Mode.XSM.Value);	
	}

if ((Mode.XSA.Quality &lt; 192) &amp;&amp; (Mode.XSM.Quality &lt; 192))
	{      
	  current = Math.SetBit(current, 2, false);
      current = Math.SetBit(current, 3, false);	
	}

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192) || (Reference.XSA.Quality &gt;= 192) || (Reference.XSM.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLR" cause="any-change" />
          <ct:trigger on="Mode.XLL" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
          <ct:trigger on="Mode.XSM" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="9b8c7f2e-917e-4335-bbd6-8ce0d525e2b2">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));



current = Math.SetBit(current, 4, STATE.ZLOC.Value);
current = Math.SetBit(current, 5, STATE.ZLerr.Value);
current = Math.SetBit(current, 9, STATE.HSOO.Value);
current = Math.SetBit(current, 10, STATE.HSOC.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:formula target="STATE.HSOO" source-code="(Mode.ImitIO)?(STATE.HSOO):(Reference.HSOO)" />
        <ct:formula target="STATE.HSOC" source-code="(Mode.ImitIO)?(STATE.HSOC):(Reference.HSOC)" />
        <ct:handler name="_ZLOC_ZLerr" uuid="b08f12b6-33d9-46d0-8b1c-d0ce40227962">
          <ct:trigger on="Reference.ZLO" cause="any-change" />
          <ct:trigger on="Reference.ZLC" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <property name="source-code">if (!Mode.ImitIO)
{
	STATE.ZLOC = !Reference.ZLO&amp;&amp;!Reference.ZLC;
	STATE.ZLerr = Reference.ZLO&amp;&amp;Reference.ZLC;
}
else
{
	STATE.ZLOC = !STATE.ZLO&amp;&amp;!STATE.ZLC;
	STATE.ZLerr = STATE.ZLO&amp;&amp;STATE.ZLC;
}</property>
        </ct:handler>
        <attribute type="Attributes.Common.Type_HMI" value="0" />
        <ct:handler name="TU_HSO" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.HSO = TU.HSO;" uuid="558b2c01-23ac-43a0-83a7-d6d7a734b186">
