      <ct:handler name="_Set_Current_File" uuid="838f340f-5392-4fd1-8ee4-dbe384be3bc0">
        <ct:trigger on="Ref_Extractor.ExtrInProgress" cause="change" />
        <property name="source-code">if ((Ref_Extractor.ExtrInProgress == false) &amp;&amp; (LockExtract.Value == false))
{
	if (CurrentSnapShot &lt; Ref_InitSnapShot.TemplateCount)
	{
		CurrentSnapShot += 1;
	}
	else
	{
		CurrentSnapShot = 1;
		LockExtract = true;
	}
}</property>
      </ct:handler>
