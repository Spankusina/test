			AP6.Off_group_cmd_LO = false;
		}
	}
	if (AP6.Off_group_cmd_HI)
	{
		if (!Ref_AP6.Mode.alm_oper_H)
		{	
			Ref_AP6.Mode.alm_oper_H = true;
			AP6.Off_group_cmd_HI = false;
		}
