    </ct:type>
    <ct:type name="Point_TU_SPPR" uuid="b5607542-3b07-4457-ae8a-ed58f39abb09" base-type="Point_SPPR">
      <ct:parameter name="Set_CoordInterface" type="float64" direction="in" uuid="fba35921-56e5-4b07-94a5-4057f0920c15">
        <attribute type="unit.System.Attributes.Description" value="Задать интерфейсную координату" />
        <attribute type="unit.Server.Attributes.Unit" value="км" />
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
      </ct:parameter>
      <attribute type="unit.System.Attributes.Description" value="Расчётная точка" />
      <ct:parameter name="GenMessage" type="string" direction="in" uuid="3e551e8f-9424-4e14-9602-d545472d5443">
        <attribute type="unit.System.Attributes.Description" value="Динамическое сообщение" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"Severity":"105","Type":"Dynamic"}],"Type":"Dynamic"}}</property>
        </attribute>
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="Attributes.Type_Events" value="SCADA_CTRL" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
      </ct:parameter>
      <ct:socket name="Attrib" access-level="public" access-scope="global" direction="none" uuid="286f967a-fee3-47df-89c1-b791ed90c527">
        <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
        <ct:socket-parameter name="Sign" type="string" uuid="5a389eeb-f30e-4479-a8a3-131ecd901aff">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Common.Sign)" />
          <attribute type="unit.System.Attributes.Description" value="@(object:System.Attributes.Description)" />
          <attribute type="Attributes.Attrib.Priority_Display_1000030" value="@(object:Attributes.Common.Priority_Display)" />
          <attribute type="Attributes.Attrib.DescriptionRUS_1000050" value="@(object:Attributes.Common.DescriptionRUS)" />
          <attribute type="Attributes.Attrib.Remote_1000020" value="@(object:Attributes.Common.Remote)" />
          <attribute type="Attributes.Attrib.Group_1000040" value="@(object:Attributes.Common.Group)" />
        </ct:socket-parameter>
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
      </ct:socket>
      <ct:socket name="TU" direction="in" uuid="28ba59e5-ceb0-4b12-b5a0-5943ba554b60">
        <ct:socket-parameter name="Atyrau_Down" type="bool" uuid="5c876e96-f845-4d1a-970a-91269f08ad8d">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.Sign). Включить режим ввода ''Километра до Арырау''</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
        </ct:socket-parameter>
        <ct:socket-parameter name="Atyrau_Up" type="bool" uuid="681dd0ff-6144-4885-b5f2-200dcbbb2980">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.Sign). Включить режим ввода ''Километра после Арырау''</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
        </ct:socket-parameter>
        <ct:socket-parameter name="Cntrl_On" type="bool" uuid="7471f780-9209-4af3-acf8-e3c3d9c7cc24">
          <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Включить контроль за точкой" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
        </ct:socket-parameter>
        <ct:socket-parameter name="Cntrl_Off" type="bool" uuid="d1e69b67-5b25-49f4-a693-b2c0695f28b9">
          <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Отключить контроль за точкой" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
        </ct:socket-parameter>
      </ct:socket>
      <ct:socket name="Mode" access-level="public" access-scope="global" direction="out" uuid="e56d326d-5dcc-4dfb-ae3a-e5f4b076a5b8">
        <ct:socket-parameter name="Atyrau" type="bool" uuid="37253d25-6183-4568-aac3-d90fede0d75c">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Режим ''Километр до/после Атырау''</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Километр до Атырау''","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Километр после Атырау''","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="false" />
          <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
          <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        </ct:socket-parameter>
        <ct:socket-parameter name="Cntrl_On" uuid="66d7c3e4-19b8-4b45-8c4c-24f0dea823dc" type="bool">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Контроль точки включен</property>
          </attribute>
          <attribute type="unit.System.Attributes.Comment" value="Только для отображения на экранах (для удобства)" />
        </ct:socket-parameter>
      </ct:socket>
      <ct:handler name="_TU_Atyrau_Down" uuid="19d4d0d1-e68a-48cd-945c-82084c39ab9e">
        <property name="source-code">if (TU.Atyrau_Down.Quality &gt;= 192 &amp;&amp; TU.Atyrau_Down.Value)
{
	Mode.Atyrau = false;
	
	if (CoordInterface_FromDisp.Quality &gt;= 192)
	{
		CoordOut = CoordInterface_FromDisp + 13.974;
	}
}</property>
        <ct:trigger on="TU.Atyrau_Down" cause="any-change" />
      </ct:handler>
      <ct:handler name="_TU_Atyrau_Up" uuid="0fd9fd7a-47d9-4e20-95ec-48b50eb9f23a">
        <property name="source-code">if (TU.Atyrau_Up.Quality &gt;= 192 &amp;&amp; TU.Atyrau_Up.Value)
{
	Mode.Atyrau = true;

	if (CoordInterface_FromDisp.Quality &gt;= 192)
	{
		CoordOut = CoordInterface_FromDisp;
	}	
}</property>
        <ct:trigger on="TU.Atyrau_Up" cause="any-change" />
      </ct:handler>
      <ct:handler name="ReplaceMsg" uuid="12a6d691-c913-40d9-8941-f00fabdc5e07">
        <ct:trigger on="GenMessage" cause="message-prepare" />
        <property name="source-code">GenMessage.Messages.Selected.Message = "Команда: " + GenMessage.Messages.Selected.Message;</property>
      </ct:handler>
      <ct:parameter name="CoordOut" uuid="46757edf-66e9-4a8d-acd1-ac53ccbb1241" type="float64" direction="out">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">@(*object:Attributes.Common.DescriptionRUS). Исходящая фактичекая координата</property>
        </attribute>
        <attribute type="unit.Server.Attributes.Unit" value="км" />
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
      </ct:parameter>
      <ct:handler name="_Set_CoordInterface" uuid="58f0dbde-390c-4390-befe-3bbd96a97c50">
        <ct:trigger on="Set_CoordInterface" cause="any-change" />
        <property name="source-code">if (Set_CoordInterface.Quality &gt;= 192)
{
	if (Mode.Atyrau)
	{
		CoordOut = Set_CoordInterface;
	}
	else
	{
		CoordOut = Set_CoordInterface + 13.974;
	}
	CoordInterface_FromDisp = Set_CoordInterface;
}</property>
      </ct:handler>
      <ct:parameter name="CoordInterface" type="float64" direction="out" uuid="b1f58fa8-09de-494f-b2c6-8078174351bc">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">@(*object:Attributes.Common.DescriptionRUS). Интерфейсная координата</property>
        </attribute>
        <attribute type="unit.Server.Attributes.Unit" value="км" />
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
      </ct:parameter>
      <ct:parameter name="Flagout" type="int32" direction="out" uuid="ed6bae51-3ccd-45fa-bf83-e2f073c16b80">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">@(*object:Attributes.Common.DescriptionRUS). Исходящая команда включени/отключения контроля точки</property>
        </attribute>
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
      </ct:parameter>
      <ct:handler name="_TU_Cntrl_On" uuid="7357c4a7-0dea-41cf-9626-01033250141b">
        <property name="source-code">if (TU.Cntrl_On.Quality &gt;= 192 &amp;&amp; TU.Cntrl_On.Value)
{
	Flagout = 1;
}</property>
        <ct:trigger on="TU.Cntrl_On" cause="any-change" />
      </ct:handler>
      <ct:handler name="_TU_Cntrl_Off" uuid="30568fa8-7d92-498a-93b7-c23bb8ae12a3">
        <property name="source-code">if (TU.Cntrl_Off.Quality &gt;= 192 &amp;&amp; TU.Cntrl_Off.Value)
{
	Flagout = 0;
}</property>
        <ct:trigger on="TU.Cntrl_Off" cause="any-change" />
      </ct:handler>
      <ct:parameter name="Flagin" type="int32" direction="out" uuid="1091fe6a-e312-4927-9f6d-da0f56ee7b51">
        <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Контроль точки" />
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Контроль точки отключен","Severity":"104","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Контроль точки включен","Severity":"104","Type":"Enumeration","Value":1}],"Type":"Enumeration"}}</property>
        </attribute>
      </ct:parameter>
      <ct:formula target="Mode.Cntrl_On">
        <property name="source-code">(Flagin == 1)?(VQ(true, Flagin.Quality)):(VQ(false, Flagin.Quality))</property>
      </ct:formula>
      <ct:parameter name="Set_CoordInterface_MinEGU_SP" uuid="eff843ad-1349-40b5-b22d-0c17c3409e44" type="float32" direction="out">
        <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.Min_EGU)" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Set_CoordInterface.MinEGU_SP" />
        <attribute type="unit.Server.Attributes.Unit" value="км" />
      </ct:parameter>
      <ct:parameter name="Set_CoordInterface_MaxEGU_SP" type="float32" direction="out" uuid="4021d09e-ef63-48fd-b5f3-d9d04c1ab91f">
        <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.Max_EGU)" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Set_CoordInterface.MaxEGU_SP" />
        <attribute type="unit.Server.Attributes.Unit" value="км" />
      </ct:parameter>
      <attribute type="Attributes.AP.Max_EGU" value="2000" />
      <attribute type="Attributes.AP.Min_EGU" value="0" />
      <attribute type="Attributes.AP.EUnitRUS" value="кПа" />
      <ct:parameter name="CoordInterface_FromDisp" type="float64" direction="out" uuid="81df1a2b-0f37-4b31-a390-570fb10852b0">
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="CoordInterface.FromDisp" />
      </ct:parameter>
      <ct:formula target="CoordInterface" source-code="(read Mode.Atyrau)?(CoordIn):(CoordIn + 13.974)" />
    </ct:type>
    <ct:type name="State_Server" uuid="72de6481-b97e-4c69-8c0f-e87c956d99f2">
      <attribute type="unit.System.Attributes.Description" value="Состояние сервера СППР" />
      <ct:parameter name="Active" type="int32" direction="out" uuid="be15b603-db80-4ada-975a-9bdfd45536a2">
        <attribute type="unit.System.Attributes.Comment" value="0 - не на связи, 1 - резервный, 2 - мастер" />
        <attribute type="unit.System.Attributes.Description" value="Активность" />
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Не на связи","Severity":"51","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Резервный","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Мастер","Severity":"104","Type":"Enumeration","Value":2}],"Type":"Enumeration"}}</property>
        </attribute>
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="2" />
      </ct:parameter>
      <attribute type="Attributes.Common.Group" value="No_signal" />
      <attribute type="Attributes.Common.Remote" value="No_signal" />
      <attribute type="Attributes.Common.Sign" value="No_signal" />
      <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
      <ct:parameter name="Link" uuid="260606cc-b57d-4c6c-8aa6-55b72624714a" type="uint8" direction="out">
        <attribute type="unit.System.Attributes.Description" value="Связь" />
        <attribute type="unit.System.Attributes.Comment">
          <property name="value">Сейчас не передаётся значение от Энергоавтоматики, т.к. нет понимания у Энергоавтоматики нужен ли этот сигнал</property>
        </attribute>
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
      </ct:parameter>
      <ct:parameter name="Configuration" type="uint8" direction="out" uuid="a966fff4-aa73-4518-a4d8-dae1369630cd">
