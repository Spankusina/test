        <ct:parameter name="PV" type="float32" direction="out" uuid="77d7bb9c-af5e-4d61-9b94-cdbc46995ee8">
          <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Положение" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="Attributes.История.DeadBandTime" value="0" />
          <attribute type="unit.Server.Attributes.History">
            <property name="value">Deadband="@(:Attributes.История.DeadBandValue)" MinTime="@(:Attributes.История.DeadBandTime)" ServerTime="True"</property>
          </attribute>
          <attribute type="Attributes.История.DeadBandValue" value="0.1" />
