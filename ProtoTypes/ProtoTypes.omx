          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" выше высокого значения","Severity":"52","Type":"On"},{"AckStrategy":0,"IsGenerateEqualSubcondition":false,"Message":" ниже высокого значения","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="false" />
          <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
          <attribute type="Attributes.Type_Events" value="SCADA_H" />
