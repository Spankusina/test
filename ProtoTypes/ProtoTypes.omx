        <ct:bind source="Reference.HSS" target="TU_Answer.HSS_Answer" action="delivery_status" />
        <ct:formula target="Mode.XSM" source-code="(Mode.ImitIO)?(Mode.XSM):(!Reference.XSA)" />
        <ct:formula target="Mode.XLL" source-code="(Mode.ImitIO)?(Mode.XLL):(Reference.XLL)" />
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="2542c3f5-1f51-4432-b3f9-817d78c2b78e">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="8be6dc77-c1e3-4c40-888a-7343445b1cc4">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="857760ac-ebf2-4788-9318-1408b6f5bf06">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, Mode.XLR.Value);
current = Math.SetBit(current, 1, Mode.XLL.Value);
current = Math.SetBit(current, 2, Mode.XSA.Value);
current = Math.SetBit(current, 3, Mode.XSM.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192) || (Reference.XSA.Quality &gt;= 192) || (Reference.XSM.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLR" cause="any-change" />
          <ct:trigger on="Mode.XLL" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
          <ct:trigger on="Mode.XSM" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="6021b46c-8bf8-433c-9e62-f088f2ca137e">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));

current = Math.SetBit(current, 4, (!STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 5, (STATE.ZLO.Value &amp;&amp; STATE.ZLC.Value));

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <attribute type="Attributes.Common.Type_HMI" value="126" />
        <ct:handler name="_ZLOC_ZLerr" uuid="6e5f7729-fce3-4b12-a8b5-29cca8bf097d">
          <ct:trigger on="Reference.ZLO" cause="any-change" />
          <ct:trigger on="Reference.ZLC" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <property name="source-code">if (!Mode.ImitIO)
{
	STATE.ZLOC = !Reference.ZLO&amp;&amp;!Reference.ZLC;
	STATE.ZLerr = Reference.ZLO&amp;&amp;Reference.ZLC;
}
else
{
	STATE.ZLOC = !STATE.ZLO&amp;&amp;!STATE.ZLC;
	STATE.ZLerr = STATE.ZLO&amp;&amp;STATE.ZLC;
}</property>
        </ct:handler>
        <ct:bind source="TU.HSO_tu" target="Reference.HSO" />
        <ct:bind source="TU.HSC_tu" target="Reference.HSC" />
        <ct:bind source="TU.HSA_tu" target="Reference.HSA" />
        <ct:bind source="TU.HSM_tu" target="Reference.HSM" />
        <ct:bind source="TU.HSS_tu" target="Reference.HSS" />
        <ct:formula target="Mode.XLR_ERR" source-code="(Mode.XLL &amp;&amp; Mode.XLR) || (!Mode.XLL &amp;&amp; !Mode.XLR)" />
        <attribute type="Attributes.Valve.Two_LR_bit" value="true" />
        <ct:formula target="Mode.uLR">
          <property name="source-code">TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL))</property>
        </ct:formula>
        <attribute type="Attributes.Valve.Cmd.EnableCom_Auto" value="1" />
        <attribute type="Attributes.Valve.Cmd.EnableCom_Close" value="1" />
        <attribute type="Attributes.Valve.Cmd.EnableCom_Man" value="1" />
        <attribute type="Attributes.Valve.Cmd.EnableCom_Open" value="1" />
        <attribute type="Attributes.Valve.Cmd.EnableCom_Stop" value="1" />
        <attribute type="Attributes.Valve.Type.Type_Station" value="1" />
        <attribute type="Attributes.Valve.Type.EnableALM" value="1" />
        <attribute type="Attributes.Valve.Mode_other.EnableMode_Auto" value="1" />
        <attribute type="Attributes.Valve.Mode_other.EnableMode_Local" value="1" />
        <attribute type="Attributes.Valve.Mode_other.EnableMode_Man" value="1" />
        <attribute type="Attributes.Valve.Mode_other.EnableMode_Remote" value="1" />
        <ct:handler name="Handler" uuid="68816a81-8ee6-4649-80c8-5082d03aefb2">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:object name="Comment" aspect="IOS" base-type="Служебные.Comment" uuid="d2a93079-cc94-44b9-afef-d000e2ed0540">
          <attribute type="unit.System.Attributes.Description" />
        </ct:object>
        <attribute type="Attributes.Valve.Type.Type_NAR" value="0" />
        <attribute type="Attributes.Valve.Type.Type_SIKN" value="0" />
        <attribute type="Attributes.Valve.Mode_other.EnableAnalog_Prc" value="0" />
        <attribute type="Attributes.Valve.Mode_other.EnableAnalog_SPT1" value="0" />
        <attribute type="Attributes.Valve.Mode_other.EnableAnalog_SPT2" value="0" />
        <attribute type="Attributes.Valve.Cmd.EnableCom_Deenerg" value="0" />
        <attribute type="Attributes.Valve.State.EnableSt_Deenerg" value="0" />
        <attribute type="Attributes.Valve.Type.Type_CV" value="0" />
        <attribute type="Attributes.Valve.Type.EnableReasons" value="0" />
        <attribute type="Attributes.Valve.Type.Type_Linear" value="0" />
        <attribute type="Attributes.Valve.Cmd.EnableCom_Osn" value="0" />
        <attribute type="Attributes.Valve.Type.Type_Mini" value="0" />
        <attribute type="unit.System.Attributes.Comment">
          <property name="value">В этой задвижке режим приходит только режим местный, и только режим автоматический</property>
        </attribute>
        <ct:service-communication source="TU.HSO" target="TU_Answer.HSO_CoreCommandStatus" />
        <ct:service-communication source="TU.HSC" target="TU_Answer.HSC_CoreCommandStatus" />
        <ct:service-communication source="TU.HSA" target="TU_Answer.HSA_CoreCommandStatus" />
        <ct:service-communication source="TU.HSM" target="TU_Answer.HSM_CoreCommandStatus" />
        <ct:service-communication source="TU.HSS" target="TU_Answer.HSS_CoreCommandStatus" />
      </ct:type>
      <ct:type name="IOS_VALVE_POS_1L1A_MODE" aspect="IOS" original="M_VALVE_STOP_AUT" base-type="IOS_VALVE_STOP_AUT_1L1A_MODE" uuid="ee816d9a-7bb6-424f-abf2-1321b7109b8e">
