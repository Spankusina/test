      <ct:parameter name="INV_UA" access-level="public" access-scope="global" direction="none" type="bool" uuid="d410c989-f10a-45a0-b5ab-fa580585280c">
        <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Valve.Inversion.INV_UA)" />
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
