        <ct:trigger on="Active" cause="any-change" />
        <property name="source-code">if ((Active.Quality &gt;= 192) &amp;&amp; (Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192))
{
	Reference_Module.ActiveSet = Active;
}</property>
