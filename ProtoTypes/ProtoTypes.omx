    <ct:type name="IOS_DATE_TIME" aspect="IOS" original="M_DATE_TIME" access-level="public" uuid="a5e5de4c-915b-4b64-a185-bd16044314da">
      <attribute type="unit.System.Attributes.Description" />
      <ct:bind source="Reference.Year" target="YEAR" action="set_all" />
      <ct:bind source="Reference.Month" target="MONTH" action="set_all" />
      <ct:bind source="Reference.Day" target="DAY" action="set_all" />
      <ct:bind source="Reference.Hour" target="HOUR" action="set_all" />
      <ct:bind source="Reference.Min" target="MINUTE" action="set_all" />
      <r:ref name="Reference" type="M_DATE_TIME" const-access="false" aspected="true" uuid="3f9bc690-95ec-4393-b2bc-bf63a2519e89" />
      <ct:handler name="Handler" access-level="public" uuid="f9a278e5-33f4-453a-b761-2a2d360b0fba">
        <ct:trigger on="Reference.Year" cause="any-change" />
        <ct:trigger on="Reference.Month" cause="any-change" />
        <ct:trigger on="Reference.Day" cause="any-change" />
        <ct:trigger on="Reference.Hour" cause="any-change" />
        <ct:trigger on="Reference.Min" cause="any-change" />
        <property name="source-code">Year : uint2=TypeConvert.ToUint2(Reference.Year);
Month :  uint1=TypeConvert.ToUint1(Reference.Month);
Day : uint1=TypeConvert.ToUint1(Reference.Day);
H : uint1=TypeConvert.ToUint1(Reference.Hour);
M : uint1=TypeConvert.ToUint1(Reference.Min);
S : uint1=TypeConvert.ToUint1(0);
MS:    uint2 = TypeConvert.ToUint2(0);
PLC_Time=DateTime.Create(Year, Month, Day, H, M, S, MS);</property>
      </ct:handler>
      <ct:parameter name="PLC_Time" access-level="public" access-scope="global" direction="out" type="uint64" uuid="121981ef-b2df-4171-aa05-dc578df9a2f9">
        <attribute type="unit.System.Attributes.Description" value="Время" />
      </ct:parameter>
