        <ct:parameter name="XSP" type="bool" direction="out" uuid="ecd6e814-0ffd-4f7a-9740-761a20768959">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Режим работы ''Основной''</property>
          </attribute>
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE.XSP" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим работы ''Основной''","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим работы ''Основной''. Сигнал снят","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="Attributes.Type_Events" value="PLC_EQ" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:formula target="PV" source-code="(Mode.ImitIO)?(PV):(Reference_P.PV)" />
        <ct:formula target="XSP" source-code="(Mode.ImitIO)?(XSP):(Reference_P.XSP)" />
        <ct:handler name="_STATE_HMI_XSP" uuid="cedf1aa3-3fe7-4639-88f3-41686931f4fa">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 7, XSP.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference_P.TRANS.Quality &gt;= 192) || (Reference_P.XSP.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="XSP" cause="any-change" />
        </ct:handler>
