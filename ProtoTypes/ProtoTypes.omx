        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="98f439a4-b3d6-42bf-b2ec-aefbe80bafd3">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="c686ea3c-d6e1-49a6-ba14-e483ab7723e9">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="7755330f-4e21-4616-a179-54373a508e69">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, false);
current = Math.SetBit(current, 1, false);
current = Math.SetBit(current, 2, Mode.XSP.Value);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 9, false);
current = Math.SetBit(current, 10, false);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ( (Reference.XSP.Quality &gt;= 192) || (Reference.XSS.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSP" cause="any-change" />
          <ct:trigger on="Mode.XSS" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="f76c04c3-7fbf-49e4-bd32-4ebc4e078f77">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XL.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XL.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XL" cause="any-change" />
        </ct:handler>
        <ct:formula target="Mode.XSP" source-code="(Mode.ImitIO)?(Mode.XSP):(Reference.XSP)" />
        <ct:formula target="Mode.XSS" source-code="(Mode.ImitIO)?(Mode.XSS):(Reference.XSS)" />
