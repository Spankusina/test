      <r:ref name="Ref_who_am_i" type="who_am_i" uuid="4b51a64f-4c02-4aac-888a-f8d40d2310d2" />
      <ct:parameter name="GenMessage" type="string" direction="out" uuid="284a06f7-ca26-4f72-9bf9-f2f7502d601a">
        <attribute type="unit.System.Attributes.Description" value="Динамическое сообщение" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"Severity":"105","Type":"Dynamic"}],"Type":"Dynamic"}}</property>
        </attribute>
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
      <ct:handler name="_Role" uuid="cf05f32b-36f9-4da8-a952-70b174af9752">
        <property name="source-code">if ((Role_Trigger.Quality &gt;= 192) &amp;&amp; (Role_Trigger.Value) &amp;&amp; (Role.Quality &gt;= 192))
{
	/*if (ClusterRole != 2)
	{*/
	if (Role.Value == 0)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Роль сервера &amp;apos;&amp;apos;Резервный&amp;apos;&amp;apos;' Severity='104' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Роль сервера &amp;apos;&amp;apos;Резервный&amp;apos;&amp;apos;' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
	else if (Role.Value == 1)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Роль сервера &amp;apos;&amp;apos;Резервный лидер&amp;apos;&amp;apos;' Severity='104' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Роль сервера &amp;apos;&amp;apos;Резервный лидер&amp;apos;&amp;apos;' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
	else if (Role.Value == 2)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Роль сервера &amp;apos;&amp;apos;Основной&amp;apos;&amp;apos;' Severity='104' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Роль сервера &amp;apos;&amp;apos;Основной&amp;apos;&amp;apos;' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
	//}
}</property>
        <ct:trigger on="Role_Trigger" cause="change" />
      </ct:handler>
      <ct:handler name="_Status_Connected" uuid="f49db1a2-29c8-4763-a272-db189d9c2b66">
        <property name="source-code">if (Status_Connected.Quality &gt;= 192)
{
	if (Status_Connected.Value == false)
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Связь отсутствует' Severity='51' Enabled='1' AckRequired='1'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Связь отсутствует' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
	else
	{
		GenMessage = "&lt;Subcondition Type='Dynamic' Message='. Связь установлена' Severity='104' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
		GenMessageSMTP = "&lt;Subcondition Type='Dynamic' Message='. Связь установлена' Severity='587' Enabled='1' AckRequired='0'&gt; &lt;CustomAttribute Name='Sign' ValueSource='constant' Value='"+ Ref_who_am_i.Name + "' /&gt;&lt;/Subcondition&gt;";
	}
}</property>
        <ct:trigger on="Status_Connected" cause="change" />
      </ct:handler>
