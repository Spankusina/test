            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Изолирован''","Severity":"104","Type":"On"},{"AckStrategy":0,"IsGenerateEqualSubcondition":false,"Severity":"1","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
