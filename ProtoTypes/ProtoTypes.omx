      <ct:type name="IOS_FCV" aspect="IOS" original="M_FCV" access-level="public" uuid="edab18ca-8f2b-4830-89e2-0abffe83df1f">
        <attribute type="unit.System.Attributes.Description" value="Регулятор @(object:Attributes.Common.Sign)" />
        <attribute type="Attributes.Common.DescriptionRUS" value="No_signal" />
        <attribute type="Attributes.Common.Remote" value="No_signal" />
        <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
        <attribute type="Attributes.Common.Group" value="M0040_D" />
        <attribute type="Attributes.Common.Sign" value="FCV-000A" />
        <attribute type="Attributes.Valve.Inversion.INV_FAIL" value="false" />
        <attribute type="Attributes.Valve.Inversion.INV_LOCAL" value="false" />
        <attribute type="Attributes.Valve.Inversion.INV_AUT" value="false" />
        <ct:formula target="Mode.XLL">
          <property name="source-code">(Mode.ImitIO)?(Mode.XLL):(INV_LOCAL?(!Reference.NotRemote):Reference.NotRemote)</property>
        </ct:formula>
        <ct:formula target="Mode.XSA">
          <property name="source-code">(Mode.ImitIO)?(Mode.XSA):(INV_AUT?(!Reference.AUT):Reference.AUT)</property>
        </ct:formula>
        <ct:formula source-code="(Mode.ImitIO)?(ALM.FAIL.On):(Reference.FAIL)" target="ALM.FAIL.On" />
        <ct:formula source-code="(Mode.ImitIO)?(STATE.ZLO):(Reference.ZLO)" target="STATE.ZLO" />
        <ct:formula source-code="(Mode.ImitIO)?(STATE.ZLC):(Reference.ZLC)" target="STATE.ZLC" />
        <ct:formula source-code="TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC))" target="STATE.uZL" />
        <attribute type="Attributes.REG.EUnit_PV_SP" value="м3/ч" />
        <attribute type="Attributes.REG.EUnit_OUT" value="%" />
        <ct:bind source="Reference.SP_VAL" target="rSP_VAL" action="set_all" />
        <ct:bind source="Reference.SO_VAL" target="rSO_VAL" action="set_all" />
        <ct:bind source="Reference.AUTO" target="TU_Answer.HSA_Answer" action="delivery_status" />
        <ct:bind source="Reference.MAN" target="TU_Answer.HSM_Answer" action="delivery_status" />
        <ct:bind source="Reference.UPD" target="TU_Answer.UPD_Answer" action="delivery_status" />
        <ct:bind source="Reference.rSP" target="Set_UST_Answer" action="delivery_status" />
        <ct:bind source="Reference.rSO" target="Set_OUT_Answer" action="delivery_status" />
        <ct:bind source="TU.HSA_tu" target="Reference.AUTO" action="set_all" />
        <ct:bind source="TU.HSM_tu" target="Reference.MAN" action="set_all" />
        <ct:bind source="TU.UPD_tu" target="Reference.UPD" action="set_all" />
        <ct:bind source="Adr_UST" target="Reference.rSP" action="set_all" />
        <ct:bind source="Adr_OUT" target="Reference.rSO" action="set_all" />
        <ct:socket name="Attrib" access-level="public" access-scope="global" direction="none" uuid="a8abd223-f605-4ee5-821a-eeacb0319b36">
          <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
