      <attribute type="Attributes.Valve.Cmd.EnableCom_Close" value="1" />
      <attribute type="Attributes.Valve.Cmd.EnableCom_Deenerg" value="0" />
      <attribute type="Attributes.Valve.Cmd.EnableCom_Open" value="1" />
      <attribute type="Attributes.Valve.Cmd.EnableCom_PermissionLocal" value="1" />
      <attribute type="Attributes.Valve.Cmd.EnableCom_ResetLocal" value="0" />
      <attribute type="Attributes.Valve.Cmd.EnableCom_Stop" value="1" />
      <attribute type="Attributes.Valve.State.EnableSt_Deenerg" value="0" />
      <attribute type="Attributes.Valve.Mode_other.EnableAnalog_OPCNT" value="1" />
      <attribute type="Attributes.Valve.Mode_other.EnableAnalog_Prc" value="1" />
      <attribute type="Attributes.Valve.Mode_other.EnableAnalog_SPT1" value="0" />
      <attribute type="Attributes.Valve.Mode_other.EnableAnalog_SPT2" value="1" />
      <attribute type="Attributes.Valve.Mode_other.EnableMode_Local" value="0" />
      <attribute type="Attributes.Valve.Mode_other.EnableMode_LocalBlock" value="0" />
      <attribute type="Attributes.Valve.Mode_other.EnableMode_PermissionLocal" value="1" />
      <attribute type="Attributes.Valve.Mode_other.EnableMode_Remote" value="0" />
      <ct:handler name="Handler" uuid="7326c201-c22f-4983-b8c1-8560915e7fed">
        <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
        <ct:trigger on="STATE_HMI" />
        <ct:trigger on="Mode_HMI" />
      </ct:handler>
      <ct:object name="Comment" aspect="IOS" base-type="Служебные.Comment" uuid="7fc242f5-94fd-4804-ad13-bc51633446fd">
