      </ct:parameter>
      <ct:object name="Channel_1" uuid="e1560927-7739-476e-84a0-5194dac05ec9" base-type="PLC_Channel">
        <attribute type="unit.System.Attributes.Description" value="Канал 1" />
        <attribute type="Attributes.Common.Group" value="@(parent:ProtoTypes.Attributes.Common.Group)" />
        <attribute type="Attributes.Common.Remote" value="@(parent:ProtoTypes.Attributes.Common.Remote)" />
        <ct:socket name="All_Alarm" direction="out" uuid="51219b5e-4928-4ab6-813c-46335c26b630">
          <ct:socket-parameter name="UnAck" type="bool" uuid="28bceed9-2888-4146-b1e9-4f6e52e1bcbf">
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
          </ct:socket-parameter>
          <ct:socket-parameter name="On" type="bool" uuid="baa2fa97-e852-4e78-af70-5585fa5a6ee2">
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
            <attribute type="unit.Server.Attributes.NodeRelativePath" value="Active" />
          </ct:socket-parameter>
        </ct:socket>
        <ct:handler name="_All_Alarm" uuid="40cbb8e7-d067-4afa-81dc-5f01128c1be3">
          <ct:trigger on="Ref_Service_PLC.Enabled" cause="change" />
          <ct:trigger on="Ref_Channel_1.Status.Enabled" cause="change" />
          <ct:trigger on="Ref_Channel_1.Status.Connected" cause="change" />
          <property name="source-code">if ((Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192))
{
	if (Ref_Service_PLC.Enabled &amp;&amp; Ref_Channel_1.Status.Enabled &amp;&amp; !(Ref_Channel_1.Status.Connected))
	{
		All_Alarm.On = true;
		All_Alarm.UnAck = Status.Agg_DiagCIP.OUT.UnAck;
	}
	else
	{
		All_Alarm.On = false;
		All_Alarm.UnAck = true;
	}
}</property>
          <ct:trigger on="Ref_Replication_This.Role" cause="any-change" />
          <ct:trigger on="Status.Agg_DiagCIP.OUT.UnAck" cause="change" />
        </ct:handler>
        <ct:handler name="_Gen_Msg_Channel_Offline" uuid="4ac39bc9-2dfe-486a-ad92-1245e011a1fc">
          <property name="source-code">if (Ref_Service_PLC.Enabled &amp;&amp; Ref_Channel_1.Status.Enabled &amp;&amp; !(Ref_Channel_1.Status.Connected))
{
	Status.Connected_TikTimer = VQT(Status.Connected_TikTimer.Value, 200, DateTime.UtcNow());
}</property>
          <ct:trigger on="Ref_Channel_1.Status.Enabled" cause="change" />
          <ct:trigger on="Ref_Service_PLC.Enabled" cause="change" />
        </ct:handler>
      </ct:object>
      <r:ref name="Ref_Timer" type="Time_180s" uuid="0c459282-6308-4738-a0fa-f15d36f5d84e" />
