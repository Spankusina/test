        <ct:socket name="Attrib" access-level="public" access-scope="global" direction="none" uuid="113aab1c-e424-40f5-866a-10bc6b48f744">
          <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <ct:socket-parameter name="TypeHMI_64" type="uint64" uuid="99605ccc-ce33-4ac2-a542-dcdca21afea2">
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
          </ct:socket-parameter>
          <ct:socket-parameter name="TypeHMI_Str" type="string" uuid="adeadb65-f699-4f9b-ad0b-af2603be4a4c">
            <attribute type="unit.System.Attributes.InitialValue">
              <property name="value">00010000000000@(object:Attributes.Valve.Type.EnableReasons)@(object:Attributes.Valve.Type.EnableALM)@(object:Attributes.Valve.Cmd.EnableCom_Open)@(object:Attributes.Valve.Cmd.EnableCom_Close)@(object:Attributes.Valve.Cmd.EnableCom_Stop)@(object:Attributes.Valve.Cmd.EnableCom_Auto)@(object:Attributes.Valve.Cmd.EnableCom_Man)@(object:Attributes.Valve.Cmd.EnableCom_RST)@(object:Attributes.Valve.Cmd.EnableCom_Deenerg)000000000110011@(object:Attributes.Valve.State.EnableSt_Deenerg)00@(object:Attributes.Valve.State.EnableSt_ComOpen)@(object:Attributes.Valve.State.EnableSt_ComClose)00000@(object:Attributes.Valve.Mode_other.EnableMode_Remote)@(object:Attributes.Valve.Mode_other.EnableMode_Local)@(object:Attributes.Valve.Mode_other.EnableMode_Auto)@(object:Attributes.Valve.Mode_other.EnableMode_Man)@(object:Attributes.Valve.Mode_other.EnableMode_Block)00000@(object:Attributes.Valve.Mode_other.EnableAnalog_SPT1)@(object:Attributes.Valve.Mode_other.EnableAnalog_SPT2)0000</property>
            </attribute>
          </ct:socket-parameter>
          <ct:socket-parameter name="Sign" type="string" uuid="49f4d858-a667-4e1c-92a6-30a0cc0a359e">
            <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Common.Sign)" />
            <attribute type="unit.System.Attributes.Description" value="@(object:System.Attributes.Description)" />
            <attribute type="Attributes.Attrib.Priority_Display_1000030" value="@(object:Attributes.Common.Priority_Display)" />
            <attribute type="Attributes.Attrib.DescriptionRUS_1000050" value="@(object:Attributes.Common.DescriptionRUS)" />
            <attribute type="Attributes.Attrib.Remote_1000020" value="@(object:Attributes.Common.Remote)" />
            <attribute type="Attributes.Attrib.Group_1000040" value="@(object:Attributes.Common.Group)" />
          </ct:socket-parameter>
        </ct:socket>
        <ct:handler name="Handler" uuid="7c621f65-32f7-4ce9-9775-6574dfb4722d">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:handler name="TU_DE" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.DEENERG = TU.DEENERG;" uuid="be5b040d-1db1-4ee5-911d-fce9bdb59a9c">
          <ct:trigger on="TU.DEENERG" cause="any-change" />
        </ct:handler>
