      <ct:handler name="_TypeHMI_64" uuid="57c64007-57c9-4214-92d0-ec8220b6872c">
        <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
        <ct:trigger on="STATE_HMI" />
        <ct:trigger on="Mode_HMI" />
        <ct:trigger on="STATE.ZLO" />
        <ct:trigger on="STATE.ZLC" />
      </ct:handler>
      <attribute type="Attributes.Electric.Type.EnableRack" value="1" />
      <ct:handler name="_uDP" uuid="584c9101-d420-4961-86b2-34277e9b72e9">
        <ct:trigger on="STATE.ZLP" cause="any-change" />
        <ct:trigger on="STATE.ZLD" cause="any-change" />
        <property name="source-code">Temp_uDP :uint2;

if (Mode.ImitIO)
  {

    if ((STATE.ZLP.Quality &gt;= 192) &amp;&amp; (STATE.ZLD.Quality &gt;= 192))
	  {      
        Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(STATE.ZLD));
	  }

     if ((STATE.ZLP.Quality &gt;= 192) &amp;&amp; (STATE.ZLD.Quality &lt; 192))
	  {      

         Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(!STATE.ZLP));
	   }

      if ((STATE.ZLP.Quality &lt; 192) &amp;&amp; (STATE.ZLD.Quality &gt;= 192))
	   {      

         Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLD)+2*TypeConvert.ToInt4(STATE.ZLD));
	   }
      
       if ((STATE.ZLP.Quality &lt; 192) &amp;&amp; (STATE.ZLD.Quality &lt;192))
	   {      

         Temp_uDP =99;
	   }     
      
   }
else
  {
	
    if ((Reference.ZLP.Quality &gt;= 192) &amp;&amp; (Reference.ZLD.Quality &gt;= 192))
	  {      
        Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(STATE.ZLD));
	  }

     if ((Reference.ZLP.Quality &gt;= 192) &amp;&amp; (Reference.ZLD.Quality &lt; 192))
	  {      

         Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(!STATE.ZLP));
	   }

      if ((Reference.ZLP.Quality &lt; 192) &amp;&amp; (Reference.ZLD.Quality &gt;= 192))
	   {      

         Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLD)+2*TypeConvert.ToInt4(STATE.ZLD));
	   }
      
      if ((Reference.ZLP.Quality &lt; 192) &amp;&amp; (Reference.ZLD.Quality &lt; 192))
	   {      

         Temp_uDP=99;
	   }
      
   }
   
if  ((Temp_uDP&lt;99) &amp;&amp; (Temp_uDP!=STATE.uDP))
	{
	 STATE.uDP=Temp_uDP;
	}
	
if  (Temp_uDP==99)
	{
	 STATE.uDP=Temp_uDP;
	}</property>
      </ct:handler>
