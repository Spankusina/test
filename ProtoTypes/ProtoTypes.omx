      <r:ref name="Reference_Channel_2" type="CIP_Channel" uuid="75adcd9d-196d-4c7a-b887-2e55e7fe9a34" />
      <ct:formula target="Online">
        <property name="source-code">(Reference_Channel_1.ConnectionState || Reference_Channel_2.ConnectionState) &amp;&amp; (Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192)</property>
