  <namespace name="Общие расчёты" uuid="a90f70e6-4cbe-41f7-b2ca-7d929cea626d">
    <ct:type name="Volume" uuid="25d12511-b658-45c9-916e-fde8f25be7f1">
      <ct:parameter name="volume" type="float32" direction="out" uuid="115e377d-87a7-4a4e-aee0-e340812e5fe6" />
      <ct:parameter name="isFirstEntry9125" type="bool" direction="out" uuid="6285a550-96d1-46f3-a686-6f0acf4bef04">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry6100" type="bool" direction="out" uuid="21d02542-c1bf-40a0-a458-cc1c9beba452">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry4075" type="bool" direction="out" uuid="641815d9-c8db-4297-b22b-a1e86c14a799">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry2050" type="bool" direction="out" uuid="493f72cf-9ddd-4961-bd42-fa65521c07cb">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry1025" type="bool" direction="out" uuid="f84dfc07-b7c6-41c2-9d51-65b5199b240e">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry500" type="bool" direction="out" uuid="84f460ba-5857-4605-bcf5-89b424cdaa7f">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry300" type="bool" direction="out" uuid="255ad86b-35cc-4acd-9382-50b99f8a3f9e">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="isFirstEntry100" type="bool" direction="out" uuid="61aca74e-0258-4171-aee9-b8f2cb53b9dd">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="bannerValue" type="string" direction="out" uuid="efe24ae0-1fb6-4653-8bb1-be6dbafd6209" />
      <ct:handler name="Calc_bannerValue" uuid="86f65483-a252-415d-82a4-95e4d2b314b4">
        <ct:trigger on="volume" cause="change" />
        <property name="source-code">if (volume.Quality &gt;= 192)
{
	volume_round: int4 = TypeConvert.ToInt4(Math.Round(volume));
	
	if ((volume_round &gt; 6100) &amp;&amp; (volume_round  &lt; 9125))
	{
		if (isFirstEntry9125)
		{
			bannerValue = "9000";
			isFirstEntry9125 = false;
		}
	}
	else if ((volume_round &gt; 4075) &amp;&amp; (volume_round &lt; 6100))
	{
		if (isFirstEntry6100)
		{
			bannerValue = "6000";
			isFirstEntry6100 = false;
		}
	}
	else if ((volume_round &gt; 2050) &amp;&amp; (volume_round &lt; 4075))
	{
		if (isFirstEntry4075)
		{
			bannerValue = "4000";
			isFirstEntry4075 = false;
		}
	}
	else if ((volume_round &gt; 1025) &amp;&amp; (volume_round &lt; 2050))
	{
		if (isFirstEntry2050)
		{
			bannerValue = "2000";
			isFirstEntry2050 = false;
		}
	}
	else if ((volume_round &gt; 500) &amp;&amp; (volume_round &lt; 1025))
	{
		if (isFirstEntry1025)
		{
			bannerValue = "1000";
			isFirstEntry1025 = false;
		}
	}
	else if ((volume_round &gt; 300) &amp;&amp; (volume_round &lt; 500))
	{
		if (isFirstEntry500)
		{
			bannerValue = "500";
			isFirstEntry500 = false;
		}
	}
	else if ((volume_round &gt; 100) &amp;&amp; (volume_round &lt; 300))
	{
		if (isFirstEntry300)
		{
			bannerValue = "300";
			isFirstEntry300 = false;
		}
	}
	else if ((volume_round &gt; 50) &amp;&amp; (volume_round &lt; 100))
	{
		if (isFirstEntry100)
		{
			bannerValue = "100";
			isFirstEntry100 = false;
		}
	}
	else if (volume_round &lt; 50)
	{
		isFirstEntry9125 = true;
		isFirstEntry6100 = true;
		isFirstEntry4075 = true;
		isFirstEntry2050 = true;
		isFirstEntry1025 = true;
		isFirstEntry500 = true;
		isFirstEntry300 = true;
		isFirstEntry100 = true;
	}
}</property>
      </ct:handler>
      <ct:socket name="Attrib" access-level="public" access-scope="global" direction="none" uuid="ac284108-62fc-45c6-8abd-f7624cc1e86c">
        <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
        <ct:socket-parameter name="EUnitRUS" type="string" uuid="e702d58f-af65-42cc-9ec9-b6350c9790d5">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.System.Attributes.Description" value="Единицы измерения на русском" />
        </ct:socket-parameter>
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
      </ct:socket>
      <attribute type="Attributes.AP.EUnitRUS" value="м³" />
    </ct:type>
    <ct:type name="Flow" uuid="7e1f231c-dc92-4dd9-a781-54c49b7c4c28">
      <ct:handler name="Calc_bannerValue" uuid="ebb07fa5-518b-4133-ad2b-6c0d9e1063c8">
        <property name="source-code">if (flow.Quality &gt;= 192)
{
	if (flow.Value &gt; 0)
	{
		delta: int4 const = 1000;
		rate: int4 = TypeConvert.ToInt4(Math.Round(flow)); //расход округлённый до целого числа 
		cutoff: int4 = currentCutoff; //срез текущего расхода (кратный 1000), т.е. число, определяющее диапазон, в котором сейчас находится расход. Изменение среза происходит при выходе расхда за диапазон (cuttoff - delta; cutoff + delta)
		preCutoff: int4; //придыдущее значение среза расхода
		
		//-------------------------------особые диапазоны: [400; 800), (1100; 1600]
		if (rate &lt; 100) // если расход падает меньше 100, то обнуляем флаг isShownBanner500, чтобы при росте расхода в диапазоне [400; 800) вновь показать банер
		{
			commit isShownBanner500 = false;
		}
		else if (rate &gt;= 2000) // если расход поднимается выше (или равен) 2000, то обнуляем флаг isShownBanner1600, чтобы при падении расхода в диапазоне (1100; 1600] вновь показать банер
				commit isShownBanner1600 = false;
		
		if ((rate &gt;= 400) &amp;&amp; (rate &lt; 800)) //показываем банер при росте и нахождении расхода в диапазоне [400; 800)
		{
			if (!isShownBanner500)
			{
				commit isShownBanner500 = true;
				bannerValue = "500";  //значение будет перезаписано далее в 1000, если при падении попадём в данный диапазон
				if (showAddInfo)
					showAddInfo = false; // признак вывода дополнительной информации
			}
		}
		else if ((rate &gt; 1100) &amp;&amp; (rate &lt;= 1600)) //показываем банер при падении и нахождении расхода в диапазоне (1100; 1600]
			{
				if (!isShownBanner1600)
				{
					isShownBanner1600 = true;
					bannerValue = "1600";
					currentCutoff = 2000; //при падении расхода и нахождении в диапазон (1100; 1600] соответствует срезу 2000
					cutoff = 2000; // таким образом расход не выходит за диапазон (cuttoff - delta; cutoff + delta)
					if (showAddInfo)
						showAddInfo = false; // признак вывода дополнительной информации
				}
			}
		//-------------------------------
		
		//-------------------------------диапазоны 0, 1000, 2000, 3000, 4000, 5000...
		if ((rate &gt;= (cutoff + delta)) || (rate &lt;= (cutoff - delta))) //если расход выходит за диапазон (cuttoff - delta; cutoff + delta) текущего среза
		{
			preCutoff = cutoff; 												// сохраняем предыдущий срез
			cutoff = TypeConvert.ToInt4(Math.Truncate(rate / 1000) * 1000); 	//рассчитываем новый срез
			
			
			if (preCutoff &gt; cutoff)  		//если идёт падение среза расхода, т.е. перезодим в новый диапазон, который ниже предыдущего
			{
				if ((rate % 1000) != 0) //если расход не попадает на границу диапазона
					cutoff = cutoff + 1000; // при падении среза приближаемся к ближайшему верхнему границе
				
				if  (cutoff == 9000) // если расход попадает в диапазон [9000 - delta; 9000 + delta], т.е [8000; 10000]
				{
					addInfo = "снижение до 6000"; 	// дополнительная информация
					showAddInfo = true;				// возводим флаг, определяющий необходимо выводить дополнительную информацию
				}
				else if  (cutoff == 6000) //если расход попадает в диапазон [5000;7000]
				{
					addInfo = "снижение до 1600"; // дополнительная информация
					showAddInfo = true; // возводим флаг, определяющий необходимо выводить дополнительную информацию
				}
				else if (cutoff == 1000) //если расход попадает в диапазон (0;2000]
				{
					if (!isShownBanner1600) // если срез расхода становится 1000, то банер 1600 уже не должен появляться, т.к. уже установилось меньшее значение среза
						isShownBanner1600 = true;
					
					if (!isShownBanner500 &amp;&amp; !(rate &lt;= 100)) // при падениии расхода банер 500 не должен появляться (если не попадаем в диапазон [0;100))
						isShownBanner500 = true;
					
					if (showAddInfo)
						showAddInfo = false;
				}
				else
				{
					if (showAddInfo)
						showAddInfo = false;
				}
				bannerValue = String.ToString(cutoff);

			}
			else //если идёт рост среза расхода, т.е. переходим в новый диапазон, который выше предыдущего
			{
				bannerValue = String.ToString(cutoff);
				if (showAddInfo)
					showAddInfo = false;
			}
			currentCutoff = cutoff; 											//сохраняем текущий срез
		}
		//-------------------------------
	}
	else 
	{
		if ((bannerValue != "0") || (bannerValue.Quality &lt; 192))
		{
			bannerValue = "0";
		}

		if (showAddInfo)
			showAddInfo = false;
		if (isShownBanner500)
			isShownBanner500 = false;
		if (!isShownBanner1600)
			isShownBanner1600 = true;
		if (currentCutoff != 0)
			currentCutoff = 0;
	}
}</property>
        <ct:trigger on="flow" cause="change" />
      </ct:handler>
      <ct:parameter name="flow" type="float32" direction="out" uuid="9f60963c-96c4-4d59-a51e-23fabf6aec24" />
      <ct:parameter name="bannerValue" type="string" direction="out" uuid="ac68c5ed-dd37-42c5-9322-eab8b76101e3">
