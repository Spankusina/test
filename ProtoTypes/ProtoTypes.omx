      <ct:handler name="_TypeHMI_64" uuid="a09cbba1-f2e3-41e0-ab35-25f062abafc7">
        <property name="source-code">Temp_Str: string;

TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     TypeHMI_64=TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
        <ct:trigger on="STATE.ALM" />
      </ct:handler>
