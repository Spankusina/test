          <attribute type="unit.System.Attributes.InitialValue" value="-32768" />
          <attribute type="unit.Server.Attributes.InitialQuality" value="100" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
          <attribute type="unit.Server.Attributes.Replicate" value="@(object:Attributes.AP.LL_alarm_check)" />
          <attribute type="unit.Server.History.Set.DatabaseSettings">
            <property name="value">Enable="@(object:Attributes.AP.LL_alarm_check)" AppendServerTime="False"</property>
          </attribute>
        </ct:socket-parameter>
      </ct:socket>
      <ct:socket name="Calc_alm" access-level="public" access-scope="global" direction="out" uuid="cb8f56f9-797c-4a6e-a6e1-5b4dfa8a183b">
        <ct:socket-parameter name="AHH" type="bool" uuid="209e96e4-9d68-4d14-83ab-7a4d4c991f6a">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS).  выше аварийного высокого значения</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" выше аварийного высокого значения","Severity":"51","Type":"On"},{"AckStrategy":0,"IsGenerateEqualSubcondition":false,"Message":" ниже аварийного высокого значения","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="false" />
