        <attribute type="unit.System.Attributes.Comment" value="1 -синхронизировано, 2 - не синхронизировано, 0 -нет связи" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Синхронизировано","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Не синхронизировано","Severity":"52","Type":"Enumeration","Value":2}],"Type":"Enumeration"}}</property>
        </attribute>
      </ct:parameter>
      <ct:parameter name="ConnectServer" type="uint8" direction="out" uuid="8d91bad1-b4ac-4325-9642-9077810940b6">
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.System.Attributes.Comment" value="0 - нет связи с OPC сервером, 1 - есть связь с OPC сервером" />
