          <property name="source-code">Name_Msg.Messages.Selected.Message = String.Insert(Name_Msg.Messages.Selected.Message, String.IndexOf(Name_Msg.Messages.Selected.Message, "Ученик") + 6, String.Concat(" ", Name.Value));</property>
        </ct:handler>
        <ct:bind source="TU.Ready" target="TU_trigger_reset_bool" />
        <ct:bind source="TU.UnReady" target="TU_trigger_reset_bool" />
