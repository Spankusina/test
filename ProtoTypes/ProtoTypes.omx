          </attribute>
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" ниже аварийного низкого значения","Severity":"51","Type":"On"},{"AckStrategy":0,"IsGenerateEqualSubcondition":false,"Message":" выше аварийного низкого значения","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="false" />
