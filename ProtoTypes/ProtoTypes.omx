        <ct:handler name="_Mode_HMI" uuid="102a7b74-17ab-4036-9b8f-7d1de16b6113">
          <property name="source-code">current: uint2 = Mode_HMI;



current = Math.SetBit(current, 14, Mode.ImitIO.Value);

current = Math.SetBit(current, 15, true);

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="baabd22b-5dbc-4d4a-a98c-b40e43e2587d">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
        current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));
	}

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	{      
		current = Math.SetBit(current, 0, STATE.ZLO.Value );
        current = Math.SetBit(current, 1, !STATE.ZLO.Value);
	}

if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 0, !STATE.ZLC.Value);
        current = Math.SetBit(current, 1, STATE.ZLC.Value );
	}

if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	{      
		current = Math.SetBit(current, 0, false);
        current = Math.SetBit(current, 1, false );
	}

current = Math.SetBit(current, 4, STATE.ZLOC.Value);
current = Math.SetBit(current, 5, STATE.ZLerr.Value);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        </ct:handler>
        <ct:handler name="Handler" uuid="d5504281-fd00-40af-be99-5ca761eabbd2">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:handler name="_uZL" uuid="9b67e829-06e3-4e66-a75f-6fbb55b94a91">
          <ct:trigger on="STATE.ZLO" cause="change" />
          <ct:trigger on="STATE.ZLC" cause="change" />
          <property name="source-code">if (Mode.ImitIO)
  {

    if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	  {      
        STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLO.Quality &lt; 192))
	  {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	   {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }
      
   }
else
  {
	
    if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	  {      
        STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &lt; 192))
	  {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((Reference.ZLO.Quality &lt; 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	   {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }	
	
   }</property>
        </ct:handler>
        <ct:handler name="_ZLOC_ZLerr" uuid="221cc8a8-a12a-4aaf-81b4-0233a184b08f">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.uZL" cause="any-change" />
          <property name="source-code">if (!Mode.ImitIO)
{

	
    if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	  {      
	    STATE.ZLOC = !Reference.ZLO&amp;&amp;!Reference.ZLC;
	    STATE.ZLerr = Reference.ZLO&amp;&amp;Reference.ZLC;
	  } 
    
	else
		
	{	
	    STATE.ZLOC = false;
	    STATE.ZLerr = false;
	
	}
}
else
	
{

	
	
    if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	  {      
	    STATE.ZLOC = !STATE.ZLO&amp;&amp;!STATE.ZLC;
	    STATE.ZLerr = STATE.ZLO&amp;&amp;STATE.ZLC;
	  } 	
	
	else
		
	 {
      	STATE.ZLOC = false;
	    STATE.ZLerr = false;     

     }		
	
}</property>
        </ct:handler>
