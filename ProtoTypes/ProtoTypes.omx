        <ct:parameter name="DEENERG_Answer" type="int8" direction="out" uuid="326ef95a-30f1-440d-8c91-b752c4192c63">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="TU.DEENERG.Answer" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"Message":". Обесточить задвижку. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"Message":". Обесточить задвижку. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"Message":". Обесточить задвижку. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"Message":". Обесточить задвижку. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
        </ct:parameter>
        <ct:parameter name="XSP" type="bool" direction="out" uuid="1500e146-a4d6-40f0-8cc8-d4f7cf22b0f0">
          <attribute type="unit.System.Attributes.InitialValue" value="false" />
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Подается команда отключить питание</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Подается команда отключить питание","Severity":"104","Type":"On"},{"AckStrategy":0,"IsGenerateEqualSubcondition":false,"Message":". Подается команда отключить питание. Сигнал снят","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE.XSP" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <attribute type="unit.Server.Attributes.History" />
          <attribute type="Attributes.Type_Events" value="PLC_EQ" />
        </ct:parameter>
        <ct:bind source="Reference_DE.DEENERG" target="DEENERG_Answer" action="delivery_status" />
        <ct:formula target="XSP" source-code="(Mode.ImitIO)?(XSP):(Reference_DE.XSP)" />
        <ct:handler name="_STATE_HMI_XSP" uuid="d13ae0b6-8f1e-4ef8-99a4-56899ebc206a">
          <ct:trigger on="XSP" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 7, XSP.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference_DE.XSP.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        </ct:handler>
