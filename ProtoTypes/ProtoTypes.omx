          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Местный''","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Дистанционный''","Severity":"154","Type":"Off"}],"Type":"Discrete"}}</property>
