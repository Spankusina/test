        <ct:handler name="_STATE_HMI" uuid="581e2129-4443-46af-bc0e-db8c5833b5de">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

if (STATE.ZLC.Quality &gt;= 192)
	{      
         current = Math.SetBit(current, 0, STATE.ZLO.Value);
         current = Math.SetBit(current, 1, STATE.ZLC.Value);

	}

if (STATE.ZLO.Quality &lt; 192)
	{      
         current = Math.SetBit(current, 0, false);
         current = Math.SetBit(current, 1, false);
	}



if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if (Reference.ZLC.Quality &gt;= 192)
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="6311de47-33fc-4c78-a907-78ba91f6f128">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

current = Math.SetBit(current, 15, true);

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="8f42ea05-d534-45c1-a5fc-ccf4d4ff438a">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="a0aa6657-c8bf-4ef9-be38-07d85dfbea3f">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_uZL" uuid="55072ab4-1c1c-4570-829a-3409861afc27">
          <ct:trigger on="STATE.ZLO" cause="change" />
          <ct:trigger on="STATE.ZLC" cause="change" />
          <property name="source-code">Temp_uZL :uint2;

if (Mode.ImitIO)
  {

    if (STATE.ZLC.Quality &gt;= 192)
	  {      
        Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }
      
       if (STATE.ZLC.Quality &lt;192)
	   {      

         Temp_uZL =99;
	   }     
      
   }
else
  {
	
    if (Reference.ZLC.Quality &gt;= 192)
	  {      
        Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }
      
      if (Reference.ZLC.Quality &lt; 192)
	   {      

         Temp_uZL=99;
	   }
      
   }
   
if  ((Temp_uZL&lt;99) &amp;&amp; (Temp_uZL!=STATE.uZL))
	{
	 STATE.uZL=Temp_uZL;
	}
	
if  (Temp_uZL==99)
	{
	 STATE.uZL=Temp_uZL;
	}</property>
        </ct:handler>
        <ct:handler name="_TypeHMI_64" uuid="5341a8ca-0881-43a4-9498-c09a4e98c7cc">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
          <ct:trigger on="STATE.ZLO" />
          <ct:trigger on="STATE.ZLC" />
        </ct:handler>
