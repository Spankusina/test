        <attribute type="Attributes.Common.DescriptionRUS" value="Задвижка XV-001" />
        <attribute type="Attributes.Common.Group" value="M0040_D" />
        <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
        <attribute type="Attributes.Common.Remote" value="No_signal" />
