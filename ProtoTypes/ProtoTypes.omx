        </ct:socket-parameter>
        <ct:socket-parameter name="SP_AH" type="float32" uuid="89b7bcc6-f6b1-41a9-963e-c49819bf4503">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Уставка высокого значения</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.H_Limit)" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
        </ct:socket-parameter>
        <ct:socket-parameter name="SP_AL" type="float32" uuid="d4027504-1cdf-4bf3-9e4f-317381a50b5e">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Уставка низкого значения</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.L_Limit)" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
        </ct:socket-parameter>
        <ct:socket-parameter name="SP_ALL" type="float32" uuid="4b81223f-bf55-41c7-a414-955f398d6ee3">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Уставка аварийного низкого значения</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.LL_Limit)" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
        </ct:socket-parameter>
      </ct:socket>
      <ct:handler name="CalcAlarm" access-level="public" uuid="32de41cf-06d6-49db-9b84-31cb4f4da24f">
        <ct:trigger on="Mode.alm_oper_H" cause="any-change" />
        <ct:trigger on="Mode.alm_HH" cause="any-change" />
        <ct:trigger on="Mode.alm_H" cause="any-change" />
        <ct:trigger on="Mode.alm_LL" cause="any-change" />
        <ct:trigger on="Mode.alm_L" cause="any-change" />
        <ct:trigger on="Mode.alm_oper_L" cause="any-change" />
        <ct:trigger on="OutPreset.Oper_SP_LO" cause="any-change" />
        <ct:trigger on="OutPreset.Oper_SP_HI" cause="any-change" />
        <ct:trigger on="OutPreset.SP_AHH" cause="any-change" />
        <ct:trigger on="OutPreset.SP_AL" cause="any-change" />
        <ct:trigger on="OutPreset.SP_AH" cause="any-change" />
        <ct:trigger on="OutPreset.SP_ALL" cause="any-change" />
        <ct:trigger on="PLC_Preset.SP_AHH" cause="any-change" />
        <ct:trigger on="PLC_Preset.SP_AH" cause="any-change" />
        <ct:trigger on="PLC_Preset.SP_AL" cause="any-change" />
        <ct:trigger on="PLC_Preset.SP_ALL" cause="any-change" />
        <property name="source-code">SP_AHH         :float;
SP_AH          :float;
SP_AL          :float;  
SP_ALL         :float;
Eng_val        :float;

SP_AHH_st      :bool;
SP_AH_st       :bool;
SP_AL_st       :bool;  
SP_ALL_st      :bool;

Calc_alm_AHH_local	: bool =Calc_alm.AHH;
Calc_alm_AH_local	: bool =Calc_alm.AH ;
Calc_alm_AL_local	: bool =Calc_alm.AL ;
Calc_alm_ALL_local	: bool = Calc_alm.ALL;
Oper_Alm_Oper_HI_local :bool = Oper_Alm.Oper_HI;
Oper_Alm_Oper_LO_local :bool = Oper_Alm.Oper_LO;







//////////////////// custominfo
custominfo	:uint8;
Val_local	:float;
Val_Quality_local	:uint4;


Eng_val=OutPreset.Min_EGU+(Reference.PV-OutPreset.Min_raw)*(OutPreset.Max_EGU-OutPreset.Min_EGU)/(OutPreset.Max_raw-OutPreset.Min_raw);   

	
	
if (Mode.ImitIO)
   {
		
	  Val_local =Imit_val;
	  Val_Quality_local=Imit_val.Quality;
   }
	  	
else
    {
	  
	  		Val_local =Eng_val;
	  		Val_Quality_local=Eng_val.Quality; 
	  	
	}


/////////////////////////////////////////////////////////



//Выбираем ставки с учетом качества 
if (Mode.use_plc_HH)
 {
   if (PLC_Preset.SP_AHH.Quality &gt;= 192)
    {	
	 SP_AHH_st=true;
     SP_AHH=PLC_Preset.SP_AHH;
    }
   else
    {
      	 SP_AHH_st=false;

     }   	
 }

if (Mode.use_plc_H)
 {
   if (PLC_Preset.SP_AH.Quality &gt;= 192)
    {	
	 SP_AH_st=true;
     SP_AH=PLC_Preset.SP_AH;
    }
   else
    {
      	 SP_AH_st=false;

     }   	
 }

if (Mode.use_plc_L)
 {
   if (PLC_Preset.SP_AL.Quality &gt;= 192)
    {	
	 SP_AL_st=true;
     SP_AL=PLC_Preset.SP_AL;
    }
   else
    {
      	 SP_AL_st=false;

     }   	
 }

if (Mode.use_plc_LL)
 {
   if (PLC_Preset.SP_ALL.Quality &gt;= 192)
    {  
   SP_ALL_st=true;
     SP_ALL=PLC_Preset.SP_ALL;
    }
   else
    {
         SP_ALL_st=false;

     }     
 }

if (!Mode.use_plc_HH)
 {	
     SP_AHH=OutPreset.SP_AHH;
     SP_AHH_st=true;     
 }

if (!Mode.use_plc_H)
 {	
     SP_AH=OutPreset.SP_AH;
     SP_AH_st=true;     
 }


if (!Mode.use_plc_L)
 {	
     SP_AL=OutPreset.SP_AL; 
     SP_AL_st=true;     
 }

if (!Mode.use_plc_LL)
 {	
     SP_ALL=OutPreset.SP_ALL;
     SP_ALL_st=true;
 }



//Формирование сигнализации по уставкам
if (Val_Quality_local &gt;= 192)
  {
	if  (Mode.alm_HH &amp;&amp; SP_AHH_st)
	  { //Аварийно высокий уровень
		if (Val_local&gt;=SP_AHH)
		  {
			Calc_alm_AHH_local=true;
			Calc_alm_AH_local=false;
				custominfo=1;
		  }
		if (Val_local&lt;(SP_AHH-OutPreset.Alarm_Deadband))
		  {
			Calc_alm_AHH_local=false;
		  }
	   }
	else
       {
	 	Calc_alm_AHH_local=false;
	
	   }
    if  (Mode.alm_LL &amp;&amp; SP_ALL_st)
      {	
        //Аварийно низкий уровень
		if (Val_local&lt;=SP_ALL)
		  {
			Calc_alm_ALL_local=true;
			Calc_alm_AL_local=false;
				custominfo=1;
		  }
		if (Val_local&gt;(SP_ALL+OutPreset.Alarm_Deadband))
		  {
			Calc_alm_ALL_local=false;
		  }		
		
		}
	
	 else
       {

	    Calc_alm_ALL_local=false;	
	   }
 	
   }
   


if (Val_Quality_local &gt;= 192)
  {
	if  (Mode.alm_H &amp;&amp; SP_AH_st)
	  { //Предупредительно высокий уровень
		if ((Val_local&gt;=SP_AH) &amp;&amp; !Calc_alm_AHH_local)
		  {
			Calc_alm_AH_local=true;
				custominfo=101;
		  }
		if (Val_local&lt;(SP_AH-OutPreset.Alarm_Deadband))
		  {
			Calc_alm_AH_local=false;
		  }
	  }
    else
       {
	 	Calc_alm_AH_local=false;	
	   }

   	if  (Mode.alm_L &amp;&amp; SP_AL_st)
     {
        //Предупредительно низкий уровень
		if ((Val_local&lt;=SP_AL) &amp;&amp; !Calc_alm_ALL_local)
		  {
			Calc_alm_AL_local=true;
				custominfo=101;
		  }
		if (Val_local&gt;(SP_AL+OutPreset.Alarm_Deadband))
		  {
			Calc_alm_AL_local=false;
		  }		
		
		}
	
	 else
       {
	    Calc_alm_AL_local=false;	
	   }
 	
   }
   
//сбрасываем custominfo
if (!Calc_alm_AHH_local &amp;&amp;!Calc_alm_AH_local &amp;&amp; !Calc_alm_AL_local &amp;&amp; !Calc_alm_ALL_local)
	{
	custominfo = 11;
	}
   
 //формирование сработок по уставкам оператора  
 if (Val_Quality_local &gt;= 192)
  {
	if  (Mode.alm_oper_H)
	  { // высокий уровень
		if (Val_local&gt;=OutPreset.Oper_SP_HI)
		  {
			// if (!Oper_Alm.Oper_HI)
			 //	{
			 //	 Calc_alm.Kvit=true;
			 //	}
			 Oper_Alm_Oper_HI_local=true;
		  }
		if (Val_local&lt;(OutPreset.Oper_SP_HI-OutPreset.Alarm_Deadband))
		  {
			Oper_Alm_Oper_HI_local=false;
		  }
		
	  }
	 else
       {
	 	Oper_Alm_Oper_HI_local=false;
	   }
 	
   }
     
   
 //формирование сработок по уставкам оператора  
 if (Val_Quality_local &gt;= 192)
  {
	if  (Mode.alm_oper_L)
       { //Пнизкий уровень
		if (Val_local&lt;=OutPreset.Oper_SP_LO)
		  {
			//if (!Oper_Alm.Oper_LO)
			// 	{
			// 	 Calc_alm.Kvit=true;
			// 	}
			
			Oper_Alm_Oper_LO_local=true;
		  }
		if (Val_local&gt;(OutPreset.Oper_SP_LO+OutPreset.Alarm_Deadband))
		  {
			Oper_Alm_Oper_LO_local=false;
		  }		
		
		}
	
	 else
       {

	    Oper_Alm_Oper_LO_local=false;	
	   }
 	
   }
 
 if (!Mode.ImitIO)
   {
	
	 
	  		Val=VQTC (Eng_val.Value,Eng_val.Quality, Eng_val.Timestamp, custominfo);
	  	//Val =Eng_val;
	  	//	Imit_val=Eng_val;
	}
 Calc_alm.AHH=Calc_alm_AHH_local;
 Calc_alm.AH=Calc_alm_AH_local;
 Calc_alm.AL=Calc_alm_AL_local;
 Calc_alm.ALL=Calc_alm_ALL_local;
 Oper_Alm.Oper_HI=Oper_Alm_Oper_HI_local;
 Oper_Alm.Oper_LO=Oper_Alm_Oper_LO_local;</property>
        <ct:trigger on="Reference.PV" cause="any-change" />
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
        <ct:trigger on="Imit_val" cause="any-change" />
      </ct:handler>
      <ct:parameter name="Imit_val" access-level="public" access-scope="global" direction="out" type="float32" uuid="53737758-f75a-43d5-99e2-bed2c1afd83b">
        <attribute type="unit.System.Attributes.Description">
          <property name="value">@(*object:Attributes.Common.DescriptionRUS). Введенное оператором значение</property>
        </attribute>
        <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
      </ct:parameter>
      <ct:parameter name="Val" access-level="public" access-scope="global" direction="out" type="float32" uuid="dcf48216-0384-4afe-8de3-9124b3f6aae8">
        <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS)" />
        <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
        <attribute type="unit.Server.Attributes.History">
          <property name="value">Deadband="@(object:Attributes.История.DeadBandValue)" MinTime="@(object:Attributes.История.DeadBandTime)" ServerTime="True"</property>
        </attribute>
        <attribute type="unit.Server.History.Set.DatabaseSettings">
          <property name="value">Enable="@(object:Attributes.История.SaveValueInHistory)" AppendServerTime="False"</property>
        </attribute>
      </ct:parameter>
      <ct:handler name="In_cmd" access-level="public" uuid="769f5652-7ed5-4c82-be1c-222d288b9170">
        <ct:trigger on="Cmd" cause="update" />
        <property name="source-code">//cmd
//1-включить/отключить тревоги оператора верхние
//2-включить/отключить тревоги аварийно высокого уровня
//3-включить/отключить тревоги высокого уровня
//4-установить реальный режим
//5-установить режим ручного ввода
//6-подтвердить ввод в ручном режиме
//7-подтвердить ввод инжерных параметров
//8-подтвердить ввод низких/высоких уставок оператора
//9-включить/отключить режим пересчета с по инженерным пределам
//10-включить/отключить тревоги аварийно низкого уровня
//11-включить/отключить тревоги низкого уровня
//12-включить/отключить тревоги оператора верхние

//1-включить/отключить тревоги оператора высокие
if (Cmd==1) 
	
   {	
    Mode.alm_oper_H=!Mode.alm_oper_H;
   }

//2-включить/отключить тревоги аварийно высокого/низкого уровня
if (Cmd==2) 
	
   {	
    Mode.alm_HH=!Mode.alm_HH;
   }
//3-включить/отключить тревоги высокого/низкого уровня
if (Cmd==3) 
	
   {	
    Mode.alm_H=!Mode.alm_H;
   }
//4-установить реальный режим
//if (Cmd==4) 
	
 //  {	
 //   Mode.man_mode=false;
 //  }
   
//5-установить режим ручного ввода
//if (Cmd==5) 
	
  // {	
  //  Mode.man_mode=true;
   //}

//6-подтвердить ввод в ручном режиме

//if (Cmd==6) 
	
 //  {	
 //   OutPreset.Man_Val=Input_Preset.Man_Val_wValue;
 //   Imit_val=OutPreset.Man_Val;
    
 //   if (Mode.man_mode)
//	  	{
    	   	
 //   	    Imit_val=(Imit_val&gt;OutPreset.Max_EGU)?(OutPreset.Max_EGU):(Imit_val);
//    	    Imit_val=(Imit_val&lt;OutPreset.Min_EGU)?(OutPreset.Min_EGU):(Imit_val);
  //          Val =Imit_val;
//	  	}
//   }

//7-подтвердить ввод инжерных параметров

//if (Cmd==7) 
	
//   {	
//    OutPreset.Alarm_Deadband=Input_Preset.Alarm_Deadband_wValue;
    //OutPreset.Max_EGU=Input_Preset.Max_EGU_wValue;
    // OutPreset.Min_EGU=Input_Preset.Min_EGU_wValue;
    //OutPreset.Max_raw=Input_Preset.Max_raw_wValue;
    //OutPreset.Min_raw=Input_Preset.Min_raw_wValue;
    //OutPreset.SP_AH=Input_Preset.SP_AH_wValue;
    //OutPreset.SP_AHH=Input_Preset.SP_AHH_wValue;
    //OutPreset.SP_AL=Input_Preset.SP_AL_wValue;
    //OutPreset.SP_ALL=Input_Preset.SP_ALL_wValue;
//   }

//8-подтвердить ввод низких/высоких уставок оператора
//if (Cmd==8) 
	
//   {	

//    OutPreset.Oper_SP_HI=Input_Preset.Oper_SP_HI_wValue;
//    OutPreset.Oper_SP_LO=Input_Preset.Oper_SP_LO_wValue;

//  }

	
//9-включить/отключить режим пересчета с по инженерным пределам

//2-включить/отключить тревоги аварийно низкого уровня
if (Cmd==10) 
	
   {	
    Mode.alm_LL=!Mode.alm_LL;
   }
//3-включить/отключить тревоги низкого уровня
if (Cmd==11) 
	
   {	
    Mode.alm_L=!Mode.alm_L;
   }
//12-включить/отключить тревоги оператора низкие
if (Cmd==12) 
	
   {	
    Mode.alm_oper_L=!Mode.alm_oper_L;
   }</property>
