              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Сбой режима","Severity":"151","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Режим ''Дистанционный''","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Режим ''Местный''","Severity":"104","Type":"Enumeration","Value":2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Сбой режима","Severity":"151","Type":"Enumeration","Value":3}],"Type":"Enumeration"}}</property>
            </attribute>
