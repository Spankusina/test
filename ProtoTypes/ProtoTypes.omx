      <ct:handler name="_STATE_HMI_XSP" uuid="eb088541-946b-45d0-8b05-62a7c6cd9b26">
        <ct:trigger on="STATE_2.XSP" cause="any-change" />
        <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 6, STATE_2.XSP.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference.OPENING.Quality &gt;= 192) || (Reference.CLOSING.Quality &gt;= 192) || (Reference.MDDL.Quality &gt;= 192) || (Reference.ERROR.Quality &gt;= 192) || (Reference.XSP.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
      </ct:handler>
      <ct:formula target="SPT1" source-code="(Mode.ImitIO)?(SPT1):(Reference.SPT1)" />
