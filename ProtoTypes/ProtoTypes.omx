        <ct:formula target="ALM_PROG.VAH.On" source-code="(Mode.ImitIO)?(ALM_PROG.VAH.On):(Reference.VAH)" />
        <ct:formula target="ALM_PROG.TAH.On" source-code="(Mode.ImitIO)?(ALM_PROG.TAH.On):(Reference.TAH)" />
        <ct:formula target="ALM_PROG.UAE.On" source-code="(Mode.ImitIO)?(ALM_PROG.UAE.On):(Reference.UAE)" />
        <ct:formula target="ALM_PROG.UAA.On" source-code="(Mode.ImitIO)?(ALM_PROG.UAA.On):(Reference.UAA)" />
        <ct:formula target="ALM_PROG.BTAE.On" source-code="(Mode.ImitIO)?(ALM_PROG.BTAE.On):(Reference.BTAE)" />
