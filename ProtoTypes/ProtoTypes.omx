        <ct:bind source="Reference.HSX" target="TU_Answer.HSX_Answer" action="delivery_status" />
        <ct:formula target="Mode.XLL">
          <property name="source-code">(Mode.ImitIO)?(Mode.XLL):((Two_LR_bit)?(Reference.XLL):(!Reference.XLR))</property>
        </ct:formula>
        <ct:handler name="_Mode_HMI" uuid="3620530c-76c6-4676-b074-30eb0857ea00">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, Mode.XLR.Value);
current = Math.SetBit(current, 1, Mode.XLL.Value);
current = Math.SetBit(current, 2, Mode.XSP.Value);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 9, Mode.XSA.Value);
current = Math.SetBit(current, 10, Mode.XSM.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192) || (Reference.XSP.Quality &gt;= 192) || (Reference.XSS.Quality &gt;= 192) || (Reference.XSA.Quality &gt;= 192) || (Reference.XSM.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="update" />
          <ct:trigger on="Mode.XSS" cause="update" />
          <ct:trigger on="Mode.XLR" cause="update" />
          <ct:trigger on="Mode.XSA" cause="update" />
          <ct:trigger on="Mode.XLL" cause="update" />
          <ct:trigger on="Mode.XSM" cause="update" />
          <ct:trigger on="Mode.XSP" cause="update" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="01c730d0-84d2-4b5f-ab96-13a5446ac461">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XL.Value);
current = Math.SetBit(current, 2, STATE.UAA.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XL.Quality &gt;= 192) || (Reference.UAA.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XL" cause="any-change" />
          <ct:trigger on="STATE.UAA" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="a19e19c9-ad32-4c8b-8423-8b11ab70174e">
