        <ct:handler name="_uZL" uuid="d8e701a5-960e-40d5-a5ff-16fd35dfd79c">
          <ct:trigger on="STATE.ZLO" cause="change" />
          <ct:trigger on="STATE.ZLC" cause="change" />
          <property name="source-code">if (Mode.ImitIO)
  {

    if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	  {      
        STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	  {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	   {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }
      
   }
else
  {
	
    if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	  {      
        STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &lt; 192))
	  {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((Reference.ZLO.Quality &lt; 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	   {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }	
	
   }</property>
        </ct:handler>
        <ct:handler name="_uRL" uuid="c6d07a26-cd3f-4fbd-8350-3233fd124b12">
          <property name="source-code">if (Mode.ImitIO)
  {

    if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL .Quality&gt;= 192))
	  {      
         Mode.uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL));
	  }

    if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL .Quality&lt; 192))
	  {      

         Mode.uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(!Mode.XLR));
	  }

   if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL .Quality&gt;= 192))
	  {      

         Mode.uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(!Mode.XLL)+2*TypeConvert.ToInt4(Mode.XLL));
	  }
    }
else
 
  {

    if ((Reference.XLR.Quality &gt;= 192) &amp;&amp; (Reference.XLL .Quality&gt;= 192))
	  {      
         Mode.uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL));
	  }

    if ((Reference.XLR.Quality &gt;= 192) &amp;&amp; (Reference.XLL .Quality&lt; 192))
	  {      

         Mode.uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(!Mode.XLR));
	  }

   if ((Reference.XLR.Quality &lt; 192) &amp;&amp; (Reference.XLL .Quality&gt;= 192))
	  {      

         Mode.uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(!Mode.XLL)+2*TypeConvert.ToInt4(Mode.XLL));
	  }
 }</property>
          <ct:trigger on="Mode.XLR" cause="change" />
          <ct:trigger on="Mode.XLL" cause="change" />
