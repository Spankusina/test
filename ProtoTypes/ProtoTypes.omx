   {
      SP_AH=PLC_Preset.SP_AH.Value;	
   }
 
 else
 	
 {
    SP_AH=OutPreset.SP_AH.Value;	
 }









Calc_alm.AH.Messages.Selected.Message = Calc_alm.AH.Messages.Selected.Message+". Tекущее значение "+  String.ToString("%.2f", Math.Round(Val,2))+ " " + Attrib.EUnitRUS.Value + " (текущая уставка: " + String.ToString("%.2f", Math.Round(SP_AH.Value, 2)) + " " + Attrib.EUnitRUS.Value + ")";</property>
      </ct:handler>
