	{
		//AP4.Off_group_cmd_LO = true;
		Ref_AP4.Mode.alm_oper_L = false;
	}
	
	if (Ref_AP4.Mode.alm_oper_H)
	{
		//AP4.Off_group_cmd_HI = true;
		Ref_AP4.Mode.alm_oper_H = false;
	}

	if (Ref_AP5.Mode.alm_oper_L)
	{
		//AP5.Off_group_cmd_LO = true;
		Ref_AP5.Mode.alm_oper_L = false;
	}
	
	if (Ref_AP5.Mode.alm_oper_H)
	{
		//AP5.Off_group_cmd_HI = true;
		Ref_AP5.Mode.alm_oper_H = false;
	}
}</property>
