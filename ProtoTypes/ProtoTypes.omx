      <attribute type="unit.System.Attributes.Description" />
      <ct:handler name="_On_Msg" uuid="c1cc6075-4472-440f-930a-4c71005921f9">
        <ct:trigger on="On" cause="change" />
        <property name="source-code">if ((On.Quality &gt;= 192) &amp;&amp; !On.Value)
{
	On_Msg = "&lt;Subcondition Type='Dynamic' Message='. Сигнал снят' Severity='104' Enabled='1' SoundEnabled='0' AckRequired='0'/&gt;";
}</property>
      </ct:handler>
