   }
else
  {
	
    if ((Reference.ZLP.Quality &gt;= 192) &amp;&amp; (Reference.ZLD.Quality &gt;= 192))
	  {      
        Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(STATE.ZLD));
	  }

     if ((Reference.ZLP.Quality &gt;= 192) &amp;&amp; (Reference.ZLD.Quality &lt; 192))
	  {      

         Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLP)+2*TypeConvert.ToInt4(!STATE.ZLP));
	   }

      if ((Reference.ZLP.Quality &lt; 192) &amp;&amp; (Reference.ZLD.Quality &gt;= 192))
	   {      

         Temp_uDP=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLD)+2*TypeConvert.ToInt4(STATE.ZLD));
	   }
      
      if ((Reference.ZLP.Quality &lt; 192) &amp;&amp; (Reference.ZLD.Quality &lt; 192))
	   {      

         Temp_uDP=99;
	   }
      
   }
   
if  ((Temp_uDP&lt;99) &amp;&amp; (Temp_uDP!=STATE.uDP))
	{
	 STATE.uDP=Temp_uDP;
	}
	
if  (Temp_uDP==99)
	{
	 STATE.uDP=Temp_uDP;
	}</property>
      </ct:handler>
