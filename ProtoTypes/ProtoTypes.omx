            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Режим ''Автоматический''. Команда не доставлена. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Режим ''Автоматический''. Команда не доставлена. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Режим ''Автоматический''. Команда не доставлена. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Режим ''Автоматический''. Команда не доставлена. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
        </ct:socket-parameter>
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="TU" />
      </ct:socket>
      <ct:bind source="Reference.HSC" target="TU_Answer.HSC_Answer" action="delivery_status" />
      <ct:bind source="Reference.HSO" target="TU_Answer.HSO_Answer" action="delivery_status" />
      <ct:bind source="Reference.TRIP" target="TU_Answer.TRIP_Answer" action="delivery_status" />
      <ct:bind source="TU.HSO_tu" target="Reference.HSO" />
      <ct:bind source="TU.HSC_tu" target="Reference.HSC" />
      <ct:bind source="TU.TRIP_tu" target="Reference.TRIP" />
      <ct:handler name="_STATE_HMI" uuid="72963c40-2ef1-435e-a68a-c6ebae730b36">
        <ct:trigger on="STATE.ZLO" cause="any-change" />
        <ct:trigger on="STATE.ZLC" cause="any-change" />
        <ct:trigger on="STATE.TRIPPED" cause="any-change" />
        <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.ZLO.Value);
current = Math.SetBit(current, 1, STATE.ZLC.Value);




current = Math.SetBit(current, 3, STATE.TRIPPED.Value);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference.TRIPPED.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
      </ct:handler>
      <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="8ec094b8-d25e-464b-bd16-82452f142a28">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
        <attribute type="unit.System.Attributes.InitialValue" value="0" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.History" />
      </ct:parameter>
      <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="f6d24f31-8a4e-438f-bc41-2a4b8f5bf82a">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
        <attribute type="unit.System.Attributes.InitialValue" value="0" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.History" />
      </ct:parameter>
      <ct:handler name="_Mode_HMI" uuid="923bd4a4-75f1-446a-abfe-a8f1cb9c1177">
        <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 14, Mode.ImitIO.Value);
current = Math.SetBit(current, 9, Mode.XSA.Value);
current = Math.SetBit(current, 10, !Mode.XSA.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XSA.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
        <ct:trigger on="Mode.XSA" cause="any-change" />
      </ct:handler>
      <attribute type="Attributes.Electric.Open_Close" value="true" />
      <ct:formula target="Mode.XSA" source-code="(Mode.ImitIO)?(Mode.XSA):(Reference.XSA)" />
      <attribute type="Attributes.Common.Type_HMI" value="7" />
      <ct:handler name="_TypeHMI_64" uuid="887697d3-e5bc-458e-b308-c39294ecfd2c">
        <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
        <ct:trigger on="STATE_HMI" />
        <ct:trigger on="Mode_HMI" />
        <ct:trigger on="STATE.ZLO" />
        <ct:trigger on="STATE.ZLC" />
      </ct:handler>
