      <ct:formula target="STATE.ZLO" source-code="(Mode.ImitIO)?(STATE.ZLO):(!Reference.ZLC)" />
      <ct:handler name="_STATE_HMI" uuid="ea0ecd52-76df-4234-acf9-6137b2bde039">
        <ct:trigger on="STATE.ZLO" cause="any-change" />
        <ct:trigger on="STATE.ZLC" cause="any-change" />
        <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.ZLO.Value);
current = Math.SetBit(current, 1, STATE.ZLC.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
      </ct:handler>
      <ct:handler name="_Mode_HMI" uuid="85a2e0f2-046a-44ac-8bcc-a12b4f68574e">
        <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

current = Math.SetBit(current, 15, true);

Mode_HMI = current;</property>
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
      </ct:handler>
