        <ct:handler name="Handler" uuid="e5b3af2a-cf39-4643-909d-787eeb5508e6">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="9921fd18-e590-4fe3-a61c-8cd4114f07ac">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, !Mode.XLR.Value);
current = Math.SetBit(current, 1, Mode.XLR.Value);


current = Math.SetBit(current, 5, Mode.ZLP.Value);

current = Math.SetBit(current, 9, Mode.AUT.Value);
current = Math.SetBit(current, 10, !Mode.AUT.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.AUT.Quality &gt;= 192) ||(Reference.XLR.Quality &gt;= 192) ||(Reference.ZLP.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.ZLP" cause="any-change" />
          <ct:trigger on="Mode.AUT" cause="any-change" />
          <ct:trigger on="Mode.XLR" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="289e0b04-dae0-4b06-a84d-39ff41bbdf04">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="5fa48a8e-dba1-46d3-bace-2a4c0a6e740e">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="a66ed467-9db7-436a-a732-c2f9387daee5">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.RUN.Value);
current = Math.SetBit(current, 1, STATE.AVAIL.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.RUN.Quality &gt;= 192) || (Reference.AVAIL.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.RUN" cause="any-change" />
          <ct:trigger on="STATE.AVAIL" cause="any-change" />
        </ct:handler>
