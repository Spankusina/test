        <ct:formula target="ALM_PROG.XAA.On" source-code="(Mode.ImitIO)?(ALM_PROG.XAA.On):(Reference.XAA)" />
        <ct:formula target="ALM_PROG.XAB.On" source-code="(Mode.ImitIO)?(ALM_PROG.XAB.On):(Reference.XAB)" />
        <ct:formula target="ALM_PROG.ZAO.On" source-code="(Mode.ImitIO)?(ALM_PROG.ZAO.On):(Reference.ZAO)" />
