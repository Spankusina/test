        <ct:handler name="TU_ImitIO_On" access-level="public" uuid="632db529-95a6-4c68-88c9-6103827d73e8">
          <ct:trigger on="TU.ImitIO_On" cause="any-change" />
          <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
	Mode.ImitIO = true;</property>
        </ct:handler>
        <ct:handler name="TU_ImitIO_Off" access-level="public" uuid="f3c8137e-315c-461b-b279-baea9f4281bb">
          <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
          <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
        </ct:handler>
        <ct:handler name="TU_OOS" access-level="public" uuid="00512d02-c2d7-4d5b-9eaa-a997e6cf216d">
          <ct:trigger on="TU.OOS" cause="update" />
          <property name="source-code">if (!Mode.ImitIO)
	if (TU.OOS &amp;&amp; TU.OOS.Quality&gt;=192)
		Reference.OutOfServ = true;
		Reference.IS = false;</property>
        </ct:handler>
