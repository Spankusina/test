          <attribute type="unit.Server.Attributes.Replicate" value="@(object:Attributes.AP.LL_alarm_check)" />
          <attribute type="unit.Server.History.Set.DatabaseSettings">
            <property name="value">Enable="@(object:Attributes.AP.LL_alarm_check)" AppendServerTime="False"</property>
          </attribute>
        </ct:socket-parameter>
        <ct:socket-parameter name="NORM" type="bool" uuid="e8bb227a-fc93-4b02-88a4-e2e8f776bb9f">
          <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). значение в норме" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" значение в норме","Severity":"104","Type":"On"},{"AckStrategy":0,"IsGenerateEqualSubcondition":false,"Message":" значение в норме","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.InitialValue" value="false" />
          <attribute type="Attributes.Type_Events" value="SCADA_NRM" />
        </ct:socket-parameter>
      </ct:socket>
      <ct:parameter name="Cmd" access-level="public" access-scope="global" direction="in" type="uint16" uuid="63fd7821-9805-4066-86cb-fbcfe21bf987">
        <attribute type="unit.System.Attributes.Description" value="Команды" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
      </ct:parameter>
      <ct:socket name="OutPreset" access-level="public" access-scope="global" direction="out" uuid="5b2aa917-e43b-46e6-9425-48710c47e8ef">
