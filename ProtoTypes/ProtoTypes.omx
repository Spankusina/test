        <ct:handler name="_Mode_HMI" uuid="8123a9da-089d-4ef7-b3af-de07ef7b6097">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, Mode.XLLR.Value);
current = Math.SetBit(current, 1, !Mode.XLLR.Value);
current = Math.SetBit(current, 2, Mode.XSX.Value);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 4, false);
current = Math.SetBit(current, 5, false);
current = Math.SetBit(current, 6, false);
current = Math.SetBit(current, 7, !Mode.XLD.Value);
current = Math.SetBit(current, 8, Mode.XLD.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLLR.Quality &gt;= 192) || (Reference.XSX.Quality &gt;= 192) || (Reference.XSS.Quality &gt;= 192) || (Reference.XLD.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLLR" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSX" cause="any-change" />
          <ct:trigger on="Mode.XSS" cause="any-change" />
          <ct:trigger on="Mode.XLD" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="20037f97-4453-43e1-a4d7-b1e1284644bf">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="b0cd2afe-f5f5-456c-b83c-f8c4a8a434d3">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XI.Value);
current = Math.SetBit(current, 2, STATE.XIA.Value);
current = Math.SetBit(current, 3, STATE.XIE.Value);
current = Math.SetBit(current, 4, STATE.XIF.Value);
current = Math.SetBit(current, 5, STATE.XIG.Value);
current = Math.SetBit(current, 9, STATE.XLB.Value);



if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XI.Quality &gt;= 192) || (Reference.XIA.Quality &gt;= 192) || (Reference.XIE.Quality &gt;= 192) || (Reference.XIF.Quality &gt;= 192) || (Reference.XIG.Quality &gt;= 192) || (Reference.XLB.Quality &gt;= 192)  )
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XI" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XIE" cause="any-change" />
          <ct:trigger on="STATE.XIF" cause="any-change" />
          <ct:trigger on="STATE.XIG" cause="any-change" />
          <ct:trigger on="STATE.XLB" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="abab91e2-e384-4217-bbb9-13b0e203be6a">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="RDY_HMI" type="uint16" direction="out" uuid="8aa632cf-e910-4c35-9054-01ffe96dc816">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="RDY" />
        </ct:parameter>
        <ct:handler name="_RDY_HMI" uuid="45b4f0d8-883c-4dac-97c7-db8679e1825a">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XL.Value);
current = Math.SetBit(current, 1, RDY.XL_AUX.Value);
current = Math.SetBit(current, 2, RDY.LO_ON_DN.Value);
current = Math.SetBit(current, 3, RDY.SS_ON_DN.Value);
current = Math.SetBit(current, 4, RDY.VT_ON_DN.Value);
current = Math.SetBit(current, 8, RDY.MPC_PERM.Value);
current = Math.SetBit(current, 9, false);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XL.Quality &gt;= 192) || (Reference.XL_AUX.Quality &gt;= 192) || (Reference.LO_ON_DN.Quality &gt;= 192) || (Reference.SS_ON_DN.Quality &gt;= 192) || (Reference.MPC_PERM.Quality &gt;= 192)  || (Reference.VT_ON_DN.Quality &gt;= 192) || (Reference.XLA.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="RDY.XL" cause="any-change" />
          <ct:trigger on="RDY.XL_AUX" cause="any-change" />
          <ct:trigger on="RDY.LO_ON_DN" cause="any-change" />
          <ct:trigger on="RDY.SS_ON_DN" cause="any-change" />
          <ct:trigger on="RDY.VT_ON_DN" cause="any-change" />
        </ct:handler>
