      </ct:parameter>
      <ct:handler name="TU_RST" uuid="b55a747c-f12e-49eb-9dec-279d3be55d99" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.RST = TU.RST;">
        <ct:trigger on="TU.RST" cause="any-change" />
      </ct:handler>
