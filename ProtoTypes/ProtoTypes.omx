        <property name="source-code">SP_AHH         :float;

if (Mode.use_plc_HH)
	
   {
      SP_AHH=PLC_Preset.SP_AHH.Value;	
   }
 
 else
 	
 {
    SP_AHH=OutPreset.SP_AHH.Value;	
 }

Calc_alm.AHH.Messages.Selected.Message = Calc_alm.AHH.Messages.Selected.Message +". Текущее значение "+  String.ToString("%.2f", Math.Round(Val,2))+ " " + Attrib.EUnitRUS.Value +" (текущая уставка: " + String.ToString("%.2f", Math.Round(SP_AHH, 2)) + " " + Attrib.EUnitRUS.Value + ")";</property>
      </ct:handler>
