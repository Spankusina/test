      <ct:socket name="Attrib" access-level="public" access-scope="global" direction="none" uuid="a690eced-5e1b-445b-9172-c7a5455574d7">
        <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
        <ct:socket-parameter name="Sign" type="string" uuid="32173eab-cc0a-4a40-8e91-624cd07fb962">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Common.Sign)" />
          <attribute type="unit.System.Attributes.Description" value="@(object:System.Attributes.Description)" />
          <attribute type="Attributes.Attrib.Priority_Display_1000030" value="@(object:Attributes.Common.Priority_Display)" />
          <attribute type="Attributes.Attrib.DescriptionRUS_1000050" value="@(object:Attributes.Common.DescriptionRUS)" />
          <attribute type="Attributes.Attrib.Remote_1000020" value="@(object:Attributes.Common.Remote)" />
          <attribute type="Attributes.Attrib.Group_1000040" value="@(object:Attributes.Common.Group)" />
        </ct:socket-parameter>
