      <ct:formula target="STATE.ZLO" source-code="(Mode.ImitIO)?(STATE.ZLO):(Reference.ZLO)" />
      <ct:formula target="STATE.ZLC" source-code="(Mode.ImitIO)?(STATE.ZLC):(Reference.ZLC)" />
      <ct:formula target="STATE.ZLP" source-code="(Mode.ImitIO)?(STATE.ZLP):(Reference.ZLP)" />
      <ct:handler name="_uZL" uuid="a90a9616-42ea-4337-98d1-f42d5b5b6af7">
        <ct:trigger on="STATE.ZLO" cause="change" />
        <ct:trigger on="STATE.ZLC" cause="change" />
        <property name="source-code">Temp_uZL :uint2;

if (Mode.ImitIO)
  {

    if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	  {      
        Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	  {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	   {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }
      
       if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &lt;192))
	   {      

         Temp_uZL =99;
	   }     
      
   }
else
  {
	
    if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	  {      
        Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC));
	  }

     if ((Reference.ZLO.Quality &gt;= 192) &amp;&amp; (Reference.ZLC.Quality &lt; 192))
	  {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(!STATE.ZLO));
	   }

      if ((Reference.ZLO.Quality &lt; 192) &amp;&amp; (Reference.ZLC.Quality &gt;= 192))
	   {      

         Temp_uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.ZLC)+2*TypeConvert.ToInt4(STATE.ZLC));
	   }
      
      if ((Reference.ZLO.Quality &lt; 192) &amp;&amp; (Reference.ZLC.Quality &lt; 192))
	   {      

         Temp_uZL=99;
	   }
      
   }
   
if  ((Temp_uZL&lt;99) &amp;&amp; (Temp_uZL!=STATE.uZL))
	{
	 STATE.uZL=Temp_uZL;
	}
	
if  (Temp_uZL==99)
	{
	 STATE.uZL=Temp_uZL;
	}</property>
      </ct:handler>
      <ct:handler name="_STATE_HMI" uuid="80423eb3-bc98-44b4-9d40-ed92e769a216">
        <ct:trigger on="STATE.ZLO" cause="any-change" />
        <ct:trigger on="STATE.ZLC" cause="any-change" />
        <property name="source-code">current: uint2 = STATE_HMI;

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
         current = Math.SetBit(current, 0, STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value);
         current = Math.SetBit(current, 1, STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value);

	}

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	{      
         current = Math.SetBit(current, 0, STATE.ZLO.Value);
         current = Math.SetBit(current, 1, !STATE.ZLO.Value);
	}

if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
         current = Math.SetBit(current, 0, !STATE.ZLC.Value);
         current = Math.SetBit(current, 1, STATE.ZLC.Value);
	}

if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	{      
         current = Math.SetBit(current, 0, false);
         current = Math.SetBit(current, 1, false);
	}

if ((STATE.ZLP.Quality &gt;= 192) &amp;&amp; (STATE.ZLD.Quality &gt;= 192))
	{      
        current = Math.SetBit(current, 2, STATE.ZLP.Value &amp;&amp; !STATE.ZLD.Value);
         current = Math.SetBit(current, 3, STATE.ZLD.Value &amp;&amp; !STATE.ZLP.Value);

	}

if ((STATE.ZLP.Quality &gt;= 192) &amp;&amp; (STATE.ZLD.Quality &lt; 192))
	{      
         current = Math.SetBit(current, 2, STATE.ZLP.Value);
         current = Math.SetBit(current, 3, !STATE.ZLP.Value);
	}

if ((STATE.ZLP.Quality &lt; 192) &amp;&amp; (STATE.ZLD.Quality &gt;= 192))
	{      
         current = Math.SetBit(current, 2, !STATE.ZLD.Value);
         current = Math.SetBit(current, 3, STATE.ZLD.Value);
	}

if ((STATE.ZLP.Quality &lt; 192) &amp;&amp; (STATE.ZLD.Quality &lt; 192))
	{      
         current = Math.SetBit(current, 2, false);
         current = Math.SetBit(current, 3, false);
	}

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        <ct:trigger on="STATE.ZLP" cause="any-change" />
        <ct:trigger on="STATE.ZLD" cause="any-change" />
      </ct:handler>
      <attribute type="Attributes.Electric.State.EnableSt_ZLC" value="1" />
      <attribute type="Attributes.Electric.State.EnableSt_ZLO" value="1" />
      <attribute type="Attributes.Electric.State.EnableSt_ZLP" value="1" />
      <attribute type="Attributes.Electric.Type.EnableALM" value="0" />
      <attribute type="Attributes.Electric.Type.Type_Line_SWC" value="0" />
