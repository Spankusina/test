        <ct:handler name="Handler" uuid="a17fe267-4525-45e8-bf27-e2fa11880ced">
          <ct:trigger on="Reference.MINUTE" />
          <property name="source-code">Year : uint2 =0;
if (Reference.YEAR_INT.Quality &gt;= 192) {
	Year = TypeConvert.ToUint2(Reference.YEAR_INT);  }
else { 
	Year = TypeConvert.ToUint2(Reference.YEAR); }
                                
Month :  uint1=TypeConvert.ToUint1(Reference.MONTH);
Day : uint1=TypeConvert.ToUint1(Reference.DAY);
H : uint1=TypeConvert.ToUint1(Reference.HOUR);
M : uint1=TypeConvert.ToUint1(Reference.MINUTE);
S : uint1=TypeConvert.ToUint1(0);
MS:    uint2 = TypeConvert.ToUint2(0);
PLC_Time=DateTime.Create(Year, Month, Day, H, M, S, MS);</property>
          <ct:trigger on="Reference.YEAR" />
          <ct:trigger on="Reference.MONTH" />
          <ct:trigger on="Reference.DAY" />
          <ct:trigger on="Reference.HOUR" />
        </ct:handler>
        <attribute type="Attributes.Common.DescriptionRUS" value="@(object:System.Attributes.Description)" />
      </ct:type>
