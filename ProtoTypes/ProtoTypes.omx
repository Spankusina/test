      <ct:handler name="ReplaceMsg" uuid="0b65f5b5-b244-43be-a4d9-b5c3732b5572">
        <ct:trigger on="GenMessage" cause="message-prepare" />
        <property name="source-code">GenMessage.Messages.Selected.Message = "Команда: " + GenMessage.Messages.Selected.Message;</property>
      </ct:handler>
      <ct:handler name="_Active" uuid="381f9c64-54c7-4c72-91b9-21092e29246c">
        <property name="source-code">if ((Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192))
	Active = Ref_Service_CIP.Active;</property>
        <ct:trigger on="Ref_Replication_This.Role" cause="any-change" />
        <ct:trigger on="Ref_Service_CIP.Active" cause="any-change" />
      </ct:handler>
      <attribute type="Attributes.Common.Sign" value="No_signal" />
      <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
    </ct:type>
    <ct:type name="SyncSnapShot" uuid="e9e79449-2faa-4a60-9b3a-3a04cc02b447">
      <r:ref name="Ref_Replication_This" uuid="0ec811ed-3082-4f78-b448-c50eca4e7493" type="Replication_This" />
      <r:ref name="Ref_SnapShot_Generator" type="SnapShot Module_Generator" uuid="d19267f8-959c-4bfa-b58f-00497ef0d94f" />
      <ct:handler name="_SyncSnapShot" uuid="c9a5f4ea-c43d-4568-aab7-ade6926129c5">
        <ct:trigger on="Ref_Replication_This.Role" cause="change" />
        <property name="source-code">if (((((Ref_Replication_This.Role.Value == 0) || (Ref_Replication_This.Role.Value == 1)) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192) &amp;&amp; (Ref_Replication_This.InitState.Value == 6) &amp;&amp; (Ref_Replication_This.InitState.Quality &gt;= 192))) &amp;&amp; (LockSync.Value == false))
{
	//commit SyncProgress = true;
	commit Symaphor = true;
	commit Ref_SnapShot_Generator.OutFileName = Ref_InitSnapShot.Name_1;
	commit Ref_SnapShot_Generator.TemplateName = Ref_InitSnapShot.Name_1 + "_Template";
	//Ref_SnapShot_Generator.Generate = true;
	//LockSync = true;
}
else if ((Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192) &amp;&amp; (LockSync.Value == false))
{
	LockSync = true;
}</property>
        <ct:trigger on="Ref_Replication_This.InitState" cause="change" />
      </ct:handler>
      <attribute type="unit.Server.Attributes.Replicate" value="false" />
      <r:ref name="Ref_InitSnapShot" type="InitSnapShot" uuid="ae4c88c3-dfe3-45f7-9e66-36b204823355" />
      <ct:parameter name="CurrentSnapShot" type="int32" direction="out" uuid="0f3f0cdf-e0ef-45e0-89ec-d891e2bcd6bc">
        <attribute type="unit.System.Attributes.InitialValue" value="1" />
        <attribute type="unit.System.Attributes.Description" value="Текущий файл snapshot" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
      <ct:handler name="_Set_Current_File" uuid="ee4b2500-5043-45b8-8b64-1fa880eefe75">
        <ct:trigger on="Ref_SnapShot_Generator.GenInProgress" cause="change" />
        <property name="source-code">if ((Ref_SnapShot_Generator.GenInProgress == false) &amp;&amp; (LockSync.Value == false))
{
	if ((Symaphor.Quality &gt;= 192) &amp;&amp; (Symaphor.Value == false))
	{
		if (CurrentSnapShot &lt; Ref_InitSnapShot.TemplateCount)
			CurrentSnapShot += 1;
		else
		{
			CurrentSnapShot = 1;
			LockSync = true;
		}
		
		Symaphor = true;
	}
}</property>
      </ct:handler>
