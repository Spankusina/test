      <ct:handler name="TU_ImitIO_On" uuid="a2d0009e-ea85-48d6-a7d0-616ae0b04f34">
        <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
