            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsGenerateEqualSubcondition":true,"Message":". Неопределённое  положение","Severity":"104","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Разомкнут","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Замкнут","Severity":"104","Type":"Enumeration","Value":2},{"AckStrategy":0,"IsGenerateEqualSubcondition":true,"Message":". Ошибка положения","Severity":"2","Type":"Enumeration","Value":3}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="Attributes.Type_Events" value="PLC_EQ" />
        </ct:socket-parameter>
