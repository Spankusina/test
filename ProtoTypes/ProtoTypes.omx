      <attribute type="Attributes.Replication.UUID_Srv5" />
      <attribute type="Attributes.Replication.UUID_Srv6" />
      <ct:handler name="_Name" uuid="e5c28178-0d94-4654-ae24-2a82c975d8ab">
        <ct:trigger on="Ref_Server_State.Server" cause="any-change" />
        <ct:trigger on="Ref_Id_Instance.Str" cause="any-change" />
        <property name="source-code">if (Ref_Server_State.Server.Quality &gt;= 192)
{
	if (Ref_Id_Instance.Str == Srv1_UUID)
	{
		Name = Srv1;
	}
	else if (Ref_Id_Instance.Str == Srv2_UUID)
	{
		Name = Srv2;
	}
	else if (Ref_Id_Instance.Str == Srv3_UUID)
	{
		Name = Srv3;
	}
	else if (Ref_Id_Instance.Str == Srv4_UUID)
	{
		Name = Srv4;
	}
	else if (Ref_Id_Instance.Str == Srv5_UUID)
	{
		Name = Srv5;
	}
	else if (Ref_Id_Instance.Str == Srv6_UUID)
	{
		Name = Srv6;
	}
}</property>
      </ct:handler>
    </ct:type>
