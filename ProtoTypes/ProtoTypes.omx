    <ct:type name="Counter_Server" uuid="28dd9a34-556f-4080-a027-0ae83b149077">
      <ct:parameter name="Counter" uuid="2da7209f-dab4-4547-b186-a985d5cd58cf" type="int32" direction="out">
        <attribute type="unit.System.Attributes.Description" value="Текущее значение счётчика" />
        <attribute type="unit.System.Attributes.InitialValue" value="1" />
      </ct:parameter>
      <ct:parameter name="Online" uuid="a6db1f55-ff1d-488e-890f-54b17e19b11b" type="bool" direction="out">
        <attribute type="unit.System.Attributes.Description" value="Cвязь" />
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Установлена","Severity":"104","Type":"On"},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Отсутствует","Severity":"1","Sound":"fastbeep.wav","Type":"Off"}],"Type":"Discrete"}}</property>
        </attribute>
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="2" />
      </ct:parameter>
      <attribute type="unit.System.Attributes.Description" value="Работоспособность" />
      <ct:socket name="SDKU" uuid="c0dd8a9c-46be-46dd-9e54-2bebe4cbbaa4" direction="out">
        <ct:socket-parameter name="Counter" uuid="29be1d5d-4a75-4e3a-8435-3bd57ae29975" type="int32">
          <attribute type="unit.System.Attributes.Description" value="Значение счётчика" />
          <attribute type="unit.System.Attributes.InitialValue" value="-2147483648" />
        </ct:socket-parameter>
        <attribute type="unit.System.Attributes.Description" value="СДКУ" />
      </ct:socket>
      <ct:timer name="Timer" uuid="d33c570f-e752-4f4c-b5c4-71a17f33f5c1" period="1000" />
      <ct:handler name="_Online" uuid="04f3af2c-4845-4351-b32b-e99367a60b2e">
        <ct:trigger on="Timer" cause="any-change" />
        <property name="source-code">if (Counter.Quality &gt;= 192)
{
	if (Counter.Value == Counter_Previous.Value)
	{
		if (Online.Value)
		{
			Online = false;
		}
	}
	else
	{
		if (Online.Value == false)
		{
			Online = true;
		}
	}
}
else
{
	if (Online.Value)
	{
		Online = false;
	}
}

Counter_Previous = Counter;

if (SDKU.Counter == 2147483647)
{
	SDKU.Counter = -2147483648;
}

SDKU.Counter += 1;</property>
      </ct:handler>
      <ct:parameter name="Counter_Previous" type="int32" direction="out" uuid="1100b3b5-518b-4ae1-bbe2-df95900074e3">
        <attribute type="unit.System.Attributes.Description" value="Предыдущее значение счётчика" />
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Counter.Previous" />
        <attribute type="unit.System.Attributes.InitialValue" value="0" />
      </ct:parameter>
      <attribute type="Attributes.Common.Group" value="No_signal" />
      <attribute type="Attributes.Common.Remote" value="No_signal" />
      <attribute type="Attributes.Common.Sign" value="No_signal" />
      <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
    </ct:type>
