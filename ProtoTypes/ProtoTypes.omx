            <attribute type="unit.System.Attributes.InitialValue">
              <property name="value">00@(object:Attributes.Valve.Type.Type_Mini)000001000000@(object:Attributes.Valve.Type.EnableALM)@(object:Attributes.Valve.Cmd.EnableCom_Open)@(object:Attributes.Valve.Cmd.EnableCom_Close)@(object:Attributes.Valve.Cmd.EnableCom_Stop)@(object:Attributes.Valve.Cmd.EnableCom_Auto)@(object:Attributes.Valve.Cmd.EnableCom_Man)0000@(object:Attributes.Valve.Cmd.EnableCom_Osn)0000001100110000000000@(object:Attributes.Valve.Mode_other.EnableMode_Remote)@(object:Attributes.Valve.Mode_other.EnableMode_Local)@(object:Attributes.Valve.Mode_other.EnableMode_Auto)@(object:Attributes.Valve.Mode_other.EnableMode_Man)000000000000</property>
