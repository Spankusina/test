        <ct:handler name="_RDY_HMI" uuid="8330b3cb-6080-40d9-8540-08acad43dde6">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XL.Value);
current = Math.SetBit(current, 8, RDY.UAB.Value);
current = Math.SetBit(current, 9, RDY.XLA.Value);
current = Math.SetBit(current, 10, RDY.XLF.Value);
current = Math.SetBit(current, 11, RDY.XLS.Value);
current = Math.SetBit(current, 12, RDY.UA.Value);
current = Math.SetBit(current, 13, RDY.UAD.Value);
current = Math.SetBit(current, 14, RDY.BPSS.Value);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XL.Quality &gt;= 192) || (Reference.UAB.Quality &gt;= 192) || (Reference.XLA.Quality &gt;= 192) || (Reference.XLF.Quality &gt;= 192) || (Reference.XLS.Quality &gt;= 192) || (Reference.UA.Quality &gt;= 192) || 
	      (Reference.UAD.Quality &gt;= 192) || (Reference.BPSS.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="RDY.XL" cause="any-change" />
          <ct:trigger on="RDY.XLA" cause="any-change" />
          <ct:trigger on="RDY.UA" cause="any-change" />
