      <ct:parameter name="Calc_ADR" uuid="a4cb3639-f5f9-40f6-9cc9-d8c610637123" type="string" direction="out">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Calc.ADR" />
        <attribute type="unit.System.Attributes.Description" value="Включён в суммарный расчёт" />
        <attribute type="unit.System.Attributes.InitialValue" value="Logic" />
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
      </ct:parameter>
      <ct:handler name="TU_Calc_On" uuid="9e52f198-e15f-450a-b3ba-b6402c500414">
        <ct:trigger on="TU.Calc_On" cause="any-change" />
        <property name="source-code">if (TU.Calc_On.Quality &gt;= 192 &amp;&amp; TU.Calc_On.Value)
{	
	commit Calc = true;
	
	if (Ref_SnapShot_Generator.TemplateName != "Use_Tank_Template")
	{
		commit Ref_SnapShot_Generator.TemplateName = "Use_Tank_Template";
	}
	if (Ref_SnapShot_Generator.OutFileName != "Use_Tank")
	{
		commit Ref_SnapShot_Generator.OutFileName = "Use_Tank";
	}
	Ref_SnapShot_Generator.Generate = true;
}</property>
      </ct:handler>
      <ct:handler name="TU_Calc_Off" uuid="f5d32917-77a4-4076-a9df-e39f8844f839">
        <property name="source-code">if (TU.Calc_Off.Quality &gt;= 192 &amp;&amp; TU.Calc_Off.Value)
{
	commit Calc = false;
	
	if (Ref_SnapShot_Generator.TemplateName != "Use_Tank_Template")
	{
		commit Ref_SnapShot_Generator.TemplateName = "Use_Tank_Template";
	}
	if (Ref_SnapShot_Generator.OutFileName != "Use_Tank")
	{
		commit Ref_SnapShot_Generator.OutFileName = "Use_Tank";
	}
	Ref_SnapShot_Generator.Generate = true;
}</property>
        <ct:trigger on="TU.Calc_Off" cause="any-change" />
      </ct:handler>
