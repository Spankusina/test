          <attribute type="unit.System.Attributes.Description" />
        </ct:object>
        <ct:formula target="STATE.ZLOC" source-code="(Mode.ImitIO)?(STATE.ZLOC):(!Reference.ZLOA &amp;&amp; !Reference.ZLOB)" />
        <ct:formula target="Mode.uLR">
          <property name="source-code">TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL))</property>
        </ct:formula>
        <ct:service-communication source="TU.HSOA" target="TU_Answer.HSOA_CoreCommandStatus" />
        <ct:service-communication source="TU.HSOB" target="TU_Answer.HSOB_CoreCommandStatus" />
      </ct:type>
