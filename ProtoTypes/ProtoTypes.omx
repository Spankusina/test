      <ct:parameter name="isShownBanner1600" type="bool" direction="out" uuid="495ee850-296e-48db-b656-e806e0136b1a">
        <attribute type="unit.System.Attributes.InitialValue" value="true" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
