        <ct:handler name="_TU_Ready" uuid="96f0f00f-9f64-4e91-90a8-5b4b5c2a3026">
          <ct:trigger on="TU.Ready" cause="any-change" />
          <property name="source-code">if ((TU.Ready.Quality &gt;= 192) &amp;&amp; TU.Ready.Value)
{
	Ready = true;
}</property>
        </ct:handler>
        <ct:handler name="_TU_UnReady" uuid="fc0b93dd-d7e0-4402-ab70-eb6d91ce64c3">
          <ct:trigger on="TU.UnReady" cause="any-change" />
          <property name="source-code">if ((TU.UnReady.Quality &gt;= 192) &amp;&amp; TU.UnReady.Value)
{
	Ready = false;
}</property>
        </ct:handler>
        <attribute type="unit.System.Attributes.Description" value="Ученик" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <ct:parameter name="GenMessage" type="string" direction="in" uuid="b6a2b2e8-48b7-4d94-8a73-2250c114f3cc">
          <attribute type="unit.System.Attributes.Description" value="Динамическое сообщение" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"Severity":"105","Type":"Dynamic"}],"Type":"Dynamic"}}</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="Attributes.Type_Events" value="SCADA_CTRL" />
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
        </ct:parameter>
        <ct:handler name="ReplaceMsg" uuid="7dd9f5f8-8b85-4039-aa37-17e76e44bc77">
          <ct:trigger on="GenMessage" cause="message-prepare" />
          <property name="source-code">GenMessage.Messages.Selected.Message = "Команда: " + GenMessage.Messages.Selected.Message;</property>
        </ct:handler>
        <ct:socket name="TU_Answer" direction="out" uuid="6d10e623-3d5b-4e17-b856-ad593d07b235">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="TU" />
          <ct:socket-parameter name="Ready_CoreCommandStatus" type="uint8" uuid="2a9a271c-ef32-4a1a-93ec-edae974f1c9f">
            <attribute type="Attributes.DeliveryStatusCoreCommand" value="DeliveryStatus" />
            <attribute type="unit.System.Attributes.ServiceItem" />
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
            <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
            <attribute type="unit.Server.Attributes.NodeRelativePath" value="Ready.CoreCommandStatus" />
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Непредвиденная ошибка","Severity":"151","Type":"Enumeration","Value":128},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Роль сервера не подходит для записи команды","Severity":"151","Type":"Enumeration","Value":129},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Нет мастера на связи","Severity":"151","Type":"Enumeration","Value":130},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Ошибка при отправке команды мастеру","Severity":"151","Type":"Enumeration","Value":131},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Потеряна связь с мастером","Severity":"151","Type":"Enumeration","Value":132},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Вышел тайм-аут ожидания ответа от мастера","Severity":"151","Type":"Enumeration","Value":133},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Реплика не готова к командам","Severity":"151","Type":"Enumeration","Value":134},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Неизвестный узел","Severity":"151","Type":"Enumeration","Value":135},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Роль изменилась во время выполнения","Severity":"151","Type":"Enumeration","Value":200}],"Type":"Enumeration"}}</property>
            </attribute>
            <attribute type="unit.System.Attributes.Description">
              <property name="value">@(TU.Ready:unit.System.Attributes.Description). Контроль статуса доставки</property>
