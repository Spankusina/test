    <ct:type name="CIP_DataReceivingMode_Service" uuid="29ee55dc-bb98-45da-b780-dee77c074a10">
      <ct:parameter name="IsSlowGroup" type="bool" direction="out" uuid="ab3946f0-edc9-4f34-8195-3b52438158a1" />
      <ct:parameter name="Set" type="string" direction="in" uuid="46ba1156-18c0-4249-9709-5daeb45f4a48">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Name.Set" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
      </ct:parameter>
      <ct:parameter name="Name" type="string" direction="out" uuid="3324c46f-fa28-468c-90bb-7398dd10d1f2" />
      <ct:handler name="Mode" uuid="d39151eb-8ca4-4594-80be-337afa9f5831">
        <property name="source-code">current: uint2 = Mode_HMI;


current = Math.SetBit(current, 0, (!IsSlowGroup.Value &amp;&amp; Name=="SatelliteMode")||(IsSlowGroup.Value &amp;&amp; Name=="FiberMode") );
current = Math.SetBit(current, 1, Name=="SatelliteMode" &amp;&amp; IsSlowGroup.Value );
current = Math.SetBit(current, 2, Name=="RadioMode");
current = Math.SetBit(current, 3, Name=="FiberMode" &amp;&amp; !IsSlowGroup.Value );



if ((IsSlowGroup.Quality &gt;= 192) || (Name.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
else
	{
		current = Math.SetBit(current, 15, false);
	}


commit Mode_HMI = current;</property>
        <ct:trigger on="Changed" cause="any-change" />
      </ct:handler>
