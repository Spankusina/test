        <property name="source-code">if (Seller_MAN_DoSnapShot.Value &amp;&amp; (Seller_MAN_DoSnapShot.Quality &gt;= 192))
{
	if (Ref_SnapShot_Generator.TemplateName != "Manual_Input_Seller_Template")
	{
		commit Ref_SnapShot_Generator.TemplateName = "Manual_Input_Seller_Template";
	}
	if (Ref_SnapShot_Generator.OutFileName != "Manual_Input_Seller")
	{
		commit Ref_SnapShot_Generator.OutFileName = "Manual_Input_Seller";
	}
	Ref_SnapShot_Generator.Generate = true;
}</property>
