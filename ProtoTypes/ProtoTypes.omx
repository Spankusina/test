        <ct:formula target="ALM_PROG.UAA.On" source-code="(Mode.ImitIO)?(ALM_PROG.UAA.On):(Reference.UAA)" />
        <ct:formula target="ALM_PROG.BTAE.On" source-code="(Mode.ImitIO)?(ALM_PROG.BTAE.On):(Reference.BTAE)" />
        <ct:formula target="ALM_PROG.UAF.On" source-code="(Mode.ImitIO)?(ALM_PROG.UAF.On):(Reference.UAF)" />
        <ct:formula target="ALM_PROG.UAB.On" source-code="(Mode.ImitIO)?(ALM_PROG.UAB.On):(Reference.UAB)" />
        <ct:handler name="_Mode_HMI" uuid="5080c556-0b90-46dc-83d8-363ee7fad0cd">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, Mode.XLLR.Value);
current = Math.SetBit(current, 1, !Mode.XLLR.Value);
current = Math.SetBit(current, 2, Mode.XSX.Value);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 4, false);
current = Math.SetBit(current, 5, false);
current = Math.SetBit(current, 6, false);
current = Math.SetBit(current, 7, !Mode.XLD.Value);
current = Math.SetBit(current, 8, Mode.XLD.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLLR.Quality &gt;= 192) || (Reference.XSX.Quality &gt;= 192) || (Reference.XSS.Quality &gt;= 192) || (Reference.XLD.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLLR" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSX" cause="any-change" />
          <ct:trigger on="Mode.XSS" cause="any-change" />
          <ct:trigger on="Mode.XLD" />
        </ct:handler>
