        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="920103a0-ad43-411a-9fd1-ef2c2a8bce4d">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="66ef2044-0adf-4f00-96cf-c803419d3ce6">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="a67f0e1b-8b7e-4e45-b4ac-7d9f2e209590">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.RUN.Value);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if (Reference.RUN.Quality &gt;= 192)
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.RUN" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="3abe4aca-fbff-4413-8c34-8296872f5e57">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 4, Mode.MAINT.Value);
current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if (Reference.Maint.Quality &gt;= 192)
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.MAINT" cause="any-change" />
        </ct:handler>
        <ct:handler name="Handler" uuid="3e51b5c4-0b29-4b54-b2c1-36e04284a17d">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <attribute type="Attributes.VS.Cmd.EnableCom_Auto" value="0" />
        <attribute type="Attributes.VS.Cmd.EnableCom_Man" value="0" />
        <attribute type="Attributes.VS.Cmd.EnableCom_ResMaint" value="1" />
        <attribute type="Attributes.VS.Cmd.EnableCom_RST" value="1" />
        <attribute type="Attributes.VS.Cmd.EnableCom_SetMaint" value="1" />
        <attribute type="Attributes.VS.Cmd.EnableCom_Start" value="1" />
        <attribute type="Attributes.VS.Cmd.EnableCom_Stop" value="1" />
        <attribute type="Attributes.VS.Mode_other.EnableMode_Auto" value="0" />
        <attribute type="Attributes.VS.Mode_other.EnableMode_Maint" value="1" />
        <attribute type="Attributes.VS.Mode_other.EnableMode_Man" value="0" />
        <attribute type="Attributes.VS.State.EnableSt_Work" value="1" />
        <attribute type="Attributes.VS.Type.EnableALM" value="0" />
        <attribute type="Attributes.VS.Type.Type_FAN" value="0" />
        <attribute type="Attributes.VS.Type.Type_Heater" value="0" />
        <attribute type="Attributes.VS.Type.Type_Pump" value="1" />
        <attribute type="Attributes.VS.Type.Type_SIKN" value="1" />
        <attribute type="Attributes.VS.Type.Type_Group" value="0" />
        <attribute type="Attributes.VS.Type.Type_BSMT" value="1" />
        <ct:socket name="TU_Answer" access-level="public" access-scope="global" direction="out" uuid="19c00f27-7e12-43ed-82e2-36780091cbca">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="TU" />
          <ct:socket-parameter name="RST_Answer" type="int8" uuid="113a02b8-e32a-45aa-9e9f-97178c850ef5">
            <attribute type="unit.Server.Attributes.NodeRelativePath" value="RST.Answer" />
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Сброс. Команда не доставлена. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Сброс. Команда не доставлена. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Сброс. Команда не доставлена. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Сброс. Команда не доставлена. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
            </attribute>
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
            <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
          </ct:socket-parameter>
          <ct:socket-parameter name="HSO_Answer" type="int8" uuid="0d100ab3-9486-4680-bff8-5f332ba2e033">
