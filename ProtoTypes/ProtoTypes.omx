      <ct:handler name="_ALL" uuid="4a72b83e-acb8-4fce-849e-a8d3f921d70e">
        <ct:trigger on="Calc_alm.ALL" cause="message-prepare" />
        <property name="source-code">SP_ALL         :float;

if (Mode.use_plc_LL)
	
   {
      SP_ALL=PLC_Preset.SP_ALL.Value;	
   }
 
 else
 	
 {
    SP_ALL=OutPreset.SP_ALL.Value;	
 }







Calc_alm.ALL.Messages.Selected.Message = Calc_alm.ALL.Messages.Selected.Message+". Tекущее значение "+  String.ToString("%.2f", Math.Round(Val,2))+ " " + Attrib.EUnitRUS.Value + " (текущая уставка: " + String.ToString("%.2f", Math.Round(SP_ALL.Value, 2)) + " " + Attrib.EUnitRUS.Value + ")";</property>
