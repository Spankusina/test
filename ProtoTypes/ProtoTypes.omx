        <ct:handler name="_TU_trigger_reset_bool" uuid="f37b60ca-e2d4-45a0-97b2-989a339497c6">
          <ct:trigger on="TU_trigger_reset_bool" cause="any-change" />
          <property name="source-code">if ((TU.Ready.Quality &gt;= 192) &amp;&amp; TU.Ready.Value)
{
	TU.Ready = false;
} else 
if ((TU.UnReady.Quality &gt;= 192) &amp;&amp; TU.UnReady.Value)
{
	TU.UnReady = false;
}</property>
        </ct:handler>
