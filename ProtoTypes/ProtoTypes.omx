        <ct:formula source-code="(Mode.ImitIO)?(Mode.AUT):(INV_AUT?(!Reference.AUT):Reference.AUT)" target="Mode.AUT" />
        <ct:formula source-code="(Mode.ImitIO)?(Mode.XLR):(INV_LOCAL?(!Reference.HLR):Reference.HLR)" target="Mode.XLR" />
