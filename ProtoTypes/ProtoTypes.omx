      <attribute type="Attributes.Common.Remote" value="No_signal" />
      <attribute type="Attributes.Common.Sign" value="No_signal" />
      <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
      <attribute type="Attributes.Common.DescriptionRUS" value="No_signal" />
      <ct:object name="Pressure" uuid="3fe717a5-f589-49ba-80b6-38d59120a0c7" base-type="Простой аналоговый параметр.IOS_AP_S_notPLC_double" aspect="IOS">
