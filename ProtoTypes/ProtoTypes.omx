      <ct:handler name="ReplaceMsg" uuid="8adaf967-00cd-428c-b8e9-1c21e5c46841">
        <ct:trigger on="GenMessage" cause="message-prepare" />
        <property name="source-code">GenMessage.Messages.Selected.Message = "Команда: " + GenMessage.Messages.Selected.Message;</property>
      </ct:handler>
      <attribute type="Attributes.Type_Object" value="0" />
      <ct:formula target="STATE.OFF" source-code="(Mode.ImitIO)?(STATE.OFF):(Reference.OFF)" />
      <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="22396f37-4402-4ccb-84bc-1dcdc90a0278">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
        <attribute type="unit.System.Attributes.InitialValue" value="0" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.History" />
      </ct:parameter>
      <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="3277aeaf-3522-417c-bf03-e1ae488ae524">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
        <attribute type="unit.System.Attributes.InitialValue" value="0" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="unit.Server.Attributes.History" />
      </ct:parameter>
      <ct:handler name="_STATE_HMI" uuid="424c22f5-f1f3-46d0-8e82-2032987aa3fa">
        <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.RUN.Value);
current = Math.SetBit(current, 1, STATE.OFF.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.RUN.Quality &gt;= 192) || (Reference.OFF.Quality &gt;= 192) )
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
        <ct:trigger on="STATE.RUN" />
        <ct:trigger on="STATE.OFF" />
      </ct:handler>
      <ct:handler name="_Mode_HMI" uuid="c41c0eb5-4323-4da2-b749-bb42e490d89d">
        <property name="source-code">current: uint2 = Mode_HMI;



current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	
	
	current = Math.SetBit(current, 15, false);
	
}

Mode_HMI = current;</property>
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
      </ct:handler>
      <ct:object name="Comment" aspect="IOS" base-type="Служебные.Comment" uuid="01898d23-c7e8-41a6-a785-016d5af2323b">
        <attribute type="unit.System.Attributes.Description" />
      </ct:object>
      <attribute type="Attributes.Common.Type_HMI" value="64" />
    </ct:type>
