        <ct:handler name="ZL" access-level="public" uuid="9aa7cccf-030d-4497-adf6-32e255385e3c">
          <ct:trigger on="Reference.ZLO" cause="update" />
          <ct:trigger on="Reference.ZLC" cause="update" />
          <ct:trigger on="Mode.ImitIO" cause="update" />
          <property name="source-code">if (!Mode.ImitIO)
	{
	STATE.ZLOC = !Reference.ZLO&amp;&amp;!Reference.ZLC;
	STATE.ZLerr = Reference.ZLO&amp;&amp;Reference.ZLC;
	}
else
	{
	STATE.ZLOC = !STATE.ZLO&amp;&amp;!STATE.ZLC;
	STATE.ZLerr = STATE.ZLO&amp;&amp;STATE.ZLC;
	}</property>
        </ct:handler>
        <ct:parameter name="Adr_UST" access-level="public" access-scope="global" direction="in" type="float32" uuid="20a54037-5145-4d96-ac00-6585173059d7">
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Set_UST.ADR_TU" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
        </ct:parameter>
        <ct:handler name="TU_Open" source-code="if (!Mode.ImitIO &amp;&amp; TU.HSO)&#xD;&#xA;&#x9;Set_UST = 100;" access-level="public" uuid="5ac1a120-36e1-474b-a5e0-d5b1c6368078">
          <ct:trigger on="TU.HSO" cause="update" />
        </ct:handler>
        <ct:handler name="TU_Close" source-code="if (!Mode.ImitIO &amp;&amp; TU.HSC)&#xD;&#xA;&#x9;Set_UST = 0;" access-level="public" uuid="53c089b1-d432-4202-bf91-c25795065d4e">
          <ct:trigger on="TU.HSC" />
        </ct:handler>
        <ct:parameter name="rHIC" access-level="public" access-scope="global" direction="out" type="float32" uuid="a8d9488b-52cd-4c66-9a82-e972cfdb3d13">
          <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Положение клапана" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.REG.EUnit_PV_SP)" />
          <attribute type="Attributes.История.DeadBandTime" value="0" />
          <attribute type="unit.Server.Attributes.History">
            <property name="value">Deadband="@(:Attributes.История.DeadBandValue)" MinTime="@(:Attributes.История.DeadBandTime)" ServerTime="True"</property>
          </attribute>
          <attribute type="Attributes.История.DeadBandValue" value="0.1" />
        </ct:parameter>
        <ct:formula target="rHIC" source-code="(Mode.ImitIO)?(rHIC):(Reference.rHIC)" />
        <ct:handler name="_Mode_HMI" uuid="bee92322-4ab0-4d8d-842a-9a6fd8a07bfd">
          <property name="source-code">current: uint2 = Mode_HMI;


current = Math.SetBit(current, 2, Mode.AUT.Value);
current = Math.SetBit(current, 3, !Mode.AUT.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.AUT.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.AUT" cause="any-change" />
          <ct:trigger on="Mode.LOCK_S" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="11d13d67-7093-4a37-9394-5979f5db312e">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));

current = Math.SetBit(current, 4, (!STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 5, (STATE.ZLO.Value &amp;&amp; STATE.ZLC.Value));



if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="2de082c1-94a1-4d60-949d-eb20986937a6">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
