          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Set_OUT.ADR_TU" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
        </ct:parameter>
        <attribute type="Attributes.SIKN.MAN_false" value="false" />
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="521f6e51-b0ce-4183-b80f-fa8d6c33eb4f">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="d5ce5b38-8afa-4a33-809a-010c9833275b">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="Handler" uuid="cc851182-d772-43b3-9848-4e5c7aa3da87">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="f3c9e256-d8b3-42cf-a87b-eba88404ced0">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;
opened: bool;
closed: bool;

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
      current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
      current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));

      current = Math.SetBit(current, 4, (!STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
      current = Math.SetBit(current, 5, (STATE.ZLO.Value &amp;&amp; STATE.ZLC.Value));
      
	}



opened=(PV&gt;=1);
closed=(PV&lt;1);


if (PV.Quality&gt;=192)
	
	{      
      current = Math.SetBit(current, 0, opened);
      current = Math.SetBit(current, 1, closed);

      current = Math.SetBit(current, 4, false);
      current = Math.SetBit(current, 5, false);
      current.Quality = 192;
	}
	
if (PV.Quality&lt;192)
	
	{      
      current = Math.SetBit(current, 0, false);
      current = Math.SetBit(current, 1, false);

      current = Math.SetBit(current, 4, false);
      current = Math.SetBit(current, 5, false);
      current.Quality = 88;
	}



if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference.ZI.Quality&gt;=192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="PV" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="29db09ba-da21-485f-9792-b53b9b3e532e">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, !Mode.XLL.Value);
current = Math.SetBit(current, 1, Mode.XLL.Value);
current = Math.SetBit(current, 2, Mode.XSA.Value);
current = Math.SetBit(current, 3,!Mode.XSA.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.NotRemote.Quality &gt;= 192) || (Reference.AUT.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLL" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
        </ct:handler>
