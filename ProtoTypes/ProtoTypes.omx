    <ct:type name="IOS_SWITCHER_CBCP" uuid="7145f197-2728-4337-a8a4-717ce5681a51" base-type="IOS_SWITCHER" original="M_SWITCHER_CBCP">
      <ct:parameter name="CBCP" uuid="23982885-e252-47f9-877b-2a46b1a2c96a" type="bool" direction="out">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE.CBCP" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Блокировка замыкания","Severity":"2","Sound":"@(Attributes.Sound)","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Блокировка замыкания. Сигнал снят","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
        </attribute>
        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
        <attribute type="unit.System.Attributes.Description">
          <property name="value">@(*object:Attributes.Common.DescriptionRUS). Блокировка замыкания</property>
        </attribute>
        <attribute type="Attributes.Type_Events" value="PLC_EQ" />
        <attribute type="Attributes.Sound" value="beep-7.wav" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="2" />
      </ct:parameter>
      <ct:formula target="CBCP" source-code="(Mode.ImitIO)?(CBCP):(Reference1.CBCP)" />
      <r:ref name="Reference1" uuid="3821accc-734e-4983-935f-b850a3c63df0" type="M_SWITCHER_CBCP" />
      <attribute type="Attributes.Electric.Type.Type_RCL" value="1" />
      <ct:handler name="_STATE_HMI1" uuid="dce3a0c0-74a6-4737-ab1f-d704ab2bb4ec">
        <property name="source-code">current: uint2 = STATE_HMI;


current = Math.SetBit(current, 6, CBCP.Value);

if ((CBCP.Quality &gt;= 192) || (Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) )
    {      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}


STATE_HMI = current;</property>
        <ct:trigger on="CBCP" cause="any-change" />
      </ct:handler>
    </ct:type>
  </namespace>
