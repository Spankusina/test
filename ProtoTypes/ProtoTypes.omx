        <attribute type="Attributes.CV.Mode_other.EnableMode_Auto" value="1" />
        <attribute type="Attributes.CV.Mode_other.EnableMode_Man" value="1" />
        <attribute type="Attributes.CV.Mode_other.EnableReg_SP" value="1" />
        <attribute type="Attributes.CV.Cmd.EnableCom_Close" value="0" />
        <attribute type="Attributes.CV.Cmd.EnableCom_Open" value="0" />
        <attribute type="Attributes.CV.Cmd.EnableCom_Auto" value="1" />
        <attribute type="Attributes.CV.Cmd.EnableCom_Man" value="1" />
        <attribute type="Attributes.CV.Cmd.EnableCom_RST" value="1" />
        <attribute type="Attributes.CV.Mode_other.EnableAnalog_Prc" value="1" />
        <attribute type="Attributes.CV.Type.Type_CV_Mini" value="0" />
        <ct:handler name="Handler" uuid="4c14fe2d-e814-4340-9be1-dd7eb067688c">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
