        <ct:formula target="RDY.PERM_C1" source-code="(ImitIO)?(RDY.PERM_C1):(Reference.PERM_C1)" />
        <ct:parameter name="RDY_HMI" type="uint16" direction="out" uuid="d1fbeaf8-d8c5-4f16-89fa-e25d4bc83f55">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="RDY" />
        </ct:parameter>
        <ct:handler name="_RDY_HMI" uuid="479ae7ec-c372-4ba5-8690-925dd8ed6b71">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.PERM_C1.Value);
current = Math.SetBit(current, 1, RDY.PERM_C2.Value);

if (ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.PERM_C1.Quality &gt;= 192) || (Reference.PERM_C2.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
