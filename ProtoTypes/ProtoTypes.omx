      <ct:handler name="_On" uuid="7d5f49dd-bbc7-44a7-b950-329d5b5f55c9">
        <ct:trigger on="TU.On" cause="any-change" />
        <property name="source-code">if ((TU.On.Quality &gt;= 192) &amp;&amp; TU.On.Value)
{
	/*if (AP1.Off_group_cmd_LO)
	{
		if (!Ref_AP1.Mode.alm_oper_L)
		{			
			Ref_AP1.Mode.alm_oper_L = true;
			AP1.Off_group_cmd_LO = false;
		}
	}
	if (AP1.Off_group_cmd_HI)
	{
		if (!Ref_AP1.Mode.alm_oper_H)
		{	
			Ref_AP1.Mode.alm_oper_H = true;
			AP1.Off_group_cmd_HI = false;
		}
	}
	
	if (AP2.Off_group_cmd_LO)
	{
		if (!Ref_AP2.Mode.alm_oper_L)
		{
			Ref_AP2.Mode.alm_oper_L = true;
			AP2.Off_group_cmd_LO = false;
		}
	}
	if (AP2.Off_group_cmd_HI)
	{
		if (!Ref_AP2.Mode.alm_oper_H)
		{
			Ref_AP2.Mode.alm_oper_H = true;
			AP2.Off_group_cmd_HI = false;
		}
	}*/
	
	if (!Ref_AP1.Mode.alm_oper_L)
	{
		Ref_AP1.Mode.alm_oper_L = true;
	}
	
	if (!Ref_AP1.Mode.alm_oper_H)
	{
		Ref_AP1.Mode.alm_oper_H = true;
	}
	
	//---------------------------------------------------------------------------
	if (!Ref_AP2.Mode.alm_oper_L)
	{
		Ref_AP2.Mode.alm_oper_L = true;
	}
	
	if (!Ref_AP2.Mode.alm_oper_H)
	{
		Ref_AP2.Mode.alm_oper_H = true;
	}
	
	On = true;
}</property>
      </ct:handler>
