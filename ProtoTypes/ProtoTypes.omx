        <ct:handler name="_get_time" source-code="if (IOS_trigger.STATE.ALM.Value &amp;&amp; (IOS_trigger.STATE.ALM.Quality &gt;= 192) &amp;&amp; (IOS_Minute.Val.Quality &gt;= 192) &amp;&amp; (IOS_Minute.Val.Value &gt;= 0)  &amp;&amp; (IOS_Hour.Val.Quality &gt;= 192) &amp;&amp; (IOS_Hour.Val.Value &gt;= 0))&#xA;{&#xA;&#x9;time_zero: uint8 = 0;&#xA;&#x9;time_zero = DateTime.AddHours(time_zero, IOS_Hour.Val);&#xA;&#x9;time_zero = DateTime.AddMinutes(time_zero, IOS_Minute.Val);&#xA;&#x9;Val = time_zero;&#xA;}" access-level="public" uuid="47f5c681-f552-4d74-97cd-6f86d1cff206">
          <ct:trigger on="IOS_trigger.STATE.ALM" cause="change" />
          <ct:trigger on="IOS_Minute.Val" cause="change" />
          <ct:trigger on="IOS_Hour.Val" cause="change" />
        </ct:handler>
