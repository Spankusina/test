      <ct:type name="IOS_VALVE_POS" aspect="IOS" original="M_VALVE_STOP_AUT" base-type="IOS_VALVE_STOP_AUT_BASE" uuid="66e49ada-887f-442b-8338-f35e7f198d6e">
        <r:ref name="Reference_P" type="M_VALVE_POS" uuid="ccfcf4da-4f32-49cc-8ec3-7c15e1ce3ec6" />
        <ct:handler name="Handler" uuid="171d7ad9-c6bb-44ac-b1ce-4e1bbdab8c33">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
