        <ct:handler name="Handler" uuid="5a6bb1f4-bc8e-422f-bc93-52b82f328bed">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="Mode.HSB_AB" cause="update" />
          <ct:trigger on="Mode.AUT" cause="update" />
          <ct:trigger on="Mode.ImitIO" cause="update" />
        </ct:handler>
        <attribute type="Attributes.VS.Cmd.EnableCom_Expand" value="0" />
        <attribute type="Attributes.VS.Type.EnableALM" value="1" />
      </ct:type>
