          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
          <attribute type="unit.System.Attributes.Description" value="Служебный триггер для сброса поданных пользователем команд bool" />
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
