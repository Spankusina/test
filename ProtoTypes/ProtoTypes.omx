	Mode.ImitIO = false;</property>
        </ct:handler>
        <ct:handler name="ReplaceMsg" source-code="GenMessage.Messages.Selected.Message = &quot;Команда: &quot; + GenMessage.Messages.Selected.Message;" access-level="public" uuid="0e2f40a6-d037-4c9e-b617-beb0b4984cd9">
