        <ct:trigger on="PoleLeak" cause="message-prepare" />
        <property name="source-code">if ((PoleLeak.Value == 2) || (PoleLeak.Value == 1))
{
	PoleLeak.Messages.Selected.Message = PoleLeak.Messages.Selected.Message + ". Координата: " + String.ToString(Math.Round(PoleLeak_coord, 3)) + " км. Время: " + PoleLeak_str_time;
