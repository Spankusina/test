          <attribute type="unit.System.Attributes.InitialValue" value="false" />
          <attribute type="unit.System.Attributes.Description" value="Сигнал для отключения уставок" />
          <attribute type="unit.Server.Attributes.InitialQuality" value="28" />
        </ct:socket-parameter>
        <ct:socket-parameter name="TypeHMI_64" type="uint64" uuid="898a237e-9394-4679-9d86-35c8010308af">
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
        </ct:socket-parameter>
        <ct:socket-parameter name="TypeHMI_Str" type="string" uuid="2902b324-b76c-4829-9f76-93ba73528dc4">
          <attribute type="unit.System.Attributes.InitialValue">
            <property name="value">10000000000000@(object:Attributes.AP.Type.EnableSensors)@(object:Attributes.AP.Type.EnableALM)0000000000000000@(object:Attributes.AP.Ust.EnableUST_AlarmWarning)00010000000000000000000000000000</property>
