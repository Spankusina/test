          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="97dd7e3b-6e3f-4011-b039-f052584cd8a1">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 3, STATE.XIC.Value);
current = Math.SetBit(current, 4, STATE.XIA.Value);
current = Math.SetBit(current, 5, STATE.XIB.Value);
current = Math.SetBit(current, 9, STATE.XLB.Value);
current = Math.SetBit(current, 11, STATE.ZLA.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.ZLA.Quality &gt;= 192) || (Reference.XIA.Quality &gt;= 192) || (Reference.XIB.Quality &gt;= 192) || (Reference.XIC.Quality &gt;= 192) || (Reference.XLB.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XLB" cause="any-change" />
          <ct:trigger on="STATE.ZLA" cause="any-change" />
          <ct:trigger on="STATE.XIB" cause="any-change" />
          <ct:trigger on="STATE.XIC" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="6d2d2772-ea6c-4036-99e7-e0d469e3c00a">
