        <ct:handler name="TU_ImitIO_On" uuid="2b21c1b6-7d8b-49a6-bf82-82f4d4d3b3c9">
          <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
	Mode.ImitIO = true;</property>
          <ct:trigger on="TU.ImitIO_On" cause="any-change" />
        </ct:handler>
        <ct:handler name="TU_ImitIO_Off" uuid="6172fcb1-ac7d-42ee-a4e5-6a979d3c0a2e">
          <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
          <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
        </ct:handler>
        <ct:formula target="Mode.XLR" source-code="(Mode.ImitIO)?(Mode.XLR):(Reference.XLR)" />
        <ct:formula target="Mode.XLL" source-code="(Mode.ImitIO)?(Mode.XLL):(Reference.XLL)" />
        <ct:handler name="_Mode_HMI" uuid="d6713b1a-f5a8-45ec-a746-2cdd221bfd06">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, Mode.XLR.Value);
current = Math.SetBit(current, 1, Mode.XLL.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XLR" cause="any-change" />
          <ct:trigger on="Mode.XLL" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="109bc9b7-9ae0-43b0-a901-a38c914bca18">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.ZL.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="473c4e43-1301-4249-a527-0b0d1b84dbb3">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
