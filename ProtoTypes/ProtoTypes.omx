        <ct:handler name="_Mode_HMI" uuid="f551c238-b998-4c85-9f80-67d9ad6bf1e2">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, Mode.XLLR.Value);
current = Math.SetBit(current, 1, !Mode.XLLR.Value);
current = Math.SetBit(current, 2, false);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 4, Mode.XST.Value);
current = Math.SetBit(current, 5, Mode.XSXO.Value);
current = Math.SetBit(current, 6, Mode.XSF.Value);

current = Math.SetBit(current, 9, Mode.XSA.Value);
current = Math.SetBit(current, 10, Mode.XSM.Value);
current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLLR.Quality &gt;= 192)  || (Reference.XSS.Quality &gt;= 192) || (Reference.XST.Quality &gt;= 192) || (Reference.XSXO.Quality &gt;= 192) || (Reference.XSF.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLLR" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSS" cause="any-change" />
          <ct:trigger on="Mode.XST" cause="any-change" />
          <ct:trigger on="Mode.XSXO" cause="any-change" />
          <ct:trigger on="Mode.XSF" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
          <ct:trigger on="Mode.XSM" cause="any-change" />
          <ct:trigger on="Mode.XDS" cause="any-change" />
          <ct:trigger on="Mode.XSKB" cause="any-change" />
          <ct:trigger on="Mode.XSKA" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="6a741533-e384-44c4-8989-d5ddb5f2e9b0">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="bf2ab1c8-e459-43c3-831d-cc17d629621d">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XI.Value);
current = Math.SetBit(current, 2, false);
current = Math.SetBit(current, 3, false);
current = Math.SetBit(current, 4, STATE.XIA.Value);
current = Math.SetBit(current, 5, STATE.XIB.Value);
current = Math.SetBit(current, 6, STATE.XLD.Value);

current = Math.SetBit(current, 7, STATE.HSC_SDC.Value);
current = Math.SetBit(current, 8, STATE.HSO_SDC.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XI.Quality &gt;= 192) || (Reference.XIA.Quality &gt;= 192) || (Reference.XIB.Quality &gt;= 192) ||  (Reference.XLD.Quality &gt;= 192) || (Reference.HSC_SCD.Quality &gt;= 192) || (Reference.HSO_SCD.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XI" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XIB" cause="any-change" />
