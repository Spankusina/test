        <attribute type="unit.System.Attributes.InitialValue" value="0" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
      </ct:parameter>
      <ct:parameter name="isShownBanner500" type="bool" direction="out" uuid="36e12ef8-5f5c-4514-baf7-6d1036cc5b5f">
        <attribute type="unit.System.Attributes.InitialValue" value="false" />
        <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
