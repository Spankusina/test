            <attribute type="Attributes.Attrib.DescriptionRUS_1000050" value="@(object:Attributes.Common.DescriptionRUS)" />
            <attribute type="Attributes.Attrib.Remote_1000020" value="@(object:Attributes.Common.Remote)" />
            <attribute type="Attributes.Attrib.Group_1000040" value="@(object:Attributes.Common.Group)" />
