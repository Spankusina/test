        </ct:parameter>
        <ct:handler name="_RDY_HMI" uuid="14aa3a0b-ed25-4d9f-875c-cf295784ae80">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XLC.Value);
current = Math.SetBit(current, 1, false);
current = Math.SetBit(current, 2, false);
current = Math.SetBit(current, 3, false);
current = Math.SetBit(current, 4, false);
current = Math.SetBit(current, 5, RDY.XS.Value);
current = Math.SetBit(current, 6, false);
current = Math.SetBit(current, 8, false);
current = Math.SetBit(current, 9, RDY.XSTC.Value);
current = Math.SetBit(current, 10, RDY.XS1A.Value);
current = Math.SetBit(current, 11, RDY.XS1B.Value);
current = Math.SetBit(current, 12, RDY.XS1C.Value);
current = Math.SetBit(current, 12, RDY.XSTD.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLC.Quality &gt;= 192) || (Reference.XS.Quality &gt;= 192) || (Reference.XSTC.Quality &gt;= 192) || (Reference.XS1A.Quality &gt;= 192) || (Reference.XS1B.Quality &gt;= 192) || (Reference.XS1C.Quality &gt;= 192) || (Reference.XSTD.Quality &gt;= 192) )
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
