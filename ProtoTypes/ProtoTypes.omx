        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="7dd5a22c-2224-45b5-be3f-7d63f402004f">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="2ca985a9-9b34-440d-9610-201863849893">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="35f5b01c-c80b-4cbb-af51-e46e0b26e19e">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 14, Mode.ImitIO.Value);
current = Math.SetBit(current, 15, true);


Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="216fe608-1101-4800-9dc4-5eabf50bbb84">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, (STATE.ZLO.Value &amp;&amp; !STATE.ZLC.Value));
current = Math.SetBit(current, 1, (STATE.ZLC.Value &amp;&amp; !STATE.ZLO.Value));

current = Math.SetBit(current, 4, STATE.ZLOC.Value);
current = Math.SetBit(current, 5, STATE.ZLerr.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <attribute type="Attributes.Common.Type_HMI" value="0" />
        <ct:handler name="_ZLOC_ZLerr" uuid="7b1c5649-1abe-4fd8-9e71-355039fc0353">
          <ct:trigger on="Reference.ZLO" cause="any-change" />
          <ct:trigger on="Reference.ZLC" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <property name="source-code">if (!Mode.ImitIO)
{
	STATE.ZLOC = !Reference.ZLO&amp;&amp;!Reference.ZLC;
	STATE.ZLerr = Reference.ZLO&amp;&amp;Reference.ZLC;
}
else
{
	STATE.ZLOC = !STATE.ZLO&amp;&amp;!STATE.ZLC;
	STATE.ZLerr = STATE.ZLO&amp;&amp;STATE.ZLC;
}</property>
        </ct:handler>
        <attribute type="Attributes.Valve.State.EnableSt_Close" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_Middle" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_Open" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_ZLerror" value="1" />
        <attribute type="Attributes.Valve.Type.EnableALM" value="0" />
        <attribute type="Attributes.Valve.Type.Type_Mini" value="1" />
        <ct:handler name="Handler" uuid="6dc4d61b-18a0-4106-9860-88fdbae6c845">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
          <ct:trigger on="STATE.uZL" />
        </ct:handler>
