          <property name="source-code">(Mode.ImitIO)?(ALM_PROG.UNAUTHORIZED.On):(Reference.UNAUTHORIZED)</property>
        </ct:formula>
        <ct:formula target="ALM_PROG.XIX.On" source-code="(Mode.ImitIO)?(ALM_PROG.XIX.On):(Reference.XIX)" />
        <ct:formula target="ALM_PROG.UA.On" source-code="(Mode.ImitIO)?(ALM_PROG.UA.On):(Reference.UA)" />
        <ct:formula target="STATE.XLB" source-code="(Mode.ImitIO)?(STATE.XLB):(Reference.XLB)" />
        <ct:formula target="RDY.UAB" source-code="(Mode.ImitIO)?(RDY.UAB):(!Reference.UAB)" />
        <ct:bind source="Reference.HSA" target="TU_Answer.HSA_Answer" action="delivery_status" />
        <ct:bind source="Reference.HSM" target="TU_Answer.HSM_Answer" action="delivery_status" />
        <ct:formula target="Mode.XSA" source-code="(Mode.ImitIO)?(Mode.XSA):(Reference.XSA)" />
        <ct:formula target="Mode.XSM" source-code="(Mode.ImitIO)?(Mode.XSM):(Reference.XSM)" />
        <ct:handler name="_Mode_HMI" uuid="43411422-582a-4f66-a3b7-73ad34ab249e">
          <property name="source-code">current: uint2 = 0;

//current = Math.SetBit(current, 0, Mode.XLR.Value);
//current = Math.SetBit(current, 1, Mode.XLL.Value);
//current = Math.SetBit(current, 2, Mode.XSX.Value);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 4, Mode.XSTA.Value);
//current = Math.SetBit(current, 5, Mode.XSXO.Value);
current = Math.SetBit(current, 6, Mode.XSTB.Value);
current = Math.SetBit(current, 7, Mode.XLD.Value);
current = Math.SetBit(current, 8, !Mode.XLD.Value);
current = Math.SetBit(current, 9, Mode.XSA.Value);
current = Math.SetBit(current, 10, Mode.XSM.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XSS.Quality &gt;= 192)  ||  (Reference.XSTA.Quality &gt;= 192) || (Reference.XSTB.Quality &gt;= 192) || (Reference.XLD.Quality &gt;= 192) || (Reference.XSA.Quality &gt;= 192) || (Reference.XSM.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSS" cause="any-change" />
          <ct:trigger on="Mode.XSTA" cause="any-change" />
          <ct:trigger on="Mode.XSTB" cause="any-change" />
          <ct:trigger on="Mode.XLD" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
          <ct:trigger on="Mode.XSM" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="eb775964-cad0-4eb8-8d47-57bb6fb38326">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="503526d4-705c-4749-b4a6-d0e469af6d39">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XI.Value);
current = Math.SetBit(current, 2, STATE.XLR.Value);
//current = Math.SetBit(current, 3, STATE.XIE.Value);
current = Math.SetBit(current, 4, STATE.XIA.Value);
current = Math.SetBit(current, 5, STATE.XIB.Value);
current = Math.SetBit(current, 9, STATE.XLB.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XI.Quality &gt;= 192) || (Reference.XLR.Quality &gt;= 192) || (Reference.XIA.Quality &gt;= 192) || (Reference.XIB.Quality &gt;= 192) || (Reference.XLB.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XI" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XIB" cause="any-change" />
          <ct:trigger on="STATE.XLB" cause="any-change" />
          <ct:trigger on="STATE.XLR" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="fcc73c2f-e63f-4940-a87b-e03e12ab680a">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_RDY_HMI" uuid="4d5f2677-6315-47e5-b4c5-74d34761cf5f">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XL.Value);
current = Math.SetBit(current, 9, RDY.XLA.Value);
current = Math.SetBit(current, 10, RDY.XLO.Value);
current = Math.SetBit(current, 11, RDY.XLC.Value);
current = Math.SetBit(current, 8, RDY.UAB.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XL.Quality &gt;= 192) &amp;&amp; (Reference.XLA.Quality &gt;= 192) &amp;&amp; (Reference.XLO.Quality &gt;= 192) &amp;&amp; (Reference.XLC.Quality &gt;= 192) &amp;&amp; (Reference.UAB.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="RDY.XL" cause="any-change" />
          <ct:trigger on="RDY.XLA" cause="any-change" />
          <ct:trigger on="RDY.XLO" cause="any-change" />
          <ct:trigger on="RDY.XLC" cause="any-change" />
          <ct:trigger on="RDY.UAB" cause="any-change" />
        </ct:handler>
        <ct:parameter name="RDY_HMI" type="uint16" direction="out" uuid="42c3690f-aa0b-4cec-9ecc-8d648761e442">
