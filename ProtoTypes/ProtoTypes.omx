        <property name="source-code">if ((Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192) &amp;&amp; Ref_Service_PLC.Enabled)
{
	if (!Ref_Channel_1.Status.Connected &amp;&amp; Ref_Channel_1.Status.Enabled)
		Channel_1.Status.Connected_TikTimer = VQT(Channel_1.Status.Connected_TikTimer.Value, 200, DateTime.UtcNow());
	if (!Ref_Channel_2.Status.Connected &amp;&amp; Ref_Channel_2.Status.Enabled)
		Channel_2.Status.Connected_TikTimer = VQT(Channel_2.Status.Connected_TikTimer.Value, 200, DateTime.UtcNow());
}</property>
        <ct:trigger on="Ref_Timer.Timer" />
