    <namespace name="ЗадвижкаСИКН" uuid="ffe55473-243c-4892-99ef-be087c1d8f19">
      <ct:type name="M_XV" aspect="PCL" access-level="public" uuid="f928e2e8-0dec-40b2-8d15-9eb408fbed00">
