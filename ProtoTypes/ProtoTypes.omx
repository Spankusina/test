      <ct:socket name="Attrib" uuid="bfc3d4a9-fd0b-4f08-94f8-9612f4617c36">
        <attribute type="unit.System.Attributes.Description" value="Значения аттрибутов" />
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
        <ct:socket-parameter name="Sign" type="string" uuid="40ba6091-d2c5-4f20-95e7-027de2b164b0">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Common.Sign)" />
          <attribute type="Attributes.Attrib.Priority_Display_1000030" value="@(object:Attributes.Common.Priority_Display)" />
          <attribute type="Attributes.Attrib.DescriptionRUS_1000050" value="@(object:Attributes.Common.DescriptionRUS)" />
          <attribute type="Attributes.Attrib.Remote_1000020" value="@(object:Attributes.Common.Remote)" />
          <attribute type="Attributes.Attrib.Group_1000040" value="@(object:Attributes.Common.Group)" />
        </ct:socket-parameter>
      </ct:socket>
      <attribute type="Attributes.Common.Group" value="No_signal" />
      <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
      <attribute type="Attributes.Common.Remote" value="СДКУ" />
      <attribute type="Attributes.Common.DescriptionRUS" value="No_signal" />
      <ct:handler name="_EndTime_ForecastDailyRemainder" uuid="d54a3c1a-b1c1-4209-b99e-40985d744a6e">
        <ct:trigger on="ManFlow_Use" cause="change" />
        <ct:trigger on="Density" cause="change" />
        <ct:trigger on="Remainder" cause="change" />
        <ct:trigger on="Flow" cause="change" />
        <ct:trigger on="ManFlow" cause="change" />
        <property name="source-code">NowDateTime: uint8 = DateTime.Now();
NextDay: uint8 = DateTime.AddDays(DateTime.Create(DateTime.Year(NowDateTime), DateTime.Month(NowDateTime), DateTime.Day(NowDateTime), 0, 0, 0, 0), 1);

tonn_in_hour: float;
EndTime_: uint8 = 0;

if ((Density.Quality &gt;= 192) &amp;&amp; (Density.Value &gt; 0))
{
	if (ManFlow_Use.Value == false)
	{
		if ((Flow.Quality &gt;= 192) &amp;&amp; (Flow.Value &gt;= 1))
		{
			tonn_in_hour = ((Flow.Value * Density.Value) / 1000f);
			
			if ((ManBatchMass.Value &gt; 0) &amp;&amp; (NMASS_gross.Quality &gt;= 192) &amp;&amp; (ManBatchMass.Value &gt;= NMASS_gross.Value))
			{
				EndTime_ = DateTime.AddHours(NowDateTime, (Remainder / tonn_in_hour));
			}
		}
	
		EndTime = EndTime_;

		if ((EndTime_ &gt; NextDay) || EndTime_ == 0)
		{
			ForecastDailyRemainder = (((NextDay - NowDateTime)/36000000000f) * tonn_in_hour) + ((NMASS_gross.Quality &gt;= 192)?(NMASS_gross.Value):(0));
		}
		else
		{
			if (ForecastDailyRemainder != 0)
				ForecastDailyRemainder = 0;
		}
	
	}
	else
	{
		if ((ManFlow.Quality &gt;= 192) &amp;&amp; (ManFlow.Value &gt;= 1))
		{
			tonn_in_hour = ((ManFlow.Value * Density.Value) / 1000f);
			
			if ((ManBatchMass.Value &gt; 0) &amp;&amp; (NMASS_gross.Quality &gt;= 192) &amp;&amp; (ManBatchMass.Value &gt;= NMASS_gross.Value))
			{
				EndTime_ = DateTime.AddHours(NowDateTime, (Remainder / tonn_in_hour));
			}
		}
		
		EndTime = EndTime_;
		
		if ((EndTime_ &gt; NextDay) || (EndTime_ == 0))
		{
			ForecastDailyRemainder = (((NextDay - NowDateTime)/36000000000f) * tonn_in_hour) + ((NMASS_gross.Quality &gt;= 192)?(NMASS_gross.Value):(0));
		}
		else
		{
			if (ForecastDailyRemainder != 0)
				ForecastDailyRemainder = 0;
		}
	}
}
else
{
	if (ForecastDailyRemainder != 0)
		ForecastDailyRemainder = 0;
	if (EndTime != 0)
		EndTime = 0;
}</property>
        <ct:trigger on="ManBatchMass" cause="change" />
        <ct:trigger on="NMASS_gross" cause="change" />
      </ct:handler>
