}</property>
        <ct:trigger on="PoleLeakDop3" cause="message-prepare" />
      </ct:handler>
    </ct:type>
    <ct:type name="Point_SPPR" uuid="9b8e949d-230d-4891-ae92-1ebb4d079d22">
      <ct:parameter name="P" uuid="468c9cdc-45b0-4b2e-aed4-15ad66ded4d8" type="float64" direction="out">
