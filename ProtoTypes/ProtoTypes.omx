          </ct:socket-parameter>
          <ct:socket-parameter name="TypeHMI_Str" type="string" uuid="f5ff4c1c-f777-43d0-b641-e5d553a4cd85">
            <attribute type="unit.System.Attributes.InitialValue">
              <property name="value">10@(object:Attributes.Valve.Type.Type_Mini)00000000000@(object:Attributes.Valve.Type.EnableReasons)@(object:Attributes.Valve.Type.EnableALM)@(object:Attributes.Valve.Cmd.EnableCom_Open)@(object:Attributes.Valve.Cmd.EnableCom_Close)@(object:Attributes.Valve.Cmd.EnableCom_Stop)@(object:Attributes.Valve.Cmd.EnableCom_Auto)@(object:Attributes.Valve.Cmd.EnableCom_Man)0@(object:Attributes.Valve.Cmd.EnableCom_Deenerg)000000000110011@(object:Attributes.Valve.State.EnableSt_Deenerg)000000000@(object:Attributes.Valve.Mode_other.EnableMode_Remote)@(object:Attributes.Valve.Mode_other.EnableMode_Local)@(object:Attributes.Valve.Mode_other.EnableMode_Auto)@(object:Attributes.Valve.Mode_other.EnableMode_Man)0000@(object:Attributes.Valve.Mode_other.EnableAnalog_Prc)0@(object:Attributes.Valve.Mode_other.EnableAnalog_SPT1)@(object:Attributes.Valve.Mode_other.EnableAnalog_SPT2)0000</property>
