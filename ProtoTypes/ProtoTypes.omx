        <ct:handler name="_Mode_HMI" uuid="54e164dd-aed6-4c24-99f9-be60afd6a837">
          <property name="source-code">current: uint2 = Mode_HMI;

if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, Mode.XLR.Value);
       current = Math.SetBit(current, 1, Mode.XLL.Value);	
	}
	
if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL.Quality &lt; 192))
	{      
	   current = Math.SetBit(current, 0, Mode.XLR.Value);
       current = Math.SetBit(current, 1, !Mode.XLR.Value);	
	}
	
if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, !Mode.XLL.Value);
       current = Math.SetBit(current, 1, Mode.XLL.Value);	
	}	
	

if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL.Quality &lt; 192))
	{      
	   current = Math.SetBit(current, 0, false);
       current = Math.SetBit(current, 1, false);	
	}
	

if ((Mode.XSA.Quality &gt;= 192) &amp;&amp; (Mode.XSM.Quality &gt;= 192))
	{      
	  current = Math.SetBit(current, 9, Mode.XSA.Value);
      current = Math.SetBit(current, 10, Mode.XSM.Value);	
	}

if ((Mode.XSA.Quality &gt;= 192) &amp;&amp; (Mode.XSM.Quality &lt; 192))
	{      
	  current = Math.SetBit(current, 9, Mode.XSA.Value);
      current = Math.SetBit(current, 10, !Mode.XSA.Value);	
	}

if ((Mode.XSA.Quality &lt; 192) &amp;&amp; (Mode.XSM.Quality &gt;= 192))
	{      
	  current = Math.SetBit(current, 9, !Mode.XSM.Value);
      current = Math.SetBit(current, 10, Mode.XSM.Value);	
	}

if ((Mode.XSA.Quality &lt; 192) &amp;&amp; (Mode.XSM.Quality &lt; 192))
	{      
	  current = Math.SetBit(current, 9, false);
      current = Math.SetBit(current, 10, false);	
	}

current = Math.SetBit(current, 11, Mode.SL.Value);
current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192)   || (Reference.XSA.Quality &gt;= 192) || (Reference.XSM.Quality &gt;= 192) || (Reference.SL.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XLR" cause="any-change" />
          <ct:trigger on="Mode.XSA" cause="any-change" />
          <ct:trigger on="Mode.XLL" cause="any-change" />
          <ct:trigger on="Mode.XSM" cause="any-change" />
          <ct:trigger on="Mode.SL" cause="any-change" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="db5b7819-fb89-4ae5-9947-1879b78c1ca4">
          <property name="source-code">current: uint2 = STATE_HMI;

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 0, (!STATE.ZLO.Value &amp;&amp; STATE.ZLC.Value));

	}

if ((STATE.ZLO.Quality &gt;= 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))
	{      
	current = Math.SetBit(current, 0, !STATE.ZLO.Value );
	}

if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &gt;= 192))
	{      
	   current = Math.SetBit(current, 0, STATE.ZLC.Value);
	}

if ((STATE.ZLO.Quality &lt; 192) &amp;&amp; (STATE.ZLC.Quality &lt; 192))

	{      
	  current = Math.SetBit(current, 0, false);

	}

current = Math.SetBit(current, 1, STATE.XL.Value);
current = Math.SetBit(current, 2, STATE.XS.Value);
current = Math.SetBit(current, 5, STATE.ZLerr);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.XL.Quality &gt;= 192) || (Reference.XS.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) )
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <ct:trigger on="STATE.XL" cause="any-change" />
          <ct:trigger on="STATE.XS" cause="any-change" />
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="8cf4f999-da93-4b80-ae2d-322b0b6dfb2e">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="958b2483-735d-45fa-bd3f-61f1ac22ea01">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:formula target="STATE.XL" source-code="(Mode.ImitIO)?(STATE.XL):(Reference.XL)" />
        <ct:bind source="TU.HSO_tu" target="Reference.HSO" />
        <ct:bind source="TU.HSC_tu" target="Reference.HSC" />
        <ct:bind source="TU.HSA_tu" target="Reference.HSA" />
        <ct:bind source="TU.HSM_tu" target="Reference.HSM" />
        <ct:handler name="_TypeHMI" uuid="861e933b-b806-4584-9910-86a7593700c7">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" />
          <ct:trigger on="Mode_HMI" />
        </ct:handler>
        <ct:handler name="TU_HSOA" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.HSOA = TU.HSOA;" uuid="7a504eae-c6ab-4200-8bb2-be9c9fabe5f4">
          <ct:trigger on="TU.HSOA" cause="any-change" />
        </ct:handler>
        <ct:handler name="TU_RST" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.RST = TU.RST;" uuid="37521fbb-3d7d-4ba4-8f5b-9a24a2c7dbe9">
          <ct:trigger on="TU.RST" cause="any-change" />
        </ct:handler>
        <ct:bind source="TU.HSOA_tu" target="Reference.HSOA" />
        <ct:bind source="TU.RST_tu" target="Reference.RST" />
        <ct:handler name="_uLR" uuid="e6626745-c2e0-4945-a61c-75332b49abdd">
          <property name="source-code">Temp_uLR :uint2;


if (Mode.ImitIO)
  {

    if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL .Quality&gt;= 192))
	  {      
         Temp_uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL));
	  }

    if ((Mode.XLR.Quality &gt;= 192) &amp;&amp; (Mode.XLL .Quality&lt; 192))
	  {      

         Temp_uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(!Mode.XLR));
	  }

   if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL .Quality&gt;= 192))
	  {      

         Temp_uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(!Mode.XLL)+2*TypeConvert.ToInt4(Mode.XLL));
	  }
   
   if ((Mode.XLR.Quality &lt; 192) &amp;&amp; (Mode.XLL .Quality&lt; 192))
	  {      

         Temp_uLR= 99;
	  }   
    }
else
 
  {

    if ((Reference.XLR.Quality &gt;= 192) &amp;&amp; (Reference.XLL .Quality&gt;= 192))
	  {      
         Temp_uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(Mode.XLL));
	  }

    if ((Reference.XLR.Quality &gt;= 192) &amp;&amp; (Reference.XLL .Quality&lt; 192))
	  {      

         Temp_uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XLR)+2*TypeConvert.ToInt4(!Mode.XLR));
	  }

   if ((Reference.XLR.Quality &lt; 192) &amp;&amp; (Reference.XLL .Quality&gt;= 192))
	  {      

         Temp_uLR= TypeConvert.ToUint2(TypeConvert.ToInt4(!Mode.XLL)+2*TypeConvert.ToInt4(Mode.XLL));
	  }
   
   if ((Reference.XLR.Quality &lt; 192) &amp;&amp; (Reference.XLL .Quality&lt; 192))
	  {      

         Temp_uLR= 99;
	  }   
   
 }
 
  if  ((Temp_uLR&lt;99) &amp;&amp; (Temp_uLR!=Mode.uLR))
	{
	 Mode.uLR=Temp_uLR;
	}
	
if  (Temp_uLR==99)
	{
	 Mode.uLR=Temp_uLR;
	}</property>
          <ct:trigger on="Mode.XLR" cause="change" />
          <ct:trigger on="Mode.XLL" cause="change" />
        </ct:handler>
        <ct:handler name="_uAM" uuid="df7bba65-f270-4941-9c35-c82b1159dbf4">
          <ct:trigger on="Mode.XSA" cause="change" />
          <ct:trigger on="Mode.XSM" cause="change" />
          <property name="source-code">Temp_uAM :uint2;


if (Mode.ImitIO)
  {

    if ((Mode.XSA.Quality &gt;= 192) &amp;&amp; (Mode.XSM .Quality&gt;= 192))
	  {      
         Temp_uAM= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XSA)+2*TypeConvert.ToInt4(Mode.XSM));
	  }

    if ((Mode.XSA.Quality &gt;= 192) &amp;&amp; (Mode.XSM .Quality&lt; 192))
	  {      

         Temp_uAM= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XSA)+2*TypeConvert.ToInt4(!Mode.XSA));
	  }

   if ((Mode.XSA.Quality &lt; 192) &amp;&amp; (Mode.XSM .Quality&gt;= 192))
	  {      

         Temp_uAM= TypeConvert.ToUint2(TypeConvert.ToInt4(!Mode.XSM)+2*TypeConvert.ToInt4(Mode.XSM));
	  }
   
   if ((Mode.XSA.Quality &lt; 192) &amp;&amp; (Mode.XSM .Quality&lt; 192))
	  {      

         Temp_uAM= 99;
	  }   
    }
else
 
  {

    if ((Reference.XSA.Quality &gt;= 192) &amp;&amp; (Reference.XSM .Quality&gt;= 192))
	  {      
         Temp_uAM= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XSA)+2*TypeConvert.ToInt4(Mode.XSM));
	  }

    if ((Reference.XSA.Quality &gt;= 192) &amp;&amp; (Reference.XSM .Quality&lt; 192))
	  {      

         Temp_uAM= TypeConvert.ToUint2(TypeConvert.ToInt4(Mode.XSA)+2*TypeConvert.ToInt4(!Mode.XSA));
	  }

   if ((Reference.XSA.Quality &lt; 192) &amp;&amp; (Reference.XSM .Quality&gt;= 192))
	  {      

         Temp_uAM= TypeConvert.ToUint2(TypeConvert.ToInt4(!Mode.XSM)+2*TypeConvert.ToInt4(Mode.XSM));
	  }
   
   if ((Reference.XSA.Quality &lt; 192) &amp;&amp; (Reference.XSM .Quality&lt; 192))
	  {      

         Temp_uAM= 99;
	  }   
   
 }
 
  if  ((Temp_uAM&lt;99) &amp;&amp; (Temp_uAM!=Mode.uAM))
	{
	 Mode.uAM=Temp_uAM;
	}
	
if  (Temp_uAM==99)
	{
	 Mode.uAM=Temp_uAM;
	}</property>
        </ct:handler>
