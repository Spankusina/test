      <ct:handler name="_Mode_HMI" uuid="6fd9cd29-ff27-433d-bc8a-78de525e9a36">
        <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, !Mode_2.XLL.Value);
current = Math.SetBit(current, 1, Mode_2.XLL.Value);
current = Math.SetBit(current, 6, Mode.XCL.Value);
current = Math.SetBit(current, 7, Mode_2.LOCK_S.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.HRL.Quality &gt;= 192) || (Reference.LOCK.Quality &gt;= 192) || (Reference.HRR.Quality &gt;= 192) || (Reference.HCL.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
        <ct:trigger on="Mode.XCL" cause="any-change" />
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
        <ct:trigger on="Mode_2.XLL" cause="any-change" />
        <ct:trigger on="Mode_2.LOCK_S" cause="any-change" />
      </ct:handler>
