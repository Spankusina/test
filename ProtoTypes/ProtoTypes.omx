Calc_alm.AL.Messages.Selected.Message = Calc_alm.AL.Messages.Selected.Message+". Tекущее значение "+  String.ToString("%.2f", Math.Round(Val,2))+ " " + Attrib.EUnitRUS.Value + " (текущая уставка: " + String.ToString("%.2f", Math.Round(SP_AL.Value, 2)) + " " + Attrib.EUnitRUS.Value + ")";</property>
