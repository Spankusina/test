            <attribute type="unit.Server.Attributes.NodeRelativePath" value="rSP.Answer" />
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание уставки регулирования. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание уставки регулирования. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание уставки регулирования. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание уставки регулирования. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
            </attribute>
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
            <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
          </ct:socket-parameter>
          <ct:socket-parameter name="rSP_CV_Answer" type="int8" uuid="673a17ad-784a-41fb-8c84-51279740d3a7">
            <attribute type="unit.Server.Attributes.NodeRelativePath" value="rSP_CV.Answer" />
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание выхода в ручном режиме. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание выхода в ручном режиме. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание выхода в ручном режиме. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Задание выхода в ручном режиме. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
            </attribute>
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
            <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
          </ct:socket-parameter>
        </ct:socket>
