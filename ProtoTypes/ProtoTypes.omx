        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="b84b57b4-6772-4d40-9f9f-8d65f15d15b2">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="03f76706-e7a3-4445-8dc2-30ff3e76ea7e">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, XIB.Value);
current = Math.SetBit(current, 1, false);
current = Math.SetBit(current, 2, false);
current = Math.SetBit(current, 3, XISB.Value);
current = Math.SetBit(current, 4, XIBC1.Value);
current = Math.SetBit(current, 5, XIBC2.Value);


current = Math.SetBit(current, 14, ImitIO.Value);

if (ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XIB.Quality &gt;= 192) || (Reference.XIBC1.Quality &gt;= 192) || (Reference.XIBC2.Quality &gt;= 192) || (Reference.XISB.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="ImitIO" cause="any-change" />
          <ct:trigger on="XIB" cause="any-change" />
          <ct:trigger on="XISB" cause="any-change" />
          <ct:trigger on="XIBC1" />
          <ct:trigger on="XIBC2" />
        </ct:handler>
        <attribute type="Attributes.Common.Type_HMI" value="0" />
