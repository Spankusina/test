        <property name="source-code">if (Ref_AP1.Oper_Alm.Oper_LO.Value &amp;&amp; (Ref_AP1.Oper_Alm.Oper_LO.Quality &gt;= 192) &amp;&amp; (AP1.AlarmTime_LO == 0))
{
