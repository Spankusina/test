          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Режим блокировки открытия</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим блокировки открытия","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим блокировки открытия. Сигнал снят","Severity":"154","Type":"Off"}],"Type":"Discrete"}}</property>
