          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XL.Value);
current = Math.SetBit(current, 1, RDY.XL_AUX.Value);
current = Math.SetBit(current, 2, RDY.LO_ON_DN.Value);
current = Math.SetBit(current, 3, RDY.SS_ON_DN.Value);
current = Math.SetBit(current, 4, RDY.VT_ON_DN.Value);
current = Math.SetBit(current, 8, RDY.MPC_PERM.Value);
current = Math.SetBit(current, 9, RDY.XLA.Value);


if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XL.Quality &gt;= 192) || (Reference.XL_AUX.Quality &gt;= 192) || (Reference.LO_ON_DN.Quality &gt;= 192) || (Reference.SS_ON_DN.Quality &gt;= 192) || (Reference.VT_ON_DN.Quality &gt;= 192) || (Reference.XLA.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
