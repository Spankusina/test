      <ct:formula target="STATE_GU">
        <property name="source-code">TypeConvert.ToUint1(3 - 2*TypeConvert.ToInt4(!STATE.ZLC) - 3*TypeConvert.ToInt4(STATE.ZLC))</property>
      </ct:formula>
