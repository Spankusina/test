          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="e3ea00dc-a70f-459d-8923-7b9e84bea7b5">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XI.Value);
current = Math.SetBit(current, 2, STATE.XIA.Value);
current = Math.SetBit(current, 3, STATE.XIE.Value);
current = Math.SetBit(current, 4, STATE.XIF.Value);
current = Math.SetBit(current, 5, STATE.XIG.Value);
current = Math.SetBit(current, 9, STATE.XLB.Value);



if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XI.Quality &gt;= 192) || (Reference.XIA.Quality &gt;= 192) || (Reference.XIE.Quality &gt;= 192) || (Reference.XIF.Quality &gt;= 192) || (Reference.XIG.Quality &gt;= 192) || (Reference.XLB.Quality &gt;= 192)  )
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XI" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XIE" cause="any-change" />
          <ct:trigger on="STATE.XIF" cause="any-change" />
          <ct:trigger on="STATE.XIG" cause="any-change" />
          <ct:trigger on="STATE.XLB" cause="any-change" />
        </ct:handler>
