          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Нет связи","Severity":"104","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Норма","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Низкая скорость","Severity":"52","Type":"Enumeration","Value":2}],"Type":"Enumeration"}}</property>
        </attribute>
