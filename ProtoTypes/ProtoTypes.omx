        <ct:parameter name="FIRE_AVAIL" access-level="public" access-scope="global" direction="none" type="bool" uuid="7dc70cc9-a111-4607-abb6-444398d85bac">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Fire.NoAVAIL)" />
