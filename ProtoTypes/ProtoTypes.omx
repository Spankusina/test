      </ct:parameter>
      <attribute type="Attributes.SIKN.ID_Seller" value="0" />
      <r:ref name="Ref_IOS_SP" type="Уставка.IOS_SP" uuid="bd5369a2-ad19-4fe8-b72b-a15af61439d9" />
      <ct:handler name="_CMD" uuid="4c3df02a-5e1d-4f65-85a7-0e559e50a42c">
        <ct:trigger on="CMD" cause="any-change" />
        <property name="source-code">if ((CMD.Quality &gt;= 192) &amp;&amp; CMD.Value)
{
	if ((Seller_id == 0) &amp;&amp; (Ref_IOS_SP.OUT.Quality &gt;= 192) &amp;&amp; (Ref_IOS_SP.OUT.Value == 0)) //если в контроллере уже 0, то значение не обновиться с ПЛК
	{
		if (Seller_isMAN)
		{
			if (!Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled)
				commit Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled = true;
			Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_DoSnapShot = true;
			Ref_IOS_SIKN_SELLER_NAME.Seller = Ref_IOS_SIKN_SELLER_NAME.Seller_MAN;
		}
		else
		{
			if (Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled)
			{
				commit Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled = false;
				Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_DoSnapShot = true;
			}
			Ref_IOS_SIKN_SELLER_NAME.Seller = Seller;
		}
	}
	else
	{
		Ref_IOS_SP.Set_Ust = Seller_id;
		if (Seller_isMAN)
		{
			if (!Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled)
				commit Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled = true;
			Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_DoSnapShot = true;
		}
		else
		{
			if (Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled)
			{
				commit Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_Enabled = false;
				Ref_IOS_SIKN_SELLER_NAME.Seller_MAN_DoSnapShot = true;
			}
		}
	}
}</property>
      </ct:handler>
