      <ct:parameter name="NameServer" type="uint8" direction="out" uuid="c4d8b3b7-db70-45a3-b467-a78e646b58a6">
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.System.Attributes.Comment">
          <property name="value">Сервер, к которому подключился сервер СОУ: 0 - нет связь, 1 - m42rts01a, 2 - m42rts02a</property>
        </attribute>
        <attribute type="unit.System.Attributes.Description" value="Соединение с сервером СДКУ" />
