        <property name="source-code">(Mode.ImitIO)?(PLC_Alm.AHH.On):(Mode.alm_HH?(Reference.AHH):(Attrib.Bad_signal))</property>
      </ct:formula>
      <ct:formula target="PLC_Alm.AH.On">
        <property name="source-code">(Mode.ImitIO)?(PLC_Alm.AH.On):(Mode.alm_H?(Reference.AH):(Attrib.Bad_signal))</property>
      </ct:formula>
      <ct:formula target="PLC_Alm.AL.On">
        <property name="source-code">(Mode.ImitIO)?(PLC_Alm.AL.On):(Mode.alm_L?(Reference.AL):(Attrib.Bad_signal))</property>
      </ct:formula>
      <ct:formula target="PLC_Alm.ALL.On">
        <property name="source-code">(Mode.ImitIO)?(PLC_Alm.ALL.On):(Mode.alm_LL?(Reference.ALL):(Attrib.Bad_signal))</property>
      </ct:formula>
      <ct:formula source-code="(Mode.ImitIO)?(PLC_Alm.LF.On):(Reference.LF)" target="PLC_Alm.LF.On" />
      <ct:bind source="Reference.RST" target="TU_Answer.RST_Answer" action="delivery_status" />
      <ct:bind source="TU.RST_tu" target="Reference.RST" action="set_all" />
      <ct:parameter name="Physic_val" access-level="public" access-scope="global" direction="out" type="float32" uuid="fd570d8c-738f-44e8-b70c-2cf39ab06b75">
