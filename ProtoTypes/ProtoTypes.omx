      <ct:bind source="TU_2.ON_tu" target="Reference.TU_ON" />
      <ct:bind source="TU_2.HSA_tu" target="Reference.HSA" />
      <ct:bind source="TU_2.HSM_tu" target="Reference.HSM" />
      <ct:handler name="TU_ON" uuid="962f4c72-4c2b-458a-8175-811de9659f61">
        <ct:trigger on="TU_2.ON" cause="any-change" />
        <property name="source-code">if (!Mode.ImitIO &amp;&amp; (TU_2.ON.Quality &gt;= 192))
	Reference.TU_ON = TU_2.ON;</property>
      </ct:handler>
      <ct:bind source="Reference.HSA" target="TU_Answer_2.HSA_Answer" action="delivery_status" />
      <ct:bind source="Reference.HSM" target="TU_Answer_2.HSM_Answer" action="delivery_status" />
      <ct:bind source="Reference.TU_ON" target="TU_Answer_2.ON_Answer" action="delivery_status" />
      <ct:bind source="Reference.TU_OFF" target="TU_Answer_2.OFF_Answer" action="delivery_status" />
      <ct:handler name="_STATE_2_HMI" uuid="e5ec93f4-96a9-4108-8dd2-e8385e6b9b9a">
        <ct:trigger on="STATE_2.ON" cause="any-change" />
        <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 1, STATE_2.ON.Value);
current = Math.SetBit(current, 2, STATE_2.OFF.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ON.Quality &gt;= 192) || (Reference.HOT.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
      </ct:handler>
      <ct:handler name="_Mode_2_HMI" uuid="2b22cc5d-ece7-4c99-89b4-cf62bba742f4">
        <ct:trigger on="Mode_2.XSA" cause="any-change" />
        <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 9, Mode_2.XSA.Value);
current = Math.SetBit(current, 10, !Mode_2.XSA.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XSA.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
      </ct:handler>
      <ct:formula target="STATE_2.OFF" source-code="(Mode.ImitIO)?(STATE_2.ON):(Reference.ON)" />
    </ct:type>
