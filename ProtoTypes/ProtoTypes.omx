        <ct:formula target="Mode.XLL" source-code="(Mode.ImitIO)?(Mode.XLL):(Reference.XLL)" />
        <ct:handler name="_ZLOC_ZLerr" uuid="f9be5757-4e28-41f4-a47a-3853a5e6d922">
          <ct:trigger on="Reference.ZLOA" cause="any-change" />
          <ct:trigger on="Reference.ZLOB" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZLOA" cause="any-change" />
          <ct:trigger on="STATE.ZLOB" cause="any-change" />
          <property name="source-code">if (!Mode.ImitIO)
{
	STATE.ZLerr = Reference.ZLOA &amp;&amp; Reference.ZLOB;
	STATE.ZLOC = !Reference.ZLOA &amp;&amp; !Reference.ZLOB;
}
else
{
	STATE.ZLerr = STATE.ZLOA &amp;&amp; STATE.ZLOB;
	STATE.ZLOC = !STATE.ZLOA &amp;&amp; !STATE.ZLOB;
}</property>
        </ct:handler>
        <ct:bind source="TU.HSOA_tu" target="Reference.HSOA" />
        <ct:bind source="TU.HSOB_tu" target="Reference.HSOB" />
        <ct:handler name="_STATE_HMI" uuid="92e5e96e-4df8-460c-aa6a-1cddca122713">
          <ct:trigger on="STATE.ZLOA" cause="any-change" />
          <ct:trigger on="STATE.ZLOB" cause="any-change" />
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 7, (STATE.ZLOA.Value &amp;&amp; !STATE.ZLOB.Value));
current = Math.SetBit(current, 8, (STATE.ZLOB.Value &amp;&amp; !STATE.ZLOA.Value));

current = Math.SetBit(current, 4, STATE.ZLOC.Value);
current = Math.SetBit(current, 5, STATE.ZLerr.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLOA.Quality &gt;= 192) || (Reference.ZLOB.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="6ef6314a-c005-40cb-b5f0-48ef540c9c16">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, Mode.XLR.Value);
current = Math.SetBit(current, 1, Mode.XLL.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLR.Quality &gt;= 192) || (Reference.XLL.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLR" cause="any-change" />
          <ct:trigger on="Mode.XLL" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="e3c31030-738b-48a0-aac0-739636dc9084">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="82725575-136a-4761-9313-ed743ae6c1b3">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
