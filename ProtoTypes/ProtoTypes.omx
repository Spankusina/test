      <ct:handler name="_Off" uuid="4d1ec67d-7e29-4032-a909-744a8c5fcebd">
        <property name="source-code">if ((TU.Off.Quality &gt;= 192) &amp;&amp; TU.Off.Value)
{
	if (Ref_AP1.Mode.alm_oper_L)
	{
		//AP1.Off_group_cmd_LO = true;
		Ref_AP1.Mode.alm_oper_L = false;
	}
	
	if (Ref_AP1.Mode.alm_oper_H)
	{
		//AP1.Off_group_cmd_HI = true;
		Ref_AP1.Mode.alm_oper_H = false;
	}
	
	//---------------------------------------------------------------------------
	if (Ref_AP2.Mode.alm_oper_L)
	{
		//AP2.Off_group_cmd_LO = true;
		Ref_AP2.Mode.alm_oper_L = false;
	}
	
	if (Ref_AP2.Mode.alm_oper_H)
	{
		//AP2.Off_group_cmd_HI = true;
		Ref_AP2.Mode.alm_oper_H = false;
	}
	
	On = false;
}</property>
        <ct:trigger on="TU.Off" cause="any-change" />
      </ct:handler>
      <ct:socket name="AP1" direction="out" uuid="2fbfcff2-9be5-4a39-bd57-e1564cc8733b">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="Ust1" />
        <ct:socket-parameter name="AlarmTime_LO" type="uint64" uuid="fc1023c4-bd96-40bc-b282-0d0f7c3542de">
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.System.Attributes.Description" value="Время срабатывания низкой операторской уставки" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        </ct:socket-parameter>
        <attribute type="unit.System.Attributes.Description" />
        <ct:socket-parameter name="AlarmTime_HI" type="uint64" uuid="e2a7f81f-7027-4140-afb7-1e2c87549db0">
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.System.Attributes.Description" value="Время срабатывания высокой операторской уставки" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
