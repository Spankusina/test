        <ct:handler name="_Name" uuid="2a092b19-0a35-40a2-80b0-2e8036e64ede">
          <ct:trigger on="Chars.char32" cause="any-change" />
          <property name="source-code">temp_str: string = Chars.char1 + Chars.char2 + Chars.char3 + Chars.char4 + Chars.char5 + Chars.char6 + Chars.char7 + Chars.char8 + Chars.char9 + Chars.char10 + Chars.char11 + Chars.char12 + Chars.char13 + Chars.char14 + Chars.char15 + Chars.char16 + Chars.char17 + Chars.char18 + Chars.char19 + Chars.char20 + Chars.char21 + Chars.char22 + Chars.char23 + Chars.char24 + Chars.char25 + Chars.char26 + Chars.char27 + Chars.char28 + Chars.char29 + Chars.char30 + Chars.char31 + Chars.char32;

l: int4 = String.Length(temp_str);

if (l &gt; 11)
{
	l -= 1;
	ch: string = String.SubString(temp_str, l, 1);
	if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
	{
		l -= 1;
		ch = String.SubString(temp_str, l, 1);
		if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
		{
			l -= 1;
			ch = String.SubString(temp_str, l, 1);
			if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
			{
				l -= 1;
				ch = String.SubString(temp_str, l, 1);
				if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
				{
					l -= 1;
					ch = String.SubString(temp_str, l, 1);
					if (ch == ".")
					{
						l -= 1;
						ch = String.SubString(temp_str, l, 1);
						if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
						{
							l -= 1;
							ch = String.SubString(temp_str, l, 1);
							if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
							{
								l -= 1;
								ch = String.SubString(temp_str, l, 1);
								if (ch == ".")
								{
									l -= 1;
									ch = String.SubString(temp_str, l, 1);
									if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
									{
										l -= 1;
										ch = String.SubString(temp_str, l, 1);
										if (ch == "0" || ch == "1" || ch == "2" || ch == "3" || ch == "4" || ch == "5" || ch == "6" || ch == "7" || ch == "8" || ch == "9")
										{
											l -= 1;
											ch = String.SubString(temp_str, l, 1);
											if (ch == " ")
											{
												temp_str = String.SubString(temp_str, 0, String.Length(temp_str) - 11); //" dd.mm.yyyy"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

Name = temp_str;</property>
