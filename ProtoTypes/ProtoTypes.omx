      <ct:handler name="Calc_Val" access-level="public" uuid="0ba4aabd-48e3-4026-a376-5e6bc5cb6931">
        <ct:trigger on="Reference.PV" cause="any-change" />
        <ct:trigger on="Mode.ImitIO" cause="any-change" />
        <property name="source-code">Eng_val        :float;

//Определение критерия по уставке, выше верхнего значение - 1, ниже нижнего значения -101, норма - 11:
custominfo: uint8;
custominfo=TypeConvert.ToUint8((Calc_alm.AHH)?(1):((Calc_alm.AH)?(101):(((Calc_alm.ALL)?(1):((((Calc_alm.AL)?(101):(11))))))));



Eng_val=Reference.PV;



//Конроль за пределами вычесленных значений

//Eng_val=(Eng_val&gt;OutPreset.Max_EGU)?(OutPreset.Max_EGU):(Eng_val);
//Eng_val=(Eng_val&lt;OutPreset.Min_EGU)?(OutPreset.Min_EGU):(Eng_val);


if (Mode.man_mode)
   {
	  Val =Imit_val;
   }
	  	
else
    {
	  if (!Mode.ImitIO)
	    {
	  		Val=VQTC (Eng_val.Value,Eng_val.Quality, Eng_val.Timestamp, custominfo);
	  	//Val =Eng_val;
	  		Imit_val=Eng_val;
	  	}
	}</property>
      </ct:handler>
