          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Oper_SP_LO.wValue.CoreCommandStatus" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Непредвиденная ошибка","Severity":"151","Type":"Enumeration","Value":128},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Роль сервера не подходит для записи команды","Severity":"151","Type":"Enumeration","Value":129},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Нет мастера на связи","Severity":"151","Type":"Enumeration","Value":130},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Ошибка при отправке команды мастеру","Severity":"151","Type":"Enumeration","Value":131},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Потеряна связь с мастером","Severity":"151","Type":"Enumeration","Value":132},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Вышел тайм-аут ожидания ответа от мастера","Severity":"151","Type":"Enumeration","Value":133},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Реплика не готова к командам","Severity":"151","Type":"Enumeration","Value":134},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Неизвестный узел","Severity":"151","Type":"Enumeration","Value":135},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Роль изменилась во время выполнения","Severity":"151","Type":"Enumeration","Value":200}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.Description">
            <property name="value">Задать уставку оператора низкого значения. Контроль статуса доставки</property>
          </attribute>
          <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="2" />
        </ct:socket-parameter>
