        <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Отсутствует","Severity":"104","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Установлена","Severity":"104","Type":"Enumeration","Value":1}],"Type":"Enumeration"}}</property>
