          <attribute type="unit.Server.Attributes.Alarm" value="{&quot;Aggregator&quot;:{&quot;Condition&quot;:{&quot;Conditions&quot;:[{&quot;Type&quot;:&quot;Enumeration&quot;},{&quot;Type&quot;:&quot;Dynamic&quot;},{&quot;Subconditions&quot;:[&quot;On&quot;],&quot;Type&quot;:&quot;Discrete&quot;}]},&quot;IsEnabled&quot;:true,&quot;Severity&quot;:{&quot;Ranges&quot;:[{&quot;High&quot;:1,&quot;Low&quot;:1},{&quot;High&quot;:51,&quot;Low&quot;:51},{&quot;High&quot;:101,&quot;Low&quot;:101},{&quot;High&quot;:151,&quot;Low&quot;:151}]}},&quot;Conditions&quot;:{&quot;IsEnabled&quot;:&quot;false&quot;}}" />
        </ct:object>
