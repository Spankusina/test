        <ct:trigger on="Reference.MAN" />
        <property name="source-code">Qual     :bool;


	
    Qual=(Reference.AUT.Quality&gt;191) || (Reference.MAN.Quality&gt;191) || (Reference.ON.Quality&gt;191);
    
