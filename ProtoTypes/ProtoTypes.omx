            <attribute type="unit.Server.Attributes.NodeRelativePath" value="HSO.Answer" />
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Старт\/стоп. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Старт\/стоп. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Старт\/стоп. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Старт\/стоп. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
            </attribute>
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
            <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
          </ct:socket-parameter>
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="TU" />
        </ct:socket>
        <attribute type="Attributes.Common.Type_HMI" value="1" />
        <attribute type="Attributes.VS.Cmd.EnableCom_Start" value="0" />
        <attribute type="Attributes.VS.Cmd.EnableCom_Stop" value="0" />
        <ct:handler name="Handler" uuid="e04aab16-3658-449b-ba36-05d36b1c09af">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE.ZL" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="a0acc7bb-d9b9-4a96-989b-cb5fba0d3723">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="8e9257ed-7195-4d45-a0f9-e388ee97a57e">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="54b1cb9f-77dd-4787-8c59-70e476310f71">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, STATE.ZL.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="07af497d-c032-431b-bbb6-b0bd1cd5147e">
          <property name="source-code">current: uint2 = Mode_HMI;


current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
Math.SetBit(current, 15, true);


Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:object name="Comment" aspect="IOS" base-type="Служебные.Comment" uuid="1985f9d2-8f3d-415b-83db-6e3cc7d41998">
          <attribute type="unit.System.Attributes.Description" />
        </ct:object>
        <ct:bind source="TU.HSO_tu" target="Reference.ON_OFF" />
        <ct:bind source="TU.HSC_tu" target="Reference.ON_OFF" />
        <ct:bind source="Reference.ON_OFF" target="TU_Answer.ON_OFF_Answer" action="delivery_status" />
      </ct:type>
    </namespace>
