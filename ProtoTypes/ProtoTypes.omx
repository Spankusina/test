        <ct:parameter name="RACC" type="float32" direction="out" uuid="c6a35f6c-1e64-4304-a008-6aaa101f6267">
          <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Общее время работы" />
          <attribute type="unit.Server.Attributes.Unit" value="ч" />
        </ct:parameter>
