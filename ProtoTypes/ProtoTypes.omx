        <ct:handler name="ReplaceMsg" uuid="0a0f06db-989f-46a4-8cfa-c24b2c4e70d4">
          <ct:trigger on="GenMessage" cause="message-prepare" />
          <property name="source-code">GenMessage.Messages.Selected.Message = "Команда: " + GenMessage.Messages.Selected.Message;</property>
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="61353bc1-8dab-4223-80e1-8fb2ad39b7cf">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.System.Attributes.InitialValue" value="0" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_Mode_HMI" uuid="8084fc61-ffee-48f9-a875-be989184a8d2">
          <property name="source-code">current: uint2 = Mode_HMI;
current = Math.SetBit(current, 14, Mode.ImitIO.Value);
current = Math.SetBit(current, 15, true);
Mode_HMI = current;</property>
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="e0feee80-5341-4ecb-8eea-ec2a78828704">
          <ct:trigger on="STATE.ZLOC" cause="any-change" />
          <ct:trigger on="STATE.ZLerr" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

if ((STATE.HSOO.Quality &gt;= 192) &amp;&amp; (STATE.HSOC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 0, (STATE.HSOO.Value &amp;&amp; !STATE.HSOC.Value));
        current = Math.SetBit(current, 1, (STATE.HSOC.Value &amp;&amp; !STATE.HSOO.Value));
	}

if ((STATE.HSOO.Quality &gt;= 192) &amp;&amp; (STATE.HSOC.Quality &lt; 192))
	{      
		current = Math.SetBit(current, 0, STATE.HSOO.Value );
        current = Math.SetBit(current, 1, !STATE.HSOO.Value);
	}

if ((STATE.HSOO.Quality &lt; 192) &amp;&amp; (STATE.HSOC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 0, !STATE.HSOC.Value);
        current = Math.SetBit(current, 1, STATE.HSOC.Value );
	}

if ((STATE.HSOO.Quality &lt; 192) &amp;&amp; (STATE.HSOC.Quality &lt; 192))
	{      
		current = Math.SetBit(current, 0, false);
        current = Math.SetBit(current, 1, false );
	}

current = Math.SetBit(current, 4, STATE.ZLOC.Value);
current = Math.SetBit(current, 5, STATE.ZLerr.Value);
current = Math.SetBit(current, 9, STATE.HSOO.Value);
current = Math.SetBit(current, 10, STATE.HSOC.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.HSOO.Quality &gt;= 192) || (Reference.HSOC.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="STATE.uZL" cause="any-change" />
        </ct:handler>
        <ct:formula target="STATE.HSOO" source-code="(Mode.ImitIO)?(STATE.HSOO):(Reference.HSOO)" />
        <ct:formula target="STATE.HSOC" source-code="(Mode.ImitIO)?(STATE.HSOC):(Reference.HSOC)" />
        <attribute type="Attributes.Common.Type_HMI" value="0" />
        <attribute type="Attributes.Valve.Type.Type_Fire" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_Close" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_ComClose" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_ComOpen" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_Middle" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_Open" value="1" />
        <attribute type="Attributes.Valve.State.EnableSt_ZLerror" value="1" />
        <ct:handler name="Handler" uuid="b5478ce3-579e-4243-a1c9-21dc9a8fee86">
          <property name="source-code">Temp_Str: string;

Attrib.TypeHMI_64=0;
one : uint8;
sdvig :uint8;

one=1;
	
for (i: int4 = 0; i &lt;= 63; i += 1)
{
	
  Temp_Str=String.SubString(Attrib.TypeHMI_Str, i, 1);
  if  (String.Equals(Temp_Str, "1"))
    {
     sdvig=TypeConvert.ToUint8(i);
     Attrib.TypeHMI_64=Attrib.TypeHMI_64|(one&lt;&lt;sdvig);
     
    }	
 }</property>
          <ct:trigger on="STATE_HMI" cause="any-change" />
          <ct:trigger on="STATE.uZL" cause="any-change" />
        </ct:handler>
        <attribute type="Attributes.Valve.Type.EnableALM" value="1" />
        <ct:socket name="TU" access-level="public" access-scope="global" direction="in" uuid="f93accfd-dca3-42d9-9993-c87a181ff20c">
          <ct:socket-parameter name="ImitIO_On" type="bool" uuid="23a10626-7c94-410c-b909-25441879eaae">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Включить режим ''Имитация''" />
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
          </ct:socket-parameter>
          <ct:socket-parameter name="ImitIO_Off" type="bool" uuid="4c410a42-d8ea-4b4c-badd-de928d1ceaf9">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Отключить режим ''Имитация''" />
            <attribute type="unit.Server.Attributes.Replicate" value="false" />
          </ct:socket-parameter>
        </ct:socket>
        <attribute type="Attributes.Valve.Type.Type_Mini" value="1" />
        <ct:handler name="_ZLOC_ZLerr" uuid="4d5939d0-a623-4988-a188-744eb4ce1524">
          <property name="source-code">if (!Mode.ImitIO)
{

	
    if ((Reference.HSOO.Quality &gt;= 192) &amp;&amp; (Reference.HSOC.Quality &gt;= 192))
	  {      
	    STATE.ZLOC = !Reference.HSOO&amp;&amp;!Reference.HSOC;
	    STATE.ZLerr = Reference.HSOO&amp;&amp;Reference.HSOC;
	  } 
    
	else
		
	{	
	    STATE.ZLOC = false;
	    STATE.ZLerr = false;
	
	}
}
else
	
{

	
	
    if ((STATE.HSOO.Quality &gt;= 192) &amp;&amp; (STATE.HSOC.Quality &gt;= 192))
	  {      
	    STATE.ZLOC = !STATE.HSOO&amp;&amp;!STATE.HSOC;
	    STATE.ZLerr = STATE.HSOO&amp;&amp;STATE.HSOC;
	  } 	
	
	else
		
	 {
      	STATE.ZLOC = false;
	    STATE.ZLerr = false;     

     }		
	
}</property>
          <ct:trigger on="STATE.HSOO" cause="any-change" />
          <ct:trigger on="STATE.HSOC" cause="any-change" />
          <ct:trigger on="STATE.uZL" cause="any-change" />
        </ct:handler>
        <ct:handler name="_uZL" uuid="1d3ac934-37ec-44df-81be-c5a32503ccd2">
          <property name="source-code">if (Mode.ImitIO)
  {

    if ((STATE.HSOO.Quality &gt;= 192) &amp;&amp; (STATE.HSOC.Quality &gt;= 192))
	  {      
        STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.HSOO)+2*TypeConvert.ToInt4(STATE.HSOC));
	  }

     if ((STATE.HSOO.Quality &gt;= 192) &amp;&amp; (STATE.HSOC.Quality &lt; 192))
	  {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.HSOO)+2*TypeConvert.ToInt4(!STATE.HSOO));
	   }

      if ((STATE.HSOO.Quality &lt; 192) &amp;&amp; (STATE.HSOC.Quality &gt;= 192))
	   {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.HSOC)+2*TypeConvert.ToInt4(STATE.HSOC));
	   }
      
   }
else
  {
	
    if ((Reference.HSOO.Quality &gt;= 192) &amp;&amp; (Reference.HSOC.Quality &gt;= 192))
	  {      
        STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.HSOO)+2*TypeConvert.ToInt4(STATE.HSOC));
	  }

     if ((Reference.HSOO.Quality &gt;= 192) &amp;&amp; (Reference.HSOC.Quality &lt; 192))
	  {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.HSOO)+2*TypeConvert.ToInt4(!STATE.HSOO));
	   }

      if ((Reference.HSOO.Quality &lt; 192) &amp;&amp; (Reference.HSOC.Quality &gt;= 192))
	   {      

         STATE.uZL=TypeConvert.ToUint2(TypeConvert.ToInt4(!STATE.HSOC)+2*TypeConvert.ToInt4(STATE.HSOC));
	   }	
	
   }</property>
          <ct:trigger on="STATE.HSOO" cause="change" />
          <ct:trigger on="STATE.HSOC" cause="change" />
        </ct:handler>
        <ct:socket name="Mode" direction="out" uuid="c7265a10-3116-4dfe-9a60-d4cf68ef3423">
          <ct:socket-parameter name="ImitIO" type="bool" uuid="b3fce986-1063-49ee-b18d-395c7546858f">
