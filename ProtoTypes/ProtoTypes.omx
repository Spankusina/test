        <attribute type="unit.Server.Attributes.Alarm">
          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Severity":"1","Type":"Dynamic"}],"Type":"Dynamic"}}</property>
        </attribute>
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="2" />
