      <ct:handler name="TU_ImitIO_On" uuid="5803b6ae-afd0-4ef1-9b59-c243cb2866ee">
        <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
	Mode.ImitIO = true;</property>
        <ct:trigger on="TU.ImitIO_On" cause="any-change" />
      </ct:handler>
      <ct:handler name="TU_ImitIO_Off" uuid="dd0885ca-aafd-40fe-a7a1-911607c1f917">
        <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
        <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
      </ct:handler>
      <ct:handler name="TU_OFF" uuid="d8a3d218-788e-4349-9920-07827d618e86">
        <ct:trigger on="TU.OFF" />
        <property name="source-code">if (!Mode.ImitIO)
	
	{
	if (TU.OFF)
	 {	
	    Reference.OFF = true;
	 
	   }
	
	
	}</property>
      </ct:handler>
      <ct:formula target="STATE.ON" source-code="(Mode.ImitIO)?(STATE.ON):(Reference.ON)" />
      <ct:handler name="ReplaceMsg" uuid="d93d4e0d-71a5-40cc-92ac-cfb6ce2eee3c">
        <ct:trigger on="GenMessage" cause="message-prepare" />
        <property name="source-code">GenMessage.Messages.Selected.Message = "Команда: " + GenMessage.Messages.Selected.Message;</property>
      </ct:handler>
      <ct:handler name="TU_ON" uuid="578153e2-d0ee-4e89-8ae8-8e58efeea184">
        <property name="source-code">if (!Mode.ImitIO)
	
