        <ct:trigger on="TU.On" cause="any-change" />
        <property name="source-code">if ((TU.On.Quality &gt;= 192) &amp;&amp; TU.On.Value)
{
	/*if (AP4.Off_group_cmd_LO)
	{
		if (!Ref_AP4.Mode.alm_oper_L)
		{			
			Ref_AP4.Mode.alm_oper_L = true;
			AP4.Off_group_cmd_LO = false;
		}
	}
	if (AP4.Off_group_cmd_HI)
	{
		if (!Ref_AP4.Mode.alm_oper_H)
		{	
			Ref_AP4.Mode.alm_oper_H = true;
			AP4.Off_group_cmd_HI = false;
		}
	}
	
	if (AP5.Off_group_cmd_LO)
	{
		if (!Ref_AP5.Mode.alm_oper_L)
		{			
			Ref_AP5.Mode.alm_oper_L = true;
			AP5.Off_group_cmd_LO = false;
		}
	}
	if (AP5.Off_group_cmd_HI)
	{
		if (!Ref_AP5.Mode.alm_oper_H)
		{	
			Ref_AP5.Mode.alm_oper_H = true;
			AP5.Off_group_cmd_HI = false;
		}
	}*/
	
	if (!Ref_AP4.Mode.alm_oper_L)
	{
		Ref_AP4.Mode.alm_oper_L = true;
	}
	
	if (!Ref_AP4.Mode.alm_oper_H)
	{
		Ref_AP4.Mode.alm_oper_H = true;
	}

	if (!Ref_AP5.Mode.alm_oper_L)
	{
		Ref_AP5.Mode.alm_oper_L = true;
	}
	
	if (!Ref_AP5.Mode.alm_oper_H)
	{
		Ref_AP5.Mode.alm_oper_H = true;
	}
	
}</property>
      </ct:handler>
      <ct:handler name="_Off2" uuid="08afe7b5-580a-4a0c-967d-ed3af65cc33f">
