current = Math.SetBit(current, 10, !Mode_2.XSA.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XSA.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
