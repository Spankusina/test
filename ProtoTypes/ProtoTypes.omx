          <attribute type="unit.System.Attributes.InitialValue" value="Ученик" />
        </ct:parameter>
        <ct:socket name="TU" direction="in" uuid="2af091c4-76cd-42e7-872a-a89ae5394742">
          <ct:socket-parameter name="Ready" type="bool" uuid="b56a4a93-f25a-4959-ac23-bad31d7bd712">
