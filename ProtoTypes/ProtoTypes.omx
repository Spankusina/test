              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Разрешение на команды коллектор 1","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Разрешение на команды коллектор 1. Сигнал снят","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
