      <ct:type name="IOS_VALVE_SIKN" aspect="IOS" original="M_XV" access-level="public" uuid="6fbe7185-6710-46e7-9f9c-beb4c8022797">
        <attribute type="Attributes.Valve.Inversion.INV_LOCAL" value="false" />
        <attribute type="Attributes.Common.DescriptionRUS" value="Задвижка XV-001" />
        <attribute type="Attributes.Common.Group" value="M0040_D" />
        <attribute type="Attributes.Common.Priority_Display" value="No_signal" />
        <attribute type="Attributes.Common.Remote" value="No_signal" />
        <attribute type="Attributes.Common.Sign" value="XV0001" />
        <attribute type="unit.System.Attributes.Description" value="Задвижка @(object:Attributes.Common.Sign)" />
        <ct:formula source-code="TypeConvert.ToUint2(TypeConvert.ToInt4(STATE.ZLO)+2*TypeConvert.ToInt4(STATE.ZLC))" target="STATE.uZL" />
        <ct:formula source-code="(Mode.ImitIO)?(STATE.ZLO):(Reference.ZLO)" target="STATE.ZLO" />
        <ct:formula source-code="(Mode.ImitIO)?(STATE.ZLC):(Reference.ZLC)" target="STATE.ZLC" />
        <ct:formula source-code="(Mode.ImitIO)?(Mode.XLR):(INV_LOCAL?(!Reference.HLR):Reference.HLR)" target="Mode.XLR" />
        <ct:bind source="Reference.ReSeT" target="TU_Answer.RST_Answer" action="delivery_status" />
        <ct:bind source="Reference.OPEN" target="TU_Answer.HSO_Answer" action="delivery_status" />
        <ct:bind source="Reference.CLOSE" target="TU_Answer.HSC_Answer" action="delivery_status" />
        <ct:bind source="Reference.STOP" target="TU_Answer.HSS_Answer" action="delivery_status" />
        <ct:bind source="TU.RST_tu" target="Reference.ReSeT" action="set_all" />
        <ct:bind source="TU.HSO_tu" target="Reference.OPEN" action="set_all" />
        <ct:bind source="TU.HSC_tu" target="Reference.CLOSE" action="set_all" />
        <ct:bind source="TU.HSS_tu" target="Reference.STOP" action="set_all" />
        <r:ref name="Reference" type="M_XV" const-access="false" aspected="false" uuid="7a8de47d-6553-4300-9ee7-dd76efdcbd92" />
        <ct:socket name="Mode" access-level="public" access-scope="global" direction="out" uuid="53adf9cf-3582-421a-8188-b8a7debd9121">
          <ct:socket-parameter name="XLR" type="bool" uuid="d1fb5216-66c1-4bb1-ac0e-8e7263868569">
            <attribute type="unit.System.Attributes.Description">
              <property name="value">@(*object:Attributes.Common.DescriptionRUS). Режим ''Местный/Дистанционный''</property>
            </attribute>
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Местный''","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Дистанционный''","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
            </attribute>
            <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
            <attribute type="Attributes.Type_Events" value="PLC_EQ" />
          </ct:socket-parameter>
          <ct:socket-parameter name="ImitIO" type="bool" uuid="48a6a655-7827-4759-9135-a7f18bfe77a1">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Режим ''Имитация''" />
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Имитация''","Severity":"152","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим ''Имитация''. Сигнал снят","Severity":"154","Type":"Off"}],"Type":"Discrete"}}</property>
            </attribute>
            <attribute type="unit.System.Attributes.InitialValue" value="false" />
            <attribute type="unit.Server.Attributes.InitialQuality" value="192" />
            <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
          </ct:socket-parameter>
        </ct:socket>
        <ct:socket name="STATE" access-level="public" access-scope="global" direction="out" uuid="35381f82-3d28-463a-a1e7-c77a4c42bdf6">
          <ct:socket-parameter name="ZLO" type="bool" uuid="95d434ed-9013-4cab-b5aa-0369609e1597">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Открыта" />
            <attribute type="unit.System.Attributes.InitialValue" value="false" />
            <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
          </ct:socket-parameter>
          <ct:socket-parameter name="ZLC" type="bool" uuid="ec0ecc4d-1eba-449a-8409-94d74f924fe4">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Закрыта" />
            <attribute type="unit.System.Attributes.InitialValue" value="false" />
            <attribute type="unit.Server.Attributes.History" value="ServerTime=&quot;True&quot;" />
          </ct:socket-parameter>
          <ct:socket-parameter name="ZLOC" type="bool" uuid="eee78af3-ae78-4188-9c24-be115da08c56">
            <attribute type="unit.System.Attributes.Description">
              <property name="value">@(*object:Attributes.Common.DescriptionRUS). Промежуточное положение</property>
            </attribute>
            <attribute type="unit.System.Attributes.InitialValue" value="false" />
          </ct:socket-parameter>
          <ct:socket-parameter name="ZLerr" type="bool" uuid="4809b426-4535-49f1-ad89-eef386d34415">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.DescriptionRUS). Ошибка положения" />
            <attribute type="unit.System.Attributes.InitialValue" value="false" />
          </ct:socket-parameter>
          <ct:socket-parameter name="uZL" type="uint16" uuid="077c77b8-2598-4741-ab8e-fff8afd51a7f">
            <attribute type="unit.Server.Attributes.Alarm">
              <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Ошибка положения","Severity":"2","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Открыта","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Закрыта","Severity":"104","Type":"Enumeration","Value":2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Промежуточное положение","Severity":"104","Type":"Enumeration","Value":3}],"Type":"Enumeration"}}</property>
            </attribute>
            <attribute type="Attributes.Type_Events" value="PLC_EQ" />
          </ct:socket-parameter>
        </ct:socket>
        <ct:socket name="TU" access-level="public" access-scope="global" direction="in" uuid="505128ea-248f-41d9-bf46-420d435b69f4">
          <ct:socket-parameter name="RST" type="bool" uuid="56de64ca-d975-451a-9873-85fa85d11626">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Сброс" />
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
            <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
          </ct:socket-parameter>
          <ct:socket-parameter name="HSO" type="bool" uuid="7104ead4-fe76-4d26-875e-b3b95441a611">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Открыть" />
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
            <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
          </ct:socket-parameter>
          <ct:socket-parameter name="HSC" type="bool" uuid="6e37bc4c-1975-4832-9a89-ea6fb61e82b0">
            <attribute type="unit.System.Attributes.Description" value="@(*object:Attributes.Common.Sign). Закрыть" />
            <attribute type="unit.Server.Attributes.Replicate" value="true" />
            <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
