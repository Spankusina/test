          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" Подозрительный режим","Severity":"2","Type":"Enumeration","Value":32769},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" Спутниковый канал","Severity":"1","Type":"Enumeration","Value":32770},{"AckStrategy":1,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" Радио канал","Severity":"1","Type":"Enumeration","Value":32772},{"AckStrategy":1,"IsGenerateEqualSubcondition":false,"Message":" Радио канал. Медленная группа уставок","Severity":"1","Type":"Enumeration","Value":32773},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":" Оптический канал","Severity":"104","Type":"Enumeration","Value":32776},{"AckStrategy":1,"IsGenerateEqualSubcondition":false,"Message":" Оптический канал. Подозрительный режим","Severity":"1","Type":"Enumeration","Value":32777}],"Type":"Enumeration"}}</property>
        </attribute>
