        <ct:handler name="TU_HSS" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.STOP= TU.HSS;" access-level="public" uuid="5d1d9192-a944-47f4-b9e0-a249d907bf88">
          <ct:trigger on="TU.HSS" cause="any-change" />
