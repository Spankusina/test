          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.System.Attributes.Description" value="Единицы измерения на русском" />
        </ct:socket-parameter>
        <attribute type="unit.Server.Attributes.Replicate" value="false" />
        <ct:socket-parameter name="MinEGU_SP" type="float32" uuid="5a5a28cf-e197-446f-8822-c68cad5305c1">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.Min_EGU)" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        </ct:socket-parameter>
        <ct:socket-parameter name="MaxEGU_SP" type="float32" uuid="b09d9dcd-69c0-4d2e-8abf-b342ae0efd1d">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.AP.Max_EGU)" />
          <attribute type="unit.Server.Attributes.Unit" value="@(object:Attributes.AP.EUnitRUS)" />
          <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        </ct:socket-parameter>
        <ct:socket-parameter name="TypeHMI" type="uint16" uuid="9fab6b09-e9a3-4fb0-b20e-da324e6f6d8f">
          <attribute type="unit.System.Attributes.InitialValue" value="@(object:Attributes.Common.Type_HMI)" />
