        <ct:handler name="TU_ImitIO_On" access-level="public" uuid="612ce6b9-3f0a-42bd-8a1b-a7f7180771aa">
          <ct:trigger on="TU.ImitIO_On" cause="any-change" />
          <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
	Mode.ImitIO = true;</property>
        </ct:handler>
        <ct:handler name="TU_ImitIO_Off" access-level="public" uuid="4316868a-0c73-4a57-ad00-f7d1a6aadf11">
          <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
          <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
        </ct:handler>
        <ct:handler name="ReplaceMsg" source-code="GenMessage.Messages.Selected.Message = &quot;Команда: &quot; + GenMessage.Messages.Selected.Message;" access-level="public" uuid="dd605e89-841e-4155-8b88-01fef9754179">
          <ct:trigger on="GenMessage" cause="message-prepare" />
        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="167ac1c0-0418-44e2-9c98-d0ff7259c4aa">
          <ct:trigger on="STATE.ZLO" cause="any-change" />
          <ct:trigger on="STATE.ZLC" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, (STATE.ZLO.Value));
current = Math.SetBit(current, 1, (STATE.ZLC.Value));

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if (Reference.ZLO.Quality &gt;= 192)
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="1b3c66d0-1f88-48c5-b4a2-f847a13d5edb">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 14, Mode.ImitIO.Value);
current = Math.SetBit(current, 15, true);


Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
