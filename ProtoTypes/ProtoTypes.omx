          <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Нет связи","Severity":"51","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Связь с сервером m42rts01a","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Связь с сервером m42rts02a","Severity":"104","Type":"Enumeration","Value":2}],"Type":"Enumeration"}}</property>
        </attribute>
      </ct:parameter>
      <ct:parameter name="DataServer" type="uint8" direction="out" uuid="6ee5ef82-7e0e-4ff3-9883-210aecd88d6a">
        <attribute type="Attributes.Type_Events" value="SCADA_EQ" />
        <attribute type="unit.System.Attributes.Comment" value="0 - нет связи, 1 - норма, 2 - низкая скорость" />
