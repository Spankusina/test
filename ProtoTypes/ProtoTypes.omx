      <ct:parameter name="SMB_3_4" type="int16" direction="out" uuid="443985cd-719d-4629-ab51-9acef880d26e" />
      <ct:parameter name="SMB_5_6" type="int16" direction="out" uuid="9a8b7446-50ba-489a-8ae8-4e8dec58eeb6" />
      <ct:parameter name="SMB_7_8" type="int16" direction="out" uuid="3ec800e1-4dd4-43f1-9e96-c91d21913fa7" />
      <ct:bind source="Reference.SMB_1_2" target="SMB_1_2" />
      <ct:bind source="Reference.SMB_3_4" target="SMB_3_4" />
      <ct:bind source="Reference.SMB_5_6" target="SMB_5_6" />
      <ct:bind source="Reference.SMB_7_8" target="SMB_7_8" />
      <ct:handler name="Handler" uuid="f554a38e-d63f-4b18-a86b-8fc1405dbaad">
        <ct:trigger on="SMB_1_2" />
        <ct:trigger on="SMB_3_4" />
        <ct:trigger on="SMB_5_6" />
        <ct:trigger on="SMB_7_8" />
        <property name="source-code">simb1: string;
simb2: string;
simb3: string;
simb4: string;
simb5: string;
simb6: string;
simb7: string;
simb8: string;
ascii_str: string;

dig1 :int4;
dig2 :int4;

ascii_str=" ! #$%&amp;'()*+,-./0123456789:;&lt;=&gt;?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[ ]^_`abcdefghijklmnopqrstuvwxyz{|}~";

simb1=" ";
simb2=" ";
simb3=" ";
simb4=" ";
simb5=" ";
simb6=" ";
simb7=" ";
simb8=" ";


//_____________________________________________Символы 1-2_______________________

dig1=TypeConvert.ToInt4(((SMB_1_2 &amp; 65280)&gt;&gt;8)-32);
dig2=TypeConvert.ToInt4(((SMB_1_2 &amp; 255))-32);

if ((dig1&gt;=0) &amp;&amp; (dig1&lt;=126) )
 {
  simb1=String.SubString(ascii_str, dig1, 1);

 }
 
if ((dig2&gt;=0) &amp;&amp; (dig2&lt;=126) )
 {
  simb2=String.SubString(ascii_str, dig2, 1);

 } 
 
//_____________________________________________Символы 3-4_______________________

dig1=TypeConvert.ToInt4(((SMB_3_4 &amp; 65280)&gt;&gt;8)-32);
dig2=TypeConvert.ToInt4(((SMB_3_4 &amp; 255))-32);

if ((dig1&gt;=0) &amp;&amp; (dig1&lt;=126) )
 {
  simb3=String.SubString(ascii_str, dig1, 1);

 }
 
if ((dig2&gt;=0) &amp;&amp; (dig2&lt;=126) )
 {
  simb4=String.SubString(ascii_str, dig2, 1);

 }  

//_____________________________________________Символы 5-6_______________________

dig1=TypeConvert.ToInt4(((SMB_5_6 &amp; 65280)&gt;&gt;8)-32);
dig2=TypeConvert.ToInt4(((SMB_5_6 &amp; 255))-32);

if ((dig1&gt;=0) &amp;&amp; (dig1&lt;=126) )
 {
  simb5=String.SubString(ascii_str, dig1, 1);

 }
 
if ((dig2&gt;=0) &amp;&amp; (dig2&lt;=126) )
 {
  simb6=String.SubString(ascii_str, dig2, 1);

 } 
 
//_____________________________________________Символы 7-8_______________________

dig1=TypeConvert.ToInt4(((SMB_7_8 &amp; 65280)&gt;&gt;8)-32);
dig2=TypeConvert.ToInt4(((SMB_7_8 &amp; 255))-32);

if ((dig1&gt;=0) &amp;&amp; (dig1&lt;=126) )
 {
  simb7=String.SubString(ascii_str, dig1, 1);

 }
 
if ((dig2&gt;=0) &amp;&amp; (dig2&lt;=126) )
 {
  simb8=String.SubString(ascii_str, dig2, 1);

 } 
  
 
 
 
 
 
 
Descr_from_plc=simb1+simb2+simb3+simb4+simb5+simb6+simb7+simb8;</property>
      </ct:handler>
    </ct:type>
  </namespace>
