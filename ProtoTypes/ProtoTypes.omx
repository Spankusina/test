        <ct:handler name="TU_IS" access-level="public" uuid="5ad1b97f-2e00-4c53-ae62-2b8745920e79">
          <ct:trigger on="TU.IS" cause="update" />
          <property name="source-code">if (!Mode.ImitIO)
	if (TU.IS &amp;&amp; TU.IS.Quality&gt;=192)
		Reference.OutOfServ = false;
		Reference.IS = true;</property>
        </ct:handler>
        <ct:handler name="TU_HSC" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.CLOSE = TU.HSC;" access-level="public" uuid="5b3c0e91-b334-4841-886a-fe84d25e1e64">
          <ct:trigger on="TU.HSC" cause="update" />
        </ct:handler>
        <ct:formula target="STATE.PROV" source-code="(Mode.ImitIO)?(STATE.PROV):(Reference.Proving)" />
        <ct:formula target="STATE.MAINT" source-code="(Mode.ImitIO)?(STATE.MAINT):(Reference.MAINT)" />
        <ct:bind source="TU.IS_tu" target="Reference.IS" />
