        <ct:handler name="_Mode_HMI" uuid="e6b0bbe6-0fe5-480f-af4b-6cec48c936fd">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, Mode.XLLR.Value);
current = Math.SetBit(current, 1, !Mode.XLLR.Value);
current = Math.SetBit(current, 2, Mode.XSX.Value);
current = Math.SetBit(current, 3, Mode.XSS.Value);
current = Math.SetBit(current, 4, Mode.XST.Value);
current = Math.SetBit(current, 5, Mode.XSXO.Value);
current = Math.SetBit(current, 6, Mode.XSF.Value);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XLLR.Quality &gt;= 192) || (Reference.XSX.Quality &gt;= 192) || (Reference.XSS.Quality &gt;= 192) || (Reference.XST.Quality &gt;= 192) || (Reference.XSXO.Quality &gt;= 192) || (Reference.XSF.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

Mode_HMI = current;</property>
          <ct:trigger on="Mode.XLLR" cause="any-change" />
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="Mode.XSX" cause="any-change" />
          <ct:trigger on="Mode.XSS" cause="any-change" />
          <ct:trigger on="Mode.XST" cause="any-change" />
          <ct:trigger on="Mode.XSXO" cause="any-change" />
          <ct:trigger on="Mode.XSF" cause="any-change" />
        </ct:handler>
        <ct:parameter name="Mode_HMI" type="uint16" direction="out" uuid="d9f91694-efce-4185-aaef-4c5d2fc917a9">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="Mode" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:handler name="_STATE_HMI" uuid="ae29aa0d-1dfc-444e-9b54-56c1f0b46c01">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, STATE.ZL.Value);
current = Math.SetBit(current, 1, STATE.XI.Value);
current = Math.SetBit(current, 2, STATE.XIA.Value);
current = Math.SetBit(current, 3, STATE.XIE.Value);
current = Math.SetBit(current, 4, STATE.XIF.Value);
current = Math.SetBit(current, 5, STATE.XIG.Value);
current = Math.SetBit(current, 6, STATE.XLD.Value);

current = Math.SetBit(current, 7, STATE.HSC_SDC.Value);
current = Math.SetBit(current, 8, STATE.HSO_SDC.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZL.Quality &gt;= 192) || (Reference.XI.Quality &gt;= 192) || (Reference.XIA.Quality &gt;= 192) || (Reference.XIE.Quality &gt;= 192) || (Reference.XIF.Quality &gt;= 192) || (Reference.XIG.Quality &gt;= 192) || (Reference.XLD.Quality &gt;= 192) || (Reference.HSC_SCD.Quality &gt;= 192) || (Reference.HSO_SCD.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="STATE.ZL" cause="any-change" />
          <ct:trigger on="STATE.XI" cause="any-change" />
          <ct:trigger on="STATE.XIA" cause="any-change" />
          <ct:trigger on="STATE.XIE" cause="any-change" />
          <ct:trigger on="STATE.XIF" cause="any-change" />
          <ct:trigger on="STATE.XIG" cause="any-change" />
          <ct:trigger on="STATE.HSC_SDC" cause="any-change" />
          <ct:trigger on="STATE.HSO_SDC" cause="any-change" />
          <ct:trigger on="STATE.XLD" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="6f05d741-de0a-40a4-b262-e21a7960a7b6">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE" />
          <attribute type="unit.Server.Attributes.Replicate" value="true" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:parameter name="RDY_HMI" type="uint16" direction="out" uuid="e8b6614b-6f77-4c10-9a52-e1a6c7f65b92">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="RDY" />
        </ct:parameter>
        <ct:handler name="_RDY_HMI" uuid="880143ca-d9d8-4dc6-834e-caa5c5367572">
          <property name="source-code">current: uint2 = 0;

current = Math.SetBit(current, 0, RDY.XL.Value);
current = Math.SetBit(current, 1, RDY.XL_AUX.Value);
current = Math.SetBit(current, 2, RDY.LO_ON_DN.Value);
current = Math.SetBit(current, 3, RDY.SS_ON_DN.Value);
current = Math.SetBit(current, 4, RDY.VT_ON_DN.Value);
current = Math.SetBit(current, 5, RDY.XS.Value);
current = Math.SetBit(current, 6, RDY.XLS.Value);
current = Math.SetBit(current, 8, RDY.MPC_PERMISSIVE.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.XL.Quality &gt;= 192) || (Reference.XL_AUX.Quality &gt;= 192) || (Reference.LO_ON_DN.Quality &gt;= 192) || (Reference.SS_ON_DN.Quality &gt;= 192) || (Reference.VT_ON_DN.Quality &gt;= 192) || (Reference.XS.Quality &gt;= 192) || (Reference.XLS.Quality &gt;= 192)  || (Reference.XSB.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

RDY_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
          <ct:trigger on="RDY.XL" cause="any-change" />
          <ct:trigger on="RDY.XL_AUX" cause="any-change" />
          <ct:trigger on="RDY.LO_ON_DN" cause="any-change" />
          <ct:trigger on="RDY.SS_ON_DN" cause="any-change" />
          <ct:trigger on="RDY.VT_ON_DN" cause="any-change" />
          <ct:trigger on="RDY.XS" cause="any-change" />
          <ct:trigger on="RDY.MPC_PERMISSIVE" cause="any-change" />
          <ct:trigger on="RDY.XLS" cause="any-change" />
        </ct:handler>
        <ct:handler name="HSXCA" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.HSXOA = TU_O.HSXCA;" uuid="40c2c347-ecb7-4f3c-85dc-977c785abbd9">
          <ct:trigger on="TU_O.HSXCA" />
        </ct:handler>
