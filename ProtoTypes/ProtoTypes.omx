          <attribute type="unit.Server.Attributes.NodeRelativePath" value="OFF.Answer" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Отключить. Команда не доставлена. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Отключить. Команда не доставлена. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Отключить. Команда не доставлена. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Отключить. Команда не доставлена. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
        </ct:socket-parameter>
        <ct:socket-parameter name="ON_Answer" type="int8" uuid="26abb4da-1277-4deb-801b-a41425b467f8">
