{
	Ref_Extractor.Extract = true;
}</property>
      </ct:handler>
      <ct:handler name="Extract_After_Start_Server" uuid="73f7062b-7485-4afc-a4d0-671abaec0801">
        <property name="source-code">if (((Ref_Replication_This.Role.Value == 2) &amp;&amp; (Ref_Replication_This.Role.Quality &gt;= 192)) &amp;&amp; (LockExtract.Value == false) &amp;&amp; Ref_Replication_This.Role_Trigger.Value)
{
	commit Ref_Extractor.SnapShotName = Ref_InitSnapShot.Name_1;	
	//Ref_Extractor.Extract = true;
}</property>
        <ct:trigger on="Ref_Replication_This.Role_Trigger" cause="any-change" />
      </ct:handler>
      <r:ref name="Ref_Replication_This" type="Replication_This" uuid="9a00ef6d-f2fd-4025-b4da-f57569f40e02" />
      <r:ref name="Ref_Extractor" type="SnapShot Module_Extractor" uuid="e9624591-3a70-4a27-8b9a-8d6a876ea0dc" />
      <attribute type="unit.Server.Attributes.Replicate" value="false" />
      <r:ref name="Ref_InitSnapShot" type="InitSnapShot" uuid="dda4bcfb-9095-436e-9db4-3140e281fe8e" />
      <ct:parameter name="LockExtract" uuid="bf331e37-9e40-493b-8d34-ec750aa558c4" type="bool" direction="out">
        <attribute type="unit.System.Attributes.InitialValue" value="false" />
        <attribute type="unit.Server.Attributes.IsReadOnly" value="true" />
        <attribute type="unit.Server.Attributes.Replicate" value="true" />
      </ct:parameter>
      <ct:parameter name="ManExtractAllSnapShot" uuid="b00fe178-6579-461a-a5df-2a65d091cbf6" type="bool" direction="in" />
      <ct:handler name="_ManExtractAllSnapShot" uuid="4d0d4c3e-ebd0-4fa6-b223-d04c248677c0">
        <ct:trigger on="ManExtractAllSnapShot" cause="any-change" />
        <property name="source-code">if (ManExtractAllSnapShot.Value &amp;&amp; (ManExtractAllSnapShot.Quality &gt;= 192))
{
	commit CurrentSnapShot = 1;
	commit LockExtract = false;
	commit Ref_Extractor.SnapShotName = Ref_InitSnapShot.Name_1;
	Ref_Extractor.Extract = true;
}</property>
      </ct:handler>
    </ct:type>
    <ct:type name="Preset" abstract="false" access-level="public" uuid="db3966ed-a4c7-4b59-8daf-531018be3b04">
      <ct:handler name="_Generate_SnapShot_Preset" access-level="public" uuid="e14643bc-c228-460c-bc1f-871f696c1765">
        <property name="source-code">if ((DoSnapShot.Quality &gt;= 192) &amp;&amp; (DoSnapShot.Value))
{
	if (SubRef_SnapShot_Generator.TemplateName != Name + "_Template")
	{
		commit SubRef_SnapShot_Generator.TemplateName = Name  + "_Template";
	}
	if (SubRef_SnapShot_Generator.OutFileName != Name)
	{
		commit SubRef_SnapShot_Generator.OutFileName = Name;
	}
	SubRef_SnapShot_Generator.Generate = true; 
}</property>
        <ct:trigger on="DoSnapShot" cause="any-change" />
      </ct:handler>
      <ct:parameter name="Value" access-level="public" access-scope="global" direction="in-out" type="string" uuid="eb2db43a-b2b2-45ba-a168-eac211319972">
        <attribute type="unit.Server.Attributes.WriteFromSlaveServer" value="1" />
