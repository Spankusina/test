      <ct:handler name="TU_ImitIO_On" access-level="public" uuid="670d52c2-74bc-4d8a-814e-d5d4617f61da">
        <ct:trigger on="TU.ImitIO_On" cause="any-change" />
        <property name="source-code">if (TU.ImitIO_On.Quality &gt;= 192 &amp;&amp; TU.ImitIO_On.Value)
	Mode.ImitIO = true;</property>
      </ct:handler>
      <ct:handler name="TU_ImitIO_Off" access-level="public" uuid="efcf58a5-e2f0-4654-9b6d-10f839fe1df9">
        <ct:trigger on="TU.ImitIO_Off" cause="any-change" />
        <property name="source-code">if (TU.ImitIO_Off.Quality &gt;= 192 &amp;&amp; TU.ImitIO_Off.Value)
	Mode.ImitIO = false;</property>
      </ct:handler>
      <ct:handler name="TU_RST" source-code="if (!Mode.ImitIO)&#xD;&#xA;&#x9;Reference.RST = TU.RST;" access-level="public" uuid="079ab9d0-8f0c-4cd8-8dca-82d17da8a0b5">
        <ct:trigger on="TU.RST" cause="any-change" />
      </ct:handler>
      <ct:handler name="ReplaceMsg" source-code="GenMessage.Messages.Selected.Message = &quot;Команда: &quot; + GenMessage.Messages.Selected.Message;" access-level="public" uuid="8f872b54-bbc4-452c-9ad7-22759222b6eb">
        <ct:trigger on="GenMessage" cause="message-prepare" />
      </ct:handler>
      <ct:socket name="TU_Answer" access-level="public" access-scope="global" direction="out" uuid="24d50bfa-4b9d-450b-9ba1-41d2ac456be2">
        <attribute type="unit.Server.Attributes.NodeRelativePath" value="TU" />
        <ct:socket-parameter name="RST_Answer" type="int8" uuid="b7030d08-7695-42ea-85b1-8c04fe91526b">
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="RST.Answer" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"Message":". @(TU.RST_ADR:unit.System.Attributes.Description). Команда не доставлена. Команда не отправлена, т.к. модуль находится в режиме РЕЗЕРВ","Severity":"151","Type":"Enumeration","Value":-4},{"AckStrategy":0,"IsEnabled":true,"Message":". @(TU.RST_ADR:unit.System.Attributes.Description). Команда не доставлена. Ошибка конфигурирования сигнала","Severity":"151","Type":"Enumeration","Value":-3},{"AckStrategy":0,"IsEnabled":true,"Message":". @(TU.RST_ADR:unit.System.Attributes.Description). Команда не доставлена. Ошибка устройства","Severity":"151","Type":"Enumeration","Value":-2},{"AckStrategy":0,"IsEnabled":true,"Message":". @(TU.RST_ADR:unit.System.Attributes.Description). Команда не доставлена. Ошибка коммуникации","Severity":"151","Type":"Enumeration","Value":-1}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
        </ct:socket-parameter>
        <ct:socket-parameter name="RST_CoreCommandStatus" type="uint8" uuid="337f2ed5-ace9-4381-b3fc-b318018b42ea">
          <attribute type="Attributes.DeliveryStatusCoreCommand" value="DeliveryStatus" />
          <attribute type="unit.System.Attributes.ServiceItem" />
          <attribute type="unit.Server.Attributes.Replicate" value="false" />
          <attribute type="Attributes.Type_Events" value="SCADA_DIAG" />
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="RST.CoreCommandStatus" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Непредвиденная ошибка","Severity":"151","Type":"Enumeration","Value":128},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Роль сервера не подходит для записи команды","Severity":"151","Type":"Enumeration","Value":129},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Нет мастера на связи","Severity":"151","Type":"Enumeration","Value":130},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Ошибка при отправке команды мастеру","Severity":"151","Type":"Enumeration","Value":131},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Потеряна связь с мастером","Severity":"151","Type":"Enumeration","Value":132},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Вышел тайм-аут ожидания ответа от мастера","Severity":"151","Type":"Enumeration","Value":133},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Реплика не готова к командам","Severity":"151","Type":"Enumeration","Value":134},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Неизвестный узел","Severity":"151","Type":"Enumeration","Value":135},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:System.Attributes.Description). Роль изменилась во время выполнения","Severity":"151","Type":"Enumeration","Value":200}],"Type":"Enumeration"}}</property>
          </attribute>
          <attribute type="unit.System.Attributes.Description" value="Сброс. Контроль статуса доставки" />
        </ct:socket-parameter>
      </ct:socket>
      <ct:handler name="_AHH" uuid="147ed82b-6b0f-41cc-ae75-6c98dc393cff">
        <ct:trigger on="Calc_alm.AHH" cause="message-prepare" />
        <property name="source-code">SP_AHH         :float;

if (Mode.use_plc_HH)
	
   {
      SP_AHH=PLC_Preset.SP_AHH.Value;	
   }
 
 else
 	
 {
    SP_AHH=OutPreset.SP_AHH.Value;	
 }

Calc_alm.AHH.Messages.Selected.Message = Calc_alm.AHH.Messages.Selected.Message +". Текущее значение "+  String.ToString("%.2f", Math.Round(Val,2))+ " " + Attrib.EUnitRUS.Value +" (текущая уставка: " + String.ToString("%.2f", Math.Round(SP_AHH, 2)) + " " + Attrib.EUnitRUS.Value + ")";</property>
      </ct:handler>
      <ct:handler name="_AH" uuid="4c900748-53f9-494c-ac6d-268b2f918289">
