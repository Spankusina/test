            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsGenerateEqualSubcondition":true,"Message":". Неопределённое  положение тележки","Severity":"2","Type":"Enumeration","Value":0},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Выкачен","Severity":"104","Type":"Enumeration","Value":1},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":true,"Message":". Вкачен","Severity":"104","Type":"Enumeration","Value":2},{"AckStrategy":0,"IsGenerateEqualSubcondition":true,"Message":". Ошибка положения тележки","Severity":"2","Type":"Enumeration","Value":3}],"Type":"Enumeration"}}</property>
          </attribute>
