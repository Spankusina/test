        </ct:handler>
        <ct:handler name="_STATE_HMI" uuid="4b9e2663-0555-4910-87d1-e29d0d8c8e04">
          <ct:trigger on="STATE.ZLOA" cause="any-change" />
          <ct:trigger on="STATE.ZLOB" cause="any-change" />
          <property name="source-code">current: uint2 = STATE_HMI;

if ((STATE.ZLOA.Quality &gt;= 192) &amp;&amp; (STATE.ZLOB.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 0, (STATE.ZLOA.Value &amp;&amp; !STATE.ZLOB.Value));
        current = Math.SetBit(current, 1, (STATE.ZLOB.Value &amp;&amp; !STATE.ZLOA.Value));
	}

if ((STATE.ZLOA.Quality &gt;= 192) &amp;&amp; (STATE.ZLOB.Quality &lt; 192))
	{      
		current = Math.SetBit(current, 0, STATE.ZLOA.Value );
        current = Math.SetBit(current, 1, !STATE.ZLOA.Value);
	}

if ((STATE.ZLOA.Quality &lt; 192) &amp;&amp; (STATE.ZLOB.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 0, !STATE.ZLOB.Value);
        current = Math.SetBit(current, 1, STATE.ZLOB.Value );
	}

if ((STATE.ZLOA.Quality &lt; 192) &amp;&amp; (STATE.ZLOB.Quality &lt; 192))
	{      
		current = Math.SetBit(current, 0, false);
        current = Math.SetBit(current, 1, false );
	}



if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192))
	{      
	current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI" uuid="3df8cfa0-a0ef-46e9-9acf-48c3e3dada5f">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 14, Mode.ImitIO.Value);
current = Math.SetBit(current, 15, true);


Mode_HMI = current;</property>
          <ct:trigger on="Mode.ImitIO" cause="any-change" />
        </ct:handler>
        <ct:parameter name="STATE_HMI" type="uint16" direction="out" uuid="a090d266-4ec2-46dc-a121-3243aaddb50c">
