        <ct:handler name="_STATE_HMI_TRANS" uuid="74024fa2-8214-4df7-9d33-65212968bfbc">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 6, TRANS.Value);

if (Mode.ImitIO.Value)
{
	current = Math.SetBit(current, 15, true);
}
else 
{	if ((Reference.ZLO.Quality &gt;= 192) || (Reference.ZLC.Quality &gt;= 192) || (Reference_P.TRANS.Quality &gt;= 192))
	{      
		current = Math.SetBit(current, 15, true);
	}
	else
	{
		current = Math.SetBit(current, 15, false);
	}
}

STATE_HMI = current;</property>
        </ct:handler>
        <ct:formula target="OUT_LF.On" source-code="(Mode.ImitIO)?(OUT_LF.On):(Reference_P.OUT_LF)" />
        <ct:formula target="LF.On" source-code="(Mode.ImitIO)?(LF.On):(Reference_P.LF)" />
        <ct:parameter name="XSP" type="bool" direction="out" uuid="235d8b68-8bf8-4d46-8780-7d4f89c7e2b2">
          <attribute type="unit.System.Attributes.Description">
            <property name="value">@(*object:Attributes.Common.DescriptionRUS). Режим работы ''Основной''</property>
          </attribute>
          <attribute type="unit.Server.Attributes.NodeRelativePath" value="STATE.XSP" />
          <attribute type="unit.Server.Attributes.Alarm">
            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим работы ''Основной''","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". Режим работы ''Основной''. Сигнал снят","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
          </attribute>
          <attribute type="Attributes.Type_Events" value="PLC_EQ" />
          <attribute type="unit.Server.Attributes.History" />
        </ct:parameter>
        <ct:formula target="PV" source-code="(Mode.ImitIO)?(PV):(Reference_P.PV)" />
        <ct:formula target="XSP" source-code="(Mode.ImitIO)?(XSP):(Reference_P.XSP)" />
        <ct:handler name="_STATE_HMI1" uuid="f502cbcb-4030-4b3d-9829-49a986225048">
          <property name="source-code">current: uint2 = STATE_HMI;

current = Math.SetBit(current, 0, PV&gt;5);
current = Math.SetBit(current, 1, PV&lt;1);

current = Math.SetBit(current, 4, false);
current = Math.SetBit(current, 5, false);

if (current==0)
	
 {
	current = Math.SetBit(current, 0, PV&gt;=1);
    current = Math.SetBit(current, 1, PV&lt;1);
	
 }
	
	

current = Math.SetBit(current, 15, true);


STATE_HMI = current;</property>
          <ct:trigger on="PV" cause="any-change" />
        </ct:handler>
        <ct:handler name="_Mode_HMI1" uuid="578bba66-5383-4f37-9d98-faba57eb9039">
          <property name="source-code">current: uint2 = Mode_HMI;

current = Math.SetBit(current, 0, true);
current = Math.SetBit(current, 1, false);
current = Math.SetBit(current, 2, false);
current = Math.SetBit(current, 3, false);

current = Math.SetBit(current, 14, Mode.ImitIO.Value);
current = Math.SetBit(current, 15, true);



Mode_HMI = current;</property>
          <ct:trigger on="PV" cause="any-change" />
        </ct:handler>
