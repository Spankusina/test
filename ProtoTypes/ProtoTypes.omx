            <property name="value">{"Condition":{"IsEnabled":"true","Subconditions":[{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description)","Severity":"104","Type":"On"},{"AckStrategy":0,"IsEnabled":true,"IsGenerateEqualSubcondition":false,"Message":". @(:unit.System.Attributes.Description). Сигнал снят","Severity":"104","Type":"Off"}],"Type":"Discrete"}}</property>
