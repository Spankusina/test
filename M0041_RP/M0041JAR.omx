        <ct:handler name="TU_Calc_On" access-level="public" uuid="50f39274-987f-42b3-b09f-cb2e10e10fba">
          <ct:trigger on="TU.Calc_On" cause="any-change" />
          <property name="source-code">if ((TU.Calc_On.Quality &gt;= 192) &amp;&amp; TU.Calc_On.Value)
{
	if (CPC.M0041.JAR.TANKAGE.TKB001.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB001.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB002.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB002.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB003.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB003.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB004.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB004.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB005.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB005.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB006.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB006.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB007.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB007.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB008.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB008.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB009.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB009.INFO.Calc = true;
	if (CPC.M0041.JAR.TANKAGE.TKB010.INFO.Calc == false)
		commit CPC.M0041.JAR.TANKAGE.TKB010.INFO.Calc = true;
	
	if (Ref_SnapShot_Generator.TemplateName != "Use_Tank_Template")
	{
		commit Ref_SnapShot_Generator.TemplateName = "Use_Tank_Template";
	}
	if (Ref_SnapShot_Generator.OutFileName != "Use_Tank")
	{
		commit Ref_SnapShot_Generator.OutFileName = "Use_Tank";
	}
	Ref_SnapShot_Generator.Generate = true;
	Calc = true;
}</property>
        </ct:handler>
